#!/usr/bin/env python3
"""Keeps the one-file helpers' copy of Shepherdr's paths equal to its one source.

The helpers that go to other machines as one file each (herdr-secret, herdr-artifact) carry a block of
Shepherdr's paths between "# ---- SHEP:" and "# ---- end SHEP ----": the source is
mods/tasks/bin/herdr_task/layout.py's PY, written in here. Edit layout.py, never a block, then run this.

  bin/sync-shared            write the block into each helper
  bin/sync-shared --check    change nothing; exit 1 if a block differs from layout.py's PY (or is missing)

(Until 3.2 this also copied lib/ and core/ modules into the Herdr window's mods; the window's mods are gone.)
"""
import os, sys

HOME = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
LAYOUT = os.path.join("mods", "tasks", "bin", "herdr_task", "layout.py")
SHEP_BLOCKS = ["bin/herdr-secret", "mods/artifacts/bin/herdr-artifact"]


def read(path):
    try:
        with open(path, "rb") as f:
            return f.read()
    except FileNotFoundError:
        return None


def write(path, data):
    tmp = f"{path}.sync-{os.getpid()}"
    with open(tmp, "wb") as f:
        f.write(data)
    os.replace(tmp, path)


def shep_blocks(check):
    """The SHEP block in each one-file helper, as layout.py's PY says. Returns (bad, made)."""
    try:
        import importlib.util
        sys.dont_write_bytecode = True
        spec = importlib.util.spec_from_file_location("shep_layout", os.path.join(HOME, LAYOUT))
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        want = mod.PY
    except (OSError, ImportError, SyntaxError, AttributeError) as e:
        return [f"{LAYOUT}: {e}"], []
    bad, made = [], []
    for rel in SHEP_BLOCKS:
        path = os.path.join(HOME, rel)
        text = (read(path) or b"").decode()
        if not text:
            bad.append(f"{rel} is missing")
            continue
        try:
            a = text.index("\n", text.index("# ---- SHEP:")) + 1
            b = text.index("# ---- end SHEP ----")
        except ValueError:
            bad.append(f"{rel} has no SHEP block")
            continue
        if text[a:b] == want.lstrip("\n"):
            continue
        if check:
            bad.append(f"{rel}'s SHEP block differs from layout.py's PY")
        else:
            mode = os.stat(path).st_mode
            write(path, (text[:a] + want.lstrip("\n") + text[b:]).encode())
            os.chmod(path, mode)
            made.append(rel)
    return bad, made


def main(argv):
    check = "--check" in argv
    bad, made = shep_blocks(check)
    for rel in made:
        print(f"synced {rel}")
    if bad:
        print("sync-shared: " + ("out of sync" if check else "not synced") + ":", file=sys.stderr)
        for b in bad:
            print(f"  {b}", file=sys.stderr)
        sys.exit(1)
    if check:
        print(f"sync-shared: the SHEP block in all {len(SHEP_BLOCKS)} helpers matches layout.py")


if __name__ == "__main__":
    main(sys.argv[1:])

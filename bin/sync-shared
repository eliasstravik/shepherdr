#!/usr/bin/env python3
"""Keeps the mods' copies of shared modules equal to their one source in lib/ (or core/).

A mod can only import files inside its own folder (Herdr refuses symlinks and ../ paths that
resolve outside it), so a module several mods use is copied into each. lib/<file> is the source;
lib/COPIES names the mods that carry a copy. Edit lib/<file>, never a copy, then run this.
A name core/<file> is the shared core (Shepherdr 3.1: the logic the web app and the service use too): its
source is core/<file> beside lib/, and each mod's copy is mods/<mod>/core/<file>.

  bin/sync-shared                 copy every lib file into its mods
  bin/sync-shared --check         change nothing; exit 1 if any copy differs from lib
  bin/sync-shared --from <copy>   a copy was edited by hand: make it the source, then sync

A copy that differs from both lib and what this last wrote there (lib/.last/) was edited by
hand: it is never overwritten; the run fails and names it (keep its change with --from, or move
the change into lib/<file>). A fresh checkout or worktree has no lib/.last: what git last
committed of the source stands in for it (a copy equal to that is ours, not hand-edited).

The helpers that go to other machines as one file each (herdr-secret, herdr-artifact) carry a block of
Shepherdr's paths between "# ---- SHEP:" and "# ---- end SHEP ----": the source is
mods/tasks/bin/herdr_task/layout.py's PY, written in here too.
"""
import hashlib, os, shutil, subprocess, sys

HOME = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
LIB, MODS = os.path.join(HOME, "lib"), os.path.join(HOME, "mods")
src_of = lambda name: os.path.join(HOME, name) if name.startswith("core/") else os.path.join(LIB, name)
LAST = os.path.join(LIB, ".last")


def read(path):
    try:
        with open(path, "rb") as f:
            return f.read()
    except FileNotFoundError:
        return None


def committed(name):
    """The source as git last committed it (HEAD), or None outside a checkout."""
    rel = os.path.relpath(src_of(name), HOME)
    try:
        r = subprocess.run(["git", "-C", HOME, "show", f"HEAD:{rel}"], capture_output=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout if r.returncode == 0 else None


def copies():
    out = {}
    with open(os.path.join(LIB, "COPIES")) as f:
        for line in f:
            line = line.split("#", 1)[0].strip()
            if line:
                name, mods = line.split(":", 1)
                out[name.strip()] = mods.split()
    return out


def write(path, data):
    tmp = f"{path}.sync-{os.getpid()}"
    with open(tmp, "wb") as f:
        f.write(data)
    os.replace(tmp, path)


SHEP_BLOCKS = ["bin/herdr-secret", "mods/artifacts/bin/herdr-artifact"]


def shep_blocks(check):
    """The SHEP block in each one-file helper, as layout.py's PY says. Returns (bad, made)."""
    try:
        import importlib.util
        spec = importlib.util.spec_from_file_location("shep_layout", os.path.join(MODS, "tasks", "bin", "herdr_task", "layout.py"))
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        want = mod.PY
    except (OSError, ImportError, SyntaxError) as e:
        return [f"mods/tasks/bin/herdr_task/layout.py: {e}"], []
    bad, made = [], []
    for rel in SHEP_BLOCKS:
        path = os.path.join(HOME, rel)
        text = (read(path) or b"").decode()
        if not text:
            continue
        try:
            a = text.index("\n", text.index("# ---- SHEP:")) + 1
            b = text.index("# ---- end SHEP ----")
        except ValueError:
            bad.append(f"{rel} has no SHEP block")
            continue
        if text[a:b] == want.lstrip("\n"):
            continue
        if check:
            bad.append(f"{rel}'s SHEP block differs from layout.py's PY")
        else:
            mode = os.stat(path).st_mode
            write(path, (text[:a] + want.lstrip("\n") + text[b:]).encode())
            os.chmod(path, mode)
            made.append(rel)
    return bad, made


def main(argv):
    check = "--check" in argv
    table = copies()
    if "--from" in argv:
        src = os.path.realpath(argv[argv.index("--from") + 1])
        name = os.path.basename(src)
        mod = os.path.basename(os.path.dirname(src))
        if mod == "core":
            name, mod = f"core/{name}", os.path.basename(os.path.dirname(os.path.dirname(src)))
        if name not in table or mod not in table[name]:
            sys.exit(f"sync-shared: {src} is not a copy listed in lib/COPIES")
        shutil.copyfile(src, src_of(name))
        print(f"{os.path.relpath(src_of(name), HOME)} <- {os.path.relpath(src, HOME)}")

    bad, made = [], []
    for name, mods in table.items():
        lib = read(src_of(name))
        if lib is None:
            bad.append(f"{os.path.relpath(src_of(name), HOME)} is missing")
            continue
        last = read(os.path.join(LAST, name))
        if last is None:
            last = committed(name)
        for mod in mods:
            path = os.path.join(MODS, mod, name)
            rel = os.path.relpath(path, HOME)
            if not os.path.isdir(os.path.join(MODS, mod)):
                bad.append(f"{rel}: mods/{mod} is gone (remove it from lib/COPIES)")
                continue
            have = read(path)
            if have == lib:
                continue
            if check:
                bad.append(f"{rel} differs from lib/{name}")
            elif have is None or have == last:
                os.makedirs(os.path.dirname(path), exist_ok=True)
                write(path, lib)
                made.append(rel)
            else:
                bad.append(f"{rel} was edited by hand: keep it with `bin/sync-shared --from {rel}`, or move the change into lib/{name}")
        if not check:
            os.makedirs(os.path.dirname(os.path.join(LAST, name)), exist_ok=True)
            write(os.path.join(LAST, name), lib)
        # A copy made by hand in a mod lib/COPIES doesn't list (same name, same start).
        head = lib.split(b"\n", 1)[0]
        for mod in sorted(os.listdir(MODS)):
            path = os.path.join(MODS, mod, name)
            if mod not in mods and (read(path) or b"").split(b"\n", 1)[0] == head:
                bad.append(f"mods/{mod}/{name} looks like a copy of lib/{name}: add {mod} to lib/COPIES")

    b2, m2 = shep_blocks(check)
    bad += b2
    made += m2
    for rel in made:
        print(f"synced {rel}")
    if bad:
        print("sync-shared: " + ("copies out of sync" if check else "not synced") + ":", file=sys.stderr)
        for b in bad:
            print(f"  {b}", file=sys.stderr)
        sys.exit(1)
    if check:
        print(f"sync-shared: all {sum(len(m) for m in table.values())} copies match lib/ and core/")


if __name__ == "__main__":
    main(sys.argv[1:])

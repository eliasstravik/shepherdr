#!/bin/sh
# herdr-desktop: an agent's desktop (3.2). agent-desktop (the agent's tool to see and act on a desktop) on the
# desktop Shepherdr's Screen shows live and the person can take over. The picture comes from a screen server beside
# it, on the machine itself only (127.0.0.1), reached only through the Shepherdr service:
#   Linux   each agent has its own virtual display: Xvnc :N (display and VNC server in one; else Xvfb + x11vnc), a
#           small window manager and a session bus of its own. Started by its first command, stopped with its task.
#   macOS   the Mac's one real screen through the built-in Screen Sharing (port 5900), shared by its agents: ONE
#           agent at a time. The next agent that wants it waits (its task reads "Waiting for the desktop") until the
#           holder is done (herdr-desktop release), stops, or has left it unused for 5 minutes.
# Whose: as herdr-browser: --task <key> (else $HERDR_BROWSER_TASK), --space <id> (else $HERDR_BROWSER_SPACE), --chat,
# or the labels of the terminal it runs in. Its files sit beside herdr-browser's (~/.local/state/shepherdr/browser):
#   <name>.you      the person drives (Take over): every command is refused and nothing is read, until Hand back
#   <name>.hands    the agent asked for the person's hands (herdr-desktop hands "<what>")
#   <name>.display  its own display (Linux): number, VNC port, pids
#   <name>.dused    touched by every agent command
#   <name>.waits    it waits for the shared desktop (macOS)
#   desktop.holder  who holds the shared desktop (macOS): its key; its time is its last command
# --own: Shepherdr's own (the Screen): never refused, takes no turn, installs nothing.
# --own --up: makes sure the desktop can be shown and prints {"ok","port","display","own"} (or "why" it can't).
# --own --state: the same, starting nothing.  --own --down: stops its own display.
# Driver: $HERDR_DESKTOP_DRIVER (own | shared), else by system.
#
# agent-desktop itself (SHEP-346, as herdr-browser does agent-browser): $HERDR_DESKTOP_BIN (taken as it is), else any
# 1.3.x from the pin on: Shepherdr's own copy in ~/.local/share/shepherdr/agent-desktop/<pin>/ (preferred once there),
# else the PATH's. When there's none, an agent's first command installs it there: agent-desktop's own release archive
# for this machine (github.com/vercel-labs/agent-desktop), checked against the pin's checksum (no npm, no sudo).
# Install and update run --install too, and herdr-task machines sync runs it where it carries herdr-desktop. A failed
# try isn't repeated for 10 minutes, except by --install.
# --install  makes sure a working agent-desktop is here (installs it), and says what is still missing
# --status   what's here, as JSON, installing nothing (shepherdr doctor): ok, the problem and the one fix; on a Mac
#            also agent-desktop's permissions (Accessibility, Screen Recording) and Screen Sharing, which only the
#            person can switch on there ("needs", in plain words)
# --bin      the agent-desktop it runs, installing nothing

PIN=1.3.1
# The pinned release's archives (agent-desktop-v<pin>-<target>.tar.gz; its checksums.txt), by target: sha256.
sha_for() {
  case "$1" in
    aarch64-apple-darwin) echo 9b7b7cfc74892eab46c2c85d6cb7dc4863bf8dab0a222cfcfb8ae4604c69c86c ;;
    x86_64-apple-darwin) echo 469da10cfb68928c58caff88b92b30526e0ca895ac06bc86b7f533b1d9b309b3 ;;
    aarch64-unknown-linux-gnu) echo 438990a703fbeb19775596c341c3701435e80adbfa1b2f64b82ff17567d5573b ;;
    x86_64-unknown-linux-gnu) echo ca77b6b75034eeb12e537dd8c0a4f2a3424119253f38b7e6bd79ba0d2fef1264 ;;
  esac
}

if [ -n "${SHEPHERDR_HOME:-}" ]; then shep_data="$SHEPHERDR_HOME/data"; shep_state="$SHEPHERDR_HOME/state"
else shep_data="${XDG_DATA_HOME:-$HOME/.local/share}/shepherdr"; shep_state="${XDG_STATE_HOME:-$HOME/.local/state}/shepherdr"; fi
if [ "$(cut -c1 "$shep_data/LAYOUT" 2>/dev/null)" = 2 ] && [ ! -e "$HOME/.herdr/.layout-rollback" ]; then root="$shep_state/browser"
else root="$HOME/.herdr/browser"; fi
# Shepherdr's own agent-desktop (always in its data folder, whatever the layout)
addir="$shep_data/agent-desktop"
mine="$addir/$PIN/agent-desktop"
# the one command that fixes it, as the person can type it
if [ "$(command -v herdr-desktop 2>/dev/null)" ]; then fix="herdr-desktop --install"; else fix="$0 --install"; fi

json_str() { printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()), end="")'; }
driver=${HERDR_DESKTOP_DRIVER:-}
if [ -z "$driver" ]; then if [ "$(uname -s)" = Darwin ]; then driver=shared; else driver=own; fi; fi
have() { command -v "$1" >/dev/null 2>&1; }
# What the live picture needs here, and what is missing ("" when nothing is).
missing() {
  if [ "$driver" = shared ]; then return 0; fi
  if have Xvnc; then return 0; fi
  if have Xvfb && have x11vnc; then return 0; fi
  echo "a virtual display with a screen server: Xvnc (TigerVNC: tigervnc-standalone-server), or Xvfb with x11vnc"
}
port_open() { python3 -c 'import socket,sys
try: socket.create_connection(("127.0.0.1", int(sys.argv[1])), timeout=1).close()
except Exception: sys.exit(1)' "$1" 2>/dev/null; }

# Same major and minor as the pin, and not older: 1.3.1, 1.3.2… (1.4 may change what Herdr relies on).
compatible() {
  _v=${1%%[-+]*}
  case "$_v" in [0-9]*.[0-9]*.[0-9]*) ;; *) return 1 ;; esac
  case "$_v" in *[!0-9.]*|*.*.*.*) return 1 ;; esac
  [ "${_v%.*}" = "${PIN%.*}" ] && [ "${_v##*.}" -ge "${PIN##*.}" ]
}
# Which agent-desktop. Sets bin, ver, from (env, shepherdr, path; "" when there's none).
pick() {
  ver=
  if [ -n "${HERDR_DESKTOP_BIN:-}" ]; then bin=$HERDR_DESKTOP_BIN; from=env; return 0; fi
  if [ -x "$mine" ]; then bin=$mine; from=shepherdr
  else bin=$(command -v agent-desktop 2>/dev/null); from=path; fi
  if [ -n "$bin" ]; then ver=$("$bin" --version 2>/dev/null | awk 'NR == 1 { print $NF }'); else from=; fi
}
usable() { [ -n "$bin" ] && { [ "$from" = env ] || compatible "$ver"; }; }

# Puts agent-desktop $PIN's own release for this machine in $addir/$PIN. -> 0, or 1 with $why.
install_mine() {
  case "$(uname -s)" in
    Darwin) _os=apple-darwin; _helper=agent-desktop-macos-helper ;;
    Linux)
      if (ldd --version 2>&1 || true) | grep -qi musl; then why="agent-desktop has no build for musl Linux (Alpine)"; return 1; fi
      _os=unknown-linux-gnu; _helper=agent-desktop-linux-clipboard-owner ;;
    *) why="agent-desktop has no build for $(uname -s)"; return 1 ;;
  esac
  case "$(uname -m)" in
    x86_64|amd64) _arch=x86_64 ;;
    arm64|aarch64) _arch=aarch64 ;;
    *) why="agent-desktop has no build for $(uname -m)"; return 1 ;;
  esac
  _target=$_arch-$_os
  _want=${HERDR_DESKTOP_SHA256:-$(sha_for "$_target")}
  [ -n "$_want" ] || { why="agent-desktop has no build for $_target"; return 1; }
  have curl || { why="curl isn't installed"; return 1; }
  have tar || { why="tar isn't installed"; return 1; }
  _url="${HERDR_DESKTOP_URL:-https://github.com/vercel-labs/agent-desktop/releases/download/v$PIN}/agent-desktop-v$PIN-$_target.tar.gz"
  _tmp="$addir/.part.$$"
  echo "herdr-desktop: downloading agent-desktop $PIN…" >&2
  if ! _err=$(curl -fsSL --retry 2 --connect-timeout 15 --max-time 600 -o "$_tmp" "$_url" 2>&1); then
    rm -f "${_tmp:?}"; why="couldn't download it (${_err:-no answer}; offline?)"; return 1
  fi
  _got=$( (sha256sum "$_tmp" 2>/dev/null || shasum -a 256 "$_tmp" 2>/dev/null) | awk '{ print $1 }')
  if [ "$_got" != "$_want" ]; then
    rm -f "${_tmp:?}"; why="the download isn't agent-desktop $PIN (its checksum differs)"; return 1
  fi
  # exactly the two files it should hold: agent-desktop and its helper
  if [ "$(tar -tzf "$_tmp" 2>/dev/null | sort | tr '\n' ' ')" != "agent-desktop $_helper " ]; then
    rm -f "${_tmp:?}"; why="the download isn't agent-desktop $PIN (it holds other files)"; return 1
  fi
  _stage="$addir/.stage.$$"
  rm -rf "${_stage:?}"; mkdir -p "$_stage"
  if ! tar -xzf "$_tmp" -C "$_stage" 2>/dev/null || [ ! -f "$_stage/agent-desktop" ]; then
    rm -rf "${_stage:?}" "${_tmp:?}"; why="couldn't unpack it"; return 1
  fi
  rm -f "${_tmp:?}"
  chmod 755 "$_stage/agent-desktop" "$_stage/$_helper"
  rm -rf "${addir:?}/${PIN:?}"
  mv "$_stage" "$addir/$PIN" || { rm -rf "${_stage:?}"; why="can't write to $addir"; return 1; }
  # an older pin's copy: no longer used
  for _d in "$addir"/*/; do
    _dd=${_d%/}; [ -d "$_d" ] && [ "$_dd" != "$addir/$PIN" ] && rm -rf "${_dd:?}"
  done
  return 0
}

# Makes sure a usable agent-desktop is here; one at a time. -> 0, or 1 with $why (kept in .failed).
ensure() {
  why=
  mkdir -p "$addir" 2>/dev/null || { why="can't write to $addir"; return 1; }
  _n=0
  until mkdir "$addir/.lock" 2>/dev/null; do
    [ "$_n" = 0 ] && echo "herdr-desktop: another herdr-desktop is installing agent-desktop $PIN; waiting for it…" >&2
    if [ -n "$(find "${addir:?}/.lock" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then rmdir "${addir:?}/.lock" 2>/dev/null; continue; fi
    _n=$((_n + 1)); [ "$_n" -gt 600 ] && { why="another install is still running"; return 1; }
    sleep 1
  done
  pick
  _ok=0
  if ! usable; then
    echo "herdr-desktop: installing agent-desktop $PIN for Shepherdr into $addir (once)…" >&2
    install_mine || _ok=1
    if [ "$_ok" = 0 ]; then
      pick
      usable || { _ok=1; why="the agent-desktop it installed doesn't run here"; }
    fi
  fi
  if [ "$_ok" = 0 ]; then rm -f "${addir:?}/.failed"; else printf '%s\n' "$why" > "${addir:?}/.failed"; fi
  rmdir "${addir:?}/.lock" 2>/dev/null
  return $_ok
}

# What's wrong with agent-desktop, and the one command that fixes it.
problem() {
  if [ -z "$bin" ]; then _what="agent-desktop isn't installed here"
  else _what="Shepherdr runs agent-desktop $PIN (or a newer ${PIN%.*}.x); this machine has ${ver:-an unknown version} ($bin)"; fi
  _why=
  if [ -n "$why" ]; then _why=", and Shepherdr couldn't install it: $why"; fi
  echo "herdr-desktop: $_what$_why. Fix it: $fix"
}

# A Mac: what only the person can switch on there. agent-desktop's own report (`agent-desktop permissions`:
# data.accessibility, .screen_recording, .automation, each {"state": "granted" | "denied" | "not_required" | "unknown"}),
# and Screen Sharing (port 5900) for the picture Shepherdr shows. Sets perms (JSON, or null), blocking (the first thing
# without which the agent can't work, or "") and needs (each thing to switch on, one plain line each).
mac_needs() {
  perms=null; blocking=; needs=; _sharing=
  [ "$driver" = shared ] || return 0
  # Screen Sharing: off (nothing answers), nopw (it answers but offers no VNC password sign-in, RFB security type 2:
  # "VNC viewers may control screen with password" is off), or on
  _sharing=$(python3 -c 'import socket,sys
try:
    s = socket.create_connection(("127.0.0.1", int(sys.argv[1])), timeout=2)
except Exception:
    print("off"); sys.exit(0)
try:
    s.settimeout(3)
    ver = s.recv(12)
    if not ver.startswith(b"RFB "):
        print("off"); sys.exit(0)
    if ver < b"RFB 003.007":
        print("on"); sys.exit(0)
    s.sendall(b"RFB 003.008\n")
    n = s.recv(1)[0]
    types = s.recv(n) if n else b""
    print("on" if 2 in types else "nopw")
except Exception:
    print("on")
finally:
    s.close()' "${HERDR_DESKTOP_PORT:-5900}" 2>/dev/null)
  _out=$( ("$bin" permissions 2>/dev/null || true) | python3 -c 'import json,sys
sharing = sys.argv[1]
try:
    d = json.load(sys.stdin)["data"]
    p = {k: (d.get(k) or {}).get("state") for k in ("accessibility", "screen_recording", "automation")}
except Exception:
    p = None
print(json.dumps(p))
needs = []
if p is None:
    needs.append("agent-desktop could not say which Mac permissions it has: at the Mac, run herdr-desktop permissions")
else:
    for k, name in (("accessibility", "Accessibility"), ("screen_recording", "Screen Recording")):
        if p.get(k) not in ("granted", "not_required"):
            needs.append(f"{name} is off for agent-desktop: at the Mac, open System Settings › Privacy & Security › {name} and "
                         "switch on agent-desktop and the app your agents run in (herdr-desktop permissions --guide opens it there)")
blocking = needs[0] if needs else ""
if sharing == "off":
    needs.append("Screen Sharing is off, so Shepherdr can not show this Mac screen: at the Mac, switch it on in "
                 "System Settings › General › Sharing › Screen Sharing")
elif sharing == "nopw":
    needs.append("Screen Sharing has no VNC password, so Shepherdr can not show this Mac screen: at the Mac, open System "
                 "Settings › General › Sharing, the i button beside Screen Sharing, switch on \"VNC viewers may control "
                 "screen with password\" and set a password")
print(blocking)
print("\n".join(needs))' "$_sharing" 2>/dev/null)
  perms=$(printf '%s\n' "$_out" | sed -n 1p); [ -n "$perms" ] || perms=null
  blocking=$(printf '%s\n' "$_out" | sed -n 2p)
  needs=$(printf '%s\n' "$_out" | sed -n '3,$p')
  return 0
}

case "${1-}" in
  --help|-h|help)
    cat <<EOF
herdr-desktop: your desktop, as the person sees it live in Shepherdr (agent-desktop $PIN on it).
  herdr-desktop <agent-desktop command>   e.g. snapshot, click @e3, type @e5 "text", screenshot /abs/shot.png, launch <app>
  herdr-desktop hands "<what>"            a step only a person can do: ask for their hands
  herdr-desktop release                   a Mac's shared desktop: you are done with it, the next agent may use it
  herdr-desktop --install                 install agent-desktop $PIN, saying what it found
  herdr-desktop --status                  what is here and what is missing, as JSON
EOF
    pick
    echo
    if usable; then "$bin" --help 2>&1
    else echo "agent-desktop $PIN isn't here yet (${ver:+this machine has $ver; }the first desktop command installs it, or run: $fix)."; fi
    exit 0 ;;
  --install)
    if ensure; then
      echo "herdr-desktop: agent-desktop ${ver:-$PIN} is ready ($bin)."
      m=$(missing); [ -z "$m" ] || echo "herdr-desktop: still missing here: $m (install it with the system's package manager)." >&2
      mac_needs; [ -z "$needs" ] || printf '%s\n' "$needs" | sed 's/^/herdr-desktop: /' >&2
      exit 0
    fi
    pick; problem >&2
    exit 1 ;;
  --status)
    pick; why=; perms=null; blocking=; needs=; _sharing=
    [ -f "$addir/.failed" ] && why=$(cat "$addir/.failed")
    m=$(missing)
    msg=; fx=
    if ! usable; then msg=$(problem); fx=$fix
    else
      mac_needs
      if [ -n "$m" ]; then msg="herdr-desktop: agent-desktop is here, but this machine still needs $m. Install it with the system's package manager"
      elif [ -n "$blocking" ]; then msg="herdr-desktop: $blocking"; fx="herdr-desktop permissions --guide"; fi
    fi
    ok=false; [ -z "$msg" ] && ok=true
    printf '{"ok":%s,"pin":"%s","accepts":"%s","driver":"%s","bin":%s,"version":%s,"from":%s,"failed":%s,"missing":%s,"permissions":%s,"screen_sharing":%s,"needs":%s,"problem":%s,"fix":%s}\n' \
      "$ok" "$PIN" "$PIN to ${PIN%.*}.x" "$driver" "$(json_str "$bin")" "$(json_str "$ver")" "$(json_str "$from")" "$(json_str "$why")" \
      "$(json_str "$m")" "$perms" "$(json_str "$_sharing")" "$(printf '%s' "$needs" | python3 -c 'import json,sys; print(json.dumps([l for l in sys.stdin.read().splitlines() if l]), end="")')" \
      "$(json_str "$msg")" "$(json_str "$fx")"
    exit 0 ;;
  --bin)
    pick
    usable || exit 1
    echo "$bin"
    exit 0 ;;
esac

task=${HERDR_BROWSER_TASK-}
space=${HERDR_BROWSER_SPACE-}
own=; chat=; admin=
while :; do
  case "${1-}" in
    --task) task=${2-}; shift 2 || exit 2 ;;
    --space) space=${2-}; shift 2 || exit 2 ;;
    --chat) chat=1; task=; shift ;;
    --machine) chat=; task=; space=; machine=1; shift ;;
    --own) own=1; shift ;;
    --up|--down|--state) admin=${1#--}; shift ;;
    *) break ;;
  esac
done
if [ -z "${machine-}" ] && [ -z "$chat" ] && { [ -z "$task" ] || [ -z "$space" ]; } && [ -n "${HC_TERMINAL_ID-}" ]; then
  _l=$(hc get "$HC_TERMINAL_ID" --json 2>/dev/null | python3 -c 'import json,sys
try: l = json.load(sys.stdin).get("labels") or {}
except Exception: l = {}
print(l.get("herdr.task") or "")
print(l.get("herdr.task.space") or l.get("herdr.space") or l.get("herdr.coordinator.space") or "")' 2>/dev/null)
  [ -n "$task" ] || task=$(printf '%s\n' "$_l" | sed -n 1p)
  [ -n "$space" ] || space=$(printf '%s\n' "$_l" | sed -n 2p)
fi
space=${space##*/}
# Kept in step with bin/herdr-browser (the same names, so the two share <name>.you and <name>.hands).
safe() { printf %s "$1" | sed 's/[^A-Za-z0-9_-]/-/g; s/--*/-/g; s/^-//; s/-$//'; }
if [ -n "${machine-}" ]; then who=machine; name=machine     # the person's own look at a machine's real screen
elif [ -z "$task" ] && [ -z "$space" ]; then
  echo "herdr-desktop: whose desktop? Run it from a task's agent or a space's chat, or pass --task <slug#id>, or --chat --space <id>." >&2
  exit 2
elif [ -n "$task" ]; then who=$task; name=$(safe "$task")
else who="chat:$space"; name="chat-$(safe "$space")"; fi
mkdir -p "$root" 2>/dev/null && chmod 700 "$root" 2>/dev/null

# ---- Linux: its own display ----
disp=; port=; xpid=; wmpid=; buspid=; bus=
read_display() {
  disp=; port=; xpid=; wmpid=; buspid=; bus=
  [ -f "$root/$name.display" ] || return 1
  disp=$(sed -n 's/^display=//p' "$root/$name.display"); port=$(sed -n 's/^port=//p' "$root/$name.display")
  xpid=$(sed -n 's/^xpid=//p' "$root/$name.display"); wmpid=$(sed -n 's/^wmpid=//p' "$root/$name.display")
  buspid=$(sed -n 's/^buspid=//p' "$root/$name.display"); bus=$(sed -n 's/^bus=//p' "$root/$name.display")
  [ -n "$xpid" ] && kill -0 "$xpid" 2>/dev/null
}
display_down() {
  if read_display || [ -n "$xpid" ]; then
    for _p in $wmpid $buspid $xpid; do kill "$_p" 2>/dev/null; done
  fi
  rm -f "${root:?}/${name:?}.display"
}
# Starts this agent's display. -> 0 (disp, port set), or 1 with $why.
display_up() {
  read_display && return 0
  why=$(missing)
  [ -z "$why" ] || { why="This machine has no $why."; return 1; }
  _n=0
  until mkdir "$root/desktop.lock" 2>/dev/null; do
    if [ -n "$(find "${root:?}/desktop.lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then rmdir "${root:?}/desktop.lock" 2>/dev/null; continue; fi
    _n=$((_n + 1)); [ "$_n" -gt 30 ] && { why="Another desktop is still starting."; return 1; }
    sleep 1
  done
  if read_display; then rmdir "${root:?}/desktop.lock" 2>/dev/null; return 0; fi
  size=${HERDR_DESKTOP_SIZE:-1280x800}
  _d=${HERDR_DESKTOP_FIRST:-30}
  while [ -e "/tmp/.X11-unix/X$_d" ] || [ -e "/tmp/.X$_d-lock" ] || port_open $((5900 + _d)); do
    _d=$((_d + 1)); [ "$_d" -gt 98 ] && { rmdir "${root:?}/desktop.lock" 2>/dev/null; why="No free display number is left on this machine."; return 1; }
  done
  port=$((5900 + _d)); disp=":$_d"
  if have Xvnc; then
    nohup Xvnc "$disp" -localhost -rfbport "$port" -geometry "$size" -depth 24 -SecurityTypes None -AlwaysShared >/dev/null 2>&1 &
    xpid=$!
  else
    nohup Xvfb "$disp" -screen 0 "${size}x24" -nolisten tcp >/dev/null 2>&1 &
    xpid=$!
  fi
  _n=0
  while [ ! -e "/tmp/.X11-unix/X$_d" ] && [ "$_n" -lt 50 ]; do sleep 0.1; _n=$((_n + 1)); done
  if ! kill -0 "$xpid" 2>/dev/null || [ ! -e "/tmp/.X11-unix/X$_d" ]; then
    rmdir "${root:?}/desktop.lock" 2>/dev/null; why="The virtual display didn't start."; return 1
  fi
  if ! have Xvnc; then
    x11vnc -display "$disp" -localhost -rfbport "$port" -forever -shared -nopw -quiet -bg >/dev/null 2>&1
  fi
  # a session bus of its own, so agent-desktop sees this display's apps only
  bus=; buspid=
  if have dbus-daemon; then
    _b=$(dbus-daemon --session --fork --print-address 1 --print-pid 1 2>/dev/null)
    bus=$(printf '%s\n' "$_b" | sed -n 1p); buspid=$(printf '%s\n' "$_b" | sed -n 2p)
  fi
  wmpid=
  for _w in openbox xfwm4 fluxbox matchbox-window-manager twm; do
    if have "$_w"; then
      DISPLAY="$disp" DBUS_SESSION_BUS_ADDRESS="$bus" nohup "$_w" >/dev/null 2>&1 &
      wmpid=$!
      break
    fi
  done
  printf 'display=%s\nport=%s\nxpid=%s\nwmpid=%s\nbuspid=%s\nbus=%s\n' "$disp" "$port" "$xpid" "$wmpid" "$buspid" "$bus" > "$root/$name.display"
  rmdir "${root:?}/desktop.lock" 2>/dev/null
  _n=0
  while ! port_open "$port" && [ "$_n" -lt 30 ]; do sleep 0.1; _n=$((_n + 1)); done
  return 0
}

# ---- macOS: the one real screen, one agent at a time ----
lease_min=${HERDR_DESKTOP_LEASE_MIN:-5}
holder() {
  [ -f "$root/desktop.holder" ] || return 0
  if [ -z "$(find "$root/desktop.holder" -mmin "-$lease_min" 2>/dev/null)" ]; then rm -f "${root:?}/desktop.holder"; return 0; fi
  cat "$root/desktop.holder" 2>/dev/null
}
# Takes the shared desktop, waiting for it up to $HERDR_DESKTOP_WAIT seconds (default 300). -> 0, or 1 (said).
turn() {
  _w=0; _max=${HERDR_DESKTOP_WAIT:-300}
  while :; do
    if mkdir "$root/desktop.lock" 2>/dev/null; then
      _h=$(holder)
      if [ -z "$_h" ] || [ "$_h" = "$who" ]; then
        printf '%s\n' "$who" > "$root/desktop.holder"
        rmdir "${root:?}/desktop.lock" 2>/dev/null; rm -f "${root:?}/${name:?}.waits"
        return 0
      fi
      rmdir "${root:?}/desktop.lock" 2>/dev/null
    elif [ -n "$(find "${root:?}/desktop.lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then rmdir "${root:?}/desktop.lock" 2>/dev/null; continue
    fi
    if [ "$_w" -ge "$_max" ]; then
      rm -f "${root:?}/${name:?}.waits"
      echo "herdr-desktop: this Mac has one screen and another agent is still using it (${_h:-someone}), so this did not run. Do something else, or run the command again to keep waiting." >&2
      return 1
    fi
    [ "$_w" = 0 ] && echo "herdr-desktop: this Mac has one screen and another agent is using it (${_h:-someone}); waiting for the desktop…" >&2
    printf '%s\n' "${_h:-}" > "$root/$name.waits"
    sleep 2; _w=$((_w + 2))
  done
}

state_json() {  # $1: ok true/false, $2: why
  printf '{"ok":%s,"who":%s,"name":"%s","driver":"%s","own":%s,"display":"%s","port":%s,"why":%s}\n' "$1" "$(json_str "$who")" "$name" \
    "$driver" "$([ "$driver" = own ] && echo true || echo false)" "$disp" "${port:-0}" "$(json_str "${2-}")"
}
case "$admin" in
  up|state)
    if [ "$driver" = shared ]; then
      port=${HERDR_DESKTOP_PORT:-5900}
      if port_open "$port"; then state_json true
      else state_json false "Screen Sharing is off on this Mac. Turn it on in System Settings › General › Sharing › Screen Sharing."; fi
    elif [ "$admin" = state ]; then
      if read_display; then state_json true; else disp=; port=; state_json false ""; fi
    elif display_up; then state_json true
    else disp=; port=; state_json false "$why"; fi
    exit 0 ;;
  down) [ "$driver" = own ] && display_down; rm -f "${root:?}/${name:?}.dused" "${root:?}/${name:?}.waits"; exit 0 ;;
esac

verb=
for a in "$@"; do case "$a" in -*) ;; *) verb=$a; break ;; esac; done

if [ "${1-}" = hands ]; then
  shift
  if [ "${1-}" = --cancel ]; then rm -f "${root:?}/${name:?}.hands"; echo "herdr-desktop: no longer asking for the person's hands."; exit 0; fi
  what=$*
  if [ -z "$what" ]; then echo 'herdr-desktop: say what you need, in a few words: herdr-desktop hands "Allow the installer"' >&2; exit 2; fi
  [ -f "$root/$name.task" ] || printf '%s\n' "$who" > "$root/$name.task"
  printf '{"what":%s,"src":"d","at":%s}\n' "$(json_str "$what")" "$(date +%s)" > "$root/$name.hands"
  echo "herdr-desktop: asked the person: \"$what\". They see your desktop with Take over and Skip. Stop here and wait: you get a message when they are done or skip it. While they drive, your desktop commands are refused."
  exit 0
fi
if [ "${1-}" = release ]; then
  if [ "$(cat "$root/desktop.holder" 2>/dev/null)" = "$who" ]; then rm -f "${root:?}/desktop.holder"; fi
  echo "herdr-desktop: released."
  exit 0
fi

# A usable agent-desktop. None yet: an agent's first command installs it (Shepherdr's own views only say so, they never
# wait on a download), unless a try failed in the last 10 minutes.
pick
if ! usable; then
  why=
  [ -n "$(find "$addir/.failed" -mmin -10 2>/dev/null)" ] && why=$(cat "$addir/.failed")
  if [ -z "$own" ] && [ -z "$why" ]; then
    ensure
    pick
  fi
  if ! usable; then problem >&2; exit 127; fi
fi
# What touches no desktop runs as agent-desktop itself (permissions too: a Mac's --guide is the person's, at the Mac).
case "$verb" in
  skills|version|help|mcp|sandbox|permissions|"") exec "$bin" "$@" ;;
esac

if [ -z "$own" ]; then
  # The person drives now: nothing runs and nothing is read for the agent until they hand back (as herdr-browser).
  you="$root/$name.you"
  if [ -f "$you" ]; then
    if [ -n "$(find "$you" -mmin "-${HERDR_YOU_STALE_MIN:-11}" 2>/dev/null)" ]; then
      echo "herdr-desktop: the person took over your browser and desktop in Shepherdr and is using them now, so this did not run and nothing was read. Stop and wait: you get a message when they hand back. Then look again (snapshot) before you carry on." >&2
      exit 3
    fi
    rm -f "${you:?}"
  fi
fi

if [ "$driver" = own ]; then
  display_up || { echo "herdr-desktop: $why The desktop can't be used here until it is installed." >&2; exit 1; }
  [ -n "$own" ] || { [ -f "$root/$name.task" ] || printf '%s\n' "$who" > "$root/$name.task"; touch "$root/$name.dused" 2>/dev/null; }
  if [ -n "$bus" ]; then export DBUS_SESSION_BUS_ADDRESS="$bus"; fi
  DISPLAY="$disp" ACCESSIBILITY_ENABLED=1 exec "$bin" "$@"
fi
if [ -z "$own" ]; then
  turn || exit 6
  [ -f "$root/$name.task" ] || printf '%s\n' "$who" > "$root/$name.task"
  touch "$root/$name.dused" 2>/dev/null
fi
"$bin" "$@"
rc=$?
[ -z "$own" ] && [ "$(cat "$root/desktop.holder" 2>/dev/null)" = "$who" ] && touch "$root/desktop.holder" 2>/dev/null
exit $rc

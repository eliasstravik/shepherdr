#!/bin/sh
# herdr-browser: a Herdr task's own browser (HERD-57). agent-browser at the version Herdr pins, on
# the task's own session and profile, so every agent of a task drives the same browser and its
# sign-ins stay with the task:
#   session  herdr-<task>               (agent-browser --session; a <task> over 32 characters is cut to its
#            last 20 and a hash of the task's key: herdr-<tail>-<8 hex>, as agent-browser's socket path is short)
#   profile  ~/.local/state/shepherdr/browser/<task>    (a Chrome profile folder: cookies and sign-ins kept;
#            ~/.herdr/browser/<task> on a machine whose Shepherdr data hasn't moved to its own folders yet)
# <task> is the task's herdr.task key (<slug>#<id>) made safe for a name: ".config-herdr-app#57"
# is "config-herdr-app-57". Which task: --task <key>, else $HERDR_BROWSER_TASK (herdr-task gives
# its workers that), else the herdr.task label of the terminal it runs in ($HC_TERMINAL_ID).
#
# Beside the profile, plain files Herdr reads (herdr-task tick, the task panel's Browser view):
#   <task>.task   the task's key, so a tick can find its task again
#   <task>.used   touched by every agent command: tick closes a browser idle past its setting
#   <task>.you    the person drives it (Take over in the panel): acting commands are refused while
#                 it is fresh (the panel touches it every 30 s), so the agent holds off
# --own: Herdr's own commands (the panel); they don't count as the agent using it, nor get refused.
# --name: prints the session and profile it would use, as JSON, and runs nothing.
#
# agent-browser itself (SHEP-156): any 0.41.x from the pin on, found on the PATH, or Shepherdr's own copy in
# ~/.local/share/shepherdr/agent-browser/<pin>/ (preferred once there). When there's none, an agent's first command
# installs it there: agent-browser's own release binary for this machine, checked against the pin's checksum (no
# npm, no sudo), and Chrome for Testing with `agent-browser install` when no Chrome is found. Install and update run
# --install too. A failed try isn't repeated for 10 minutes, except by --install.
# --install  makes sure a working agent-browser and Chrome are here (installs them), and says what it found
# --status   what's here, as JSON, installing nothing (shepherdr doctor)
# --bin      the agent-browser it runs, installing nothing (herdr-task's tick)

PIN=0.41.1
# The pinned release's binaries (github.com/vercel-labs/agent-browser/releases), by platform: sha256.
sha_for() {
  case "$1" in
    darwin-arm64) echo 63b0a97b85a54b4c9b2871318af74104c29b80abd507b53a30316884e062854b ;;
    darwin-x64) echo 7802f053e7fb25e10548ee10ca60d892c73d42ed2dbb7fc30c2d5925a5c82859 ;;
    linux-arm64) echo f0b3bdaa40abf2a5111ec08e6d242110aaf56045ef5108cbc633bacc8e53ca17 ;;
    linux-x64) echo 2a89295b62ddd497986a9a80b52e1dbe4c1f6bd68ffde67eaae82eec2206af61 ;;
    linux-musl-arm64) echo 3afdec8f37bfd80b2ecc30e2297c95c3bae9ddb3775ebe531534ea6e3662f44c ;;
    linux-musl-x64) echo 951c795e21fddab1d4091ad2ca4f0e69f1eea6534288e6a251598df11ca8e9af ;;
  esac
}
# Shepherdr's state folder once this machine's data moved there (herdr_task/layout.py), else the old ~/.herdr/browser
if [ -n "${SHEPHERDR_HOME:-}" ]; then shep_data="$SHEPHERDR_HOME/data"; shep_state="$SHEPHERDR_HOME/state"
else shep_data="${XDG_DATA_HOME:-$HOME/.local/share}/shepherdr"; shep_state="${XDG_STATE_HOME:-$HOME/.local/state}/shepherdr"; fi
if [ "$(cut -c1 "$shep_data/LAYOUT" 2>/dev/null)" = 2 ] && [ ! -e "$HOME/.herdr/.layout-rollback" ]; then root="$shep_state/browser"
else root="$HOME/.herdr/browser"; fi
# Shepherdr's own agent-browser (always in its data folder, whatever the layout)
abdir="$shep_data/agent-browser"
mine="$abdir/$PIN/agent-browser"
# the one command that fixes it, as the person can type it
if [ "$(command -v herdr-browser 2>/dev/null)" ]; then fix="herdr-browser --install"; else fix="$0 --install"; fi

# Same major and minor as the pin, and not older: 0.41.1, 0.41.2… (0.42 may change what Herdr relies on).
compatible() {
  _v=${1%%[-+]*}
  case "$_v" in [0-9]*.[0-9]*.[0-9]*) ;; *) return 1 ;; esac
  case "$_v" in *[!0-9.]*|*.*.*.*) return 1 ;; esac
  [ "${_v%.*}" = "${PIN%.*}" ] && [ "${_v##*.}" -ge "${PIN##*.}" ]
}

# A binary's version, asked once per binary (its path and change time), then kept.
version_of() {
  _real=$(readlink -f "$1" 2>/dev/null || echo "$1")
  _stamp="$_real $(stat -c %Y "$_real" 2>/dev/null || stat -f %m "$_real" 2>/dev/null)"
  _ver=
  [ -f "$root/.version" ] && _ver=$(awk -v s="$_stamp" 'substr($0, 1, length(s)) == s { print $NF }' "$root/.version")
  if [ -z "$_ver" ]; then
    _ver=$("$1" --version 2>/dev/null | awk '{ print $NF }')
    [ -n "$_ver" ] && mkdir -p "$root" 2>/dev/null && chmod 700 "$root" 2>/dev/null && printf '%s %s\n' "$_stamp" "$_ver" >> "$root/.version"
  fi
  echo "$_ver"
}

# Which agent-browser: $HERDR_BROWSER_BIN, else Shepherdr's own, else the PATH's. Sets bin, ver, from.
pick() {
  if [ -n "${HERDR_BROWSER_BIN:-}" ]; then bin=$HERDR_BROWSER_BIN; from=env
  elif [ -x "$mine" ]; then bin=$mine; from=shepherdr
  else bin=$(command -v agent-browser 2>/dev/null); from=path; fi
  ver=
  if [ -n "$bin" ]; then ver=$(version_of "$bin"); else from=; fi
}
usable() { [ -n "$bin" ] && compatible "$ver"; }

# Puts agent-browser $PIN's own binary for this machine at $mine. -> 0, or 1 with $why.
install_mine() {
  case "$(uname -s)" in
    Darwin) _os=darwin ;;
    Linux) _os=linux; if (ldd --version 2>&1 || true) | grep -qi musl; then _os=linux-musl; fi ;;
    *) why="agent-browser has no build for $(uname -s)"; return 1 ;;
  esac
  case "$(uname -m)" in
    x86_64|amd64) _arch=x64 ;;
    arm64|aarch64) _arch=arm64 ;;
    *) why="agent-browser has no build for $(uname -m)"; return 1 ;;
  esac
  _plat=$_os-$_arch
  _want=${HERDR_BROWSER_SHA256:-$(sha_for "$_plat")}
  [ -n "$_want" ] || { why="agent-browser has no build for $_plat"; return 1; }
  command -v curl >/dev/null 2>&1 || { why="curl isn't installed"; return 1; }
  _url="${HERDR_BROWSER_URL:-https://github.com/vercel-labs/agent-browser/releases/download/v$PIN}/agent-browser-$_plat"
  mkdir -p "$abdir/$PIN" 2>/dev/null || { why="can't write to $abdir"; return 1; }
  _tmp="$abdir/.part.$$"
  if ! _err=$(curl -fsSL --retry 2 --connect-timeout 15 --max-time 600 -o "$_tmp" "$_url" 2>&1); then
    rm -f "$_tmp"
    why="couldn't download it (${_err:-no answer}; offline?)"; return 1
  fi
  _got=$( (sha256sum "$_tmp" 2>/dev/null || shasum -a 256 "$_tmp" 2>/dev/null) | awk '{ print $1 }')
  if [ "$_got" != "$_want" ]; then
    rm -f "$_tmp"; why="the download isn't agent-browser $PIN (its checksum differs)"; return 1
  fi
  chmod 755 "$_tmp" && mv -f "$_tmp" "$mine" || { rm -f "$_tmp"; why="can't write to $abdir"; return 1; }
  # an older pin's copy: no longer used
  for _d in "$abdir"/*/; do
    [ -d "$_d" ] && [ "${_d%/}" != "$abdir/$PIN" ] && rm -rf "${_d%/}"
  done
  return 0
}

# Chrome for the binary picked: agent-browser's own check, else `agent-browser install` (Chrome for Testing into
# ~/.agent-browser). -> 0, or 1 with $why.
chrome() {
  "$bin" doctor --offline --quick --json 2>/dev/null | python3 -c 'import json,sys
try: sys.exit(0 if any(c.get("id") == "chrome.installed" and c.get("status") == "pass" for c in json.load(sys.stdin)["checks"]) else 1)
except Exception: sys.exit(1)' && return 0
  echo "herdr-browser: downloading Chrome for the task browser (agent-browser install)…" >&2
  if ! _err=$("$bin" install 2>&1 </dev/null); then
    why="agent-browser couldn't download Chrome ($(printf '%s\n' "$_err" | grep . | tail -n 1))"; return 1
  fi
  return 0
}

# Makes sure a usable agent-browser and Chrome are here; one at a time. -> 0, or 1 with $why (kept in .failed).
ensure() {
  why=
  mkdir -p "$abdir" 2>/dev/null || { why="can't write to $abdir"; return 1; }
  _n=0
  until mkdir "$abdir/.lock" 2>/dev/null; do
    # another one is installing: wait for it (a lock left by one that died goes after 10 minutes)
    if [ -n "$(find "$abdir/.lock" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then rmdir "$abdir/.lock" 2>/dev/null; continue; fi
    _n=$((_n + 1)); [ "$_n" -gt 600 ] && { why="another install is still running"; return 1; }
    sleep 1
  done
  pick
  _ok=0
  if ! usable; then
    echo "herdr-browser: installing agent-browser $PIN for Shepherdr into $abdir (once)…" >&2
    install_mine || _ok=1
    [ "$_ok" = 0 ] && pick
  fi
  [ "$_ok" = 0 ] && { chrome || _ok=1; }
  if [ "$_ok" = 0 ]; then rm -f "$abdir/.failed"; else printf '%s\n' "$why" > "$abdir/.failed"; fi
  rmdir "$abdir/.lock" 2>/dev/null
  return $_ok
}

# What's wrong, and the one command that fixes it.
problem() {
  if [ -z "$bin" ]; then _what="agent-browser isn't installed here"
  else _what="Shepherdr runs agent-browser $PIN (or a newer ${PIN%.*}.x); this machine has ${ver:-an unknown version} ($bin)"; fi
  # The apostrophe sits outside ${...}: bash (3.2 on macOS too) reads one inside a double-quoted ${...} as a quote
  _why=
  if [ -n "$why" ]; then _why=", and Shepherdr couldn't install it: $why"; fi
  echo "herdr-browser: $_what$_why. Fix it: $fix"
}

json_str() { printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()), end="")'; }

# Chrome's shared libraries (SHEP-200). agent-browser's doctor only checks that Chrome's file is there, so a Chrome
# missing a library passes and then exits 127 with the loader's one line. Say which library is missing, and how to
# install it, before anything starts.
# Chrome: $AGENT_BROWSER_EXECUTABLE_PATH, else the newest one agent-browser installed.
chrome_bin() {
  if [ -n "${AGENT_BROWSER_EXECUTABLE_PATH:-}" ]; then echo "$AGENT_BROWSER_EXECUTABLE_PATH"; return; fi
  _c=
  for _f in "$HOME/.agent-browser/browsers"/chrome-*/chrome; do [ -x "$_f" ] && _c=$_f; done
  echo "$_c"
}
# The libraries ldd says Chrome can't find, space-separated. Nothing where ldd can't say (macOS, no Chrome yet).
missing_libs() {
  [ "$(uname -s)" = Linux ] && command -v ldd >/dev/null 2>&1 || return 0
  _c=$(chrome_bin)
  [ -n "$_c" ] || return 0
  ldd "$_c" 2>/dev/null | awk '/=> not found/ { printf "%s ", $1 }' | sed 's/ $//'
}
# The package that provides a library, by distro family: debian, fedora, arch, alpine (one name each, in that order).
lib_pkgs() {
  case "$1" in
    libgbm.so*) echo "libgbm1 mesa-libgbm libgbm mesa-gbm" ;;
    libnss3.so*|libnssutil3.so*|libsmime3.so*) echo "libnss3 nss nss nss" ;;
    libnspr4.so*) echo "libnspr4 nspr nspr nspr" ;;
    libasound.so*) echo "libasound2 alsa-lib alsa-lib alsa-lib" ;;
    libatk-1.0.so*) echo "libatk1.0-0 atk atk atk" ;;
    libatk-bridge-2.0.so*) echo "libatk-bridge2.0-0 at-spi2-atk at-spi2-atk at-spi2-atk" ;;
    libcups.so*) echo "libcups2 cups-libs libcups cups-libs" ;;
    libdrm.so*) echo "libdrm2 libdrm libdrm libdrm" ;;
    libxkbcommon.so*) echo "libxkbcommon0 libxkbcommon libxkbcommon libxkbcommon" ;;
    *) ;;
  esac
}
# The install command for this distro with the packages of the libraries given, and the ones it can't name.
install_hint() {
  _ids=$(grep -E '^(ID|ID_LIKE)=' "${HERDR_BROWSER_OS_RELEASE:-/etc/os-release}" 2>/dev/null | cut -d= -f2- | tr -d '"' | tr '\n' ' ')
  case " $_ids " in
    *" debian "*|*" ubuntu "*) _col=1; _cmd="sudo apt-get install -y" ;;
    *" fedora "*|*" rhel "*|*" centos "*) _col=2; _cmd="sudo dnf install -y" ;;
    *" arch "*) _col=3; _cmd="sudo pacman -S --needed" ;;
    *" alpine "*) _col=4; _cmd="sudo apk add" ;;
    *) _col= ;;
  esac
  _pk=; _no=
  for _l in $1; do
    _p=
    [ -n "$_col" ] && _p=$(lib_pkgs "$_l" | cut -d' ' -f"$_col")
    if [ -n "$_p" ]; then _pk="$_pk $_p"; else _no="$_no $_l"; fi
  done
  if [ -n "$_pk" ]; then echo "Install: $_cmd$_pk"; fi
  if [ -n "$_no" ]; then echo "No package name is known here for:$_no. Find the package that provides each file (your distro's package search)."; fi
}
# Chrome can't start without its libraries: says which are missing and how to install them. -> 0, or 1 (said).
libs_check() {
  _m=$(missing_libs)
  [ -n "$_m" ] || return 0
  echo "herdr-browser: Chrome can't start: missing system libraries: $_m."
  install_hint "$_m"
  return 1
}

# Chrome's sandbox (SHEP-203, GitHub #920). Ubuntu 24.04's AppArmor (kernel.apparmor_restrict_unprivileged_userns=1)
# stops unprivileged user namespaces for any program without a profile that allows them, and Chrome then dies with
# "No usable sandbox". The sandbox stays on: this says the fix for this machine and runs nothing, the person applies it.
USERNS_SYSCTL=${HERDR_BROWSER_USERNS_SYSCTL:-/proc/sys/kernel/apparmor_restrict_unprivileged_userns}
APPARMOR_D=${HERDR_BROWSER_APPARMOR_D:-/etc/apparmor.d}
_prof=herdr-browser-chrome
# Only when the restriction is on and a plain unshare of user namespaces fails: other causes are not this one.
userns_blocked() {
  [ "$(uname -s)" = Linux ] || return 1
  [ "$(cat "$USERNS_SYSCTL" 2>/dev/null)" = 1 ] || return 1
  command -v unshare >/dev/null 2>&1 || return 1
  unshare -U true >/dev/null 2>&1 && return 1
  return 0
}
# Says the one fix for the Chrome it would start (its profile, then the wider sysctl). -> 0, or 1 (said).
sandbox_check() {
  userns_blocked || return 0
  _c=$(chrome_bin)
  [ -n "$_c" ] || return 0   # no Chrome yet: the first start installs one, and this runs again then
  _c=$(readlink -f "$_c" 2>/dev/null || echo "$_c")
  # The fix is in place when its profile names this Chrome's path: this shell stays unconfined, so unshare still fails
  grep -qsF "profile $_prof \"$_c\" flags=(unconfined)" "$APPARMOR_D/$_prof" && return 0
  cat <<EOF
herdr-browser: Chrome can't start its sandbox: AppArmor blocks unprivileged user namespaces on this machine
(Ubuntu's kernel.apparmor_restrict_unprivileged_userns), so Chrome stops with "No usable sandbox".
Chrome's sandbox stays on, and nothing was changed. To let this one Chrome use it, run these two with sudo:

  printf '%s\n' 'abi <abi/4.0>,' 'include <tunables/global>' '' 'profile $_prof "$_c" flags=(unconfined) {' '  userns,' '}' | sudo tee /etc/apparmor.d/$_prof >/dev/null
  sudo apparmor_parser -r /etc/apparmor.d/$_prof

Then run herdr-browser again. The profile is for this Chrome's path: when agent-browser installs a newer Chrome, its path changes and the two lines are needed again.
The wider way, for every program on this machine until the next reboot: sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
EOF
  return 1
}

case "${1-}" in
  --install)
    if ensure; then
      libs_check >&2 || exit 1
      sandbox_check >&2 || exit 1
      echo "herdr-browser: agent-browser $ver is ready ($bin), with Chrome."
      exit 0
    fi
    pick; problem >&2
    exit 1 ;;
  --status)
    pick; why=
    [ -f "$abdir/.failed" ] && why=$(cat "$abdir/.failed")
    if usable; then ok=true; msg=; else ok=false; msg=$(problem); fi
    printf '{"ok":%s,"pin":"%s","accepts":"%s","bin":%s,"version":%s,"from":%s,"failed":%s,"problem":%s,"fix":%s}\n' \
      "$ok" "$PIN" "$PIN to ${PIN%.*}.x" "$(json_str "$bin")" "$(json_str "$ver")" "$(json_str "$from")" \
      "$(json_str "$why")" "$(json_str "$msg")" "$(json_str "$fix")"
    exit 0 ;;
  --bin)
    pick
    usable || exit 1
    echo "$bin"
    exit 0 ;;
esac

task=${HERDR_BROWSER_TASK-}
own=
while :; do
  case "${1-}" in
    --task) task=${2-}; shift 2 || exit 2 ;;
    --own) own=1; shift ;;
    --name) show=1; shift ;;
    *) break ;;
  esac
done
if [ -z "$task" ] && [ -n "${HC_TERMINAL_ID-}" ]; then
  task=$(hc get "$HC_TERMINAL_ID" --json 2>/dev/null | python3 -c 'import json,sys
try: print((json.load(sys.stdin).get("labels") or {}).get("herdr.task") or "")
except Exception: pass' 2>/dev/null)
fi
if [ -z "$task" ]; then
  echo "herdr-browser: which task's browser? Run it from a task's agent, or pass --task <slug#id>." >&2
  exit 2
fi
name=$(printf %s "$task" | sed 's/[^A-Za-z0-9_-]/-/g; s/--*/-/g; s/^-//; s/-$//')
session="herdr-$name"
# A long name is cut (SHEP-178): its last 20 characters and the first 8 hex of the key's sha256, the same every call.
# Kept in step with herdr_task/browsers.py, service/browser.ts and bin/herdr-browser-view (sessionOf).
if [ ${#name} -gt 32 ]; then
  h=$(printf %s "$task" | sha256sum 2>/dev/null | cut -c1-8)
  [ -n "$h" ] || h=$(printf %s "$task" | shasum -a 256 2>/dev/null | cut -c1-8)
  session="herdr-$(printf %s "$name" | tail -c 20 | sed 's/^-*//')-$h"
fi
profile="$root/$name"
# A browser made before the data moved keeps the path it was started with (~/.herdr/browser/<name>, a link to the
# same folder now): agent-browser's running session knows it by that path. New ones use the new place.
old="$HOME/.herdr/browser/$name"
if [ "$root" != "$HOME/.herdr/browser" ] && [ -d "$old" ] && [ -d "$profile" ] \
   && [ "$(cd "$old" && pwd -P)" = "$(cd "$profile" && pwd -P)" ] && [ ! -f "$root/$name.new" ]; then
  profile=$old
elif [ ! -d "$profile" ] && [ "$root" != "$HOME/.herdr/browser" ]; then
  mkdir -p "$root" 2>/dev/null; : > "$root/$name.new" 2>/dev/null || true   # made at the new place: always the new path from now on
fi
if [ -n "${show-}" ]; then
  printf '{"task":"%s","session":"%s","profile":"%s","pin":"%s"}\n' "$task" "$session" "$profile" "$PIN"
  exit 0
fi

# Its session and profile are Herdr's: another one would start a second browser beside it.
for a in "$@"; do
  case "$a" in
    --session|--session=*|--profile|--profile=*|--cdp|--cdp=*|--auto-connect|--namespace|--namespace=*)
      echo "herdr-browser: $a isn't needed: this task's browser is always session $session (profile $profile)." >&2
      exit 2 ;;
  esac
done

# A usable agent-browser (one version per session: two keep restarting its daemon). None yet: an agent's first command
# installs it (Herdr's own views only say so, they never wait on a download), unless a try failed in the last 10 minutes.
mkdir -p "$root" 2>/dev/null && chmod 700 "$root" 2>/dev/null
pick
if ! usable; then
  why=
  [ -n "$(find "$abdir/.failed" -mmin -10 2>/dev/null)" ] && why=$(cat "$abdir/.failed")
  if [ -z "$own" ] && [ -z "$why" ] && [ -z "${HERDR_BROWSER_BIN:-}" ]; then
    ensure || { pick; usable && echo "herdr-browser: $why. Fix it: $fix" >&2; }
    pick
  fi
  if ! usable; then problem >&2; exit 127; fi
fi
libs_check >&2 || exit 127
sandbox_check >&2 || exit 127

# The first word that isn't a flag: what the command does.
verb=
for a in "$@"; do case "$a" in -*) ;; *) verb=$a; break ;; esac; done

if [ -z "$own" ]; then
  # The person drives it now: only looking is allowed.
  you="$root/$name.you"
  if [ -f "$you" ] && [ -n "$(find "$you" -mmin -2 2>/dev/null)" ]; then
    case "$verb" in
      snapshot|screenshot|get|is|session|stream|console|errors|""|help|--help) ;;
      *)
        echo "herdr-browser: the person took over this task's browser in Herdr and is using it now. Hold off: don't drive it until they hand it back (snapshot, screenshot and get still work). Check again in a minute, or ask in your chat." >&2
        exit 3 ;;
    esac
  fi
  touch "$root/$name.used" 2>/dev/null
fi
[ -f "$root/$name.task" ] || printf '%s\n' "$task" > "$root/$name.task"
# A browser opened before names were cut (a name of 33-64 characters still fit agent-browser's socket path) holds the
# profile: closed once, quietly, so the new session can open it (sign-ins are in the profile and stay).
if [ "$session" != "herdr-$name" ] && [ ! -f "$root/$name.session" ]; then
  [ ${#name} -le 64 ] && "$bin" --session "herdr-$name" close >/dev/null 2>&1
  printf '%s\n' "$session" > "$root/$name.session" 2>/dev/null
fi

# Pages see prefers-reduced-motion (Chrome draws them in software, so an animation costs a core);
# an agent whose page must move turns it off with: set media no-preference.
export AGENT_BROWSER_ARGS="${AGENT_BROWSER_ARGS:---force-prefers-reduced-motion}"
# The session's stream (read when its daemon starts) carries the tab, its address and the person's
# input for Herdr's Browser view; its pictures come from Chrome directly (bin/herdr-browser-view),
# so the stream's own are kept small and cheap.
export AGENT_BROWSER_STREAM_MAX_WIDTH="${AGENT_BROWSER_STREAM_MAX_WIDTH:-320}"
export AGENT_BROWSER_STREAM_QUALITY="${AGENT_BROWSER_STREAM_QUALITY:-40}"
exec "$bin" --session "$session" --profile "$profile" "$@"

#!/bin/sh
# herdr-browser: an agent's own page in its space's browser (3.2; HERD-57 before it). agent-browser at the version
# Shepherdr pins. Each SPACE has one headless Chrome on one profile, so a site signed in to once is signed in for every
# agent of that space; each task's agents, and the space's chat's own agent, have their own page (a window of its own)
# in it, which Shepherdr's Screen shows live and the person can take over:
#   the space's browser   session herdr-s-<space>, profile ~/.local/state/shepherdr/browser/spaces/<space>
#                         (~/.herdr/browser/spaces/<space> on a machine whose data hasn't moved yet). Nobody drives
#                         this session: it only keeps the Chrome. It stops after 10 idle minutes (herdr-task's tick)
#                         and starts again with the next command; sign-ins stay in the profile.
#   an agent's page       session herdr-<name>, joined to that Chrome (--cdp) and pinned to its own tab (--pin-tab);
#                         its stream is what the Screen shows. <name> is the task's key (<slug>#<id>) made safe for a
#                         name (".config-herdr-app#57" is "config-herdr-app-57"), or chat-<space> for a chat's agent.
#                         A name over 32 characters is cut to its last 20 and a hash (agent-browser's socket path is short).
# Whose: --task <key> (else $HERDR_BROWSER_TASK), --space <id> (else $HERDR_BROWSER_SPACE), --chat (the space's chat's
# own agent); what is missing comes from the labels of the terminal it runs in ($HC_TERMINAL_ID).
# 3.1 kept one profile per task (<root>/<task>): a space's profile starts from one of them (adopt_profile below).
#
# Beside the profiles, plain files Shepherdr reads (the service's screens, herdr-task's tick); herdr-desktop shares them:
#   <name>.task    whose it is (the task's key, or chat:<space>);  <name>.space  its space
#   <name>.used    touched by every agent command (spaces/<space>.used too): the tick closes a space's browser idle
#                  past its setting
#   <name>.you     the person drives (Take over): every browser AND desktop command of this agent is refused, and
#                  nothing is read for it, until Hand back removes it
#   <name>.hands   the agent asked for the person's hands (herdr-browser hands "<what>"): the Needs your hands card
#   <name>.cdp, <name>.tab   the Chrome its session is joined to, and its own tab's id
#   spaces/<space>.cdp       the space's Chrome (its DevTools address, on 127.0.0.1 only)
#   spaces/<space>.desk      the person is signing in on the desktop: a normal Chrome holds the profile
# --own: Shepherdr's own commands (the Screen); they don't count as the agent using it, nor get refused.
# --name: prints the names it would use, as JSON, and runs nothing. --own --state: what is open, starting nothing.
# --own --close-space [why] / --forget / --desk <url> / --desk-end: the tick's and the Screen's own.
#
# agent-browser itself (SHEP-156): any 0.41.x from the pin on, found on the PATH, or Shepherdr's own copy in
# ~/.local/share/shepherdr/agent-browser/<pin>/ (preferred once there). When there's none, an agent's first command
# installs it there: agent-browser's own release binary for this machine, checked against the pin's checksum (no
# npm, no sudo), and Chrome for Testing with `agent-browser install` when no Chrome is found. Install and update run
# --install too. A failed try isn't repeated for 10 minutes, except by --install.
# --install  makes sure a working agent-browser and Chrome are here (installs them), and says what it found
# --status   what's here, as JSON, installing nothing (shepherdr doctor)
# --bin      the agent-browser it runs, installing nothing (herdr-task's tick)

PIN=0.41.1
# The pinned release's binaries (github.com/vercel-labs/agent-browser/releases), by platform: sha256.
sha_for() {
  case "$1" in
    darwin-arm64) echo 63b0a97b85a54b4c9b2871318af74104c29b80abd507b53a30316884e062854b ;;
    darwin-x64) echo 7802f053e7fb25e10548ee10ca60d892c73d42ed2dbb7fc30c2d5925a5c82859 ;;
    linux-arm64) echo f0b3bdaa40abf2a5111ec08e6d242110aaf56045ef5108cbc633bacc8e53ca17 ;;
    linux-x64) echo 2a89295b62ddd497986a9a80b52e1dbe4c1f6bd68ffde67eaae82eec2206af61 ;;
    linux-musl-arm64) echo 3afdec8f37bfd80b2ecc30e2297c95c3bae9ddb3775ebe531534ea6e3662f44c ;;
    linux-musl-x64) echo 951c795e21fddab1d4091ad2ca4f0e69f1eea6534288e6a251598df11ca8e9af ;;
  esac
}
# Shepherdr's state folder once this machine's data moved there (herdr_task/layout.py), else the old ~/.herdr/browser
if [ -n "${SHEPHERDR_HOME:-}" ]; then shep_data="$SHEPHERDR_HOME/data"; shep_state="$SHEPHERDR_HOME/state"
else shep_data="${XDG_DATA_HOME:-$HOME/.local/share}/shepherdr"; shep_state="${XDG_STATE_HOME:-$HOME/.local/state}/shepherdr"; fi
if [ "$(cut -c1 "$shep_data/LAYOUT" 2>/dev/null)" = 2 ] && [ ! -e "$HOME/.herdr/.layout-rollback" ]; then root="$shep_state/browser"
else root="$HOME/.herdr/browser"; fi
# Shepherdr's own agent-browser (always in its data folder, whatever the layout)
abdir="$shep_data/agent-browser"
mine="$abdir/$PIN/agent-browser"
# the one command that fixes it, as the person can type it
if [ "$(command -v herdr-browser 2>/dev/null)" ]; then fix="herdr-browser --install"; else fix="$0 --install"; fi

# Same major and minor as the pin, and not older: 0.41.1, 0.41.2… (0.42 may change what Herdr relies on).
compatible() {
  _v=${1%%[-+]*}
  case "$_v" in [0-9]*.[0-9]*.[0-9]*) ;; *) return 1 ;; esac
  case "$_v" in *[!0-9.]*|*.*.*.*) return 1 ;; esac
  [ "${_v%.*}" = "${PIN%.*}" ] && [ "${_v##*.}" -ge "${PIN##*.}" ]
}

# A binary's version, asked once per binary (its path and change time), then kept.
version_of() {
  _real=$(readlink -f "$1" 2>/dev/null || echo "$1")
  _stamp="$_real $(stat -c %Y "$_real" 2>/dev/null || stat -f %m "$_real" 2>/dev/null)"
  _ver=
  [ -f "$root/.version" ] && _ver=$(awk -v s="$_stamp" 'substr($0, 1, length(s)) == s { print $NF }' "$root/.version")
  if [ -z "$_ver" ]; then
    _ver=$("$1" --version 2>/dev/null | awk '{ print $NF }')
    [ -n "$_ver" ] && mkdir -p "$root" 2>/dev/null && chmod 700 "$root" 2>/dev/null && printf '%s %s\n' "$_stamp" "$_ver" >> "$root/.version"
  fi
  echo "$_ver"
}

# Which agent-browser: $HERDR_BROWSER_BIN, else Shepherdr's own, else the PATH's. Sets bin, ver, from.
pick() {
  if [ -n "${HERDR_BROWSER_BIN:-}" ]; then bin=$HERDR_BROWSER_BIN; from=env
  elif [ -x "$mine" ]; then bin=$mine; from=shepherdr
  else bin=$(command -v agent-browser 2>/dev/null); from=path; fi
  ver=
  if [ -n "$bin" ]; then ver=$(version_of "$bin"); else from=; fi
}
usable() { [ -n "$bin" ] && compatible "$ver"; }

# Puts agent-browser $PIN's own binary for this machine at $mine. -> 0, or 1 with $why.
install_mine() {
  case "$(uname -s)" in
    Darwin) _os=darwin ;;
    Linux) _os=linux; if (ldd --version 2>&1 || true) | grep -qi musl; then _os=linux-musl; fi ;;
    *) why="agent-browser has no build for $(uname -s)"; return 1 ;;
  esac
  case "$(uname -m)" in
    x86_64|amd64) _arch=x64 ;;
    arm64|aarch64) _arch=arm64 ;;
    *) why="agent-browser has no build for $(uname -m)"; return 1 ;;
  esac
  _plat=$_os-$_arch
  _want=${HERDR_BROWSER_SHA256:-$(sha_for "$_plat")}
  [ -n "$_want" ] || { why="agent-browser has no build for $_plat"; return 1; }
  command -v curl >/dev/null 2>&1 || { why="curl isn't installed"; return 1; }
  _url="${HERDR_BROWSER_URL:-https://github.com/vercel-labs/agent-browser/releases/download/v$PIN}/agent-browser-$_plat"
  mkdir -p "$abdir/$PIN" 2>/dev/null || { why="can't write to $abdir"; return 1; }
  _tmp="$abdir/.part.$$"
  # Said as it goes (GitHub #1173): a slow network took minutes with no word, which looked like a hang.
  curl -fsSL --retry 2 --connect-timeout 15 --max-time 600 -o "$_tmp" "$_url" 2>"$_tmp.err" &
  _pid=$!
  _t=0
  while kill -0 "$_pid" 2>/dev/null; do
    sleep 1; _t=$((_t + 1))
    if [ $((_t % ${HERDR_BROWSER_PROGRESS_EVERY:-10})) = 0 ]; then
      _sz=$(wc -c < "$_tmp" 2>/dev/null | tr -d ' ')
      _slow=
      [ "$_t" -ge 60 ] && _slow=" (a slow network: it may take up to 10 minutes)"
      echo "herdr-browser: downloading agent-browser $PIN: $(awk -v b="${_sz:-0}" 'BEGIN { printf "%.1f", b / 1048576 }') MB after ${_t} s$_slow…" >&2
    fi
  done
  wait "$_pid"; _rc=$?
  _err=$(cat "${_tmp:?}.err" 2>/dev/null); rm -f "${_tmp:?}.err"
  if [ "$_rc" != 0 ]; then
    rm -f "${_tmp:?}"
    why="couldn't download it (${_err:-no answer}; offline?)"; return 1
  fi
  _got=$( (sha256sum "$_tmp" 2>/dev/null || shasum -a 256 "$_tmp" 2>/dev/null) | awk '{ print $1 }')
  if [ "$_got" != "$_want" ]; then
    rm -f "${_tmp:?}"; why="the download isn't agent-browser $PIN (its checksum differs)"; return 1
  fi
  chmod 755 "${_tmp:?}" && mv -f "${_tmp:?}" "$mine" || { rm -f "${_tmp:?}"; why="can't write to ${abdir:?}"; return 1; }
  # an older pin's copy: no longer used
  for _d in "$abdir"/*/; do
    _dd=${_d%/}; [ -d "$_d" ] && [ "$_dd" != "$abdir/$PIN" ] && rm -rf "${_dd:?}"
  done
  return 0
}

# Chrome for the binary picked: agent-browser's own check, else `agent-browser install` (Chrome for Testing into
# ~/.agent-browser). -> 0, or 1 with $why.
chrome() {
  "$bin" doctor --offline --quick --json 2>/dev/null | python3 -c 'import json,sys
try: sys.exit(0 if any(c.get("id") == "chrome.installed" and c.get("status") == "pass" for c in json.load(sys.stdin)["checks"]) else 1)
except Exception: sys.exit(1)' && return 0
  echo "herdr-browser: downloading Chrome for the task browser (agent-browser install)…" >&2
  if ! _err=$("$bin" install 2>&1 </dev/null); then
    why="agent-browser couldn't download Chrome ($(printf '%s\n' "$_err" | grep . | tail -n 1))"; return 1
  fi
  return 0
}

# Makes sure a usable agent-browser and Chrome are here; one at a time. -> 0, or 1 with $why (kept in .failed).
ensure() {
  why=
  mkdir -p "$abdir" 2>/dev/null || { why="can't write to $abdir"; return 1; }
  _n=0
  until mkdir "$abdir/.lock" 2>/dev/null; do
    [ "$_n" = 0 ] && echo "herdr-browser: another herdr-browser is installing agent-browser $PIN; waiting for it…" >&2
    # another one is installing: wait for it (a lock left by one that died goes after 10 minutes)
    if [ -n "$(find "${abdir:?}/.lock" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then rmdir "${abdir:?}/.lock" 2>/dev/null; continue; fi
    _n=$((_n + 1)); [ "$_n" -gt 600 ] && { why="another install is still running"; return 1; }
    sleep 1
  done
  pick
  _ok=0
  if ! usable; then
    echo "herdr-browser: installing agent-browser $PIN for Shepherdr into $abdir (once)…" >&2
    install_mine || _ok=1
    [ "$_ok" = 0 ] && pick
  fi
  [ "$_ok" = 0 ] && { chrome || _ok=1; }
  if [ "$_ok" = 0 ]; then rm -f "${abdir:?}/.failed"; else printf '%s\n' "$why" > "${abdir:?}/.failed"; fi
  rmdir "${abdir:?}/.lock" 2>/dev/null
  return $_ok
}

# What's wrong, and the one command that fixes it.
problem() {
  if [ -z "$bin" ]; then _what="agent-browser isn't installed here"
  else _what="Shepherdr runs agent-browser $PIN (or a newer ${PIN%.*}.x); this machine has ${ver:-an unknown version} ($bin)"; fi
  # The apostrophe sits outside ${...}: bash (3.2 on macOS too) reads one inside a double-quoted ${...} as a quote
  _why=
  if [ -n "$why" ]; then _why=", and Shepherdr couldn't install it: $why"; fi
  echo "herdr-browser: $_what$_why. Fix it: $fix"
}

json_str() { printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()), end="")'; }

# Chrome's shared libraries (SHEP-200). agent-browser's doctor only checks that Chrome's file is there, so a Chrome
# missing a library passes and then exits 127 with the loader's one line. Say which library is missing, and how to
# install it, before anything starts.
# Every Chrome Shepherdr starts gets these: no macOS keychain (a Mac otherwise asks "Google Chrome for Testing wants to
# use your confidential information stored in 'Chromium Safe Storage'", again on every Deny), cookies kept in the
# profile. agent-browser passes them too; the desktop Chrome on the same profile needs them to read its cookies.
NO_KEYCHAIN="--use-mock-keychain --password-store=basic"
# Chrome: $AGENT_BROWSER_EXECUTABLE_PATH, else the newest one agent-browser installed.
chrome_bin() {
  if [ -n "${AGENT_BROWSER_EXECUTABLE_PATH:-}" ]; then echo "$AGENT_BROWSER_EXECUTABLE_PATH"; return; fi
  _c=
  for _f in "$HOME/.agent-browser/browsers"/chrome-*/chrome; do [ -x "$_f" ] && _c=$_f; done
  echo "$_c"
}
# The libraries ldd says Chrome can't find, space-separated. Nothing where ldd can't say (macOS, no Chrome yet).
missing_libs() {
  [ "$(uname -s)" = Linux ] && command -v ldd >/dev/null 2>&1 || return 0
  _c=$(chrome_bin)
  [ -n "$_c" ] || return 0
  ldd "$_c" 2>/dev/null | awk '/=> not found/ { printf "%s ", $1 }' | sed 's/ $//'
}
# The package that provides a library, by distro family: debian, fedora, arch, alpine (one name each, in that order).
lib_pkgs() {
  case "$1" in
    libgbm.so*) echo "libgbm1 mesa-libgbm libgbm mesa-gbm" ;;
    libnss3.so*|libnssutil3.so*|libsmime3.so*) echo "libnss3 nss nss nss" ;;
    libnspr4.so*) echo "libnspr4 nspr nspr nspr" ;;
    libasound.so*) echo "libasound2 alsa-lib alsa-lib alsa-lib" ;;
    libatk-1.0.so*) echo "libatk1.0-0 atk atk atk" ;;
    libatk-bridge-2.0.so*) echo "libatk-bridge2.0-0 at-spi2-atk at-spi2-atk at-spi2-atk" ;;
    libcups.so*) echo "libcups2 cups-libs libcups cups-libs" ;;
    libdrm.so*) echo "libdrm2 libdrm libdrm libdrm" ;;
    libxkbcommon.so*) echo "libxkbcommon0 libxkbcommon libxkbcommon libxkbcommon" ;;
    *) ;;
  esac
}
# The install command for this distro with the packages of the libraries given, and the ones it can't name.
install_hint() {
  _ids=$(grep -E '^(ID|ID_LIKE)=' "${HERDR_BROWSER_OS_RELEASE:-/etc/os-release}" 2>/dev/null | cut -d= -f2- | tr -d '"' | tr '\n' ' ')
  case " $_ids " in
    *" debian "*|*" ubuntu "*) _col=1; _cmd="sudo apt-get install -y" ;;
    *" fedora "*|*" rhel "*|*" centos "*) _col=2; _cmd="sudo dnf install -y" ;;
    *" arch "*) _col=3; _cmd="sudo pacman -S --needed" ;;
    *" alpine "*) _col=4; _cmd="sudo apk add" ;;
    *) _col= ;;
  esac
  _pk=; _no=
  for _l in $1; do
    _p=
    [ -n "$_col" ] && _p=$(lib_pkgs "$_l" | cut -d' ' -f"$_col")
    if [ -n "$_p" ]; then _pk="$_pk $_p"; else _no="$_no $_l"; fi
  done
  if [ -n "$_pk" ]; then echo "Install: $_cmd$_pk"; fi
  if [ -n "$_no" ]; then echo "No package name is known here for:$_no. Find the package that provides each file (your distro's package search)."; fi
}
# Chrome can't start without its libraries: says which are missing and how to install them. -> 0, or 1 (said).
libs_check() {
  _m=$(missing_libs)
  [ -n "$_m" ] || return 0
  echo "herdr-browser: Chrome can't start: missing system libraries: $_m."
  install_hint "$_m"
  return 1
}

# Chrome's sandbox (SHEP-203, GitHub #920). Ubuntu 24.04's AppArmor (kernel.apparmor_restrict_unprivileged_userns=1)
# stops unprivileged user namespaces for any program without a profile that allows them, and Chrome then dies with
# "No usable sandbox". The sandbox stays on: this says the fix for this machine and runs nothing, the person applies it.
USERNS_SYSCTL=${HERDR_BROWSER_USERNS_SYSCTL:-/proc/sys/kernel/apparmor_restrict_unprivileged_userns}
APPARMOR_D=${HERDR_BROWSER_APPARMOR_D:-/etc/apparmor.d}
_prof=herdr-browser-chrome
# Only when the restriction is on and a plain unshare of user namespaces fails: other causes are not this one.
userns_blocked() {
  [ "$(uname -s)" = Linux ] || return 1
  [ "$(cat "$USERNS_SYSCTL" 2>/dev/null)" = 1 ] || return 1
  command -v unshare >/dev/null 2>&1 || return 1
  unshare -U true >/dev/null 2>&1 && return 1
  return 0
}
# Says the one fix for the Chrome it would start (its profile, then the wider sysctl). -> 0, or 1 (said).
sandbox_check() {
  userns_blocked || return 0
  _c=$(chrome_bin)
  [ -n "$_c" ] || return 0   # no Chrome yet: the first start installs one, and this runs again then
  _c=$(readlink -f "$_c" 2>/dev/null || echo "$_c")
  # The fix is in place when its profile names this Chrome's path: this shell stays unconfined, so unshare still fails
  grep -qsF "profile $_prof \"$_c\" flags=(unconfined)" "$APPARMOR_D/$_prof" && return 0
  cat <<EOF
herdr-browser: Chrome can't start its sandbox: AppArmor blocks unprivileged user namespaces on this machine
(Ubuntu's kernel.apparmor_restrict_unprivileged_userns), so Chrome stops with "No usable sandbox".
Chrome's sandbox stays on, and nothing was changed. To let this one Chrome use it, run these two with sudo:

  printf '%s\n' 'abi <abi/4.0>,' 'include <tunables/global>' '' 'profile $_prof "$_c" flags=(unconfined) {' '  userns,' '}' | sudo tee /etc/apparmor.d/$_prof >/dev/null
  sudo apparmor_parser -r /etc/apparmor.d/$_prof

Then run herdr-browser again. The profile is for this Chrome's path: when agent-browser installs a newer Chrome, its path changes and the two lines are needed again.
The wider way, for every program on this machine until the next reboot: sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
EOF
  return 1
}

# herdr-browser's own help, and agent-browser's when it's here. Never installs anything (GitHub #1173: --help waited on
# a download).
own_help() {
  cat <<EOF
herdr-browser: your own tab in your space's browser (agent-browser $PIN; the space's agents share its sign-ins).
  herdr-browser <agent-browser command>   e.g. open <url>, snapshot -i, click @e2, screenshot /abs/shot.png
  herdr-browser hands "<what>"            a step only a person can do (a sign-in code, a captcha): ask for their hands
  herdr-browser --install                 install agent-browser $PIN and Chrome, saying what it found
  herdr-browser --status                  what's here, as JSON
EOF
  pick
  if usable; then echo; "$bin" --help 2>&1; return 0; fi
  echo
  echo "agent-browser $PIN isn't here yet (${ver:+this machine has $ver; }the first browser command installs it, or run: $fix)."
}

case "${1-}" in
  --help|-h|help) own_help; exit 0 ;;
  --install)
    if ensure; then
      libs_check >&2 || exit 1
      sandbox_check >&2 || exit 1
      echo "herdr-browser: agent-browser $ver is ready ($bin), with Chrome."
      exit 0
    fi
    pick; problem >&2
    exit 1 ;;
  --status)
    pick; why=
    [ -f "$abdir/.failed" ] && why=$(cat "$abdir/.failed")
    if usable; then ok=true; msg=; else ok=false; msg=$(problem); fi
    printf '{"ok":%s,"pin":"%s","accepts":"%s","bin":%s,"version":%s,"from":%s,"failed":%s,"problem":%s,"fix":%s}\n' \
      "$ok" "$PIN" "$PIN to ${PIN%.*}.x" "$(json_str "$bin")" "$(json_str "$ver")" "$(json_str "$from")" \
      "$(json_str "$why")" "$(json_str "$msg")" "$(json_str "$fix")"
    exit 0 ;;
  --bin)
    pick
    usable || exit 1
    echo "$bin"
    exit 0 ;;
esac

# Whose browser: a task's agent (--task <slug#id>, else $HERDR_BROWSER_TASK) or a space's chat's own agent (--chat),
# in which space (--space <id>, else $HERDR_BROWSER_SPACE). What is missing comes from the labels of the terminal it
# runs in ($HC_TERMINAL_ID): herdr.task and herdr.task.space on a task's agent, herdr.space on a chat's own.
task=${HERDR_BROWSER_TASK-}
space=${HERDR_BROWSER_SPACE-}
own=; chat=; show=; admin=; deskurl=
while :; do
  case "${1-}" in
    --task) task=${2-}; shift 2 || exit 2 ;;
    --space) space=${2-}; shift 2 || exit 2 ;;
    --chat) chat=1; task=; shift ;;
    --own) own=1; shift ;;
    --name) show=1; shift ;;
    --state|--close-space|--forget|--desk-end) admin=${1#--}; shift ;;
    --desk) admin=desk; deskurl=${2-}; shift 2 || exit 2 ;;
    *) break ;;
  esac
done
if [ -z "$chat" ] && { [ -z "$task" ] || [ -z "$space" ]; } && [ -n "${HC_TERMINAL_ID-}" ]; then
  _l=$(hc get "$HC_TERMINAL_ID" --json 2>/dev/null | python3 -c 'import json,sys
try: l = json.load(sys.stdin).get("labels") or {}
except Exception: l = {}
print(l.get("herdr.task") or "")
print(l.get("herdr.task.space") or l.get("herdr.space") or l.get("herdr.coordinator.space") or "")' 2>/dev/null)
  [ -n "$task" ] || task=$(printf '%s\n' "$_l" | sed -n 1p)
  [ -n "$space" ] || space=$(printf '%s\n' "$_l" | sed -n 2p)
fi
space=${space##*/}   # "vm/sp12" is sp12 on its own machine
if [ -z "$task" ] && [ -z "$space" ]; then
  echo "herdr-browser: whose browser? Run it from a task's agent or a space's chat, or pass --task <slug#id> (and --space <id>), or --chat --space <id>." >&2
  exit 2
fi
# A task whose space isn't known (started by an older Shepherdr, or by hand) shares its task list's browser.
[ -n "$space" ] || space="list-${task%%#*}"
safe() { printf %s "$1" | sed 's/[^A-Za-z0-9_-]/-/g; s/--*/-/g; s/^-//; s/-$//'; }
# A long name is cut (SHEP-178): its last 20 characters and the first 8 hex of its key's sha256, the same every call.
# Kept in step with bin/herdr-desktop, herdr_task/browsers.py and service/screens.ts (sessionOf).
sess() {
  if [ ${#1} -gt 32 ]; then
    _h=$(printf %s "$2" | sha256sum 2>/dev/null | cut -c1-8)
    [ -n "$_h" ] || _h=$(printf %s "$2" | shasum -a 256 2>/dev/null | cut -c1-8)
    echo "herdr-$(printf %s "$1" | tail -c 20 | sed 's/^-*//')-$_h"
  else echo "herdr-$1"; fi
}
sp=$(safe "$space")
if [ -n "$task" ]; then who=$task; name=$(safe "$task"); else who="chat:$space"; name="chat-$sp"; fi
session=$(sess "$name" "$who")
owner=$(sess "s-$sp" "space:$space")
profile="$root/spaces/$sp"
if [ -n "$show" ]; then
  printf '{"who":%s,"name":"%s","space":"%s","session":"%s","owner":"%s","profile":%s,"pin":"%s"}\n' \
    "$(json_str "$who")" "$name" "$sp" "$session" "$owner" "$(json_str "$profile")" "$PIN"
  exit 0
fi
mkdir -p "$root/spaces" 2>/dev/null && chmod 700 "$root" 2>/dev/null

# The first word that isn't a flag: what the command does.
verb=
for a in "$@"; do case "$a" in -*) ;; *) verb=$a; break ;; esac; done

# Needs your hands: the agent asks for the person, in a few words. The app shows the card with the live picture, Skip
# and Take over; the agent is told when the person is done or skipped it.
if [ "${1-}" = hands ] && [ -z "$admin" ]; then
  shift
  if [ "${1-}" = --cancel ]; then rm -f "${root:?}/${name:?}.hands"; echo "herdr-browser: no longer asking for the person's hands."; exit 0; fi
  what=$*
  if [ -z "$what" ]; then echo 'herdr-browser: say what you need, in a few words: herdr-browser hands "Sign in to Stripe"' >&2; exit 2; fi
  [ -f "$root/$name.task" ] || printf '%s\n' "$who" > "$root/$name.task"
  printf '%s\n' "$sp" > "$root/$name.space"
  printf '{"what":%s,"src":"b","at":%s}\n' "$(json_str "$what")" "$(date +%s)" > "$root/$name.hands"
  echo "herdr-browser: asked the person: \"$what\". They see your page with Take over and Skip. Stop here and wait: you get a message when they are done or skip it. While they drive, your browser commands are refused."
  exit 0
fi

# Its session, profile and tab are Shepherdr's: another one would start a second browser beside it.
for a in "$@"; do
  case "$a" in
    --session|--session=*|--profile|--profile=*|--cdp|--cdp=*|--auto-connect|--namespace|--namespace=*|--pin-tab|--no-pin-tab|--idle-timeout|--idle-timeout=*)
      echo "herdr-browser: $a isn't needed: this is always your own tab (session $session) in your space's browser (profile $profile)." >&2
      exit 2 ;;
  esac
done

# A usable agent-browser (one version per session: two keep restarting its daemon). None yet: an agent's first command
# installs it (Shepherdr's own views only say so, they never wait on a download), unless a try failed in the last 10 minutes.
pick
if ! usable; then
  [ "${1-}" = help ] && { own_help; exit 0; }
  for a in "$@"; do case "$a" in --help|-h) own_help; exit 0 ;; esac; done
  why=
  [ -n "$(find "$abdir/.failed" -mmin -10 2>/dev/null)" ] && why=$(cat "$abdir/.failed")
  if [ -z "$own" ] && [ -z "$why" ] && [ -z "${HERDR_BROWSER_BIN:-}" ]; then
    ensure || { pick; usable && echo "herdr-browser: $why. Fix it: $fix" >&2; }
    pick
  fi
  if ! usable; then problem >&2; exit 127; fi
fi
libs_check >&2 || exit 127
sandbox_check >&2 || exit 127

# Pages see prefers-reduced-motion (Chrome draws them in software, so an animation costs a core);
# an agent whose page must move turns it off with: set media no-preference.
# And the keychain flags, whatever else is set (newline-separated, as agent-browser reads them).
export AGENT_BROWSER_ARGS="${AGENT_BROWSER_ARGS:---force-prefers-reduced-motion}
$(echo $NO_KEYCHAIN | tr ' ' '\n')"

# ---- the space's browser, and this agent's own tab in it ----
live=
sessions() { live=$("$bin" session list 2>/dev/null); }
has() { printf '%s\n' "$live" | sed 's/^[[:space:]]*//' | grep -qxF -- "$1"; }
active_tab() { python3 -c 'import json,sys
try: print(next(t["targetId"] for t in json.load(sys.stdin)["data"]["tabs"] if t.get("active")))
except Exception: pass' 2>/dev/null; }
# The person signs in on the desktop (Open on the desktop instead): a normal Chrome holds the space's profile.
desk_pid() {
  _d=$(cat "$root/spaces/$sp.desk" 2>/dev/null)
  if [ -n "$_d" ] && kill -0 "$_d" 2>/dev/null; then echo "$_d"; else rm -f "${root:?}/spaces/${sp:?}.desk"; fi
}
# The space's profile starts from a browser a task here already had (3.1 kept one per task, in <root>/<task>): this
# task's own, else the one used last by a task of the same list. It is moved, not copied, and a link stays at its old
# place; the other tasks' old profiles stay where they are, untouched, until their task is Done.
adopt_profile() {
  [ -e "$profile" ] && return 0
  _from=
  if [ -n "$task" ] && [ -d "$root/$name" ] && [ ! -L "$root/$name" ]; then _from=$name
  elif [ -n "$task" ]; then
    _pre=$(safe "${task%%#*}")
    for _u in $(ls -t "$root/$_pre"-*.used 2>/dev/null); do
      _n=${_u##*/}; _n=${_n%.used}
      case "${_n#"$_pre"-}" in *[!0-9]*|"") continue ;; esac
      if [ -d "$root/$_n" ] && [ ! -L "$root/$_n" ]; then _from=$_n; break; fi
    done
  fi
  [ -n "$_from" ] || return 0
  _k=$(cat "$root/$_from.task" 2>/dev/null)
  "$bin" --session "$(sess "$_from" "${_k:-$_from}")" close >/dev/null 2>&1   # 3.1's own Chrome on it, if it still runs
  mv "$root/$_from" "$profile" 2>/dev/null && ln -s "spaces/$sp" "$root/$_from" 2>/dev/null
  rm -f "${root:?}/${_from:?}.new" "${root:?}/${_from:?}.session"
  return 0
}
# Makes sure the space's browser runs (one headless Chrome on the space's profile, held by the session $owner, which
# nobody drives) and sets cur to its DevTools address. -> 0, or 1 with $why.
space_up() {
  sessions
  cur=
  if has "$owner"; then cur=$("$bin" --session "$owner" --profile "$profile" --idle-timeout 0 get cdp-url 2>/dev/null | grep '^ws' | tail -n 1); fi
  if [ -z "$cur" ]; then
    _n=0
    until mkdir "$root/spaces/$sp.lock" 2>/dev/null; do
      if [ -n "$(find "${root:?}/spaces/${sp:?}.lock" -maxdepth 0 -mmin +2 2>/dev/null)" ]; then rmdir "${root:?}/spaces/${sp:?}.lock" 2>/dev/null; continue; fi
      _n=$((_n + 1)); [ "$_n" -gt 90 ] && { why="another command is still starting this space's browser"; return 1; }
      sleep 1
    done
    sessions
    if has "$owner"; then "$bin" --session "$owner" close >/dev/null 2>&1; fi
    adopt_profile
    _err=$("$bin" --session "$owner" --profile "$profile" --idle-timeout 0 open about:blank 2>&1 >/dev/null)
    cur=$("$bin" --session "$owner" --profile "$profile" --idle-timeout 0 get cdp-url 2>/dev/null | grep '^ws' | tail -n 1)
    rmdir "${root:?}/spaces/${sp:?}.lock" 2>/dev/null
    if [ -z "$cur" ]; then why="the space's browser didn't start (${_err:-agent-browser gave no address})"; return 1; fi
  fi
  [ "$(cat "$root/spaces/$sp.cdp" 2>/dev/null)" = "$cur" ] || printf '%s\n' "$cur" > "$root/spaces/$sp.cdp"
  return 0
}
ab() { "$bin" --session "$session" --cdp "$cur" --pin-tab --idle-timeout 0 "$@"; }
# This agent's own page in that browser: a window of its own in the browser's one profile (a tab behind another
# isn't drawn, so it couldn't be watched; agent-browser's own `window new` makes a separate cookie jar, so it is asked
# of Chrome itself: Target.createTarget with newWindow), which its session joins and stays pinned to. Every call of a
# session carries the same --cdp and --pin-tab: one without them makes agent-browser start a Chrome of its own, or
# take another agent's tab. -> 0, or 1 with $why.
new_window='import base64, json, os, socket, struct, sys, urllib.parse
u = urllib.parse.urlsplit(sys.argv[1])
s = socket.create_connection((u.hostname, u.port), timeout=10)
s.sendall(("GET %s HTTP/1.1\r\nHost: %s:%d\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: %s\r\nSec-WebSocket-Version: 13\r\n\r\n"
           % (u.path, u.hostname, u.port, base64.b64encode(os.urandom(16)).decode())).encode())
buf = b""
while b"\r\n\r\n" not in buf:
    buf += s.recv(4096)
buf = buf.split(b"\r\n\r\n", 1)[1]
def send(o):
    d = json.dumps(o).encode(); m = os.urandom(4)
    h = bytes([0x81]) + (bytes([0x80 | len(d)]) if len(d) < 126 else bytes([0x80 | 126]) + struct.pack(">H", len(d)))
    s.sendall(h + m + bytes(b ^ m[i % 4] for i, b in enumerate(d)))
def need(n):
    global buf
    while len(buf) < n:
        c = s.recv(65536)
        if not c: raise SystemExit(1)
        buf += c
    r, buf = buf[:n], buf[n:]
    return r
def recv():
    h = need(2); n = h[1] & 0x7F
    if n == 126: n = struct.unpack(">H", need(2))[0]
    elif n == 127: n = struct.unpack(">Q", need(8))[0]
    return need(n)
send({"id": 1, "method": "Target.createTarget", "params": {"url": "about:blank", "newWindow": True, "background": True}})
while True:
    m = json.loads(recv())
    if m.get("id") == 1:
        print((m.get("result") or {}).get("targetId") or "")
        break'
fresh=
tab_up() {
  [ "$(cat "$root/$name.cdp" 2>/dev/null)" = "$cur" ] && [ -s "$root/$name.tab" ] && return 0
  if [ -f "$root/$name.cdp" ] || [ -f "$root/$name.used" ]; then fresh=again; else fresh=first; fi
  "$bin" --session "$session" close >/dev/null 2>&1   # one left on a browser that is gone (or 3.1's own Chrome)
  # ($HERDR_BROWSER_NEW_WINDOW: a command that prints the new window's id instead, for tests without a Chrome)
  if [ -n "${HERDR_BROWSER_NEW_WINDOW:-}" ]; then _tab=$($HERDR_BROWSER_NEW_WINDOW 2>/dev/null)
  else _tab=$(python3 -c "$new_window" "$cur" 2>/dev/null); fi
  [ -n "$_tab" ] || { why="couldn't open a window in the space's browser"; return 1; }
  if ! _err=$(ab tab "$_tab" 2>&1 >/dev/null); then why="couldn't join the space's browser ($_err)"; return 1; fi
  printf '%s\n' "$cur" > "$root/$name.cdp"
  printf '%s\n' "$_tab" > "$root/$name.tab"
  return 0
}
mark() {
  [ -f "$root/$name.task" ] || printf '%s\n' "$who" > "$root/$name.task"
  [ "$(cat "$root/$name.space" 2>/dev/null)" = "$sp" ] || printf '%s\n' "$sp" > "$root/$name.space"
}
# Closes this agent's tab and its session; the space's browser and its sign-ins stay.
tab_down() {
  if has "$session"; then
    _c=$(cat "$root/$name.cdp" 2>/dev/null)
    [ -n "$_c" ] && "$bin" --session "$session" --cdp "$_c" --pin-tab tab close >/dev/null 2>&1
    "$bin" --session "$session" close >/dev/null 2>&1
  fi
  rm -f "${root:?}/${name:?}.cdp" "${root:?}/${name:?}.tab"
}
# Closes the space's browser: every tab session on it, then the Chrome itself. Sign-ins stay in the profile.
# $1: why, left for each agent that had a tab (said once on its next command).
space_down() {
  sessions
  for _f in "$root"/*.space; do
    [ -f "$_f" ] || continue
    [ "$(cat "$_f" 2>/dev/null)" = "$sp" ] || continue
    _n=${_f##*/}; _n=${_n%.space}
    _k=$(cat "$root/$_n.task" 2>/dev/null)
    _s=$(sess "$_n" "${_k:-$_n}")
    if has "$_s"; then "$bin" --session "$_s" close >/dev/null 2>&1; fi
    if [ -f "$root/$_n.cdp" ] && [ -n "${1-}" ]; then printf '%s\n' "$1" > "$root/$_n.closed"; fi
    rm -f "${root:?}/${_n:?}.cdp" "${root:?}/${_n:?}.tab"
  done
  if has "$owner"; then "$bin" --session "$owner" close >/dev/null 2>&1; fi
  rm -f "${root:?}/spaces/${sp:?}.cdp"
}

# Shepherdr's own (the service, herdr-task's tick): nothing here counts as the agent using its browser.
case "$admin" in
  state)
    sessions
    up=false; open=false; tab=; cdp=$(cat "$root/spaces/$sp.cdp" 2>/dev/null)
    if has "$owner" && [ -n "$cdp" ]; then
      up=true
      if [ "$(cat "$root/$name.cdp" 2>/dev/null)" = "$cdp" ]; then open=true; tab=$(cat "$root/$name.tab" 2>/dev/null); fi
    fi
    desk=false; [ -n "$(desk_pid)" ] && desk=true
    printf '{"who":%s,"name":"%s","space":"%s","session":"%s","owner":"%s","up":%s,"open":%s,"cdp":"%s","tab":"%s","desk":%s}\n' \
      "$(json_str "$who")" "$name" "$sp" "$session" "$owner" "$up" "$open" "$cdp" "$tab" "$desk"
    exit 0 ;;
  close-space) space_down "${1-}"; exit 0 ;;
  forget)
    sessions; tab_down
    for _e in .used .you .view .new .session .task .closed .space .hands; do rm -f "${root:?}/${name:?}${_e:?}"; done
    # 3.1's own profile of this task, where no space took it over (a link: the space's profile stays)
    if [ -L "${root:?}/${name:?}" ]; then rm -f "${root:?}/${name:?}"; elif [ -d "${root:?}/${name:?}" ]; then rm -rf "${root:?}/${name:?}"; fi
    exit 0 ;;
  desk)
    # Open on the desktop instead: the same address in a normal Chrome (no automation) on the space's own profile,
    # on the display in $DISPLAY (macOS: the real screen), so what the person signs in to there is signed in for the
    # space's agents afterwards. The headless browser stops meanwhile: one profile, one Chrome.
    _c=$(chrome_bin)
    [ -n "$_c" ] || { echo "herdr-browser: no Chrome here to open on the desktop (run: $fix)" >&2; exit 1; }
    if [ -z "$(desk_pid)" ]; then
      space_down "the person opened this space's browser on the desktop to sign in"
      mkdir -p "$profile" 2>/dev/null
      nohup "$_c" $NO_KEYCHAIN --user-data-dir="$profile" --no-first-run --no-default-browser-check --new-window "$deskurl" >/dev/null 2>&1 &
      echo $! > "$root/spaces/$sp.desk"
    fi
    printf '{"pid":%s}\n' "$(cat "$root/spaces/$sp.desk")"
    exit 0 ;;
  desk-end)
    _d=$(desk_pid)
    if [ -n "$_d" ]; then
      kill "$_d" 2>/dev/null
      _n=0; while kill -0 "$_d" 2>/dev/null && [ "$_n" -lt 50 ]; do sleep 0.1; _n=$((_n + 1)); done
      kill -9 "$_d" 2>/dev/null
      rm -f "${root:?}/spaces/${sp:?}.desk" "${profile:?}/SingletonLock" "${profile:?}/SingletonSocket" "${profile:?}/SingletonCookie"
    fi
    exit 0 ;;
esac

# What needs no browser runs as agent-browser itself, and starts none.
case "$verb" in
  skills|install|upgrade|doctor|profiles|plugin|dashboard|mcp|chat|auth|session|"") exec "$bin" --session "$session" "$@" ;;
  connect)
    echo "herdr-browser: connect isn't needed: you are always on your own tab in your space's browser." >&2; exit 2 ;;
esac

if [ -z "$own" ]; then
  # The person drives now (Take over in Shepherdr): nothing runs and nothing is read for the agent until they hand
  # back. A flag nobody refreshed for $HERDR_YOU_STALE_MIN minutes (default 11: the service hands back at 10) has ended.
  you="$root/$name.you"
  if [ -f "$you" ]; then
    if [ -n "$(find "$you" -mmin "-${HERDR_YOU_STALE_MIN:-11}" 2>/dev/null)" ]; then
      echo "herdr-browser: the person took over your browser and desktop in Shepherdr and is using them now, so this did not run and nothing was read. Stop and wait: you get a message when they hand back. Then look again (snapshot) before you carry on." >&2
      exit 3
    fi
    rm -f "${you:?}"
  fi
  if [ -n "$(desk_pid)" ]; then
    echo "herdr-browser: the person is signing in to this space's browser on the desktop, so it can't be used now. Stop and wait: you get a message when they are done." >&2
    exit 3
  fi
fi

# The agent's own close: its tab only. The space's browser belongs to every agent of the space.
if [ "$verb" = close ]; then
  sessions; tab_down
  echo "herdr-browser: your tab is closed; your space's browser and its sign-ins stay. Your next command opens a new tab."
  exit 0
fi

space_up || { echo "herdr-browser: $why." >&2; exit 1; }
tab_up || { echo "herdr-browser: $why." >&2; exit 1; }
mark
if [ -z "$own" ]; then
  touch "$root/$name.used" "$root/spaces/$sp.used" 2>/dev/null
  # Shepherdr closed it (idle, or the person signed in on the desktop): said once, so a blank page and a default
  # viewport aren't a mystery (GitHub #1147, #1138).
  if [ -f "$root/$name.closed" ]; then
    echo "herdr-browser: note: your space's browser had been closed ($(cat "$root/$name.closed" 2>/dev/null)); your tab starts again on a blank page at its default size: open your page and set the viewport again. Sign-ins are kept." >&2
    rm -f "${root:?}/${name:?}.closed"
  elif [ "$fresh" = again ]; then
    echo "herdr-browser: note: your space's browser was restarted, so your tab starts again on a blank page at its default size. Sign-ins are kept." >&2
  fi
else
  rm -f "${root:?}/${name:?}.closed"
fi

# A file it writes lands where the agent is (#964): agent-browser's daemon saves a relative path from the folder it
# was started in, maybe another task's. So a screenshot, PDF, recording, download or profile path (and
# --screenshot-dir, --download-path) is made absolute from here.
abs_path() { case "$1" in /*|\~*) printf %s "$1" ;; *) printf %s "$PWD/$1" ;; esac; }
is_file() {
  case "$1" in -*|@*|/*|\~*|http:*|https:*|file:*|data:*|about:*) return 1 ;; esac
  case "$1" in *.png|*.PNG|*.jpg|*.JPG|*.jpeg|*.JPEG|*.webp|*.pdf|*.webm|*.mp4|*.mov|*.json|*.gif) return 0 ;; esac
  return 1
}
n=$#; i=0; prev=; pos=0
while [ $i -lt $n ]; do
  a=$1; shift; i=$((i + 1))
  case "$prev" in
    --screenshot-dir|--download-path) a=$(abs_path "$a") ;;
    *)
      case "$a" in
        --screenshot-dir=*) a="--screenshot-dir=$(abs_path "${a#*=}")" ;;
        --download-path=*) a="--download-path=$(abs_path "${a#*=}")" ;;
        -*) ;;
        *)
          pos=$((pos + 1))
          case "$verb" in
            screenshot|pdf|record|profiler) is_file "$a" && a=$(abs_path "$a") ;;
            download) [ $pos -eq 3 ] && case "$a" in /*|\~*) ;; *) a=$(abs_path "$a") ;; esac ;;
          esac ;;
      esac ;;
  esac
  set -- "$@" "$a"; prev=$a
done

# A page that can't be reached (#1034): Chrome waits on it past agent-browser's own wait, so `open` came back with
# only "Resource temporarily unavailable" and the stuck tab made the next command hang too. A web address whose
# server doesn't answer a connection within HERDR_BROWSER_CONNECT_WAIT seconds (default 10) is refused here with
# why, before the browser goes there. A name that doesn't resolve, or a refused connection, Chrome answers at once.
reach='
import socket, sys, urllib.parse
u, wait = sys.argv[1], float(sys.argv[2])
if "://" not in u:
    if u.split("/")[0].split(":")[0] in ("localhost", "127.0.0.1"): u = "http://" + u
    elif "." in u.split("/")[0]: u = "https://" + u
    else: sys.exit(0)
p = urllib.parse.urlsplit(u)
if p.scheme not in ("http", "https") or not p.hostname: sys.exit(0)
try:
    port = p.port or (443 if p.scheme == "https" else 80)
    socket.create_connection((p.hostname, port), timeout=wait).close()
except socket.timeout:
    print(f"{p.hostname}:{port} did not answer within {wait:g} s")
except (OSError, ValueError):
    pass
'
case "$verb" in
  open|goto|navigate)
    url=
    for a in "$@"; do case "$a" in -*|"$verb") ;; *) url=$a; break ;; esac; done
    if [ -n "$url" ] && [ -z "${HTTPS_PROXY:-}${https_proxy:-}${HTTP_PROXY:-}${http_proxy:-}${ALL_PROXY:-}" ]; then
      why=$(python3 -c "$reach" "$url" "${HERDR_BROWSER_CONNECT_WAIT:-10}" 2>/dev/null)
      if [ -n "$why" ]; then
        echo "herdr-browser: can't open $url: $why, so the browser wasn't sent there (it would hang). Check the address and that its server is running and reachable from this machine, then open it again." >&2
        exit 4
      fi
    fi ;;
esac

# The live picture in Shepherdr is this session's own stream, as agent-browser gives it (no size or quality is set
# here; AGENT_BROWSER_STREAM_QUALITY and AGENT_BROWSER_STREAM_MAX_WIDTH still apply where the person sets them).
# open that never comes back (#1154): a watchdog ends the wait after HERDR_BROWSER_OPEN_WAIT seconds (default 90) and
# says so. A reply the daemon dropped ("Invalid response: EOF", #1081) on a command that only looks or sets is tried
# once more, and said plainly if it fails again. A tab that is gone (a page closed it) is opened again, once.
# Everything else runs as agent-browser itself.
errf=$(mktemp "${TMPDIR:-/tmp}/herdr-browser.XXXXXX") || exec "$bin" --session "$session" --cdp "$cur" --pin-tab --idle-timeout 0 "$@"
trap 'rm -f "${errf:?}" "${errf:?}.late"' EXIT
wait_s=${HERDR_BROWSER_OPEN_WAIT:-90}
tries=0; regone=
while :; do
  tries=$((tries + 1))
  case "$verb" in
    open|goto|navigate|reload)
      "$bin" --session "$session" --cdp "$cur" --pin-tab --idle-timeout 0 "$@" 2>"$errf" &   # itself, not ab(): the watchdog ends this very process
      pid=$!
      ( w=0; while [ "$w" -lt "$wait_s" ] && kill -0 "$pid" 2>/dev/null; do sleep 1; w=$((w + 1)); done
        kill -0 "$pid" 2>/dev/null && : > "$errf.late" && kill "$pid" 2>/dev/null ) &
      dog=$!
      wait "$pid"; rc=$?
      kill "$dog" 2>/dev/null; wait "$dog" 2>/dev/null
      if [ -f "$errf.late" ]; then
        cat "$errf" >&2
        echo "herdr-browser: $verb didn't finish within $wait_s s, so herdr-browser stopped waiting. The page may still be loading: get url and snapshot say where it is. If the next command hangs too, run: herdr-browser close, then open it again." >&2
        exit 124
      fi ;;
    *) ab "$@" 2>"$errf"; rc=$? ;;
  esac
  if [ "$rc" != 0 ] && [ -z "$regone" ] && grep -q 'tab_gone' "$errf" 2>/dev/null; then
    regone=1; tries=0
    rm -f "${root:?}/${name:?}.cdp" "${root:?}/${name:?}.tab"
    if tab_up; then
      echo "herdr-browser: note: your tab was gone, so a new one was opened: it starts on a blank page." >&2
      continue
    fi
  fi
  case "$verb" in
    open|goto|navigate|set|get|snapshot|screenshot|is|reload)
      if [ "$rc" != 0 ] && grep -qiE 'invalid response|EOF' "$errf" 2>/dev/null; then
        if [ "$tries" = 1 ]; then
          echo "herdr-browser: the browser dropped its answer to $verb; trying once more…" >&2
          sleep 1; continue
        fi
        cat "$errf" >&2
        echo "herdr-browser: the browser dropped its answer to $verb twice, so whether it ran is unknown. Check with get url or snapshot; if it keeps happening, run herdr-browser close and start again." >&2
        exit "$rc"
      fi ;;
  esac
  break
done
cat "$errf" >&2
exit "$rc"

#!/usr/bin/env python3
"""Shepherdr's installer: puts the Shepherdr layout, its mods and helpers into a Herdr app home.

  shepherdr install    [--root DIR] [--adopt] [--guard] [--keys ask|keep|ours] [--no-hooks] [--dry-run] [--yes]
  shepherdr update     the same, from the checkout it was installed from (git pull it first); web only too
  (a fresh clone has no web app built: install and update build it with Bun, installing Bun first when it's missing)
  shepherdr install --web               web only: herdr-core, herdr-task, the helpers, the service and the web app
                                        under .local/share/shepherdr (no herdr-app)
  shepherdr web serve-from <machine|here> [--take-link]   serve the web app from another machine linked over
                                        herdr-core (an always-on Mac mini or cloud VM), installing it there; here: back
  shepherdr web status                  which machine serves it, and its link
  shepherdr secrets move-to <machine|here> [--restore]   the machine that keeps the secrets (the vault agents use by
                                        name): moves them there, with a backup on both; --restore: the old one takes its
                                        backup back when the other is gone for good
  shepherdr secrets where               which machine keeps them
  shepherdr uninstall  [--root DIR] [--dry-run]
  shepherdr doctor     [--root DIR]: checks the install; once it's whole, lets the sync to other machines go
  shepherdr version

What goes where (each under --root, default your home):
  .config/herdr-app/mods/<mod>          the add-ons' mods (lib/addons.json lists them), one swap per mod
  .config/herdr-app/layouts/shepherdr.json, lib/, core/, bin/
  .config/herdr-app/keys.json           our keys merged in: free ones added, a key you use asked about first
  .config/herdr-core/templates/*.md     the Assistant's, worker's and reviewer's instructions
  .local/bin/{herdr-task,herdr-artifact,herdr-secret,herdr-browser,shepherdr}   links into the above
  .local/bin/herdr-app                  with --guard: a guard that refuses a window with another home
  .local/share/shepherdr/               the Shepherdr service (service/, core/) and the built web app (web/dist)
  .config/systemd/user/shepherdr.service    Linux: keeps the service running (systemctl --user)
  Library/LaunchAgents/dev.shepherdr.service.plist   macOS: the same with launchd
  ~/.claude/settings.json, ~/.codex/hooks.json   the question-card hooks (not with --no-hooks)

Never overwritten: a mod, layout or lib file that isn't ours (it refuses, naming each; --adopt backs
them up and takes them over), a key you set (unless you say yes), a file you changed since the last
install (the new copy goes beside it as <file>.new). Everything it replaces goes to
.config/herdr-app/.shepherdr-backup/<time>/ first; uninstall puts it back. What it installed is
recorded in .config/herdr-app/data/shepherdr/installed.json (a sha256 per file), so running it again
changes only what changed. While it replaces a helper or template, .herdr/sync-hold keeps
herdr-task from sending them to other machines until `shepherdr doctor` finds the install whole.
"""

import argparse
import ctypes
import ctypes.util
import datetime
import hashlib
import json
import os
import pwd
import shutil
import subprocess
import sys
import tempfile
import time

VERSION = "3.1.9"
HERDR_APP_MIN = "0.1.12"
HC_MIN = "0.1.17"

APP, BIN, TPL, HERDR = ".config/herdr-app", ".local/bin", ".config/herdr-core/templates", ".herdr"
SHARE = ".local/share/shepherdr"   # the service and the web app
UNIT = ".config/systemd/user/shepherdr.service"
PLIST = "Library/LaunchAgents/dev.shepherdr.service.plist"
AGENT = "dev.shepherdr.service"
RECORD = f"{APP}/data/shepherdr/installed.json"
HOLD = f"{HERDR}/sync-hold"
# Helpers on the PATH: their name, and where the link leads (under the app home).
LINKS = {"herdr-task": "mods/tasks/bin/herdr-task", "herdr-artifact": "mods/artifacts/bin/herdr-artifact",
         "herdr-secret": "bin/herdr-secret", "herdr-browser": "bin/herdr-browser", "shepherdr": "bin/shepherdr"}
# Written by Herdr into each mod (editor types): never ours, never touched.
GENERATED = {"gpui-kit.d.ts", "jsconfig.json"}
SKIP = {"__pycache__", ".DS_Store"}
# Layout blocks Herdr's mods point at whatever is shown now (a task's terminal, an opened artifact):
# compared without them, so a layout in use still counts as unchanged.
LIVE_BLOCKS = ("tasks-thread-term", "artifacts-view-body")
HOOKS = [  # (file under home, event, entry): the question and permission cards (the "needs" add-on)
    (".claude/settings.json", "SessionStart",
     {"matcher": "^(startup|resume|clear|compact)$", "hooks": [{"type": "command", "command": "sh '{app}/mods/chat/session-note.sh'", "timeout": 10}]}),
    (".claude/settings.json", "PermissionRequest",
     {"hooks": [{"type": "command", "command": "sh '{app}/mods/chat/ask-hook.sh'", "timeout": 1800}]}),
    (".codex/hooks.json", "SessionStart",
     {"hooks": [{"type": "command", "command": "sh '{app}/mods/chat/session-note.sh'", "timeout": 10}]}),
]


class Stop(Exception):
    pass


def say(*a):
    print(*a, flush=True)


def real_home():
    try:
        return pwd.getpwuid(os.getuid()).pw_dir
    except KeyError:
        return os.path.expanduser("~")


def sha_bytes(b):
    return hashlib.sha256(b).hexdigest()


def read(path):
    try:
        with open(path, "rb") as f:
            return f.read()
    except (FileNotFoundError, IsADirectoryError, NotADirectoryError):
        return None


def layout_bytes(b):
    """A layout as compared: its live blocks blanked (see LIVE_BLOCKS)."""
    try:
        d = json.loads(b)
    except ValueError:
        return b

    def walk(n):
        if isinstance(n, dict):
            if n.get("id") in LIVE_BLOCKS:
                n["content"] = None
            for v in n.values():
                walk(v)
        elif isinstance(n, list):
            for v in n:
                walk(v)
    walk(d)
    return json.dumps(d, sort_keys=True).encode()


def fsha(rel, b):
    """A file's sha256 as recorded: a layout's without its live blocks."""
    if b is None:
        return None
    return sha_bytes(layout_bytes(b) if rel.startswith(f"{APP}/layouts/") else b)


def version_tuple(v):
    out = []
    for p in (v or "").strip().split("."):
        digits = "".join(c for c in p if c.isdigit())
        out.append(int(digits) if digits else 0)
    return tuple(out)


def atomic_write(path, data, mode=None):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".shepherdr-", dir=os.path.dirname(path))
    with os.fdopen(fd, "wb") as f:
        f.write(data)
    if mode is not None:
        os.chmod(tmp, mode)
    os.replace(tmp, path)


def exchange(a, b):
    """Swaps two folders in one step (Linux renameat2, macOS renamex_np), so Herdr sees one change
    per mod. Elsewhere: two renames, a moment apart."""
    libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
    if sys.platform.startswith("linux") and hasattr(libc, "renameat2"):
        if libc.renameat2(-100, os.fsencode(a), -100, os.fsencode(b), 2) == 0:  # AT_FDCWD, RENAME_EXCHANGE
            return
    elif sys.platform == "darwin" and hasattr(libc, "renamex_np"):
        if libc.renamex_np(os.fsencode(a), os.fsencode(b), 2) == 0:  # RENAME_SWAP
            return
    tmp = f"{b}.shepherdr-swap"
    os.rename(b, tmp)
    os.rename(a, b)
    os.rename(tmp, a)


# ---- the source ---------------------------------------------------------------------------------

def is_source(d):
    return bool(d) and os.path.isfile(os.path.join(d, "install.sh")) and os.path.isfile(os.path.join(d, "lib", "addons.json"))


def find_source(given, record):
    for cand in [given, os.path.dirname(os.path.dirname(os.path.realpath(__file__))), (record or {}).get("source")]:
        if is_source(cand):
            return os.path.realpath(cand)
    raise Stop("no Shepherdr checkout found: run ./install.sh from one, or pass --source <checkout>")


# ---- the web app's build ------------------------------------------------------------------------
# web/dist isn't in git, so a fresh clone has no page: the installer builds it with Bun (which the service runs on
# anyway) when it's missing or older than what it's built from. A source without web/src (an installed service
# folder, Serve from's pack) ships its built page and is used as it is.
WEB_INPUTS = ("web", "core", "package.json", "bun.lock")
WEB_OUTPUTS = {"dist", "generated", "node_modules"}


def web_stale(src):
    """Why the source's web app needs a build ("isn't built", "is older than web/src/App.tsx"), or None."""
    if not os.path.isdir(os.path.join(src, "web", "src")):
        return None
    try:
        built = os.path.getmtime(os.path.join(src, "web", "dist", "index.html"))
    except OSError:
        return "isn't built"
    for top in WEB_INPUTS:
        p = os.path.join(src, top)
        if os.path.isfile(p) and os.path.getmtime(p) > built:
            return f"is older than {top}"
        for d, dirs, files in os.walk(p):
            dirs[:] = [x for x in dirs if x not in WEB_OUTPUTS and x not in SKIP]
            for f in files:
                if os.path.getmtime(os.path.join(d, f)) > built:
                    return f"is older than {os.path.relpath(os.path.join(d, f), src)}"
    return None


def install_bun():
    """Bun's own installer (https://bun.sh/install, into ~/.bun), as Serve from does on another machine."""
    say("  installing Bun (https://bun.sh/install, into ~/.bun)")
    subprocess.run(["sh", "-c", "curl -fsSL https://bun.sh/install | bash"], capture_output=True)
    return bun_path()


def build_web(r, src, home, a):
    """Builds the source's web app when it's missing or out of date (bun install, bun run build), before anything is
    written: a build that fails stops the install (nothing changed) unless --force, which installs without it."""
    why = web_stale(src)
    if not why or getattr(a, "no_build", False):
        return
    if r.dry:
        say(f"  the web app {why}: would build it (bun install, bun run build){'' if bun_path() else ', installing Bun first'}")
        return
    # Bun goes on the real machine: only for an install into the real home, never for a scratch --root
    bun = bun_path() or (install_bun() if home else None)
    err = None if bun else "Bun isn't installed (https://bun.sh)"
    if bun:
        say(f"  the web app {why}: building it in {src} (bun install, bun run build)")
        for argv in ([bun, "install", "--frozen-lockfile"], [bun, "run", "build"]):
            p = subprocess.run(argv, cwd=src, capture_output=True, text=True)
            if p.returncode != 0:
                tail = (p.stderr.strip() or p.stdout.strip()).splitlines()[-5:]
                err = f"`{' '.join(['bun', *argv[1:]])}` failed:\n    " + "\n    ".join(tail)
                break
    if not err:
        return
    if a.force:
        r.notes.append(f"couldn't build the web app ({err.splitlines()[0]}): installed without a new page")
        return
    raise Stop(f"couldn't build the web app in {src}: {err}\nNothing was changed. Fix that and run this again, "
               "or --force to install without a new page.")


def walk_files(top):
    """Files under top, relative, skipping caches and Herdr's generated files."""
    out = []
    for d, dirs, files in os.walk(top):
        dirs[:] = sorted(x for x in dirs if x not in SKIP)
        for f in sorted(files):
            if f in SKIP or f in GENERATED or f.endswith(".pyc"):
                continue
            out.append(os.path.relpath(os.path.join(d, f), top))
    return out


def source_items(src):
    """What the checkout installs: [(group, rel under root, source path)]. group: a mod's name,
    or "layout", "lib", "bin", "template"."""
    manifest = json.load(open(os.path.join(src, "lib", "addons.json")))
    mods = list(manifest["core"]["mods"]) + [m for a in manifest["addons"] for m in a.get("mods", [])]
    items = []
    for m in mods:
        top = os.path.join(src, "mods", m)
        if not os.path.isdir(top):
            raise Stop(f"lib/addons.json names mods/{m}, which isn't in {src}")
        items += [(m, f"{APP}/mods/{m}/{f}", os.path.join(top, f)) for f in walk_files(top)]
    for name in manifest["core"]["layouts"]:
        items.append(("layout", f"{APP}/layouts/{name}.json", os.path.join(src, "layouts", f"{name}.json")))
    for f in walk_files(os.path.join(src, "lib")):
        if not f.startswith(".last"):
            items.append(("lib", f"{APP}/lib/{f}", os.path.join(src, "lib", f)))
    for f in walk_files(os.path.join(src, "bin")):
        items.append(("bin", f"{APP}/bin/{f}", os.path.join(src, "bin", f)))
    # The shared core's source beside lib/, so the app's own bin/sync-shared finds it (mods carry copies).
    for f in walk_files(os.path.join(src, "core")) if os.path.isdir(os.path.join(src, "core")) else []:
        if not f.endswith(".test.js"):
            items.append(("lib", f"{APP}/core/{f}", os.path.join(src, "core", f)))
    for f in sorted(os.listdir(os.path.join(src, "templates"))):
        if f.endswith(".md"):
            items.append(("template", f"{TPL}/{f}", os.path.join(src, "templates", f)))
    items += service_items(src)
    return manifest, mods, items


def service_items(src):
    """The service (its TypeScript runs on Bun as it is), the shared core and the built web app; and what makes that
    folder a source for a web-only install on another machine (Serve from: `shepherdr web install-on` packs it)."""
    items = [("service", f"{SHARE}/package.json", os.path.join(src, "package.json")),
             # which add-ons the web app leaves out while off (Settings › Window)
             ("service", f"{SHARE}/lib/addons.json", os.path.join(src, "lib", "addons.json"))]
    # the service, the shared core, and the web app's shared code the service runs too (alerts, types' helpers)
    for top in ("service", "core", "web/shared"):
        for f in walk_files(os.path.join(src, top)) if os.path.isdir(os.path.join(src, top)) else []:
            if not f.endswith((".test.ts", ".test.js")):
                items.append(("service", f"{SHARE}/{top}/{f}", os.path.join(src, top, f)))
    dist = os.path.join(src, "web", "dist")
    for f in walk_files(dist) if os.path.isfile(os.path.join(dist, "index.html")) else []:
        items.append(("service", f"{SHARE}/web/dist/{f}", os.path.join(dist, f)))
    # herdr-task, herdr-artifact and the helpers, the role instructions and the installer: a web-only install links
    # its helpers here; on any install the folder is a whole source to install another machine from
    for top in ("mods/tasks/bin", "mods/artifacts/bin", "bin", "templates"):
        for f in walk_files(os.path.join(src, top)):
            if top != "templates" or f.endswith(".md"):
                items.append(("service", f"{SHARE}/{top}/{f}", os.path.join(src, top, f)))
    for f in ("mods/artifacts/recipe-view.js", "mods/artifacts/markup.js", "install.sh"):
        items.append(("service", f"{SHARE}/{f}", os.path.join(src, f)))
    # recipe-view.js imports it from beside itself
    items.append(("service", f"{SHARE}/mods/artifacts/core/recipe.js", os.path.join(src, "core", "recipe.js")))
    return items


def bun_path():
    for p in (shutil.which("bun"), os.path.expanduser("~/.bun/bin/bun")):
        if p and os.path.isfile(p):
            return p
    return None


def unit_text(root, bun):
    """The user service that keeps Shepherdr's service running (Linux), or its launchd agent (macOS)."""
    main = os.path.join(root, SHARE, "service", "main.ts")
    # hc, herdr-task and the helpers live in ~/.local/bin, which a user service's PATH lacks; and the tools herdr-task
    # and the agents run (gh, git, node, agent-browser, the CLIs…) where this install finds them (mise, nvm, brew…)
    tools = ["gh", "git", "node", "agent-browser", "claude", "codex", "python3", "tailscale", "pw-record", "pw-play", "jq"]
    found = [os.path.dirname(os.path.realpath(p)) if os.path.basename(os.path.realpath(p)) == t else os.path.dirname(p)
             for t in tools for p in [shutil.which(t)] if p]
    dirs = [os.path.join(root, BIN), os.path.dirname(bun), *found, "/usr/local/bin", "/opt/homebrew/bin", "/usr/bin", "/bin", "/usr/sbin", "/sbin"]
    path = ":".join(dict.fromkeys(dirs))
    if sys.platform == "darwin":
        return PLIST, f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{AGENT}</string>
  <key>ProgramArguments</key><array><string>{bun}</string><string>{main}</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>{path}</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>{os.path.join(root, HERDR, "shepherdr", "service.log")}</string>
  <key>StandardErrorPath</key><string>{os.path.join(root, HERDR, "shepherdr", "service.log")}</string>
</dict>
</plist>
"""
    return UNIT, f"""[Unit]
Description=Shepherdr: background work and the web app
After=network-online.target

[Service]
ExecStart={bun} {main}
Environment=PATH={path}
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
"""


def install_service(r, rec, home):
    """Writes the unit; on the real home, (re)starts the service with it. A scratch root only gets the file."""
    bun = bun_path()
    if not bun:
        r.notes.append("the Shepherdr service needs bun (https://bun.sh): install it, then run this again")
        return
    if not os.path.isfile(r.p(f"{SHARE}/web/dist/index.html")) and not r.dry:
        r.notes.append("the web app isn't built, so the service serves no page yet (./install.sh builds it)")
    rel, text = unit_text(r.root, bun)
    data = text.encode()
    if read(r.p(rel)) != data:
        if r.dry:
            say(f"  unit    {rel}")
            return
        atomic_write(r.p(rel), data)
    rec.setdefault("files", {})[rel] = fsha(rel, data)
    if not home or r.dry:
        return
    if sys.platform == "darwin":
        target = f"gui/{os.getuid()}"
        subprocess.run(["launchctl", "bootout", f"{target}/{AGENT}"], capture_output=True)
        # bootout returns before the old one is gone, and bootstrap refuses until it is: wait, then try a few times
        for _ in range(20):
            if subprocess.run(["launchctl", "print", f"{target}/{AGENT}"], capture_output=True).returncode != 0:
                break
            time.sleep(0.5)
        ok = False
        for _ in range(4):
            ok = subprocess.run(["launchctl", "bootstrap", target, r.p(rel)], capture_output=True).returncode == 0
            if ok:
                break
            time.sleep(1)
    else:
        subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
        ok = subprocess.run(["systemctl", "--user", "enable", "shepherdr.service"], capture_output=True).returncode == 0
        ok = ok and subprocess.run(["systemctl", "--user", "restart", "shepherdr.service"], capture_output=True).returncode == 0
    r.notes.append("the Shepherdr service is running" if ok else "couldn't start the Shepherdr service: `shepherdr doctor` says why")


# ---- the record ---------------------------------------------------------------------------------

def load_record(root):
    try:
        with open(os.path.join(root, RECORD)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def save_record(root, rec):
    atomic_write(os.path.join(root, RECORD), (json.dumps(rec, indent=2, sort_keys=True) + "\n").encode())


# ---- install ------------------------------------------------------------------------------------

class Run:
    def __init__(self, root, dry):
        self.root, self.dry = root, dry
        self.stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
        self.backup_dir = os.path.join(root, APP, ".shepherdr-backup", self.stamp)
        n = 1
        while os.path.exists(self.backup_dir):
            n += 1
            self.backup_dir = os.path.join(root, APP, ".shepherdr-backup", f"{self.stamp}-{n}")
        self.backed = False
        self.notes = []

    def p(self, rel):
        return os.path.join(self.root, rel)

    def backup(self, rel, move=False):
        """Keeps what is at rel (a file, link or folder) under this run's backup folder."""
        path = self.p(rel)
        if not os.path.lexists(path):
            return None
        dest = os.path.join(self.backup_dir, rel)
        if self.dry:
            return dest
        self.backed = True
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        if move:
            os.rename(path, dest)
        elif os.path.islink(path):
            os.symlink(os.readlink(path), dest)
        elif os.path.isdir(path):
            shutil.copytree(path, dest, symlinks=True)
        else:
            shutil.copy2(path, dest)
        return dest


def plan_files(r, rec, items, adopt):
    """For each source file: what to do. -> (actions, clashes). An action: (rel, how, data, mode)
    with how one of new, update, same, adopt, keep (the person's; .new beside it)."""
    files = (rec or {}).get("files", {})
    actions, clashes = [], []
    for group, rel, srcpath in items:
        data = read(srcpath)
        mode = os.stat(srcpath).st_mode & 0o777
        cur = read(r.p(rel))
        want = fsha(rel, data)
        have = fsha(rel, cur)
        if cur is None:
            how = "new"
        elif have == want:
            how = "same"
        elif rel in files and files[rel] == have:
            how = "update"
        elif rel in files or group == "template":
            how = "keep"
        elif adopt:
            how = "adopt"
        else:
            how = "clash"
            clashes.append(rel)
        actions.append((group, rel, how, data, mode))
    return actions, clashes


def apply_mod(r, mod, acts, rec, gone):
    """Puts one mod's changes in place in one swap. gone: recorded files no longer shipped."""
    target = r.p(f"{APP}/mods/{mod}")
    changes = [a for a in acts if a[2] in ("new", "update", "adopt", "keep")] + gone
    if not changes:
        return
    if r.dry:
        return
    stage_root = r.p(f"{APP}/.shepherdr-stage")
    os.makedirs(stage_root, exist_ok=True)
    stage = os.path.join(stage_root, mod)
    shutil.rmtree(stage, ignore_errors=True)
    exists = os.path.isdir(target)
    if exists:
        shutil.copytree(target, stage, symlinks=True)
    else:
        os.makedirs(stage)
    adopted = any(a[2] == "adopt" for a in acts)
    for group, rel, how, data, mode in acts:
        sub = os.path.relpath(rel, f"{APP}/mods/{mod}")
        dest = os.path.join(stage, sub)
        if how == "keep":
            atomic_write(dest + ".new", data, mode)
        elif how in ("new", "update", "adopt"):
            atomic_write(dest, data, mode)
    for rel in gone:
        sub = os.path.relpath(rel, f"{APP}/mods/{mod}")
        try:
            os.remove(os.path.join(stage, sub))
        except FileNotFoundError:
            pass
    if exists:
        if adopted:
            rec.setdefault("replaced", {}).setdefault(f"{APP}/mods/{mod}", r.backup(f"{APP}/mods/{mod}"))
        exchange(stage, target)
        shutil.rmtree(stage)
    else:
        # mod.json comes with main.js: the folder appears whole (mods/ made first on a fresh home).
        os.makedirs(os.path.dirname(target), exist_ok=True)
        os.rename(stage, target)


def merge_keys(r, src, rec, mode, yes):
    """Our keys into keys.json: free ones added, ours from before updated, one the person set
    asked about (or by --keys). One write. -> the record's keys."""
    ours = json.load(open(os.path.join(src, "keys.json")))
    path = r.p(f"{APP}/keys.json")
    text = read(path)
    try:
        have = json.loads(text) if text else {}
    except ValueError:
        raise Stop(f"{path} isn't valid JSON: fix it first, Herdr can't read it either")
    old = (rec or {}).get("keys", {})
    out = dict(old)
    changed = False
    asked = sys.stdin.isatty() and not yes and mode == "ask"
    for ctx, keys in ours.items():
        for key, value in keys.items():
            name = f"{ctx} {key}"
            cur = have.get(ctx, {}).get(key)
            if cur == value:
                out.setdefault(name, {"value": value, "was": None, "added": False})
                continue
            mine = name in old and cur == old[name]["value"]
            if cur is None or mine:
                take = True
            elif mode == "ours":
                take = True
            elif asked:
                ans = input(f"keys.json: {ctx} {key} is \"{cur}\". Replace it with Shepherdr's \"{value}\"? [y/N] ")
                take = ans.strip().lower() in ("y", "yes")
            else:
                take = False
            if not take:
                r.notes.append(f"kept your key {ctx} {key} = \"{cur}\" (Shepherdr's: \"{value}\"; --keys ours takes it)")
                continue
            was = old[name]["was"] if mine else cur
            out[name] = {"value": value, "was": was, "added": was is None}
            have.setdefault(ctx, {})[key] = value
            changed = True
    if changed and not r.dry:
        if text is not None:
            r.backup(f"{APP}/keys.json")
        atomic_write(path, (json.dumps(have, indent=2, ensure_ascii=False) + "\n").encode())
    return out, changed


def link_helpers(r, rec):
    app = r.p(APP)
    links = {}
    for name, target in LINKS.items():
        rel, dest = f"{BIN}/{name}", os.path.join(app, target)
        path = r.p(rel)
        links[name] = dest
        if os.path.islink(path) and os.path.realpath(path) == os.path.realpath(dest):
            continue
        if r.dry:
            say(f"  link {rel} -> {dest}")
            continue
        if os.path.lexists(path):
            r.backup(rel, move=True)
            (rec.setdefault("replaced", {})).setdefault(rel, os.path.join(r.backup_dir, rel))
        os.makedirs(os.path.dirname(path), exist_ok=True)
        os.symlink(dest, path)
    return links


def install_guard(r, src, rec):
    rel = f"{BIN}/herdr-app"
    path, data = r.p(rel), read(os.path.join(src, "guard", "herdr-app"))
    if read(path) == data:
        return
    real = os.path.join(r.root, ".local/share/herdr-app/herdr-app")
    if not os.path.exists(real):
        r.notes.append(f"--guard skipped: the real app isn't at {real} (the guard runs that one)")
        return
    if r.dry:
        say(f"  guard {rel}")
        return
    if os.path.lexists(path):
        r.backup(rel, move=True)
        rec.setdefault("replaced", {}).setdefault(rel, os.path.join(r.backup_dir, rel))
    atomic_write(path, data, 0o755)
    rec.setdefault("files", {})[rel] = fsha(rel, data)


def add_hooks(r, rec):
    app = r.p(APP)
    done = []
    by_file = {}
    for f, event, entry in HOOKS:
        by_file.setdefault(f, []).append((event, entry))
    for f, entries in by_file.items():
        path = r.p(f)
        if not os.path.isdir(os.path.dirname(path)):
            continue  # that CLI isn't installed here
        text = read(path)
        try:
            d = json.loads(text) if text else {}
        except ValueError:
            r.notes.append(f"hooks: {path} isn't valid JSON, left alone; add the hooks by hand (docs/install.md)")
            continue
        changed = False
        for event, entry in entries:
            entry = json.loads(json.dumps(entry).replace("{app}", app))
            cmd = entry["hooks"][0]["command"]
            script = cmd.split("/mods/chat/")[-1]
            lst = d.setdefault("hooks", {}).setdefault(event, [])
            if any(script in h.get("command", "") and "/mods/chat/" in h.get("command", "") for e in lst for h in e.get("hooks", [])):
                done.append([f, event, cmd])
                continue
            lst.append(entry)
            done.append([f, event, cmd])
            changed = True
        if changed and not r.dry:
            if text is not None:
                r.backup(f)
            else:
                rec.setdefault("created", []).append(f)
            atomic_write(path, (json.dumps(d, indent=2) + "\n").encode())
            if f.startswith(".codex"):
                r.notes.append("Codex asks once to trust its new hook: say yes in its Hooks screen")
    return done


def check_tools(root_is_home):
    """Herdr's versions (when it's here) and the programs Shepherdr needs. -> (problems, notes)."""
    bad, notes = [], []
    if sys.version_info < (3, 8):
        bad.append("python3 3.8 or newer")
    for name, want in (("herdr-app", HERDR_APP_MIN), ("hc", HC_MIN)):
        exe = shutil.which(name)
        if not exe:
            (bad if root_is_home else notes).append(f"{name} {want} or newer isn't on the PATH")
            continue
        try:
            out = subprocess.run([exe, "--version"], capture_output=True, text=True, timeout=20).stdout
        except (OSError, subprocess.SubprocessError):
            out = ""
        have = out.split()[-1] if out.split() else ""
        if version_tuple(have) < version_tuple(want):
            (bad if root_is_home else notes).append(f"{name} is {have or 'unknown'}: Shepherdr {VERSION} needs {want} or newer")
    for name in ("git",):
        if not shutil.which(name):
            bad.append(f"{name} isn't on the PATH")
    optional = {"gh": "pull requests (tasks)", "agent-browser": "the task browser (0.41.1)", "node": "the task browser",
                "bun": "voice calls and dictation", "pw-record": "dictation"}
    for name, what in optional.items():
        if not shutil.which(name):
            notes.append(f"optional: {name} isn't on the PATH ({what})")
    return bad, notes


def cmd_install(a, update=False):
    root = os.path.realpath(a.root or real_home())
    home = root == os.path.realpath(real_home())
    rec = load_record(root)
    if update and not rec:
        raise Stop(f"Shepherdr isn't installed under {root}: run install first")
    src = find_source(a.source, rec)
    r = Run(root, a.dry_run)
    bad, notes = check_tools(home)
    if bad and not a.force:
        raise Stop("can't install yet:\n  " + "\n  ".join(bad) + "\n(--force installs anyway)")
    if not os.path.isdir(r.p(APP)):
        if home:
            raise Stop(f"{r.p(APP)} isn't there: open Herdr once first, so it writes its home")
        r.notes.append(f"{r.p(APP)} didn't exist: made (a scratch root)")
    build_web(r, src, home, a)
    manifest, mods, items = source_items(src)
    actions, clashes = plan_files(r, rec, items, a.adopt)
    if clashes:
        shown = "\n  ".join(clashes[:40]) + (f"\n  ... and {len(clashes) - 40} more" if len(clashes) > 40 else "")
        raise Stop(f"these are someone else's (not installed by Shepherdr, and different):\n  {shown}\n"
                   "Nothing was changed. Rename your own mods, or run with --adopt to back these up and take them over.")
    old_files = (rec or {}).get("files", {})
    shipped = {x[1] for x in actions}
    gone = [rel for rel in old_files if rel.startswith(f"{APP}/") and rel not in shipped and not rel.startswith(f"{APP}/keys")
            and rel != f"{BIN}/herdr-app" and fsha(rel, read(r.p(rel))) == old_files[rel]]
    counts = {}
    for x in actions:
        counts[x[2]] = counts.get(x[2], 0) + 1
    say(f"Shepherdr {VERSION} {'update' if update else 'install'} from {src}")
    say(f"  into {root}{' (dry run: nothing is written)' if a.dry_run else ''}")
    say("  files: " + ", ".join(f"{n} {k}" for k, n in sorted(counts.items())) + (f", {len(gone)} removed" if gone else ""))
    touches_tools = any(x[2] in ("new", "update", "adopt") and (x[0] in ("template", "bin") or x[1].endswith(("/bin/herdr-task", "/bin/herdr-artifact"))
                                                                  or "/bin/herdr_task/" in x[1]) for x in actions)
    if a.dry_run:
        for g, rel, how, _, _ in actions:
            if how != "same":
                say(f"  {how:7} {rel}")
        for rel in gone:
            say(f"  remove  {rel}")
    # The sync to other machines waits until doctor finds this whole.
    if touches_tools and not a.dry_run:
        atomic_write(r.p(HOLD), f"held by shepherdr {VERSION} install at {r.stamp}: run `shepherdr doctor`\n".encode())
        r.notes.append("the sync to other machines is held until `shepherdr doctor` finds the install whole")
    rec = rec or {}
    files = dict(old_files)
    # Mods: one swap each.
    for m in mods:
        acts = [x for x in actions if x[0] == m]
        mg = [rel for rel in gone if rel.startswith(f"{APP}/mods/{m}/")]
        apply_mod(r, m, acts, rec, mg)
    # Everything else, file by file (none of it reloads a mod).
    for g, rel, how, data, mode in actions:
        if g in mods:
            continue
        if r.dry:
            continue
        if how == "adopt":
            rec.setdefault("replaced", {}).setdefault(rel, r.backup(rel))
        elif how == "update" and g == "template":
            r.backup(rel)
        if how == "keep":
            atomic_write(r.p(rel) + ".new", data, mode)
            r.notes.append(f"kept your {rel}; Shepherdr's is beside it as {os.path.basename(rel)}.new")
        elif how in ("new", "update", "adopt"):
            atomic_write(r.p(rel), data, mode)
    for rel in gone:
        if not rel.startswith(f"{APP}/mods/") and not r.dry:
            os.remove(r.p(rel))
    for g, rel, how, data, mode in actions:
        if how != "keep":
            files[rel] = fsha(rel, data)
    for rel in gone:
        files.pop(rel, None)
    rec["files"] = files
    rec["mods"] = {m: True for m in mods}
    rec["keys"], keys_changed = merge_keys(r, src, rec, a.keys, a.yes)
    rec["links"] = link_helpers(r, rec)
    install_service(r, rec, home)
    if a.guard:
        install_guard(r, src, rec)
    if not a.no_hooks:
        rec["hooks"] = add_hooks(r, rec)
    rec.update({"version": VERSION, "source": src, "at": r.stamp, "root": root})
    if a.dry_run:
        say("  keys.json: " + ("would change" if keys_changed else "nothing to add"))
    else:
        save_record(r.root, rec)
        shutil.rmtree(r.p(f"{APP}/.shepherdr-stage"), ignore_errors=True)
    for n in r.notes + notes:
        say(f"  - {n}")
    if not a.dry_run:
        if r.backed:
            say(f"  backup of what it replaced: {r.backup_dir}")
        say("  done. Next: `shepherdr doctor`" + ("" if home else f" --root {root}") + ", then pick the Shepherdr layout in Herdr (Ctrl+Shift+L).")
    return 0


# ---- web only ----------------------------------------------------------------------------------
# `install --web`: Shepherdr without the Herdr window. herdr-task, herdr-artifact, the helpers and the role
# instructions, the service and the web app, all under .local/share/shepherdr (the links in .local/bin lead there);
# what it installed is .local/share/shepherdr/installed.json. Agents' question cards come with the window's chat hooks,
# so a web-only install has none: an agent asks in its terminal, which the web app shows live.
WEB_RECORD = f"{SHARE}/installed.json"


def web_items(src):
    items = service_items(src)
    for f in sorted(os.listdir(os.path.join(src, "templates"))):
        if f.endswith(".md"):
            items.append(("template", f"{TPL}/{f}", os.path.join(src, "templates", f)))
    return items


def cmd_install_web(a, update=False):
    root = os.path.realpath(a.root or real_home())
    home = root == os.path.realpath(real_home())
    r = Run(root, a.dry_run)
    try:
        rec = json.load(open(r.p(WEB_RECORD)))
    except (OSError, ValueError):
        rec = {}
    if update:
        # from where it was installed (a checkout, or Serve from's copy), never from the installed folder itself
        if not rec:
            raise Stop(f"Shepherdr (web only) isn't installed under {root}: run ./install.sh --web first")
        if not a.source and not is_source(rec.get("source")):
            raise Stop(f"the Shepherdr it was installed from ({rec.get('source')}) is gone: clone it again and run "
                       "./install.sh --web there, or pass --source <checkout>")
        src = find_source(a.source or rec["source"], None)
    else:
        src = find_source(a.source, None)
    if not shutil.which("hc") and home and not a.force:
        raise Stop(f"herdr-core (hc {HC_MIN} or newer) isn't on the PATH: install it first (https://herdr.dev)")
    files = dict(rec.get("files", {}))
    say(f"Shepherdr {VERSION} web-only {'update' if update else 'install'} from {src}\n  into {root}{' (dry run: nothing is written)' if a.dry_run else ''}")
    build_web(r, src, home, a)
    n = 0
    for _g, rel, path in web_items(src):
        data, mode = read(path), os.stat(path).st_mode & 0o777
        if read(r.p(rel)) == data:
            files[rel] = fsha(rel, data)
            continue
        n += 1
        if r.dry:
            say(f"  write   {rel}")
            continue
        if os.path.exists(r.p(rel)) and rel not in files:
            r.backup(rel)
        atomic_write(r.p(rel), data, mode)
        files[rel] = fsha(rel, data)
    say(f"  files: {n} written")
    links = {}
    for name, target in LINKS.items():
        rel, dest = f"{BIN}/{name}", r.p(f"{SHARE}/{target}")
        links[name] = dest
        if os.path.islink(r.p(rel)) and os.path.realpath(r.p(rel)) == os.path.realpath(dest):
            continue
        if r.dry:
            say(f"  link {rel} -> {dest}")
            continue
        if os.path.lexists(r.p(rel)):
            r.backup(rel, move=True)
        os.makedirs(os.path.dirname(r.p(rel)), exist_ok=True)
        os.symlink(dest, r.p(rel))
    rec.update({"files": files, "links": links, "version": VERSION, "source": src, "at": r.stamp, "root": root, "web": True})
    # what this run replaced (an older herdr-task, the helpers…): uninstall puts it back
    if r.backed:
        rec["backups"] = [*rec.get("backups", []), r.backup_dir]
    install_service(r, rec, home)
    if not a.dry_run:
        atomic_write(r.p(WEB_RECORD), (json.dumps(rec, indent=2, sort_keys=True) + "\n").encode())
    for x in r.notes:
        say(f"  - {x}")
    say("  done." + (" Open the link the service prints (journalctl --user -u shepherdr) or ~/.herdr/shepherdr/web.json." if not a.dry_run else ""))
    return 0


def cmd_uninstall_web(a, root):
    r = Run(root, a.dry_run)
    rec = json.load(open(r.p(WEB_RECORD)))
    if root == os.path.realpath(real_home()) and not a.dry_run:
        if sys.platform == "darwin":
            subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}/{AGENT}"], capture_output=True)
        else:
            subprocess.run(["systemctl", "--user", "disable", "--now", "shepherdr.service"], capture_output=True)
    for name, dest in rec.get("links", {}).items():
        p = r.p(f"{BIN}/{name}")
        if os.path.islink(p) and os.path.realpath(p) == os.path.realpath(dest) and not a.dry_run:
            os.remove(p)
    for rel, sha in rec.get("files", {}).items():
        if fsha(rel, read(r.p(rel))) == sha and not a.dry_run:
            os.remove(r.p(rel))
    # what the installs replaced, back where it was (the oldest copy of each)
    for b in reversed(rec.get("backups", [])) if not a.dry_run else []:
        for rel in walk_files(b) + [os.path.relpath(os.path.join(d, x), b) for d, ds, _ in os.walk(b) for x in ds if os.path.islink(os.path.join(d, x))]:
            src, dest = os.path.join(b, rel), r.p(rel)
            if os.path.lexists(dest) and not os.path.islink(dest) and rel.startswith(SHARE):
                continue
            if os.path.lexists(dest):
                os.remove(dest)
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            os.rename(src, dest)
            say(f"  put back {rel}")
    if root == os.path.realpath(real_home()) and not a.dry_run:
        restore_share(root)
    if not a.dry_run:
        os.remove(r.p(WEB_RECORD))
        for d, _, _ in sorted(os.walk(r.p(SHARE)), reverse=True):
            try:
                os.rmdir(d)
            except OSError:
                pass
    say(f"Shepherdr (web only) uninstalled from {root}{' (dry run)' if a.dry_run else ''}. ~/.herdr stays.")
    return 0


# ---- doctor -------------------------------------------------------------------------------------

def serve_check(root):
    """Serve from: which machine serves the web app (what the service last wrote, web.json), and /shepherdr shared here
    only while this machine serves it. Returns (bad, notes)."""
    try:
        w = json.load(open(os.path.join(root, HERDR, "shepherdr", "web.json")))
    except (OSError, ValueError):
        return [], ["the service hasn't said where the web app is served yet (~/.herdr/shepherdr/web.json)"]
    sv = w.get("serve") or {}
    host = sv.get("host")
    notes = [f"web app: served from {host or 'this machine'}" + (f", {w['link']}" if w.get("link") else "")]
    bad = []
    if sv.get("error"):
        bad.append(f"the last move didn't finish: {sv['error']}")
    if w.get("why"):
        notes.append(f"web app: {w['why']}")
    if host and not sv.get("reachable"):
        notes.append(f"{host} can't be reached now: this machine keeps its own copy of the shared data until it's back")
    tailscale = shutil.which("tailscale")
    if host and tailscale:
        p = subprocess.run([tailscale, "serve", "status", "--json"], capture_output=True, text=True)
        try:
            for web in (json.loads(p.stdout or "{}").get("Web") or {}).values():
                if ((web.get("Handlers") or {}).get("/shepherdr") or {}).get("Proxy", "").endswith(":7788"):
                    bad.append(f"/shepherdr is still shared from here while {host} serves it: two links")
        except ValueError:
            pass
    return bad, notes


def update_hint(rec):
    """How this install updates: from the checkout it came from, or (Serve from) from the machine that sent it."""
    src = rec.get("source") or ""
    if os.path.basename(src) == "shepherdr-src":
        return "to update: from the machine that installed it here, `shepherdr web install-on <this machine>`"
    if not is_source(src):
        return f"to update: the Shepherdr it was installed from ({src}) is gone: clone it again and run ./install.sh" + (" --web" if rec.get("web") else "") + " there"
    pull = f"`git -C {src} pull --ff-only`, then " if os.path.exists(os.path.join(src, ".git")) else ""
    return f"to update: {pull}`shepherdr update`" + (" (web only)" if rec.get("web") else "")


def cmd_doctor(a):
    root = os.path.realpath(a.root or real_home())
    home = root == os.path.realpath(real_home())
    rec = load_record(root)
    if not rec and os.path.isfile(os.path.join(root, WEB_RECORD)):
        # web only: its files and links, and where the web app is served from
        rec = json.load(open(os.path.join(root, WEB_RECORD)))
        r = Run(root, True)
        bad = [f"missing: {rel}" for rel in sorted(rec.get("files", {})) if read(r.p(rel)) is None]
        bad += [f"link {BIN}/{n} doesn't lead to {d}" for n, d in rec.get("links", {}).items()
                if not os.path.islink(r.p(f"{BIN}/{n}")) or os.path.realpath(r.p(f"{BIN}/{n}")) != os.path.realpath(d)]
        s_bad, s_notes = serve_check(root) if home else ([], [])
        say(f"Shepherdr {rec.get('version')} (web only) under {root} (from {rec.get('source')}, {rec.get('at')})")
        for x in bad + s_bad:
            say(f"  ✗ {x}")
        for x in s_notes + [update_hint(rec)]:
            say(f"  - {x}")
        if not bad + s_bad:
            say("  ✓ whole")
        return 1 if bad + s_bad else 0
    if not rec:
        raise Stop(f"Shepherdr isn't installed under {root}")
    r = Run(root, True)
    bad, warn = [], []
    for rel, sha in sorted(rec.get("files", {}).items()):
        have = read(r.p(rel))
        if have is None:
            bad.append(f"missing: {rel}")
        elif fsha(rel, have) != sha:
            warn.append(f"changed since install (kept): {rel}")
    for name, dest in rec.get("links", {}).items():
        path = r.p(f"{BIN}/{name}")
        if not os.path.islink(path) or os.path.realpath(path) != os.path.realpath(dest):
            bad.append(f"link {BIN}/{name} doesn't lead to {dest}")
    sync = r.p(f"{APP}/bin/sync-shared")
    if os.path.isfile(sync):
        p = subprocess.run([sys.executable, sync, "--check"], capture_output=True, text=True)
        if p.returncode != 0:
            bad.append("shared lib copies differ: " + (p.stderr.strip() or p.stdout.strip()).replace("\n", "; "))
    pkg = r.p(f"{APP}/mods/tasks/bin/herdr_task")
    for f in sorted(os.listdir(pkg)) if os.path.isdir(pkg) else []:
        if f.endswith(".py"):
            try:
                compile(read(os.path.join(pkg, f)), os.path.join(pkg, f), "exec")
            except SyntaxError as e:
                bad.append(f"herdr-task doesn't compile: {e}")
    for rel in ("layouts/shepherdr.json", "keys.json"):
        try:
            json.load(open(r.p(f"{APP}/{rel}")))
        except (OSError, ValueError) as e:
            bad.append(f"{APP}/{rel}: {e}")
    for f, event, cmd in rec.get("hooks", []):
        if cmd not in (read(r.p(f)) or b"").decode(errors="replace").replace("\\'", "'"):
            warn.append(f"hook missing in {f} ({event}): questions from that CLI won't reach the chat")
    t_bad, t_notes = check_tools(home)
    bad += t_bad
    if home:
        s_bad, s_notes = serve_check(root)
        bad += s_bad
        t_notes += s_notes
    say(f"Shepherdr {rec.get('version')} under {root} (from {rec.get('source')}, {rec.get('at')})")
    for x in bad:
        say(f"  ✗ {x}")
    for x in warn + t_notes + [update_hint(rec)]:
        say(f"  - {x}")
    hold = r.p(HOLD)
    if bad:
        if os.path.exists(hold):
            say("  the sync to other machines stays held until these are fixed")
        return 1
    if os.path.exists(hold):
        os.remove(hold)
        say("  ✓ whole: the sync to other machines may go again")
    else:
        say("  ✓ whole")
    return 0


# ---- uninstall ----------------------------------------------------------------------------------

def cmd_uninstall(a):
    root = os.path.realpath(a.root or real_home())
    rec = load_record(root)
    if not rec and os.path.isfile(os.path.join(root, WEB_RECORD)):
        return cmd_uninstall_web(a, root)
    if not rec:
        raise Stop(f"Shepherdr isn't installed under {root}")
    r = Run(root, a.dry_run)
    kept = []
    files = rec.get("files", {})
    # The service stops first (only the real home's runs).
    if root == os.path.realpath(real_home()) and not a.dry_run and (UNIT in files or PLIST in files):
        if sys.platform == "darwin":
            subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}/{AGENT}"], capture_output=True)
        else:
            subprocess.run(["systemctl", "--user", "disable", "--now", "shepherdr.service"], capture_output=True)
    # Mods: a folder holding only our unchanged files (and Herdr's generated ones) goes in one step.
    for m in rec.get("mods", {}):
        top = r.p(f"{APP}/mods/{m}")
        if not os.path.isdir(top):
            continue
        mine = {rel for rel in files if rel.startswith(f"{APP}/mods/{m}/")}
        changed = [rel for rel in mine if fsha(rel, read(r.p(rel))) not in (None, files[rel])]
        extra = [f for f in walk_files(top) if f"{APP}/mods/{m}/{f}" not in mine and not f.endswith(".new")]
        if changed or extra:
            kept.append(f"{APP}/mods/{m} (yours too: {', '.join(sorted(changed + extra)[:4])})")
            continue
        if not a.dry_run:
            r.backup(f"{APP}/mods/{m}", move=True)
    for rel, sha in files.items():
        if rel.startswith(f"{APP}/mods/") or rel == f"{BIN}/herdr-app":
            continue
        path = r.p(rel)
        if fsha(rel, read(path)) == sha and not a.dry_run:
            r.backup(rel, move=True)
        elif read(path) is not None and fsha(rel, read(path)) != sha:
            kept.append(rel)
    # Keys: ours removed, the person's from before put back.
    path = r.p(f"{APP}/keys.json")
    try:
        have = json.loads(read(path) or b"{}")
    except ValueError:
        have = None
    if have is not None:
        for name, k in rec.get("keys", {}).items():
            ctx, key = name.split(" ", 1)
            if have.get(ctx, {}).get(key) != k["value"] or not (k.get("added") or k.get("was")):
                continue
            if k.get("was") is None:
                have[ctx].pop(key, None)
                if not have[ctx]:
                    del have[ctx]
            else:
                have[ctx][key] = k["was"]
        if not a.dry_run:
            r.backup(f"{APP}/keys.json")
            atomic_write(path, (json.dumps(have, indent=2, ensure_ascii=False) + "\n").encode())
    # Links and the guard: ours removed, anything they replaced put back.
    for name, dest in rec.get("links", {}).items():
        p = r.p(f"{BIN}/{name}")
        if os.path.islink(p) and os.path.realpath(p) == os.path.realpath(dest) and not a.dry_run:
            os.remove(p)
    g = r.p(f"{BIN}/herdr-app")
    if f"{BIN}/herdr-app" in files and fsha("", read(g)) == files[f"{BIN}/herdr-app"] and not a.dry_run:
        os.remove(g)
    for rel, saved in rec.get("replaced", {}).items():
        if os.path.lexists(saved) and not os.path.lexists(r.p(rel)) and not a.dry_run:
            os.makedirs(os.path.dirname(r.p(rel)), exist_ok=True)
            os.rename(saved, r.p(rel))
    # Hooks: our entries out.
    for f in {h[0] for h in rec.get("hooks", [])}:
        p = r.p(f)
        try:
            d = json.loads(read(p) or b"{}")
        except ValueError:
            continue
        for event, lst in list(d.get("hooks", {}).items()):
            d["hooks"][event] = [e for e in lst if not any(f"{r.p(APP)}/mods/chat/" in h.get("command", "") for h in e.get("hooks", []))]
            if not d["hooks"][event]:
                del d["hooks"][event]
        if d.get("hooks") == {}:
            del d["hooks"]
        if not a.dry_run:
            r.backup(f)
            if not d and f in rec.get("created", []):
                os.remove(p)
            else:
                atomic_write(p, (json.dumps(d, indent=2) + "\n").encode())
    if not a.dry_run:
        try:
            os.remove(r.p(HOLD))
        except FileNotFoundError:
            pass
        os.remove(r.p(RECORD))
        # Folders that only held ours.
        for rel in (f"{APP}/data/shepherdr", f"{APP}/bin", f"{APP}/lib", f"{APP}/core", SHARE):
            for d, _, _ in sorted(os.walk(r.p(rel)), reverse=True):
                try:
                    os.rmdir(d)
                except OSError:
                    pass
    say(f"Shepherdr uninstalled from {root}{' (dry run)' if a.dry_run else ''}. Your data/, ~/.herdr and your own changes stay.")
    for k in kept:
        say(f"  kept (changed or yours): {k}")
    if r.backed:
        say(f"  everything removed is in {r.backup_dir}")
    say("  In Herdr, switch to another layout (Ctrl+Shift+L) if Shepherdr's was showing.")
    return 0


# ---- web: Serve from --------------------------------------------------------------------------------

def restore_share(root):
    """/shepherdr as it was before a move here took it (serve-from --take-link kept it in replaced-share.json)."""
    f = os.path.join(root, HERDR, "shepherdr", "replaced-share.json")
    try:
        old = json.load(open(f))
    except (OSError, ValueError):
        return
    tailscale = shutil.which("tailscale")
    if not tailscale or not str(old.get("port", "")).isdigit() or not str(old.get("proxy", "")).startswith("http://127.0.0.1:"):
        return
    subprocess.run([tailscale, "serve", f"--https={old['port']}", "--set-path", "/shepherdr", "off"], capture_output=True)
    if subprocess.run([tailscale, "serve", "--bg", f"--https={old['port']}", "--set-path", "/shepherdr", old["proxy"]], capture_output=True).returncode == 0:
        os.remove(f)
        say(f"  /shepherdr is shared to {old['proxy']} again, as before")


def web_source():
    """A whole source for a web-only install: this machine's installed service folder (every 3.1.1 install keeps one),
    else the checkout."""
    share = os.path.join(real_home(), SHARE)
    if os.path.isfile(os.path.join(share, "install.sh")) and os.path.isfile(os.path.join(share, "web", "dist", "index.html")):
        return share
    src = find_source(None, load_record(real_home()) or None)
    if not os.path.isfile(os.path.join(src, "web", "dist", "index.html")):
        raise Stop(f"the web app isn't built in {src} (bun install && bun run build)")
    return src


def pack(src):
    """The web-only install as one .tar.gz, laid out as its source (what service_items installs, by its own names)."""
    import io
    import tarfile
    buf = io.BytesIO()
    seen = set()
    with tarfile.open(fileobj=buf, mode="w:gz") as t:
        for _g, rel, path in web_items(src):
            name = rel[len(SHARE) + 1:] if rel.startswith(SHARE + "/") else os.path.relpath(path, src)
            if name in seen or not os.path.isfile(path):
                continue
            seen.add(name)
            t.add(path, arcname=name, recursive=False)
    return buf.getvalue()


# On the other machine (hc exec has a bare PATH there): Bun when missing (its own installer, into ~/.bun), the pack
# unpacked as a source beside the service, then its own installer, web only.
INSTALL_THERE = r"""set -e
export PATH="$HOME/.local/bin:$HOME/.bun/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
command -v python3 >/dev/null || { echo "python3 isn't installed there" >&2; exit 3; }
command -v hc >/dev/null || { echo "herdr-core (hc) isn't installed there" >&2; exit 3; }
if [ -f "$HOME/.config/herdr-app/data/shepherdr/installed.json" ]; then
  echo "Shepherdr's whole layout is installed there: update it there (./install.sh), then move again" >&2; exit 5; fi
if ! command -v bun >/dev/null; then
  echo "installing Bun (bun.sh) there"
  curl -fsSL https://bun.sh/install | bash >/dev/null 2>&1 || { echo "couldn't install Bun there (https://bun.sh)" >&2; exit 4; }
fi
d="$HOME/.local/share/shepherdr-src"
rm -rf "$d.new"; mkdir -p "$d.new"; tar xzf - -C "$d.new"
rm -rf "$d"; mv "$d.new" "$d"
python3 "$d/bin/shepherdr" install --web --yes --source "$d"
"""


def cmd_web_install_on(a):
    """Installs (or updates) the web-only part on a machine linked over herdr-core; here: on this machine."""
    if a.machine in ("here", None):
        if load_record(real_home()) or os.path.isfile(os.path.join(real_home(), WEB_RECORD)):
            say("Shepherdr's service is installed here.")
            return 0
        a.source, a.root, a.dry_run, a.force = web_source(), None, False, False
        return cmd_install_web(a)
    src = web_source()
    body = pack(src)
    say(f"  sending Shepherdr {VERSION} ({len(body) // 1024} KB) to {a.machine}")
    r = subprocess.run(["hc", "exec", "--on", a.machine, "--stdin", "--timeout", "600", "--", "sh", "-c", INSTALL_THERE],
                       input=body, capture_output=True)
    for line in r.stdout.decode(errors="replace").splitlines():
        say(f"  {a.machine}: {line}")
    if r.returncode != 0:
        raise Stop((r.stderr.decode(errors="replace").strip().splitlines() or [f"the install on {a.machine} failed"])[-1])
    return 0


def cmd_web(a):
    if a.action == "install-on":
        return cmd_web_install_on(a)
    if a.action in ("serve-from", "status"):
        if a.action == "serve-from" and not a.machine:
            raise Stop("which machine? shepherdr web serve-from <machine|here> (hc machine ls lists them)")
        bun = bun_path()
        script = next((p for p in (os.path.join(real_home(), SHARE, "service", "serve-from.ts"),
                                   os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "service", "serve-from.ts"))
                       if os.path.isfile(p)), None)
        if not bun or not script:
            raise Stop("Shepherdr's service isn't installed here (it needs Bun): ./install.sh first")
        argv = [bun, script, a.action] + ([a.machine] if a.machine else []) + (["--take-link"] if a.take_link else []) + (["--json"] if a.json else [])
        env = {**os.environ, "SHEPHERDR_CLI": os.path.realpath(__file__)}
        return subprocess.run(argv, env=env).returncode
    raise Stop("shepherdr web serve-from <machine|here> [--take-link] | shepherdr web status")


def cmd_secrets(a):
    if a.action == "move-to" and not (a.machine or a.to_id):
        raise Stop("which machine? shepherdr secrets move-to <machine|here> (hc machine ls lists them)")
    bun = bun_path()
    script = next((p for p in (os.path.join(real_home(), SHARE, "service", "secrets-move.ts"),
                               os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "service", "secrets-move.ts"))
                   if os.path.isfile(p)), None)
    if not bun or not script:
        raise Stop("Shepherdr's service isn't installed here (it needs Bun): ./install.sh first")
    argv = [bun, script, a.action] + ([a.machine] if a.machine else []) + (["--to-id", a.to_id] if a.to_id else []) \
        + (["--restore"] if a.restore else []) + (["--json"] if a.json else [])
    return subprocess.run(argv).returncode


def hand_over(a, argv):
    """`shepherdr update` runs the installed copy, which a pull doesn't change: installing with it wrote the old version
    (and its old steps), so it took a second run to say the new one. When the source's own installer is another, it
    does the install instead, told where its source is."""
    if os.environ.get("SHEPHERDR_HANDED_OVER"):
        return
    root = os.path.realpath(a.root or real_home())
    rec = load_record(root)
    if a.web or (a.cmd == "update" and not rec):
        try:
            web = json.load(open(os.path.join(root, WEB_RECORD)))
        except (OSError, ValueError):
            web = {}
        given = a.source or web.get("source")
    else:
        given = a.source
    try:
        src = find_source(given, rec) if given or rec else None
    except Stop:
        return
    me, new = os.path.realpath(__file__), os.path.join(src or "", "bin", "shepherdr")
    if not src or not os.path.isfile(new) or os.path.realpath(new) == me or read(new) == read(me):
        return
    say(f"(the installer in {src} runs it: it's the newer one)")
    sys.stdout.flush()
    sys.stderr.flush()
    os.execve(sys.executable, [sys.executable, new, *argv, *([] if a.source else ["--source", src])],
              dict(os.environ, SHEPHERDR_HANDED_OVER="1"))


def main(argv):
    ap = argparse.ArgumentParser(prog="shepherdr", description="Install, update, check or remove Shepherdr in Herdr.")
    sub = ap.add_subparsers(dest="cmd")
    for name in ("install", "update", "uninstall", "doctor"):
        c = sub.add_parser(name)
        c.add_argument("--root", help="install under this folder instead of your home (a scratch try: it mirrors "
                                      ".config/herdr-app, .local/bin and .config/herdr-core/templates)")
        c.add_argument("--source", help="the Shepherdr checkout to install from (default: this script's, else the last one)")
        if name in ("install", "update", "uninstall"):
            c.add_argument("--dry-run", action="store_true", help="say what would change, change nothing")
        if name in ("install", "update"):
            c.add_argument("--adopt", action="store_true", help="files by these names that aren't Shepherdr's: back them up and take them over")
            c.add_argument("--guard", action="store_true", help="also put the herdr-app guard on the PATH (refuses a window with another home)")
            c.add_argument("--keys", choices=["ask", "keep", "ours"], default="ask", help="a key you already use: ask (default; keep without a terminal), keep yours, or take ours")
            c.add_argument("--no-hooks", action="store_true", help="leave Claude Code's and Codex's settings alone")
            c.add_argument("--yes", action="store_true", help="ask nothing (keys: keep yours unless --keys ours)")
            c.add_argument("--force", action="store_true", help="install although a check failed")
            c.add_argument("--web", action="store_true", help="web only: no herdr-app (the service, the web app, herdr-task and the helpers)")
            c.add_argument("--no-build", action="store_true", help="install the web app as it is in the checkout: no build, even when it's missing or old")
    w = sub.add_parser("web", help="where the web app is served from (Serve from)")
    w.add_argument("action", choices=["serve-from", "status", "install-on"])
    w.add_argument("machine", nargs="?", help="a machine linked over herdr-core (hc machine ls), or here")
    w.add_argument("--take-link", action="store_true", help="that machine's /shepherdr is shared to something else: set it aside (moving away puts it back)")
    w.add_argument("--json", action="store_true")
    s = sub.add_parser("secrets", help="which machine keeps the secrets (Settings › Secrets › Kept on)")
    s.add_argument("action", choices=["move-to", "where"])
    s.add_argument("machine", nargs="?", help="a machine linked over herdr-core (hc machine ls), or here")
    s.add_argument("--restore", action="store_true", help="here: take this machine's backup back (the other one is gone for good)")
    s.add_argument("--to-id", help=argparse.SUPPRESS)
    s.add_argument("--json", action="store_true")
    sub.add_parser("version")
    a = ap.parse_args(argv)
    try:
        if a.cmd in ("install", "update"):
            hand_over(a, argv)
        if a.cmd == "install":
            return cmd_install_web(a) if a.web else cmd_install(a)
        if a.cmd == "update":
            # the kind the install record says: the whole layout, or web only (./install.sh --web)
            root = os.path.realpath(a.root or real_home())
            web = a.web or (not load_record(root) and os.path.isfile(os.path.join(root, WEB_RECORD)))
            return cmd_install_web(a, update=True) if web else cmd_install(a, update=True)
        if a.cmd == "uninstall":
            return cmd_uninstall(a)
        if a.cmd == "doctor":
            return cmd_doctor(a)
        if a.cmd == "web":
            return cmd_web(a)
        if a.cmd == "secrets":
            return cmd_secrets(a)
        if a.cmd == "version":
            say(f"shepherdr {VERSION}")
            return 0
        ap.print_help()
        return 2
    except Stop as e:
        print(f"shepherdr: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

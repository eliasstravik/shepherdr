#!/bin/sh
# The shepherdr command: agents (and you) talk to the Shepherdr server on this machine.
here=$(cd "$(dirname "$0")/.." && pwd)
# Lifecycle verbs belong to the standalone application. `status TASK ...` keeps the familiar agent command.
case "$1" in
  start|stop) exec bun "$here/server/core/launcher.ts" "$@" ;;
  status)
    case "$2" in
      ""|--home|--home=*|--port|--port=*|--core-*) exec bun "$here/server/core/launcher.ts" "$@" ;;
    esac
    ;;
esac
if [ -n "$SHEPHERDR_CORE_CREDENTIAL" ] || [ "$SHEPHERDR_BACKEND" = core ]; then
  [ "$1" = agent ] && shift
  exec bun "$here/helper/core-cli.ts" "$@"
fi
case "$1:$2" in
  secret:set|secret:rm|secret:remove) exec bun "$here/helper/core-operator.ts" "$@" ;;
esac
case "$1" in
  help|--help|"")
    printf '%s\n' 'shepherdr start | stop | status [--home PATH]' 'shepherdr secret set NAME [--machine | --space NAME] < file' 'shepherdr secret rm NAME [--machine | --space NAME]' 'Agent commands use the owning launch-provisioned helper and core mailbox.'
    exit 0 ;;
esac
printf '%s\n' 'This standalone command has no legacy HTTP routing. Use the owning authenticated agent helper, or open the app. Use hc for core terminals and agents.' >&2
exit 1

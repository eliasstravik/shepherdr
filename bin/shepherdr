#!/usr/bin/env python3
"""Shepherdr's installer: the service, the web app and the helpers, under Shepherdr's own folder.

  shepherdr install    [--root DIR] [--no-hooks] [--adopt] [--dry-run] [--yes] [--force]
                       [--port N]: the service's port on 127.0.0.1 when another app holds 7788 (updates keep it)
                       [--https-port N]: the tailnet HTTPS port the web app is shared on, when something else holds 443
                       (--web is still accepted: since 3.2 every install is that one)
  shepherdr update     the same, from the checkout it was installed from (git pull it first)
  (a fresh clone has no web app built: install and update build it with Bun, installing Bun first when it's missing)
  shepherdr web serve-from <machine|here> [--take-link]   serve the web app from another machine linked over
                                        herdr-core (an always-on Mac mini or cloud VM), installing it there; here: back
  shepherdr web status                  which machine serves it, and its link
  shepherdr web install-on <machine|here> [--force]   install or update Shepherdr on a machine linked over herdr-core
  shepherdr web https-port [N]          the tailnet HTTPS port this machine shares the web app on (default 443): another
                                        one when something else here holds 443; no N: the one now
  shepherdr secrets move-to <machine|here> [--restore]   the machine that keeps the secrets (the vault agents use by
                                        name): moves them there, with a backup on both; --restore: the old one takes its
                                        backup back when the other is gone for good
  shepherdr secrets where               which machine keeps them
  shepherdr uninstall  [--root DIR] [--dry-run]
  shepherdr doctor     [--root DIR]: checks the install; once it's whole, lets the sync to other machines go
  shepherdr window     [--remove] [--root DIR]: the Herdr window's notices where 3.1's Shepherdr views were (each says
                       Shepherdr lives in the web app); --remove takes them out, and updates don't put them back
  shepherdr version

What goes where (each under --root, default your home):
  .local/share/shepherdr/               everything Shepherdr runs: the service (service/, core/, web/shared), the built
                                        web app (web/dist), herdr-task (mods/tasks/bin), herdr-artifact
                                        (mods/artifacts/bin), the helpers and this installer (bin/), the agents' hooks
                                        (hooks/), the role instructions (templates/), the Herdr button (herdr/)
  .local/share/shepherdr/installed.json what it installed (a sha256 per file), so running it again changes only what changed
  .local/bin/{herdr-task,herdr-artifact,herdr-secret,herdr-browser,herdr-desktop,shepherdr}   links into that folder
  .config/herdr-core/templates/*.md     the Assistant's, worker's and reviewer's instructions
  .config/systemd/user/shepherdr.service    Linux: keeps the service running (systemctl --user)
  Library/LaunchAgents/dev.shepherdr.service.plist   macOS: the same with launchd
  ~/.claude/settings.json, ~/.codex/hooks.json   the question-card hooks (not with --no-hooks)
  .config/herdr-app/mods/open-shepherdr, and one key in .config/herdr-app/keys.json (Ctrl+Shift+O, only when it's
                                        free): the "Open Shepherdr" button, only when the Herdr app is on this machine

Shepherdr's own folder is replaced whole on update. Never overwritten: a role instruction you changed (the new one
goes beside it as <file>.new), a key you set, a file by the button's name that isn't ours (--adopt takes it over).
What it replaces of yours goes to .local/share/shepherdr/.shepherdr-backup/<time>/ first. While it replaces a helper
or template, a sync hold (sync-hold in Shepherdr's state folder, and .herdr/sync-hold for older helpers) keeps
herdr-task from sending them to other machines until `shepherdr doctor` finds the install whole.

From 3.1 (the Herdr-window layout and its mods): one switch. The update waits while tasks are working (it says which;
--force switches anyway), then takes out what 3.1 put in the Herdr app (its mods, layout, lib/, core/, bin/, keys and
hooks; a file you changed is backed up first), leaves your data alone and converts old artifacts to pages once.
A window that ran 3.1's views gets a notice in each one's place (herdr/window-notice: Shepherdr lives in the web app),
also on a later update of a machine 3.2.0-3.2.2 switched; `shepherdr window --remove` takes them out.

Shepherdr's own data (tasks, artifacts, settings, secrets, browsers, the service's files) lives in its
own folders: ~/.config/shepherdr, ~/.local/share/shepherdr, ~/.local/state/shepherdr, ~/.cache/shepherdr
(SHEPHERDR_HOME or XDG_* move them). install and update move it there from ~/.herdr once, leaving links at
the old paths (mods/tasks/bin/herdr_task/layout.py):
  shepherdr where                     every path in use, and the move's state
  shepherdr migrate [--dry-run]       the move now (install, update and herdr-task do it by themselves)
  shepherdr migrate --rollback        everything back to ~/.herdr (for an older Shepherdr); `migrate` moves again
  shepherdr migrate --cleanup-legacy  remove the old paths' links, once no machine runs an older Shepherdr
"""

import argparse
import datetime
import hashlib
import json
import os
import pwd
import re
import shutil
import subprocess
import sys
import tempfile
import time

VERSION = "3.2.18"
HC_MIN = "0.1.17"

APP, BIN, TPL, HERDR = ".config/herdr-app", ".local/bin", ".config/herdr-core/templates", ".herdr"
SHARE = ".local/share/shepherdr"   # everything Shepherdr runs: the service, the web app, the helpers
UNIT = ".config/systemd/user/shepherdr.service"
PLIST = "Library/LaunchAgents/dev.shepherdr.service.plist"
AGENT = "dev.shepherdr.service"
RECORD = f"{SHARE}/installed.json"
# Where 3.1 and older (the Herdr-window install) kept theirs: found there, the install is switched over once
OLD_RECORD = f"{APP}/data/shepherdr/installed.json"
HOLD = f"{HERDR}/sync-hold"          # older helpers look here; this version's look in the state folder too


def layout_mod():
    """herdr_task/layout.py beside this script (a checkout, the app's copy, or a web-only install's)."""
    here = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    p = os.path.join(here, "mods", "tasks", "bin")
    if p not in sys.path:
        sys.path.insert(0, p)
    sys.dont_write_bytecode = True
    from herdr_task import layout
    return layout


def where_for(root):
    """The layout paths for an install root: the real home honours SHEPHERDR_HOME and XDG_*, a scratch
    root (--root) never does (it would reach the real folders)."""
    real = os.path.realpath(root) == os.path.realpath(real_home())
    return layout_mod().Where(home=root, env=None if real else {})


def tpl_rel(root=None):
    """Where the role templates go under an install root (#1182): herdr-core reads $XDG_CONFIG_HOME/herdr-core/templates,
    so the real home follows an absolute XDG_CONFIG_HOME; a scratch root (--root) never does."""
    xdg = os.environ.get("XDG_CONFIG_HOME") or ""
    if root is None or not xdg.startswith("/") or os.path.realpath(root) != os.path.realpath(real_home()):
        return TPL
    return os.path.relpath(os.path.join(xdg, "herdr-core", "templates"), root)


def env_for(root):
    """What decides the folders, as the service must see it too (a user service has none of the shell's)."""
    if os.path.realpath(root) != os.path.realpath(real_home()):
        return {}
    return {k: v for k, v in os.environ.items() if k in ("SHEPHERDR_HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME") and v.startswith("/")}


# Shepherdr's own herdr-core session (service/session.ts, herdr-task's base.SESSION): the service's unit names it, so
# every hc and agent the service starts lands there, never in herdr-core's default session (the Herdr app's).
SESSION = "shepherdr"


def service_session(root):
    """The herdr-core session the service runs in: SHEPHERDR_SESSION as the installer saw it on the real home (empty:
    herdr-core's default one), else Shepherdr's own."""
    s = os.environ.get("SHEPHERDR_SESSION") if os.path.realpath(root) == os.path.realpath(real_home()) else None
    return SESSION if s is None else s


def session_env(root):
    """The unit's lines for that session: HC_SESSION for every hc the service and its children run (a user service
    has none of the shell's), and SHEPHERDR_SESSION when it isn't Shepherdr's own."""
    s = service_session(root)
    if not s:
        return {"SHEPHERDR_SESSION": ""}
    return {"HC_SESSION": s, **({} if s == SESSION else {"SHEPHERDR_SESSION": s})}


def unit_session_problem(root):
    """doctor's words when the service's unit doesn't put the service in Shepherdr's session, else None."""
    path = os.path.join(root, PLIST if sys.platform == "darwin" else UNIT)
    text = (read(path) or b"").decode(errors="replace")
    if not text:
        return None
    want = session_env(root).get("HC_SESSION")
    if not want:
        return None
    has = (f"<key>HC_SESSION</key><string>{want}</string>" in text) if sys.platform == "darwin" else \
        any(line.strip() in (f"Environment=HC_SESSION={want}", f'Environment="HC_SESSION={want}"') for line in text.splitlines())
    if has:
        return None
    return (f"the Shepherdr service's unit doesn't set HC_SESSION={want}: the agents it starts land in herdr-core's default "
            "session, outside Shepherdr. Run `shepherdr update` (or the install again) to write it")


def service_file(root, name):
    """A file of the service's own (service.json, web.json, ...): Shepherdr's state folder once moved, else ~/.herdr/shepherdr."""
    return os.path.join(where_for(root).path("service"), name)


def hold_paths(root):
    return [os.path.join(root, HOLD), os.path.join(where_for(root).roots["state"], "sync-hold")]


def move_data(r, a, home):
    """The one-time move of Shepherdr's data into its own folders (layout.py), as part of an install or update.
    Prints one plain line when something moved; never stops the install (doctor says what's wrong)."""
    L = layout_mod()
    try:
        res = L.migrate(home=r.root, env=None if home else {}, dry=a.dry_run)
    except Exception as e:  # a lock held, a full disk: the data stays on the old paths, still working
        r.notes.append(f"Shepherdr's data stays in ~/.herdr for now ({e}); `shepherdr migrate` tries again")
        return
    if a.dry_run:
        if res["moved"]:
            say("  data: would move " + ", ".join(sorted(res["moved"])) + " into Shepherdr's own folders")
        return
    line = L.summary(res)
    if line:
        say(f"  {line}")
    for n in res["notes"]:
        r.notes.append(n)
# SHEP-319: Settings › Instructions is gone (agents read the repo's AGENTS.md / CLAUDE.md and their own global file).
# What someone wrote there (everywhere and each space's) is kept in a plain file beside the settings, once.
OLD_INSTRUCTIONS = "old-instructions.md"


def instructions_out(d):
    """The settings file's Instructions as a plain page, and the file without them: (text or "", cleaned dict)."""
    d = json.loads(json.dumps(d)) if isinstance(d, dict) else {}
    parts = []
    every = d.get("everywhere") if isinstance(d.get("everywhere"), dict) else {}
    if "instructions" in every:
        words = every.pop("instructions")
        if isinstance(words, str) and words.strip():
            parts.append(("Every space", words.strip()))
    for sid, layer in (d.get("spaces") if isinstance(d.get("spaces"), dict) else {}).items():
        if isinstance(layer, dict) and "instructions" in layer:
            words = layer.pop("instructions")
            if isinstance(words, str) and words.strip():
                name = str(layer.get("name") or sid)
                parts.append((f"{name} ({layer['folder']})" if layer.get("folder") else name, words.strip()))
    if not parts:
        return "", d
    text = ("# Your Shepherdr Instructions\n\n"
            "Shepherdr no longer has an Instructions setting: agents follow the repo's or folder's AGENTS.md (or CLAUDE.md)\n"
            "and their own global file. This is what you had written, so you can move it there. Nothing reads this file.\n")
    return text + "".join(f"\n## {head}\n\n{words}\n" for head, words in parts), d


def keep_instructions(r, a, root):
    """Moves Instructions out of the settings file into OLD_INSTRUCTIONS beside it (added to one already there), and
    says where once. Settings without any are left as they are. Never stops the install."""
    path = where_for(root).path("settings")
    raw = read(path)
    if raw is None:
        return
    try:
        d = json.loads(raw)
    except ValueError:
        return
    text, cleaned = instructions_out(d)
    if cleaned == d:
        return
    real = os.path.realpath(path)
    out = os.path.join(os.path.dirname(real), OLD_INSTRUCTIONS)
    if a.dry_run:
        if text:
            say(f"  instructions: would keep the ones in Settings in {short(out)}")
        return
    try:
        if text:
            had = (read(out) or b"").decode("utf-8", "replace")
            if text not in had:  # never lose a copy kept before (another machine's settings, an earlier update)
                atomic_write(out, ((had.rstrip("\n") + "\n\n---\n\n") if had.strip() else "").encode() + text.encode(), 0o600)
        atomic_write(real, (json.dumps(cleaned, indent=2, ensure_ascii=False) + "\n").encode(), os.stat(real).st_mode & 0o777)
    except OSError as e:
        r.notes.append(f"Settings › Instructions couldn't be moved out of the settings file ({e.strerror}); they no longer apply")
        return
    if text:
        r.notes.append(f"Settings › Instructions is gone: agents follow AGENTS.md / CLAUDE.md. What you wrote there is in {short(out)}")


# SHEP-335: the settings that shape a task are the repo's (or plain folder's) it works in, not the space's that started it.
# The update moves each space's task settings (tasks, worker, reviewer) to settings.json "repos", once: to the repo its
# folder is in, or, for a space whose tasks all work elsewhere (root, on /), to each repo they work in. A move that isn't
# to the space's own folder, and a value two spaces disagree on, is said once and kept in SETTINGS_MOVED. Nothing dropped.
REPO_SECTIONS = ("tasks", "worker", "reviewer")
SETTINGS_MOVED = "settings-moved.md"
MERGE_NAMES = {"ask": "When I mark it as done", "checks": "When checks pass", "auto": "Right away"}


def repo_folder(folder):
    """The repo's main checkout a folder is in (as herdr-task keys a folder's tasks), else the folder itself."""
    if not folder or not os.path.isdir(folder):
        return folder
    try:
        p = subprocess.run(["git", "-C", folder, "rev-parse", "--path-format=absolute", "--git-common-dir", "--show-toplevel"],
                           capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return folder
    lines = p.stdout.strip().split("\n") if p.returncode == 0 else []
    if len(lines) == 2:
        common, top = lines
        return common[:-5] if common.endswith("/.git") else top
    return os.path.realpath(folder)


def tasks_by_space(root):
    """{space id: {folder: how many of its tasks work there}} from this machine's task lists."""
    out = {}
    try:
        where = where_for(root).path("tasks")
        names = os.listdir(where)
    except (OSError, Exception):
        return out
    for name in names:
        if name.startswith(".") or not name.endswith(".json"):
            continue
        try:
            with open(os.path.join(where, name)) as f:
                d = json.load(f)
        except (OSError, ValueError):
            continue
        folder = d.get("folder") if isinstance(d, dict) else None
        for t in (d.get("tasks") or []) if folder else []:
            sp = t.get("space") if isinstance(t, dict) else None
            if sp:
                n = out.setdefault(str(sp).split("/")[-1], {})
                n[folder] = n.get(folder, 0) + 1
    return out


def setting_words(sec, field, v):
    """One moved value as Settings says it: Merge "Right away", Tasks run on codex gpt-5..."""
    if sec in ("worker", "reviewer"):
        pick = " ".join(str(v.get(k)) for k in ("agent", "model", "effort") if isinstance(v, dict) and v.get(k)) or "their own"
        return f"{'Tasks' if sec == 'worker' else 'Reviews'} run on {pick}"
    if field == "merge":
        return f'Merge "{MERGE_NAMES.get(v, v)}"'
    if field == "review_rounds":
        return f"Review on ({v} rounds)" if int(v or 0) > 0 else "Review off"
    if field == "proof":
        return "Proof " + ("on" if v else "off")
    if field == "base":
        return f"Base branch {v}"
    return f"{field.replace('_', ' ')} {json.dumps(v, ensure_ascii=False)}"


def repos_out(d, used, home=None):
    """settings.json d with each space's task settings moved to "repos" (SHEP-335): (moved dict, notes, record lines).
    used: tasks_by_space. A space on another machine ("<machine>/<id>") moves to "<machine>:<its folder>"."""
    d = json.loads(json.dumps(d)) if isinstance(d, dict) else {}
    spaces = d.get("spaces") if isinstance(d.get("spaces"), dict) else {}
    repos = d.get("repos") if isinstance(d.get("repos"), dict) else {}
    short = (lambda f: "~" + f[len(home):] if home and (f == home or f.startswith(home + "/")) else f)
    plans = []  # (order, space id, name, targets, elsewhere)
    for sid, layer in spaces.items():
        if not isinstance(layer, dict) or not any(sec in layer for sec in REPO_SECTIONS):
            continue
        other = sid.split("/")[0] if "/" in sid else None
        folder = layer.get("folder")
        name = str(layer.get("name") or sid)
        if other:
            targets, elsewhere = ([f"{other}:{folder}"] if folder else []), False
        else:
            own = repo_folder(folder) if folder else None
            where = used.get(sid, {})
            if where and own not in where:
                targets, elsewhere = sorted(where, key=lambda f: (-where[f], f)), True
            else:
                targets, elsewhere = ([own] if own else []), False
        n = sum(used.get(sid.split("/")[-1], {}).values())
        plans.append(((1 if elsewhere else 0, -n, sid), sid, name, targets, elsewhere))
    notes, record = [], []
    for _, sid, name, targets, elsewhere in sorted(plans):
        layer = spaces[sid]
        values = {sec: layer.pop(sec) for sec in REPO_SECTIONS if sec in layer}
        if not targets:
            words = [setting_words(sec, f, v) for sec, part in values.items() for f, v in
                     ((part.items() if sec == "tasks" and isinstance(part, dict) else [(None, part)])) if v not in (None, {}, "")]
            if words:
                notes.append(f"{name}'s task settings ({', '.join(words)}) had no folder to go to: set them again in Settings › Tasks")
                record.append(f"- {name}: {', '.join(words)}: no folder, not kept")
            continue
        for target in targets:
            repo = repos.setdefault(target, {})
            took, clashed = [], []
            for sec, part in values.items():
                pairs = list(part.items()) if sec == "tasks" and isinstance(part, dict) else [(None, part)]
                for field, v in pairs:
                    if v is None or v == {} or (sec != "tasks" and not v):
                        continue
                    have = (repo.get(sec) or {}).get(field) if field else repo.get(sec)
                    if have is None or have == {}:
                        if field:
                            repo.setdefault(sec, {})[field] = v
                        else:
                            repo[sec] = v
                        took.append(setting_words(sec, field, v))
                    elif have != v:
                        clashed.append(setting_words(sec, field, v))
            if not repo:
                del repos[target]
            where = short(target)
            if took:
                record.append(f"- {name}: {', '.join(took)} → {where}")
                if elsewhere:
                    notes.append(f"{name}'s {', '.join(took)} now appl{'ies' if len(took) == 1 else 'y'} to {where}, where its tasks work")
            if clashed:
                record.append(f"- {name}: {', '.join(clashed)} not taken for {where}: it already had its own")
                notes.append(f"{name}'s {', '.join(clashed)} didn't move to {where}: another space there set it differently, which it keeps")
    if repos:
        d["repos"] = repos
    return d, notes, record


def move_repo_settings(r, a, root):
    """Moves the spaces' task settings to the repos their tasks work in (repos_out), once: says what went elsewhere,
    and keeps the whole record in SETTINGS_MOVED beside the settings. Never stops the install."""
    path = where_for(root).path("settings")
    raw = read(path)
    if raw is None:
        return
    try:
        d = json.loads(raw)
    except ValueError:
        return
    if not isinstance(d, dict):
        return
    moved, notes, record = repos_out(d, tasks_by_space(root), root)
    if moved == d:
        return
    real = os.path.realpath(path)
    out = os.path.join(os.path.dirname(real), SETTINGS_MOVED)
    if a.dry_run:
        say("  settings: would move each space's task settings to the repo its tasks work in")
        return
    try:
        if record:
            had = (read(out) or b"").decode("utf-8", "replace")
            text = ("# Task settings moved to repos\n\nTask settings now follow the repo a task works in, not the space that "
                    "started it. The update moved what each space had set:\n\n" + "\n".join(record) + "\n")
            atomic_write(out, ((had.rstrip("\n") + "\n\n---\n\n") if had.strip() else "").encode() + text.encode(), 0o600)
        atomic_write(real, (json.dumps(moved, indent=2, ensure_ascii=False) + "\n").encode(), os.stat(real).st_mode & 0o777)
    except OSError as e:
        r.notes.append(f"the spaces' task settings couldn't be moved to their repos ({e.strerror}); tasks get them as before")
        return
    for n in notes:
        r.notes.append(f"task settings follow the repo now: {n}")
    if notes:
        r.notes.append(f"what moved where is in {short(out)}")


# Helpers on the PATH: their name, and where the link leads (under Shepherdr's own folder). herdr-task and

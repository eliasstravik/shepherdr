           "workspace-status-chat")
NOTICE_SHOWS = ("chat",)   # the main chat; the Tasks panel's (props.panel) draws nothing too
# Herdr keeps a mod's storage in data/<mod>: one of these means 3.1's window ran here
WINDOW_RAN = ("spaces-chat", "tabs-tasks", "workspace-chrome-shepherdr", "chat", "coordinator")
HOOKS = [  # (file under home, event, entry): the agents' question and permission cards
    (".claude/settings.json", "SessionStart",
     {"matcher": "^(startup|resume|clear|compact)$", "hooks": [{"type": "command", "command": "sh '{share}/hooks/session-note.sh'", "timeout": 10}]}),
    (".claude/settings.json", "PermissionRequest",
     {"hooks": [{"type": "command", "command": "sh '{share}/hooks/ask-hook.sh'", "timeout": 1800}]}),
    (".codex/hooks.json", "SessionStart",
     {"hooks": [{"type": "command", "command": "sh '{share}/hooks/session-note.sh'", "timeout": 10}]}),
    # Codex's approvals on the chat's card too (SHEP-91); a task worker's own hook hands them on instead
    (".codex/hooks.json", "PermissionRequest",
     {"hooks": [{"type": "command", "command": "sh '{share}/hooks/ask-hook.sh'", "timeout": 1800}]}),
]
# The same hooks as 3.1 and older wrote them (in the Herdr app's chat mod): replaced by ours, never kept beside them
OLD_HOOK = re.compile(r"sh '[^'\n]*/herdr-app/mods/chat/(session-note|ask-hook)\.sh'")


class Stop(Exception):
    pass


def say(*a):
    print(*a, flush=True)


def real_home():
    try:
        return pwd.getpwuid(os.getuid()).pw_dir
    except KeyError:
        return os.path.expanduser("~")


def sha_bytes(b):
    return hashlib.sha256(b).hexdigest()


def read(path):
    try:
        with open(path, "rb") as f:
            return f.read()
    except (FileNotFoundError, IsADirectoryError, NotADirectoryError):
        return None


def layout_bytes(b):
    """A layout as compared: its live blocks blanked (see LIVE_BLOCKS)."""
    try:
        d = json.loads(b)
    except ValueError:
        return b

    def walk(n):
        if isinstance(n, dict):
            if n.get("id") in LIVE_BLOCKS:
                n["content"] = None
            for v in n.values():
                walk(v)
        elif isinstance(n, list):
            for v in n:
                walk(v)
    walk(d)
    return json.dumps(d, sort_keys=True).encode()


def fsha(rel, b):
    """A file's sha256 as recorded: a layout's without its live blocks."""
    if b is None:
        return None
    return sha_bytes(layout_bytes(b) if rel.startswith(f"{APP}/layouts/") else b)


def version_tuple(v):
    out = []
    for p in (v or "").strip().split("."):
        digits = "".join(c for c in p if c.isdigit())
        out.append(int(digits) if digits else 0)
    return tuple(out)


def atomic_write(path, data, mode=None):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".shepherdr-", dir=os.path.dirname(path))
    with os.fdopen(fd, "wb") as f:
        f.write(data)
    if mode is not None:
        os.chmod(tmp, mode)
    os.replace(tmp, path)




# ---- the source ---------------------------------------------------------------------------------

def is_source(d):
    """A folder to install from: a checkout, or an installed Shepherdr folder (a whole source too)."""
    return bool(d) and all(os.path.isfile(os.path.join(d, f)) for f in ("install.sh", "bin/shepherdr", "service/main.ts"))


def find_source(given, record):
    for cand in [given, os.path.dirname(os.path.dirname(os.path.realpath(__file__))), (record or {}).get("source")]:
        if is_source(cand):
            return os.path.realpath(cand)
    raise Stop("no Shepherdr checkout found: run ./install.sh from one, or pass --source <checkout>")


# ---- the web app's build ------------------------------------------------------------------------
# web/dist isn't in git, so a fresh clone has no page: the installer builds it with Bun (which the service runs on
# anyway) when it's missing or older than what it's built from. A source without web/src (an installed service
# folder, Serve from's pack) ships its built page and is used as it is.
WEB_INPUTS = ("web", "core", "package.json", "bun.lock")
WEB_OUTPUTS = {"dist", "generated", "node_modules"}


def web_stale(src):
    """Why the source's web app needs a build ("isn't built", "is older than web/src/App.tsx"), or None."""
    if not os.path.isdir(os.path.join(src, "web", "src")):
        return None
    try:
        built = os.path.getmtime(os.path.join(src, "web", "dist", "index.html"))
    except OSError:
        return "isn't built"
    for top in WEB_INPUTS:
        p = os.path.join(src, top)
        if os.path.isfile(p) and os.path.getmtime(p) > built:
            return f"is older than {top}"
        for d, dirs, files in os.walk(p):
            dirs[:] = [x for x in dirs if x not in WEB_OUTPUTS and x not in SKIP]
            for f in files:
                if os.path.getmtime(os.path.join(d, f)) > built:
                    return f"is older than {os.path.relpath(os.path.join(d, f), src)}"
    return None


def install_bun():
    """Bun's own installer (https://bun.sh/install, into ~/.bun), as Serve from does on another machine."""
    say("  installing Bun (https://bun.sh/install, into ~/.bun)")
    subprocess.run(["sh", "-c", "curl -fsSL https://bun.sh/install | bash"], capture_output=True)
    return bun_path()


def build_web(r, src, home, a):
    """Builds the source's web app when it's missing or out of date (bun install, bun run build), before anything is
    written: a build that fails stops the install (nothing changed) unless --force, which installs without it."""
    why = web_stale(src)
    if not why or getattr(a, "no_build", False):
        return
    if r.dry:
        say(f"  the web app {why}: would build it (bun install, bun run build){'' if bun_path() else ', installing Bun first'}")
        return
    # Bun goes on the real machine: only for an install into the real home, never for a scratch --root
    bun = bun_path() or (install_bun() if home else None)
    err = None if bun else "Bun isn't installed (https://bun.sh)"
    if bun:
        say(f"  the web app {why}: building it in {src} (bun install, bun run build)")
        for argv in ([bun, "install", "--frozen-lockfile"], [bun, "run", "build"]):
            p = subprocess.run(argv, cwd=src, capture_output=True, text=True)
            if p.returncode != 0:
                tail = (p.stderr.strip() or p.stdout.strip()).splitlines()[-5:]
                err = f"`{' '.join(['bun', *argv[1:]])}` failed:\n    " + "\n    ".join(tail)
                break
    if not err:
        return
    if a.force:
        r.notes.append(f"couldn't build the web app ({err.splitlines()[0]}): installed without a new page")
        return
    raise Stop(f"couldn't build the web app in {src}: {err}\nNothing was changed. Fix that and run this again, "
               "or --force to install without a new page.")


def walk_files(top):
    """Files under top, relative, skipping caches and Herdr's generated files."""
    out = []
    for d, dirs, files in os.walk(top):
        dirs[:] = sorted(x for x in dirs if x not in SKIP)
        for f in sorted(files):
            if f in SKIP or f in GENERATED or f.endswith(".pyc"):
                continue
            out.append(os.path.relpath(os.path.join(d, f), top))
    return out


def share_items(src):
    """Everything that goes into Shepherdr's own folder: the service (its TypeScript runs on Bun as it is), the
    shared core, the built web app, herdr-task, herdr-artifact, the helpers, the hooks, the role instructions, the
    Herdr button and the installer. That folder is then a whole source to install another machine from (Serve from:
    `shepherdr web install-on` packs it)."""
    items = [("share", f"{SHARE}/{f}", os.path.join(src, f)) for f in ("package.json", "install.sh")]
    # the service, the shared core, and the web app's shared code the service runs too (alerts, types' helpers)
    for top in ("service", "core", "web/shared"):
        for f in walk_files(os.path.join(src, top)) if os.path.isdir(os.path.join(src, top)) else []:
            if not f.endswith((".test.ts", ".test.js")):
                items.append(("share", f"{SHARE}/{top}/{f}", os.path.join(src, top, f)))
    dist = os.path.join(src, "web", "dist")
    for f in walk_files(dist) if os.path.isfile(os.path.join(dist, "index.html")) else []:
        if f != "artifact-viewer.html":   # 3.1's recipe viewer, left in an older build: artifacts are plain pages now
            items.append(("share", f"{SHARE}/web/dist/{f}", os.path.join(dist, f)))
    for top in ("mods/tasks/bin", "mods/artifacts/bin", "bin", "hooks", "herdr", "templates"):
        for f in walk_files(os.path.join(src, top)) if os.path.isdir(os.path.join(src, top)) else []:
            if top != "templates" or f.endswith(".md"):
                items.append(("share", f"{SHARE}/{top}/{f}", os.path.join(src, top, f)))
    # the artifact guide (`herdr-artifact guide` reads it from beside its bin/)
    guide = os.path.join(src, "mods", "artifacts", "ARTIFACTS.md")
    if os.path.isfile(guide):
        items.append(("share", f"{SHARE}/mods/artifacts/ARTIFACTS.md", guide))
    return items


def source_items(src, root=None):
    """What a source installs: [(group, rel under root, source path)]. group: "share" (Shepherdr's own folder,
    replaced whole) or "template" (the person may have changed theirs: kept, the new one beside it)."""
    items = share_items(src)
    for f in sorted(os.listdir(os.path.join(src, "templates"))):
        if f.endswith(".md"):
            items.append(("template", f"{tpl_rel(root)}/{f}", os.path.join(src, "templates", f)))
    return items


def herdr_app_here(root):
    """The Herdr app is on this machine (it's optional): its home holds what the app itself writes. data/ alone
    doesn't count: the agents' question hook keeps its cards there on every machine."""
    app = os.path.join(root, APP)
    return any(os.path.exists(os.path.join(app, x)) for x in ("mods", "layouts", "keys.json")) \
        or os.path.exists(os.path.join(root, ".local/share/herdr-app/herdr-app"))


def button_items(src):
    """The "Open Shepherdr" button, as a mod of the Herdr app."""
    top = os.path.join(src, "herdr", BUTTON)
    return [("button", f"{APP}/mods/{BUTTON}/{f}", os.path.join(top, f)) for f in walk_files(top)] if os.path.isdir(top) else []


def bun_path():
    for p in (shutil.which("bun"), os.path.expanduser("~/.bun/bin/bun")):
        if p and os.path.isfile(p):
            return p
    return None


def tool_dir(name, path):
    """The folder to put on the service's PATH for a tool found at path: the folder it really lives in (a link from
    ~/.local/bin to mise's or nvm's copy), but the link's own folder when it is a link to another name or into the Nix
    store, whose folders change on every upgrade and go once garbage-collected (a profile's bin stays)."""
    real = os.path.realpath(path)
    if os.path.basename(real) != name or real.startswith("/nix/store/"):
        return os.path.dirname(path)
    return os.path.dirname(real)


def managed_unit(root):
    """Where the service's unit links to when something else keeps it (a Nix home-manager unit is a link into
    /nix/store; Shepherdr only ever writes a plain file there), else None."""
    path = os.path.join(root, PLIST if sys.platform == "darwin" else UNIT)
    return os.readlink(path) if os.path.islink(path) else None


def unit_text(root, bun, port=None):
    """The user service that keeps Shepherdr's service running (Linux), or its launchd agent (macOS). port: install's
    --port (SHEPHERDR_PORT; none: the service's own 7788). The CLI reads the port the service really took
    from its service.json, so this is the only place it is set. SHEPHERDR_HOME and XDG_* as the installer saw them go
    along, so the service finds the same folders, and HC_SESSION, so its agents land in Shepherdr's own session."""
    main = os.path.join(root, SHARE, "service", "main.ts")
    # hc, herdr-task and the helpers live in ~/.local/bin, which a user service's PATH lacks; and the tools herdr-task
    # and the agents run (gh, git, node, agent-browser, the CLIs…) where this install finds them (mise, nvm, brew…)
    # hc (herdr-core) too, wherever it is: a Nix or other package manager's install isn't in ~/.local/bin (GitHub #1048)
    tools = ["hc", "herdr-app", "gh", "git", "node", "agent-browser", "claude", "codex", "python3", "tailscale", "pw-record",
             "pw-play", "jq"]
    found = [tool_dir(t, p) for t in tools for p in [shutil.which(t)] if p]
    dirs = [os.path.join(root, BIN), os.path.dirname(bun), *found, "/usr/local/bin", "/opt/homebrew/bin", "/usr/bin", "/bin", "/usr/sbin", "/sbin"]
    path = ":".join(dict.fromkeys(dirs))
    if sys.platform == "darwin":
        return PLIST, f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{AGENT}</string>
  <key>ProgramArguments</key><array><string>{bun}</string><string>{main}</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>{path}</string>{f"<key>SHEPHERDR_PORT</key><string>{port}</string>" if port else ""}{"".join(f"<key>{k}</key><string>{v}</string>" for k, v in sorted({**env_for(root), **session_env(root)}.items()))}</dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>{service_file(root, "service.log")}</string>
  <key>StandardErrorPath</key><string>{service_file(root, "service.log")}</string>
</dict>
</plist>
"""
    return UNIT, f"""[Unit]
Description=Shepherdr: background work and the web app
After=network-online.target

[Service]
ExecStart={bun} {main}
Environment=PATH={path}
{f"Environment=SHEPHERDR_PORT={port}{chr(10)}" if port else ""}{"".join(f"Environment={k}={v}{chr(10)}" for k, v in sorted({**env_for(root), **session_env(root)}.items()))}Restart=always
RestartSec=2

[Install]
WantedBy=default.target
"""


DEFAULT_PORT = 7788


def has_unit(root):
    """the service is installed to run here (its systemd unit or launchd agent)"""
    return os.path.isfile(os.path.join(root, PLIST if sys.platform == "darwin" else UNIT))


def json_file(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def our_port(root):
    """The port this machine's service took (service.json), else the one install set, else the default."""
    try:
        return int(json_file(service_file(root, "service.json"))["port"])
    except (KeyError, TypeError, ValueError):
        rec = load_record(root) or old_record(root) or {}
        return rec.get("port") or DEFAULT_PORT


def service_answers(root):
    """Shepherdr's own service answers here (its health says the id it wrote in service.json, not another app on its
    port): (True, port), or (False, why)."""
    try:
        f = json_file(service_file(root, "service.json"))
        port, sid = int(f["port"]), f["id"]
    except (ValueError, KeyError, TypeError):
        return False, f"the Shepherdr service hasn't started here (no {service_file(root, 'service.json')})"
    import urllib.request
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/api/health", timeout=3) as res:
            h = json.load(res)
    except (OSError, ValueError):
        return False, f"the Shepherdr service isn't answering on port {port}"
    if not isinstance(h, dict) or h.get("id") != sid:
        return False, f"another app answers on port {port}, not the Shepherdr service: install again with --port <a free one>"
    return True, port


def calls_on(root):
    """How many voice calls the running service has on now (its health says so to this machine's callers); 0 when
    it doesn't answer."""
    try:
        f = json_file(service_file(root, "service.json"))
        port, sid = int(f["port"]), f["id"]
    except (ValueError, KeyError, TypeError):
        return 0
    import urllib.request
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/api/health", timeout=3) as res:
            h = json.load(res)
    except (OSError, ValueError):
        return 0
    if not isinstance(h, dict) or h.get("id") != sid:
        return 0
    n = h.get("calls")
    return n if isinstance(n, int) and n > 0 else 0


def set_port(a, rec):
    """install --port: kept in the record, so an update keeps it; 7788 goes back to the default."""
    p = getattr(a, "port", None)
    if p is None:
        return
    if not 1024 <= p <= 65535:
        raise Stop(f"--port {p}: pick one from 1024 to 65535")
    if p == DEFAULT_PORT:
        rec.pop("port", None)
    else:
        rec["port"] = p


HTTPS_FILE = "https-port"   # in the service's folder: the tailnet HTTPS port (service/tailscale.ts httpsPort); none: 443


def https_port(root):
    """The tailnet HTTPS port this machine shares the web app on: its https-port file, else 443."""
    try:
        with open(service_file(root, HTTPS_FILE)) as f:
            n = int(f.read().strip())
    except (OSError, ValueError):
        return 443
    return n if 1 <= n <= 65535 else 443


def write_https_port(root, p, dry=False):
    """Keeps the tailnet HTTPS port in the service's folder (443: the file goes, the default again). The service looks
    at it every few seconds and moves its share and links there."""
    if not 1 <= p <= 65535:
        raise Stop(f"HTTPS port {p}: pick one from 1 to 65535 (8443 is a common one)")
    path = service_file(root, HTTPS_FILE)
    if dry:
        say(f"  the web app's tailnet HTTPS port: {p}")
        return
    if p == 443:
        if os.path.exists(path):
            os.unlink(path)
        return
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    atomic_write(path, f"{p}\n".encode())


def set_https_port(a, root):
    """install --https-port: kept in the service's folder, so updates keep it and `shepherdr web https-port` changes it."""
    p = getattr(a, "https_port", None)
    if p is not None:
        write_https_port(root, p, a.dry_run)


def web_outcome(root, since, port=None, wait=15):
    """What the service last said about the web app, once it wrote web.json after `since` (and, given a port, on that
    port): its link, or why it isn't shared. None when it hasn't said within `wait` seconds."""
    end = time.time() + wait
    while True:
        w = json_file(service_file(root, "web.json")) or {}
        if (w.get("at") or 0) / 1000 >= since and (port is None or w.get("https_port", 443) == port):
            return w
        if time.time() >= end:
            return None
        time.sleep(1)


def fence_worktrees(r):
    """GitHub #1132: our package.json (type: module) sits above the task worktrees folder, so Node ran a repo with
    none of its own (its tests, a git hook's require()) as ESM there. A plain package.json in that folder stops Node's
    search; herdr-task writes the same for new worktrees (launch.fence_node). A file already there stays."""
    d = r.p(f"{SHARE}/worktrees")
    path = os.path.join(d, "package.json")
    if r.dry or not os.path.isdir(d) or os.path.lexists(path):
        return
    try:
        with open(path, "xb") as f:
            f.write(b'{"private": true, "description": "Shepherdr: keeps task worktrees off the package.json of a folder above"}\n')
    except OSError:
        pass


def service_running(root):
    """The service's unit is loaded and running here (launchd's agent, or the systemd user unit)."""
    if sys.platform == "darwin":
        return subprocess.run(["launchctl", "print", f"gui/{os.getuid()}/{AGENT}"], capture_output=True).returncode == 0
    return subprocess.run(["systemctl", "--user", "is-active", "--quiet", "shepherdr.service"], capture_output=True).returncode == 0


def stop_service(r, home):
    """Before an install or update swaps files: the running service (and the old helpers it runs) would read files
    while they move, and crashed on ones gone a moment (ENOENT on herdr-task's or herdr-secret's files). It stops,
    and cmd_install starts it again after, also when the install fails halfway. True when it stopped one."""
    if not home or r.dry or not has_unit(r.root) or not service_running(r.root):
        return False
    if calls_on(r.root):
        # a voice call on now: it isn't cut here; the service starts again on the new code once the call ends
        return False
    if sys.platform == "darwin":
        target = f"gui/{os.getuid()}"
        subprocess.run(["launchctl", "bootout", f"{target}/{AGENT}"], capture_output=True)
        for _ in range(20):
            if subprocess.run(["launchctl", "print", f"{target}/{AGENT}"], capture_output=True).returncode != 0:
                break
            time.sleep(0.5)
    else:
        subprocess.run(["systemctl", "--user", "stop", "shepherdr.service"], capture_output=True)
    say("  service: stopped while the files change")
    return True


def start_service(r):
    """The service back on whatever unit is there now, after an install that stopped it and didn't get as far as
    starting it again (it failed halfway, or had no bun)."""
    if sys.platform == "darwin":
        ok = False
        for _ in range(4):
            ok = subprocess.run(["launchctl", "bootstrap", f"gui/{os.getuid()}", r.p(PLIST)], capture_output=True).returncode == 0
            if ok:
                break
            time.sleep(1)
    else:
        ok = subprocess.run(["systemctl", "--user", "start", "shepherdr.service"], capture_output=True).returncode == 0
    say("  service: started again" if ok else "  service: didn't start again: `shepherdr doctor` says more")
    return ok


def install_service(r, rec, home):
    """Writes the unit; on the real home, (re)starts the service with it. A scratch root only gets the file."""
    fence_worktrees(r)
    bun = bun_path()
    if not bun:
        r.notes.append("the Shepherdr service needs bun (https://bun.sh): install it, then run this again")
        return
    if not os.path.isfile(r.p(f"{SHARE}/web/dist/index.html")) and not r.dry:
        r.notes.append("the web app isn't built, so the service serves no page yet (./install.sh builds it)")
    rel, text = unit_text(r.root, bun, rec.get("port"))
    data = text.encode()
    managed = managed_unit(r.root)
    if managed:
        # GitHub #1048: someone else's unit (Nix home-manager) stays as it is, with its own PATH and code; the service
        # only starts again so it picks up what this run changed
        rec.get("files", {}).pop(rel, None)
        r.notes.append(f"the Shepherdr service's unit links to {managed}, so something else (Nix home-manager?) keeps it: "
                       "left as it is; change the service there")
    same_unit = managed is not None or read(r.p(rel)) == data
    if not same_unit:
        if r.dry:
            say(f"  unit    {rel}")
            return
        atomic_write(r.p(rel), data)
    if not managed:
        rec.setdefault("files", {})[rel] = fsha(rel, data)
    if not home or r.dry:
        return
    # SHEP-173: a voice call on now would be cut by the restart: the service starts again on the new code by itself
    # once no call is on (service/main.ts restart-when-free)
    if same_unit and has_unit(r.root) and calls_on(r.root):
        atomic_write(service_file(r.root, "restart-when-free"), b"1\n")
        r.notes.append("a voice call is on: the Shepherdr service starts again on this update once it ends")
        return
    r.service_started = True
    if sys.platform == "darwin":
        target = f"gui/{os.getuid()}"
        subprocess.run(["launchctl", "bootout", f"{target}/{AGENT}"], capture_output=True)
        # bootout returns before the old one is gone, and bootstrap refuses until it is: wait, then try a few times
        for _ in range(20):
            if subprocess.run(["launchctl", "print", f"{target}/{AGENT}"], capture_output=True).returncode != 0:
                break
            time.sleep(0.5)
        ok = False
        for _ in range(4):
            ok = subprocess.run(["launchctl", "bootstrap", target, r.p(rel)], capture_output=True).returncode == 0
            if ok:
                break
            time.sleep(1)
    else:
        subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
        ok = managed is not None or subprocess.run(["systemctl", "--user", "enable", "shepherdr.service"],
                                                   capture_output=True).returncode == 0
        ok = ok and subprocess.run(["systemctl", "--user", "restart", "shepherdr.service"], capture_output=True).returncode == 0
    why = "it didn't start"
    if ok:
        # started is not answering: another app may hold its port (GitHub #635), and the service then stops at once
        for _ in range(20):
            ok, why = service_answers(r.root)
            if ok:
                break
            time.sleep(0.5)
    port = rec.get("port") or DEFAULT_PORT
    # only an answer from another app says it holds the port; no answer yet may be a slow start (GitHub #1048)
    r.notes.append("the Shepherdr service is running" if ok else
                   f"{why}; `shepherdr doctor` says more" if str(why).startswith("another app") else
                   f"the Shepherdr service isn't answering on port {port} yet: it may still be starting, or another app "
                   "may hold the port (install again with --port <a free one>); `shepherdr doctor` says more")


# ---- the record ---------------------------------------------------------------------------------

def load_record(root):
    rec = json_file(os.path.join(root, RECORD))
    return rec if isinstance(rec, dict) else None


def old_record(root):
    """What a 3.1 (or older) Herdr-window install recorded, while it hasn't been switched over."""
    rec = json_file(os.path.join(root, OLD_RECORD))
    return rec if isinstance(rec, dict) else None


def save_record(root, rec):
    atomic_write(os.path.join(root, RECORD), (json.dumps(rec, indent=2, sort_keys=True) + "\n").encode())


# ---- install ------------------------------------------------------------------------------------

class Run:
    def __init__(self, root, dry):
        self.root, self.dry = root, dry
        self.stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
        self.backup_dir = os.path.join(root, SHARE, ".shepherdr-backup", self.stamp)
        n = 1
        while os.path.exists(self.backup_dir):
            n += 1
            self.backup_dir = os.path.join(root, SHARE, ".shepherdr-backup", f"{self.stamp}-{n}")
        self.backed = False
        self.notes = []
        self.service_started = False   # install_service started the service (again) in this run

    def p(self, rel):
        return os.path.join(self.root, rel)

    def backup(self, rel, move=False):
        """Keeps what is at rel (a file, link or folder) under this run's backup folder."""
        path = self.p(rel)
        if not os.path.lexists(path):
            return None
        dest = os.path.join(self.backup_dir, rel)
        if self.dry:
            return dest
        self.backed = True
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        if move:
            os.rename(path, dest)
        elif os.path.islink(path):
            os.symlink(os.readlink(path), dest)
        elif os.path.isdir(path):
            shutil.copytree(path, dest, symlinks=True)
        else:
            shutil.copy2(path, dest)
        return dest



def plan_files(r, rec, items, adopt):
    """For each source file: what to do. -> (actions, clashes). An action: (rel, how, data, mode)
    with how one of new, update, same, adopt, keep (the person's; .new beside it)."""
    files = (rec or {}).get("files", {})
    actions, clashes = [], []
    for group, rel, srcpath in items:
        data = read(srcpath)
        mode = os.stat(srcpath).st_mode & 0o777
        cur = read(r.p(rel))
        want = fsha(rel, data)
        have = fsha(rel, cur)
        if cur is None:
            how = "new"
        elif have == want:
            how = "same"
        elif rel in files and files[rel] == have:
            how = "update"
        elif rel in files or group == "template":
            how = "keep"
        elif adopt:
            how = "adopt"
        else:
            how = "clash"
            clashes.append(rel)
        actions.append((group, rel, how, data, mode))
    return actions, clashes


# Recorded in the files, but written by their own step (the service's unit or launch agent), not shipped
MANAGED = (UNIT, PLIST)


def prune_dirs(r, rel):
    """Removes the folders a removed file leaves empty, up to the ones that aren't ours to remove."""
    stop = {os.path.realpath(r.p(x)) for x in ("", SHARE, APP, f"{APP}/mods", f"{APP}/layouts", f"{APP}/data", BIN, tpl_rel(r.root))}
    d = os.path.dirname(r.p(rel))
    while os.path.realpath(d) not in stop:
        try:
            os.rmdir(d)
        except OSError:
            return
        d = os.path.dirname(d)


def merge_key(r, rec):
    """The one key Shepherdr adds to the Herdr app's keys.json (KEY: it opens the button), only when that key is
    free: a key the person set is never replaced. -> the record's keys (what uninstall takes out again)."""
    ctx, key, value = KEY
    name = f"{ctx} {key}"
    rel = f"{APP}/keys.json"
    text = read(r.p(rel))
    try:
        have = json.loads(text) if text else {}
    except ValueError:
        have = None
    if not isinstance(have, dict) or not isinstance(have.get(ctx, {}), dict):
        r.notes.append(f"{rel} isn't valid JSON (Herdr can't read it either): left alone, no key opens Shepherdr's button")
        return {}
    cur = have.get(ctx, {}).get(key)
    if cur == value:
        return {name: (rec.get("keys") or {}).get(name) or {"value": value, "was": None, "added": False}}
    if cur is not None:
        r.notes.append(f"kept your key {key} = \"{cur}\": to open Shepherdr from Herdr, give \"{value}\" a key of your own in {rel}")
        return {}
    if r.dry:
        say(f"  key     {rel}: {key} opens Shepherdr")
        return {}
    if text is not None:
        r.backup(rel)
    elif rel not in rec.setdefault("created", []):
        rec["created"].append(rel)
    have.setdefault(ctx, {})[key] = value
    atomic_write(r.p(rel), (json.dumps(have, indent=2, ensure_ascii=False) + "\n").encode())
    return {name: {"value": value, "was": None, "added": True}}


def take_keys_out(r, rec):
    """Shepherdr's keys out of keys.json (the record says which): one it added goes, one it took over gets the
    person's back; a key the person changed since stays theirs."""
    rel = f"{APP}/keys.json"
    text = read(r.p(rel))
    keys = rec.get("keys") or {}
    if text is None or not keys:
        return
    try:
        have = json.loads(text)
    except ValueError:
        have = None
    if not isinstance(have, dict):
        r.notes.append(f"{rel} isn't valid JSON: Shepherdr's keys stay in it, remove them by hand")
        return
    changed = False
    for name, k in keys.items():
        ctx, key = name.split(" ", 1)
        if not isinstance(have.get(ctx), dict) or have[ctx].get(key) != k.get("value") or not (k.get("added") or k.get("was")):
            continue
        if k.get("was") is None:
            have[ctx].pop(key, None)
            if not have[ctx]:
                del have[ctx]
        else:
            have[ctx][key] = k["was"]
        changed = True
    if not changed or r.dry:
        return
    r.backup(rel)
    if not have and rel in rec.get("created", []):
        os.remove(r.p(rel))
    else:
        atomic_write(r.p(rel), (json.dumps(have, indent=2, ensure_ascii=False) + "\n").encode())


def link_helpers(r, rec, ours=()):
    """The helpers on the PATH: links into Shepherdr's own folder. ours: where an older install's links led (they
    are replaced); anything else by that name is set aside, and uninstall puts it back."""
    links = {}
    old = {os.path.realpath(x) for x in ours}
    for name, target in LINKS.items():
        rel, dest = f"{BIN}/{name}", r.p(f"{SHARE}/{target}")
        path = r.p(rel)
        links[name] = dest
        if os.path.islink(path) and os.path.realpath(path) == os.path.realpath(dest):
            continue
        if r.dry:
            say(f"  link    {rel} -> {dest}")
            continue
        if os.path.islink(path) and os.path.realpath(path) in old:
            os.remove(path)
        elif os.path.lexists(path):
            r.backup(rel, move=True)
            rec.setdefault("replaced", {}).setdefault(rel, os.path.join(r.backup_dir, rel))
        os.makedirs(os.path.dirname(path), exist_ok=True)
        os.symlink(dest, path)
    return links


def put_back(r, rec, only=None):
    """What an install set aside to take a name (a helper's, an adopted file's) goes back where it was, when the
    name is free again. only: just the names under these prefixes."""
    for rel, saved in list((rec.get("replaced") or {}).items()):
        if only is not None and not rel.startswith(only):
            continue
        if os.path.lexists(saved) and not os.path.lexists(r.p(rel)) and not r.dry:
            os.makedirs(os.path.dirname(r.p(rel)), exist_ok=True)
            os.rename(saved, r.p(rel))
            say(f"  put back {rel}")
        if not r.dry:
            rec["replaced"].pop(rel, None)


def set_hooks(r, rec, add):
    """The agents' hooks in Claude Code's and Codex's settings. add True: ours go in (once); False: ours come out;
    None (--no-hooks): neither. Every time, the entries a 3.1 install wrote (…/herdr-app/mods/chat/) come out: those
    files are gone. -> the record's hooks."""
    share = r.p(SHARE)
    done = [] if add is not None else list(rec.get("hooks") or [])
    by_file = {}
    for f, event, entry in HOOKS:
        by_file.setdefault(f, []).append((event, json.loads(json.dumps(entry).replace("{share}", share))))
    for f, entries in by_file.items():
        path = r.p(f)
        text = read(path)
        if text is None and (not add or not os.path.isdir(os.path.dirname(path))):
            continue  # nothing of ours there, or that CLI isn't installed here
        try:
            d = json.loads(text) if text else {}
        except ValueError:
            d = None
        if not isinstance(d, dict) or not isinstance(d.get("hooks", {}), dict):
            r.notes.append(f"hooks: {path} isn't valid JSON, left alone; add the hooks by hand (docs/install.md)")
            continue
        hooks = d.setdefault("hooks", {})
        mine = {e["hooks"][0]["command"] for _, e in entries}

        def goes(group):
            cmds = [h.get("command") or "" for h in (group.get("hooks") or []) if isinstance(h, dict)] if isinstance(group, dict) else []
            return any(OLD_HOOK.fullmatch(c) or (add is False and c in mine) for c in cmds)
        changed = added = False
        for event, lst in list(hooks.items()):
            if not isinstance(lst, list):
                continue
            keep = [g for g in lst if not goes(g)]
            if len(keep) != len(lst):
                hooks[event], changed = keep, True
            if not keep:
                del hooks[event]
        for event, entry in entries if add else []:
            cmd = entry["hooks"][0]["command"]
            lst = hooks.setdefault(event, [])
            if not any(isinstance(h, dict) and h.get("command") == cmd for g in lst if isinstance(g, dict) for h in g.get("hooks") or []):
                lst.append(entry)
                changed = added = True
            done.append([f, event, cmd])
        if not hooks:
            del d["hooks"]
        if not changed or r.dry:
            continue
        if text is not None:
            r.backup(f)
        elif f not in rec.setdefault("created", []):
            rec["created"].append(f)
        if not d and not add and f in rec.get("created", []):
            os.remove(path)
        else:
            atomic_write(path, (json.dumps(d, indent=2) + "\n").encode())
        if added and f.startswith(".codex"):
            r.notes.append("Codex asks once to trust its new hook: say yes in its Hooks screen")
    return done


# ---- agent-browser (the task browser, SHEP-156) ------------------------------------------------
# herdr-browser owns it: which versions work, where Shepherdr's own copy goes, how it's fetched. Install, update and
# doctor only ask it (--install, --status), as the installed copy, with the root's home.
def browser_helper(root):
    p = os.path.join(root, SHARE, "bin", "herdr-browser")
    return p if os.path.isfile(p) else None


def browser_env(root):
    if os.path.realpath(root) == os.path.realpath(real_home()):
        return dict(os.environ)
    drop = ("SHEPHERDR_HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME")
    return {**{k: v for k, v in os.environ.items() if k not in drop}, "HOME": root}


def browser_off(root):
    try:
        off = (json.load(open(where_for(root).path("settings"))).get("everywhere") or {}).get("off")
    except (OSError, ValueError, AttributeError):
        return False
    return isinstance(off, list) and "browser" in off


def ensure_agent_browser(r, home):
    """A working agent-browser and Chrome for the task browser: the one already here when it fits, else Shepherdr's
    own copy (installed, or updated when the pin changed). Never stops the install: a failure is a note with the fix.
    Only for the real home (a scratch --root downloads nothing), unless SHEPHERDR_AGENT_BROWSER=1."""
    if not home and os.environ.get("SHEPHERDR_AGENT_BROWSER") != "1":
        return
    hb = browser_helper(r.root)
    if not hb or browser_off(r.root):
        return
    if r.dry:
        say("  agent-browser: would make sure it's here (herdr-browser --install)")
        return
    try:
        p = subprocess.run(["sh", hb, "--install"], capture_output=True, text=True, env=browser_env(r.root),
                           stdin=subprocess.DEVNULL, timeout=1200)
        out = (p.stdout.strip() or p.stderr.strip()).splitlines()
        line = out[-1] if out else ""
        ok = p.returncode == 0
    except (OSError, subprocess.SubprocessError) as e:
        line, ok = f"herdr-browser --install didn't finish ({e})", False
    line = line.replace("herdr-browser: ", "", 1)
    if ok:
        say(f"  {line}")
    else:
        r.notes.append(f"the task browser: {line}")


# ---- agent-desktop (the agents' desktop, SHEP-346) ----------------------------------------------
# herdr-desktop owns it, as herdr-browser owns agent-browser: the pin, Shepherdr's own copy, how it's fetched. Install,
# update and doctor only ask it (--install, --status), as the installed copy, with the root's home.
SCREEN_SHARING_SECRET = "SCREEN_SHARING_PASSWORD"   # a Mac's Screen Sharing password, kept as a secret by that name


def desktop_helper(root):
    p = os.path.join(root, SHARE, "bin", "herdr-desktop")
    return p if os.path.isfile(p) else None


def ensure_agent_desktop(r, home):
    """A working agent-desktop for the agents' desktop: the one already here when it fits, else Shepherdr's own copy
    (installed, or updated when the pin changed). Never stops the install: a failure is a note with the fix. Only for
    the real home (a scratch --root downloads nothing), unless SHEPHERDR_AGENT_DESKTOP=1."""
    if not home and os.environ.get("SHEPHERDR_AGENT_DESKTOP") != "1":
        return
    hd = desktop_helper(r.root)
    if not hd or browser_off(r.root):
        return
    if r.dry:
        say("  agent-desktop: would make sure it's here (herdr-desktop --install)")
        return
    try:
        p = subprocess.run(["sh", hd, "--install"], capture_output=True, text=True, env=browser_env(r.root),
                           stdin=subprocess.DEVNULL, timeout=900)
        ok = p.returncode == 0
        out = [x.replace("herdr-desktop: ", "", 1) for x in (p.stdout + "\n" + p.stderr).splitlines()
               if x.strip() and not x.startswith(("herdr-desktop: installing", "herdr-desktop: downloading"))]
    except (OSError, subprocess.SubprocessError) as e:
        out, ok = [f"herdr-desktop --install didn't finish ({e})"], False
    if ok:
        say(f"  {out[0]}" if out else "  agent-desktop is ready")
        # still missing here (a display server, a Mac's permissions): only the person can do those, doctor says them too
        r.notes.extend(f"the agents' desktop: {x}" for x in out[1:])
    else:
        r.notes.append(f"the agents' desktop: {out[-1] if out else 'herdr-desktop --install failed'}")


def secret_names(root):
    """The secrets' names this machine can use (herdr-secret names), or None when it can't say."""
    hs = os.path.join(root, ".local", "bin", "herdr-secret")
    if not os.path.isfile(hs):
        return None
    try:
        p = subprocess.run([sys.executable, hs, "names", "--json"], capture_output=True, text=True,
                           stdin=subprocess.DEVNULL, timeout=30)
        return {x.get("name") for x in json.loads(p.stdout)} if p.returncode == 0 else None
    except (OSError, ValueError, AttributeError, subprocess.SubprocessError):
        return None


def agent_desktop_state(root, root_is_home):
    """doctor's lines on the agents' desktop: agent-desktop, and on a Mac what only the person can switch on there
    (Accessibility, Screen Recording, Screen Sharing with its VNC password, that password kept as a secret). [] when
    there's no herdr-desktop here or the browser add-on is off."""
    hd = desktop_helper(root)
    if not hd or browser_off(root):
        return []
    try:
        p = subprocess.run(["sh", hd, "--status"], capture_output=True, text=True, env=browser_env(root),
                           stdin=subprocess.DEVNULL, timeout=60)
        st = json.loads(p.stdout)
    except (OSError, ValueError, subprocess.SubprocessError):
        return ["the agents' desktop: herdr-desktop --status didn't answer"]
    lines = []
    if st.get("ok"):
        where = "Shepherdr's own copy" if st.get("from") == "shepherdr" else st.get("bin")
        lines.append(f"agent-desktop {st.get('version') or ''} for the agents' desktop ({where})".replace("  ", " "))
    else:
        lines.append("the agents' desktop: " + (st.get("problem") or "agent-desktop isn't usable").replace("herdr-desktop: ", "", 1))
    problem = st.get("problem") or ""
    lines += [f"the agents' desktop: {x}" for x in st.get("needs") or [] if x not in problem]
    if st.get("driver") == "shared" and root_is_home:
        names = secret_names(root)
        if names is not None and SCREEN_SHARING_SECRET not in names:
            lines.append(f"the agents' desktop: Shepherdr has no Screen Sharing password for this Mac: give it as the secret "
                         f"{SCREEN_SHARING_SECRET} (herdr-secret set {SCREEN_SHARING_SECRET}), the one set under \"VNC viewers "
                         "may control screen with password\"")
    return lines


def codex_sandbox_state(root_is_home):
    """doctor's line when Codex's sandbox (bwrap) can't start on this machine (SHEP-227, #998), else None.
    herdr-task's own check, asked once and kept: `herdr-task sandbox` gives the fix."""
    if not root_is_home or not shutil.which("codex"):
        return None
    try:
        layout_mod()
        from herdr_task import sandbox
        broken = sandbox.check()
    except Exception:
        return None
    return (f"Codex's sandbox can't start here ({broken.get('error') or 'bwrap refused'}): Codex workers and "
            "reviewers can't run commands. `herdr-task sandbox` says the fix") if broken else None


def agent_browser_state(root):
    """doctor's line on agent-browser, or None (no herdr-browser here, or the browser add-on is off)."""
    hb = browser_helper(root)
    if not hb or browser_off(root):
        return None
    try:
        p = subprocess.run(["sh", hb, "--status"], capture_output=True, text=True, env=browser_env(root),
                           stdin=subprocess.DEVNULL, timeout=30)
        st = json.loads(p.stdout)
    except (OSError, ValueError, subprocess.SubprocessError):
        return "the task browser: herdr-browser --status didn't answer"
    if st.get("ok"):
        where = "Shepherdr's own copy" if st.get("from") == "shepherdr" else st.get("bin")
        return f"agent-browser {st.get('version')} for the task browser ({where})"
    return "the task browser: " + (st.get("problem") or "agent-browser isn't usable").replace("herdr-browser: ", "", 1)


def check_tools(root_is_home):
    """The programs Shepherdr needs: herdr-core (hc) and git; the Herdr app is optional. -> (problems, notes)."""
    bad, notes = [], []
    if sys.version_info < (3, 8):
        bad.append("python3 3.8 or newer")
    exe = shutil.which("hc")
    if not exe:
        (bad if root_is_home else notes).append(f"herdr-core (hc {HC_MIN} or newer) isn't on the PATH: install it first (https://herdr.dev)")
    else:
        try:
            out = subprocess.run([exe, "--version"], capture_output=True, text=True, timeout=20).stdout
        except (OSError, subprocess.SubprocessError):
            out = ""
        have = out.split()[-1] if out.split() else ""
        if version_tuple(have) < version_tuple(HC_MIN):
            (bad if root_is_home else notes).append(f"hc is {have or 'unknown'}: Shepherdr {VERSION} needs {HC_MIN} or newer")
    if not shutil.which("git"):
        bad.append("git isn't on the PATH")
    # agent-browser isn't here: Shepherdr installs its own (ensure_agent_browser), doctor says how it stands
    optional = {"gh": "pull requests (tasks)", "tailscale": "the web app's private link", "jq": "the agents' question cards"}
    for name, what in optional.items():
        if not shutil.which(name):
            notes.append(f"optional: {name} isn't on the PATH ({what})")
    return bad, notes


# ---- the switch from 3.1 (the Herdr-window install) ---------------------------------------------------
# One hard switch: 3.2 has no layout, no window mods and no keys of its own in the Herdr app. An install that finds
# 3.1's record (OLD_RECORD) takes out what 3.1 put in the Herdr app and goes on as a plain install. The person's
# data is never touched: the app's data/, Shepherdr's own folders, settings, secrets, tasks.

def working_tasks(root):
    """The tasks a worker is on now (running, not archived), read from the task lists on disk: ["SHOP-3 Fix the
    cart"]. A scratch root has none."""
    w = where_for(root)
    out, seen = [], set()
    for folder in (w.path("tasks"), w.old("tasks")):
        real = os.path.realpath(folder)
        if real in seen or not os.path.isdir(folder):
            continue
        seen.add(real)
        for f in sorted(os.listdir(folder)):
            d = json_file(os.path.join(folder, f)) if f.endswith(".json") and not f.startswith(".") else None
            if not isinstance(d, dict) or not isinstance(d.get("tasks"), list):
                continue
            for t in d["tasks"]:
                if isinstance(t, dict) and t.get("state") == "running" and not t.get("archived"):
                    out.append(f"{d.get('prefix') or 'TASK'}-{t.get('id')} {t.get('title') or ''}".strip())
    return out



_REMOTE_WORKING = r'''import glob, json, os
home = os.path.expanduser("~")
base = os.environ.get("SHEPHERDR_HOME")
data = os.path.join(base, "data") if base and os.path.isabs(base) else os.path.join(os.environ.get("XDG_DATA_HOME") if os.path.isabs(os.environ.get("XDG_DATA_HOME", "")) else os.path.join(home, ".local/share"), "shepherdr")
seen, out = set(), []
for folder in (os.path.join(data, "tasks"), os.path.join(home, ".herdr/tasks")):
    real = os.path.realpath(folder)
    if real in seen: continue
    seen.add(real)
    for path in glob.glob(os.path.join(folder, "*.json")):
        try:
            with open(path) as f: doc = json.load(f)
            for task in doc.get("tasks", []):
                if task.get("state") == "running" and not task.get("archived"):
                    out.append("%s-%s %s" % (doc.get("prefix") or "TASK", task.get("id"), task.get("title") or ""))
        except (OSError, ValueError, AttributeError, TypeError):
            raise SystemExit("Could not read a task list")
print(json.dumps(out))'''

class UncheckedMachine(str):
    """A machine whose tasks could not be checked, distinct from a task title."""


def remote_working_tasks(root, run=subprocess.run):
    """Check every machine in the old session before replacing its task engine."""
    if os.path.realpath(root) != os.path.realpath(real_home()):
        return []
    env = {k: v for k, v in os.environ.items() if k not in ("HC_SESSION", "HC_SOCKET", "HC_TERMINAL_ID", "HC_TERMINAL_SOCKET", "HC_CORE_ID")}
    try:
        result = run(["hc", "machine", "ls", "--json"], capture_output=True, text=True, env=env, timeout=30)
        if result.returncode: raise ValueError("machine list unavailable")
        machines = json.loads(result.stdout)["machines"]
        out = []
        for m in machines:
            if m.get("temporary"): continue
            name = m.get("name")
            if not name or m.get("state") != "connected":
                out.append(UncheckedMachine("%s: cannot check its tasks" % (name or "a linked machine"))); continue
            r = run(["hc", "exec", "--on", name, "--timeout", "30", "python3", "-c", _REMOTE_WORKING], capture_output=True, text=True, env=env, timeout=40)
            if r.returncode: out.append(UncheckedMachine("%s: cannot check its tasks" % name)); continue
            tasks = json.loads(r.stdout)
            if not isinstance(tasks, list) or not all(isinstance(t, str) for t in tasks): raise ValueError("invalid task list")
            out.extend("%s: %s" % (name, t) for t in tasks)
        return out
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
        return [UncheckedMachine("linked machines: cannot check their tasks")]


def switch_blocked_message(prev, working):
    unchecked = [x for x in working if isinstance(x, UncheckedMachine)]
    busy = [x for x in working if not isinstance(x, UncheckedMachine)]
    parts = []
    if busy:
        parts.append(f"{len(busy)} task{'s are' if len(busy) != 1 else ' is'} still working on the old version:\n  " + "\n  ".join(busy[:40]))
    if unchecked:
        parts.append("Couldn't check these machines:\n  " + "\n  ".join(unchecked[:40]))
    return f"Shepherdr {VERSION} replaces {prev} in one switch. " + "\n".join(parts) + "\nNothing was changed. Try again once the tasks have finished and the machines can be checked (--force switches now)."

def carry_old(rec, old):
    """What of 3.1's record still stands after the switch: the files it put outside the Herdr app (Shepherdr's own
    folder, the role instructions, the service's unit), its port, the helpers it set aside, the files it made."""
    files = rec.setdefault("files", {})
    for rel, sha in (old.get("files") or {}).items():
        if not rel.startswith(f"{APP}/") and rel != f"{BIN}/herdr-app":
            files.setdefault(rel, sha)
    if old.get("port") and "port" not in rec:
        rec["port"] = old["port"]
    for rel, saved in (old.get("replaced") or {}).items():
        if rel.startswith(f"{BIN}/") and rel != f"{BIN}/herdr-app":
            rec.setdefault("replaced", {}).setdefault(rel, saved)
    for f in old.get("created") or []:
        if f not in rec.setdefault("created", []):
            rec["created"].append(f)


def leave_window(r, old, notices=None):
    """Takes out what a 3.1 install put in the Herdr app: its mods (and the art-<id> mods the old herdr-artifact
    wrote), its layout, lib/, core/, bin/, the keys it merged into keys.json (the person's from before put back) and
    the --guard link. A file the person changed, or put into one of those mods, is backed up first. The Herdr app
    is left working with its own layouts and mods. The old hooks go in set_hooks, the old links in link_helpers."""
    files = old.get("files") or {}
    mods = sorted(set(old.get("mods") or {}) | {rel[len(f"{APP}/mods/"):].split("/")[0] for rel in files if rel.startswith(f"{APP}/mods/")})
    mods = [m for m in mods if os.path.isdir(r.p(f"{APP}/mods/{m}"))]
    try:
        arts = sorted(d for d in os.listdir(r.p(f"{APP}/mods")) if d.startswith("art-") and os.path.isdir(r.p(f"{APP}/mods/{d}")))
    except OSError:
        arts = []
    rest = sorted(rel for rel in files if rel.startswith(f"{APP}/") and not rel.startswith(f"{APP}/mods/")
                  and rel != f"{APP}/keys.json" and read(r.p(rel)) is not None)
    guard = f"{BIN}/herdr-app"
    ours_guard = guard in files and fsha(guard, read(r.p(guard))) == files[guard]
    say(f"  switching from Shepherdr {old.get('version') or '3.1'} (the Herdr-window install): "
        f"{'would take' if r.dry else 'taking'} out its {len(mods)} mods"
        + (f", {len(arts)} artifact mod{'s' if len(arts) != 1 else ''}" if arts else "") + f", its layout and {len(rest)} other files in {APP}, "
        "its keys and its hooks; your data stays"
        + ("; a Herdr window showing them gets a notice in their place that Shepherdr lives in the web app" if notices else ""))
    if r.dry:
        return
    kept = 0
    for m in mods:
        top = f"{APP}/mods/{m}"
        for f in walk_files(r.p(top)):
            rel = f"{top}/{f}"
            if rel in files and fsha(rel, read(r.p(rel))) == files[rel]:
                continue   # as Shepherdr shipped it
            if f.endswith(".new") and rel[:-len(".new")] in files:
                continue   # Shepherdr's newer copy, left beside a file the person kept
            r.backup(rel)
            kept += 1
        try:
            if notices and m in RETIRED:
                swap_notice(r, m, notices)   # one swap, so a window showing it reloads once, into the stand-in
            else:
                shutil.rmtree(r.p(top))
        except OSError as e:
            raise Stop(f"can't remove {top} (Shepherdr 3.2 has no window mods): {e.strerror}. Fix that and run this again.")
    for d in arts:   # generated from the artifacts, which stay where they are (herdr-artifact convert makes them pages)
        r.backup(f"{APP}/mods/{d}", move=True)
    for rel in rest:
        if fsha(rel, read(r.p(rel))) != files[rel]:
            r.backup(rel)
            kept += 1
        os.remove(r.p(rel))
        if os.path.isfile(r.p(rel) + ".new"):
            os.remove(r.p(rel) + ".new")
    # the folders that held only ours: caches and sync-shared's notes go with them; anything else stays, and is said
    shutil.rmtree(r.p(f"{APP}/lib/.last"), ignore_errors=True)
    shutil.rmtree(r.p(f"{APP}/.shepherdr-stage"), ignore_errors=True)
    for top in ("lib", "core", "bin"):
        for d, dirs, names in os.walk(r.p(f"{APP}/{top}"), topdown=False):
            if os.path.basename(d) == "__pycache__":
                shutil.rmtree(d, ignore_errors=True)
                continue
            for n in names:
                if n in SKIP or n.endswith(".pyc"):
                    os.remove(os.path.join(d, n))
            try:
                os.rmdir(d)
            except OSError:
                pass
        if os.path.isdir(r.p(f"{APP}/{top}")):
            r.notes.append(f"{APP}/{top} holds files that aren't Shepherdr's: left as it is")
    take_keys_out(r, old)
    if ours_guard:
        os.remove(r.p(guard))
    put_back(r, {"replaced": {k: v for k, v in (old.get("replaced") or {}).items() if k.startswith(f"{APP}/") or k == guard}})
    r.notes.append(f"removed what 3.1 put in the Herdr app: {len(mods)} mods"
                   + (f", {len(arts)} artifact mod{'s' if len(arts) != 1 else ''} (kept in the backup)" if arts else "")
                   + ", the Shepherdr layout, lib/, core/, bin/, its keys and its hooks"
                   + (f"; {kept} file{'s' if kept != 1 else ''} you changed {'are' if kept != 1 else 'is'} in the backup" if kept else ""))


def notice_files(src, name):
    """The stand-in for one of 3.1's window views: {file in its folder: bytes}."""
    top = os.path.join(src, "herdr", NOTICE)
    return {"main.js": read(os.path.join(top, "full.js" if name in NOTICE_SHOWS else "blank.js")),
            "notice.js": read(os.path.join(top, "notice.js")), "mod.json": read(os.path.join(top, "mod.json"))}


def is_notice(r, name):
    """Whether the folder by that name in the Herdr app's mods is a stand-in (any version's)."""
    head = read(r.p(f"{APP}/mods/{name}/notice.js")) or b""
    return b"Shepherdr 3.1's window views, retired" in head[:400]


def swap_notice(r, name, src):
    """Puts the stand-in in the mod's place in one rename (what was there goes, after leave_window backed up yours)."""
    top = r.p(f"{APP}/mods/{name}")
    stage = r.p(f"{APP}/.shepherdr-stage/{name}")
    shutil.rmtree(stage, ignore_errors=True)
    os.makedirs(stage)
    for f, data in notice_files(src, name).items():
        with open(os.path.join(stage, f), "wb") as fh:
            fh.write(data)
    aside = None
    if os.path.lexists(top):
        aside = r.p(f"{APP}/.shepherdr-stage/{name}.old")
        shutil.rmtree(aside, ignore_errors=True)
        os.rename(top, aside)
    os.rename(stage, top)
    if aside:
        shutil.rmtree(aside, ignore_errors=True)


def window_ran(root, old=None):
    """3.1's window ran on this machine: a 3.1 record with mods, or Herdr's storage of its views."""
    if old and (old.get("mods") or any(rel.startswith(f"{APP}/mods/") for rel in (old.get("files") or {}))):
        return True
    return any(os.path.isdir(os.path.join(root, APP, "data", m)) for m in WINDOW_RAN)


def put_notices(r, rec, src):
    """SHEP-355: every one of 3.1's window views that isn't in its place gets its stand-in, and one there is brought up
    to date; a folder by that name that isn't one (someone's own mod) is left alone. Not after `shepherdr window
    --remove`. Said once, the first time."""
    if rec.get("notices_removed") or not os.path.isdir(os.path.join(src, "herdr", NOTICE)):
        return
    first = not rec.get("notices")
    done = []
    for name in RETIRED:
        top = r.p(f"{APP}/mods/{name}")
        if os.path.lexists(top) and not is_notice(r, name):
            continue
        if not r.dry and (not os.path.lexists(top) or any(read(os.path.join(top, f)) != d for f, d in notice_files(src, name).items())):
            os.makedirs(r.p(f"{APP}/mods"), exist_ok=True)
            swap_notice(r, name, src)
        done.append(name)
    if not r.dry:
        shutil.rmtree(r.p(f"{APP}/.shepherdr-stage"), ignore_errors=True)
    if not r.dry:
        rec["notices"] = done
    if done and first:
        r.notes.append(f"the Herdr window: Shepherdr's old views there {'would ' if r.dry else ''}now say Shepherdr lives in the web app, "
                       "with a button that opens it; nothing of yours stops. Herdr's own layout: Ctrl+Shift+L there. "
                       "`shepherdr window --remove` takes them out (offered, never needed)")


def take_notices_out(r, rec):
    """The stand-ins Shepherdr put in (rec "notices"), each only while it still is one. -> the names taken out."""
    out = []
    for name in rec.get("notices") or []:
        top = r.p(f"{APP}/mods/{name}")
        if name in RETIRED and os.path.isdir(top) and is_notice(r, name):
            if not r.dry:
                shutil.rmtree(top)
            out.append(name)
    return out


def forget_old_record(r):
    """3.1's record goes once the new one is written (its folder too, when it held nothing else)."""
    try:
        os.remove(r.p(OLD_RECORD))
        os.rmdir(os.path.dirname(r.p(OLD_RECORD)))
    except OSError:
        pass


def carry_env():
    """herdr-task carry-over's environment: no session of the caller's (it picks each one itself), but the caller's own
    terminal when that is in the default session (an agent there running the update), which it never ends."""
    env = {k: v for k, v in os.environ.items() if k not in ("HC_SESSION", "HC_SOCKET", "HC_TERMINAL_ID", "HC_TERMINAL_SOCKET", "HC_CORE_ID")}
    if os.environ.get("HC_TERMINAL_ID") and os.environ.get("HC_SESSION") in (None, "", "default"):
        env["SHEPHERDR_CARRY_CALLER"] = os.environ["HC_TERMINAL_ID"]
    return env


def agents_left_behind(root, run=subprocess.run):
    """doctor's lines for Shepherdr's agents (an Assistant, a task's agent) still in herdr-core's default session, where
    Shepherdr doesn't see them: the installed herdr-task's `carry-over --agents --dry-run`, read-only. [] when there
    are none, or it can't be asked (no hc, an older herdr-task)."""
    helper = os.path.join(root, SHARE, "mods", "tasks", "bin", "herdr-task")
    if not os.path.isfile(helper) or not shutil.which("hc"):
        return []
    try:
        p = run([sys.executable, helper, "carry-over", "--agents", "--dry-run", "--json"], capture_output=True, text=True,
                env=carry_env(), stdin=subprocess.DEVNULL, timeout=120)
        out = json.loads(p.stdout.strip().splitlines()[-1])
    except (OSError, subprocess.SubprocessError, ValueError, IndexError):
        return []
    rows = out.get("agents") if isinstance(out, dict) else None
    return [f"{x.get('name', 'an agent')} ({x.get('address')}) still runs in herdr-core's default session, outside Shepherdr: "
            + ("`herdr-task carry-over` moves it into Shepherdr's session" if x.get("state") == "would-move" else x.get("why") or "it stays there")
            for x in rows or [] if isinstance(x, dict)]


# SHEP-305: the records doctor checks for a machine id no machine has (shepherdr.web's is the host's own, rewritten by it)
STALE_RECORDS = {"shepherdr.secrets": ("Shepherdr's record of which machine keeps the secrets", "secrets, voice calls and dictation can't find them",
                                       "on the machine that has the secrets, run `shepherdr secrets move-to here --restore`"),
                 "shepherdr.host": ("Shepherdr's record of which machine serves the web app", "the machines can't agree which one serves it",
                                    "on the machine that should serve it, run `shepherdr web serve-from here`")}


def link_words(x):
    """SHEP-310: a link in Shepherdr's session that another herdr-core answers on (herdr-task carry-over's "links" row),
    in plain words with what to run."""
    fix = " && ".join(f"`{c}`" for c in x.get("fix") or [])
    head = (f"the link to {x['name']} is broken: a different herdr-core answers there now (it was set up again since it was linked), "
            f"so nothing reaches {x['name']}")
    if x.get("state") == "relinked":
        return f"the link to {x['name']} was broken (a different herdr-core answered there): linked again"
    if x.get("state") == "would-relink":
        return f"{head}: `herdr-task carry-over` links it again" + (f" (by hand: {fix})" if fix else "")
    return f"{head}; it wasn't linked again ({x.get('why') or 'it failed'})" + (f": run {fix}" if fix else "")


def records_naming_nobody(root, run=subprocess.run):
    """doctor's lines for a link another herdr-core answers on (SHEP-310), and for a record (who keeps the secrets, Serve from) in Shepherdr's session that names a machine by an
    id no machine has: the installed herdr-task's `carry-over --records --dry-run`, read-only. [] when none does, or it
    can't be asked (no hc, an older herdr-task)."""
    helper = os.path.join(root, SHARE, "mods", "tasks", "bin", "herdr-task")
    if not os.path.isfile(helper) or not shutil.which("hc"):
        return []
    try:
        p = run([sys.executable, helper, "carry-over", "--records", "--dry-run", "--json"], capture_output=True, text=True,
                env=carry_env(), stdin=subprocess.DEVNULL, timeout=120)
        out = json.loads(p.stdout.strip().splitlines()[-1])
    except (OSError, subprocess.SubprocessError, ValueError, IndexError):
        return []
    lines = [link_words(x) for x in (out.get("links") if isinstance(out, dict) else None) or [] if isinstance(x, dict) and x.get("name")]
    for x in (out.get("records") if isinstance(out, dict) else None) or []:
        if not isinstance(x, dict) or x.get("name") not in STALE_RECORDS or x.get("state") not in ("would-repair", "unknown"):
            continue
        what, harm, fix = STALE_RECORDS[x["name"]]
        on = f" on {x['machine']}" if x.get("machine") else ""
        if x["state"] == "would-repair":
            lines.append(f"{what}{on} still names a machine by its id from before 3.2, so {harm}: `herdr-task carry-over` changes it to that machine's id now")
        else:
            lines.append(f"{what}{on} names a machine none here knows (id {str(x.get('id'))[:12]}), so {harm}: "
                         f"`herdr-task carry-over` repairs it when the old id is still known; if it stays, {fix}")
    return lines


def carry_over_session(r, rec, home, run=subprocess.run, links_only=False):
    """At the switch, once the files are in place and before the service starts: what 3.1 kept in herdr-core's
    default session (the shared document with the spaces, who keeps the secrets, Serve from, the window's spaces,
    the machines) goes into Shepherdr's own session, and 3.1's scheduler there is removed: the new herdr-task's own
    `carry-over`, which replaces nothing and is safe to run again. Only on the real home: a scratch root has no
    herdr-core of its own. Never stops the install: what didn't go is a note, and the record says so (rec
    "carry_over": "done" | "waiting"), so the next update tries again. links_only (SHEP-310, every other update): only
    the links another herdr-core answers on, linked again where safe (`carry-over --links`), else a note with the fix."""
    if not home:
        return
    if r.dry:
        say("  session: would " + ("link again any machine another herdr-core answers on (herdr-task carry-over --links)" if links_only else
                                   "carry Shepherdr's documents and machines over from herdr-core's default session (herdr-task carry-over)"))
        return
    helper = r.p(f"{SHARE}/mods/tasks/bin/herdr-task")
    env = carry_env()
    out, err = None, ""
    if links_only:
        try:
            p = run([sys.executable, helper, "carry-over", "--links", "--json"], capture_output=True, text=True, env=env, stdin=subprocess.DEVNULL, timeout=300)
            out = json.loads(p.stdout.strip().splitlines()[-1]) if p.stdout.strip() else None
        except (OSError, subprocess.SubprocessError, ValueError, IndexError):
            out = None   # an older herdr-task has no --links: nothing to say
        say_links(r, out if isinstance(out, dict) else {})
        return
    try:
        p = run([sys.executable, helper, "carry-over", "--json"], capture_output=True, text=True, env=env, stdin=subprocess.DEVNULL, timeout=300)
        err = p.stderr.strip()
        out = json.loads(p.stdout.strip().splitlines()[-1]) if p.stdout.strip() else None
    except (OSError, subprocess.SubprocessError, ValueError, IndexError) as e:
        err = err or str(e)
    if not isinstance(out, dict):
        rec["carry_over"] = "waiting"
        r.notes.append(f"Shepherdr's data in herdr-core's default session wasn't carried over ({(err.splitlines() or ['herdr-task carry-over failed'])[-1]}): "
                       "`herdr-task carry-over` tries again")
        return
    say_links(r, out)
    rows = (out.get("machines") or []) + (out.get("documents") or [])
    agents = out.get("agents") or []
    label = lambda x: x.get("name", "?") + (f" on {x['machine']}" if x.get("machine") else "")
    copied = [label(x) for x in rows if x.get("state") in ("copied", "added")]
    moved = [x.get("name", "?") for x in agents if x.get("state") == "moved"]
    if moved:
        say("  session: moved into Shepherdr's own session: " + ", ".join(moved))
    # SHEP-295: an agent of Shepherdr's that stays in the default session is said in plain words, with what to do
    for x in agents:
        if x.get("state") != "moved":
            r.notes.append(f"{x.get('name', 'an agent')} ({x.get('address')}) still runs in herdr-core's default session, outside Shepherdr"
                           + (f": {x['why']}" if x.get("why") else ""))
    rec["carry_over_agents"] = "done" if all(x.get("state") == "moved" for x in agents) else "waiting"
    left = [label(x) + (f" ({x.get('why') or x.get('error')})" if x.get("why") or x.get("error") else "")
            for x in rows if x.get("state") in ("waiting", "failed", "wrong-session")]
    say("  session: " + (f"carried over {', '.join(copied)}" if copied else "nothing to carry over")
        + ("; 3.1's scheduler removed" if out.get("scheduler") == "removed" else ""))
    records = out.get("records") or []
    fixed = [x.get("name", "?") + (f" on {x['machine']}" if x.get("machine") else "") for x in records if x.get("state") == "repaired"]
    if fixed:
        say("  session: changed to each machine's id now (it named one by its id from before 3.2): " + ", ".join(fixed))
    # SHEP-305: a record naming a machine none here knows is said with its fix; doctor says it too
    for x in records:
        if x.get("state") == "unknown" and x.get("name") in STALE_RECORDS:
            what, harm, fix = STALE_RECORDS[x["name"]]
            r.notes.append(f"{what} names a machine none here knows, so {harm}: {fix}")
    left += [x.get("name", "?") + (f" on {x['machine']}" if x.get("machine") else "") + f" ({x.get('why') or 'not changed'})"
             for x in records if x.get("state") in ("waiting", "failed")]
    if left or out.get("scheduler") == "failed":
        r.notes.append("not carried over into Shepherdr's own herdr-core session yet: " + "; ".join(left or ["3.1's scheduler in the default session"])
                       + ". The next update, or `herdr-task carry-over`, tries again")
    rec["carry_over"] = "waiting" if left or not out.get("ok", True) else "done"
    # an older herdr-task says no records: it doesn't look at them, and the next update asks again
    rec["carry_over_records"] = "done" if "records" in out and not any(x.get("state") in ("waiting", "failed") for x in records) else "waiting"


def say_links(r, out):
    """carry-over's "links" rows (SHEP-310): one linked again is said; one that wasn't is a note with the commands. Its
    records that followed are said too."""
    for x in out.get("links") or []:
        if not isinstance(x, dict) or not x.get("name"):
            continue
        if x.get("state") == "relinked":
            say(f"  session: {link_words(x)}")
        else:
            r.notes.append(link_words(x))
    if "machines" not in out:  # --links alone: the records that followed a machine linked again
        fixed = [x.get("name", "?") + (f" on {x['machine']}" if x.get("machine") else "") for x in out.get("records") or [] if x.get("state") == "repaired"]
        if fixed:
            say("  session: changed to the id of the machine linked again: " + ", ".join(fixed))


def convert_artifacts(r):
    """Once, at the switch: the artifacts 3.1 kept (recipes, window panels) become plain pages, by the new
    herdr-artifact's own `convert --all` when it has one. Never stops the install: a failure is a note."""
    helper = r.p(f"{SHARE}/mods/artifacts/bin/herdr-artifact")
    if b'"convert"' not in (read(helper) or b""):
        return
    if r.dry:
        say("  artifacts: would turn the old ones into pages (herdr-artifact convert --all)")
        return
    try:
        p = subprocess.run([sys.executable, helper, "convert", "--all"], capture_output=True, text=True,
                           env=browser_env(r.root), stdin=subprocess.DEVNULL, timeout=900)
        out = (p.stdout.strip() or p.stderr.strip()).splitlines()
        line, ok = (out[-1] if out else ""), p.returncode == 0
    except (OSError, subprocess.SubprocessError) as e:
        line, ok = str(e), False
    if ok:
        say(f"  artifacts: {line}" if line else "  artifacts: converted")
    else:
        r.notes.append(f"the old artifacts weren't turned into pages ({line or 'herdr-artifact convert failed'}): "
                       "`herdr-artifact convert --all` tries again")


def cmd_install(a, update=False):
    root = os.path.realpath(a.root or real_home())
    home = root == os.path.realpath(real_home())
    r = Run(root, a.dry_run)
    rec = load_record(root) or {}
    old = old_record(root)
    if update:
        # from where it was installed (a checkout, or Serve from's copy), never from the installed folder itself
        if not rec and not old:
            raise Stop(f"Shepherdr isn't installed under {root}: run ./install.sh first")
        given = a.source or (rec or old).get("source")
        if not a.source and (not is_source(given) or os.path.realpath(given) == os.path.realpath(r.p(SHARE))):
            raise Stop(f"the Shepherdr it was installed from ({given}) is gone: clone it again and run "
                       "./install.sh there, or pass --source <checkout>")
        src = find_source(given, None)
    else:
        src = find_source(a.source, None)
    bad, notes = check_tools(home)
    if bad and not a.force:
        raise Stop("can't install yet:\n  " + "\n  ".join(bad) + "\n(--force installs anyway)")
    # From 3.1 or older (either kind of install): one hard switch. Tasks that are working finish on the old version first.
    prev = (rec or old or {}).get("version")
    switching = bool(prev) and version_tuple(prev)[:2] < (3, 2)
    working = (working_tasks(root) + remote_working_tasks(root)) if switching else []
    if working and not a.force and not a.dry_run:
        raise Stop(switch_blocked_message(prev, working))
    say(f"Shepherdr {VERSION} {'update' if update else 'install'} from {src}")
    say(f"  into {root}{' (dry run: nothing is written)' if a.dry_run else ''}")
    if working:
        (say if a.dry_run else r.notes.append)(("  still working (the switch waits for them, or --force): " if a.dry_run else
                                                 "switched while these tasks were working (--force): ") + ", ".join(working[:40]))
    if getattr(a, "guard", False):
        r.notes.append("--guard does nothing since 3.2: Shepherdr has no Herdr window to guard")
    build_web(r, src, home, a)
    if old:
        carry_old(rec, old)
    # 3.1's web-only install kept whole backup folders; only the helpers it set aside are put back on uninstall
    for b in rec.pop("backups", []):
        for name in LINKS:
            if os.path.lexists(os.path.join(b, BIN, name)):
                rec.setdefault("replaced", {}).setdefault(f"{BIN}/{name}", os.path.join(b, BIN, name))
    app = herdr_app_here(root)
    actions, _ = plan_files(r, rec, source_items(src, root) + (button_items(src) if app else []), a.adopt)
    # Shepherdr's own folder is replaced whole (a copy changed there is backed up); the button's name taken by
    # someone else's mod is left alone unless --adopt
    button = app and any(x[0] == "button" for x in actions)
    if any(x[0] == "button" and x[2] == "clash" for x in actions):
        button = False
        r.notes.append(f"{APP}/mods/{BUTTON} isn't Shepherdr's: left alone, so Herdr gets no \"Open Shepherdr\" button (--adopt backs it up and takes it over)")
    actions = [(g, rel, "replace" if g == "share" and how in ("keep", "clash", "adopt") else how, data, mode)
               for g, rel, how, data, mode in actions if g != "button" or button]
    old_files = rec.get("files", {})
    shipped = {x[1] for x in actions}
    # Shipped before, not any more: retired. Changed or not, it goes; a changed one is backed up first and said (#895).
    gone = [rel for rel in old_files if rel not in shipped and rel not in MANAGED]
    counts = {}
    for x in actions:
        counts[x[2]] = counts.get(x[2], 0) + 1
    say("  files: " + ", ".join(f"{n} {k}" for k, n in sorted(counts.items())) + (f", {len(gone)} removed" if gone else ""))
    touches_tools = any(how in ("new", "update", "replace", "adopt") and (g == "template" or rel.startswith((f"{SHARE}/bin/", f"{SHARE}/mods/", f"{SHARE}/hooks/")))
                        for g, rel, how, _, _ in actions)
    if a.dry_run:
        for g, rel, how, _, _ in actions:
            if how != "same":
                say(f"  {how:7} {rel}")
        for rel in gone:
            say(f"  remove  {rel}")
    # The sync to other machines waits until doctor finds this whole.
    if touches_tools and not a.dry_run:
        for p in hold_paths(root):
            atomic_write(p, f"held by shepherdr {VERSION} install at {r.stamp}: run `shepherdr doctor`\n".encode())
        r.notes.append("the sync to other machines is held until `shepherdr doctor` finds the install whole")
    # SHEP-295: the running service stops while files move (this is the new installer's side: an older installed
    # copy hands an update over to the source's own bin/shepherdr first, hand_over), and starts again after
    stopped = stop_service(r, home)
    try:
        return finish_install(a, r, rec, old, src, home, root, actions, old_files, gone, button, notes, switching)
    finally:
        if stopped and not r.service_started:
            start_service(r)


def finish_install(a, r, rec, old, src, home, root, actions, old_files, gone, button, notes, switching):
    """cmd_install from the first file it changes on: the service is stopped meanwhile (stop_service)."""
    wants_notices = herdr_app_here(root) and window_ran(root, old)
    if old:
        leave_window(r, old, src if wants_notices and not rec.get("notices_removed") else None)
    if wants_notices or rec.get("notices"):
        put_notices(r, rec, src)
    files = dict(old_files)
    for g, rel, how, data, mode in actions if not a.dry_run else []:
        if how == "keep":
            atomic_write(r.p(rel) + ".new", data, mode)
            r.notes.append(f"kept your {rel}; Shepherdr's is beside it as {os.path.basename(rel)}.new")
            continue
        if how == "replace":
            dest = r.backup(rel)
            if rel in old_files:
                r.notes.append(f"replaced {rel}, which was changed since the install (Shepherdr's own folder is replaced whole); "
                               f"the changed copy is kept as {dest}")
        elif how == "adopt":
            rec.setdefault("replaced", {}).setdefault(rel, r.backup(rel, move=True))
        elif how == "update" and g == "template":
            r.backup(rel)
        if how != "same":
            atomic_write(r.p(rel), data, mode)
        files[rel] = fsha(rel, data)
    for rel in gone if not a.dry_run else []:
        cur = read(r.p(rel))
        if cur is not None and fsha(rel, cur) != old_files[rel]:
            dest = r.backup(rel)
            r.notes.append(f"removed {rel}: Shepherdr no longer ships it; your changed copy is in {dest}")
        if cur is not None:
            try:
                os.remove(r.p(rel))
            except OSError as e:
                raise Stop(f"can't remove {rel} (Shepherdr no longer ships it): {e.strerror}. Fix that and run the update again.")
            prune_dirs(r, rel)
        files.pop(rel, None)
    rec["files"] = files
    rec["links"] = link_helpers(r, rec, list((rec.get("links") or {}).values()) + list(((old or {}).get("links") or {}).values()))
    if button:
        rec["keys"] = merge_key(r, rec)
    elif rec.get("keys") and not a.dry_run:
        take_keys_out(r, rec)
        rec["keys"] = {}
    rec["button"] = bool(button)
    rec["hooks"] = set_hooks(r, rec, None if a.no_hooks else True)
    move_data(r, a, home)   # before the service starts again: it then finds the data where it now is
    keep_instructions(r, a, root)   # SHEP-319: written Instructions into a plain file, said once
    move_repo_settings(r, a, root)   # SHEP-335: the spaces' task settings to the repos their tasks work in, said once
    # SHEP-305: an install switched by 3.2.0 has no carry_over_records yet: its records may name old ids, so once more
    if switching or rec.get("carry_over") == "waiting" or rec.get("carry_over_agents") != "done" or rec.get("carry_over_records") != "done":
        carry_over_session(r, rec, home)   # and its documents and machines in Shepherdr's own herdr-core session
    else:
        carry_over_session(r, rec, home, links_only=True)   # SHEP-310: a link another herdr-core answers on, linked again
    set_port(a, rec)
    set_https_port(a, root)
    started = time.time()
    install_service(r, rec, home)
    say_web(root, home, a, started)
    ensure_agent_browser(r, home)
    ensure_agent_desktop(r, home)
    if switching:
        convert_artifacts(r)
    rec.update({"version": VERSION, "source": src, "at": r.stamp, "root": root})
    rec.pop("web", None)
    rec.pop("mods", None)
    whole_bad = []
    if not a.dry_run:
        save_record(root, rec)
        if old:
            forget_old_record(r)
        whole_bad = install_checks(r, rec)[0]
    for n in r.notes + notes:
        say(f"  - {n}")
    if a.dry_run:
        return 0
    if r.backed:
        say(f"  backup of what it replaced: {r.backup_dir}")
    if whole_bad:
        # loud: the files went in, but doctor would fail the install, and every later update would too (#905)
        for x in whole_bad:
            say(f"  ✗ {x}")
        say("  NOT DONE: the install isn't whole. Fix the ✗ lines above, then run `shepherdr doctor`" + ("" if home else f" --root {root}") + ".")
        return 0
    say("  done. Next: `shepherdr doctor`" + ("" if home else f" --root {root}")
        + (", then open Shepherdr in a browser (`shepherdr web status` says its link)." if home else "."))
    if rec.get("keys"):
        say("  In Herdr, Ctrl+Shift+O opens the \"Open Shepherdr\" button.")
    if old:
        say("  Shepherdr's layout is gone from Herdr: pick another layout there (Ctrl+Shift+L) if Shepherdr's was selected.")
    return 0


# ---- doctor -------------------------------------------------------------------------------------

def short(p):
    h = real_home()
    return "~" + p[len(h):] if p.startswith(h + "/") else p


def data_check(root):
    """Where Shepherdr's data is (layout.py): (bad, notes). Not moved while it should be holds the sync."""
    L = layout_mod()
    w = where_for(root)
    st = L.status(home=root, env=None if w.env is os.environ else {})
    bad, notes = [], []
    if st["layout"] > L.LAYOUT:
        bad.append(f"the data here is on layout {st['layout']}, newer than this Shepherdr knows: update Shepherdr")
    elif st["rolled_back"]:
        notes.append("data: rolled back to ~/.herdr (`shepherdr migrate` moves it to Shepherdr's own folders again)")
    elif not st["migrated"]:
        if st["shared_disk"]:
            notes.append(f"data: stays in ~/.herdr: {st['shared_disk']} (a network disk); `shepherdr migrate --force` moves it")
        else:
            bad.append("data: not moved to Shepherdr's own folders yet: run `shepherdr migrate` (`shepherdr where` shows the plan)")
    else:
        r = st["roots"]
        notes.append(f"data: Shepherdr's own folders (layout {st['layout']}): {short(r['config'])}, {short(r['data'])}, {short(r['state'])}")
        odd = {k: v["state"] for k, v in st["kinds"].items() if "!" in v["state"] or "plain copy" in v["state"]}
        for k, s in sorted(odd.items()):
            (bad if "!" in s else notes).append(f"data: {k}: {s}")
        kept = [k for k, v in st["kinds"].items() if v["state"].startswith("kept")]
        if kept:
            notes.append(f"data: {', '.join(kept)} kept where they were (another disk); the new paths link there")
        if not (st["journal"] or {}).get("cleaned"):
            notes.append("data: the old paths in ~/.herdr link to the new ones, for older Shepherdr copies (until `shepherdr migrate --cleanup-legacy`)")
    if st["worktrees"]["old_left"] and st["worktrees"]["new"] != st["worktrees"]["old"]:
        notes.append(f"worktrees: {st['worktrees']['old_left']} still in {short(st['worktrees']['old'])} (they stay until their tasks finish); "
                     f"new ones go to {short(st['worktrees']['new'])}")
    return bad, notes


def say_web(root, home, a, since):
    """After the service (re)started here: the web app's link, or tailscale's own reason it isn't shared (GitHub #754)."""
    if a.dry_run or not home or not has_unit(root) or not shutil.which("tailscale"):
        return
    w = web_outcome(root, since)
    if not w or not w.get("on"):
        return
    if w.get("share_error"):
        say(f"  ✗ the web app isn't shared: {w['share_error']}")
    elif w.get("link") and not (w.get("serve") or {}).get("host"):
        say(f"  web app: {w['link']}")


def serve_check(root):
    """Serve from: which machine serves the web app (what the service last wrote, web.json), and /shepherdr shared here
    only while this machine serves it. Returns (bad, notes)."""
    try:
        w = json.load(open(service_file(root, "web.json")))
    except (OSError, ValueError):
        return [], [f"the service hasn't said where the web app is served yet ({service_file(root, 'web.json')})"]
    sv = w.get("serve") or {}
    host = sv.get("host")
    notes = [f"web app: served from {host or 'this machine'}" + (f", {w['link']}" if w.get("link") else "")]
    bad = []
    if sv.get("error"):
        bad.append(f"the last move didn't finish: {sv['error']}")
    if w.get("share_error"):
        # tailscale serve refused it here: its own words, and another port when the HTTPS port is taken (GitHub #754)
        bad.append(f"web app isn't shared: {w['share_error']}")
    elif w.get("why"):
        notes.append(f"web app: {w['why']}")
    if w.get("https_port", 443) != 443:
        notes.append(f"web app: on tailnet HTTPS port {w['https_port']} (shepherdr web https-port 443 goes back)")
    if host and not sv.get("reachable"):
        notes.append(f"{host} can't be reached now: this machine keeps its own copy of the shared data until it's back")
    tailscale = shutil.which("tailscale")
    if host and tailscale:
        p = subprocess.run([tailscale, "serve", "status", "--json"], capture_output=True, text=True)
        try:
            for web in (json.loads(p.stdout or "{}").get("Web") or {}).values():
                if ((web.get("Handlers") or {}).get("/shepherdr") or {}).get("Proxy", "").endswith(f":{our_port(root)}"):
                    bad.append(f"/shepherdr is still shared from here while {host} serves it: two links")
        except ValueError:
            pass
    return bad, notes


def update_hint(rec):
    """How this install updates: from the checkout it came from, or (Serve from) from the machine that sent it."""
    src = rec.get("source") or ""
    if os.path.basename(src) == "shepherdr-src":
        return "to update: from the machine that installed it here, `shepherdr web install-on <this machine>`"
    if not is_source(src):
        return f"to update: the Shepherdr it was installed from ({src}) is gone: clone it again and run ./install.sh there"
    pull = f"`git -C {src} pull --ff-only`, then " if os.path.exists(os.path.join(src, ".git")) else ""
    return f"to update: {pull}`shepherdr update`"


def github_checks_check(root):
    """SHEP-179: doctor's warnings for repos with tasks whose pull requests' checks this machine's GitHub token can't
    read (a fine-grained token without Checks or Commit statuses read): their tasks would never see them pass.
    Asks GitHub once per repo; GitHub not answering (no network) leaves what herdr-task last saw there."""
    gh = os.environ.get("HERDR_TASK_GH") or shutil.which("gh")
    try:
        folder = where_for(root).path("tasks")
        names = sorted(f for f in os.listdir(folder) if f.endswith(".json"))
    except (OSError, ValueError, AttributeError):
        return []
    if not gh:
        return []
    out, seen = [], set()
    for f in names:
        try:
            with open(os.path.join(folder, f)) as fh:
                d = json.load(fh)
        except (OSError, ValueError):
            continue
        repo = (d.get("github") or {}).get("repo") if isinstance(d, dict) else None
        if not repo or repo in seen or not d.get("tasks"):
            continue
        seen.add(repo)
        missing, unsure = [], False
        for path, what in (("check-runs?per_page=1", "Checks: read"), ("status", "Commit statuses: read")):
            try:
                p = subprocess.run([gh, "api", f"repos/{repo}/commits/HEAD/{path}"], capture_output=True, text=True, timeout=20)
            except (OSError, subprocess.SubprocessError):
                unsure = True
                continue
            err = (p.stderr + p.stdout).lower()
            if p.returncode and ("resource not accessible" in err or "http 403" in err):
                missing.append(what)
            elif p.returncode:
                unsure = True
        if unsure and not missing and (d.get("github_checks") or {}).get("denied"):
            missing = ["Checks: read", "Commit statuses: read"]
        if missing:
            out.append(f"GitHub checks on {repo} can't be read here: its tasks can't see them pass. "
                       f"Give this machine's GitHub token {' and '.join(missing)} on {repo}")
    return out


def install_checks(r, rec):
    """What makes an install whole, as doctor and the end of an install check it: each recorded file is there, the links
    lead to it, the one-file helpers carry layout.py's paths (sync-shared --check), herdr-task compiles, the hooks are
    in. -> (bad, warn): bad fails the install; warn is said and goes on."""
    bad, warn = [], []
    for rel, sha in sorted(rec.get("files", {}).items()):
        have = read(r.p(rel))
        if have is None:
            bad.append(f"missing: {rel}")
        elif fsha(rel, have) != sha:
            warn.append(f"changed since install (kept): {rel}" + (f"; Shepherdr's newer one is beside it as {os.path.basename(rel)}.new:"
                                                                     " merge it in, then remove the .new" if os.path.exists(r.p(rel) + ".new") else ""))
    for name, dest in rec.get("links", {}).items():
        path = r.p(f"{BIN}/{name}")
        if not os.path.islink(path) or os.path.realpath(path) != os.path.realpath(dest):
            bad.append(f"link {BIN}/{name} doesn't lead to {dest}")
    sync = r.p(f"{SHARE}/bin/sync-shared")
    if os.path.isfile(sync):
        p = subprocess.run([sys.executable, sync, "--check"], capture_output=True, text=True)
        if p.returncode != 0:
            bad.append("the helpers' paths differ: " + (p.stderr.strip() or p.stdout.strip()).replace("\n", "; "))
    pkg = r.p(f"{SHARE}/mods/tasks/bin/herdr_task")
    for f in sorted(os.listdir(pkg)) if os.path.isdir(pkg) else []:
        if f.endswith(".py"):
            try:
                compile(read(os.path.join(pkg, f)), os.path.join(pkg, f), "exec")
            except SyntaxError as e:
                bad.append(f"herdr-task doesn't compile: {e}")
    for f, event, cmd in rec.get("hooks", []):
        if cmd not in (read(r.p(f)) or b"").decode(errors="replace").replace("\\'", "'"):
            warn.append(f"hook missing in {f} ({event}): questions from that CLI won't reach the chat")
    return bad, warn


def cmd_doctor(a):
    root = os.path.realpath(a.root or real_home())
    home = root == os.path.realpath(real_home())
    rec = load_record(root)
    if not rec:
        old = old_record(root)
        if old:
            raise Stop(f"Shepherdr {old.get('version')} (the Herdr-window install) is under {root}: Shepherdr {VERSION} replaces it in one "
                       f"switch. Run ./install.sh from a {VERSION} checkout (or `shepherdr update`) first.")
        raise Stop(f"Shepherdr isn't installed under {root}")
    r = Run(root, True)
    bad, warn = install_checks(r, rec)
    if old_record(root):
        warn.append(f"{OLD_RECORD} is still there (a 3.1 install's record): run the install again to finish the switch")
    t_bad, t_notes = check_tools(home)
    bad += t_bad
    if home:
        warn += github_checks_check(root)
    d_bad, d_notes = data_check(root)
    bad += d_bad
    # SHEP-295: a unit an older install wrote lacks HC_SESSION, and the service's agents then start outside Shepherdr's session
    unit_bad = unit_session_problem(root) if has_unit(root) else None
    if unit_bad:
        (warn if managed_unit(root) else bad).append(unit_bad)
    if home:
        agents_bad = agents_left_behind(root)
        bad += agents_bad
        bad += records_naming_nobody(root)
    t_notes = d_notes + t_notes
    n_line = notices_line(root, rec)
    if n_line:
        t_notes.append(n_line)
    if home:
        s_bad, s_notes = serve_check(root)
        bad += s_bad
        # installed but not answering (a busy port crash-loops it, GitHub #635): not whole
        if has_unit(root):
            up, why = service_answers(root)
            bad += [] if up else [why]
        else:
            bad.append("the Shepherdr service isn't set up to run here (it needs bun, https://bun.sh): run the install again")
        t_notes += s_notes
    say(f"Shepherdr {rec.get('version')} under {root} (from {rec.get('source')}, {rec.get('at')})")
    for x in bad:
        say(f"  ✗ {x}")
    ab = agent_browser_state(root)
    ad = agent_desktop_state(root, home)
    cs = codex_sandbox_state(home)
    for x in warn + t_notes + ([ab] if ab else []) + ad + ([cs] if cs else []) + [update_hint(rec)]:
        say(f"  - {x}")
    holds = [p for p in hold_paths(root) if os.path.exists(p)]
    if bad:
        if holds:
            say("  the sync to other machines stays held until these are fixed")
        return 1
    if holds:
        for p in holds:
            os.remove(p)
        say("  ✓ whole: the sync to other machines may go again")
    else:
        say("  ✓ whole")
    return 0


# ---- window -------------------------------------------------------------------------------------

def notices_line(root, rec):
    """doctor's line on the Herdr window's notices (SHEP-355), or None."""
    r = Run(root, True)
    here = [n for n in rec.get("notices") or [] if is_notice(r, n)]
    if here:
        return (f"the Herdr window: {len(here)} of Shepherdr 3.1's old views show a notice that Shepherdr lives in the web app "
                "(nothing breaks there; Herdr's own layout: Ctrl+Shift+L). `shepherdr window --remove` takes them out, once "
                "you closed the old Assistant tabs")
    if not rec.get("notices_removed") and herdr_app_here(root) and window_ran(root):
        return ("the Herdr window ran Shepherdr 3.1's views here and has no notices in their place: a window still showing "
                "them shows red errors. Run `shepherdr update` to put them in, or pick Herdr's own layout there (Ctrl+Shift+L)")
    return None


def cmd_window(a):
    root = os.path.realpath(a.root or real_home())
    rec = load_record(root)
    if not rec:
        raise Stop(f"Shepherdr isn't installed under {root}")
    if not a.remove:
        say(notices_line(root, rec) or "the Herdr window has no Shepherdr notices in it")
        return 0
    r = Run(root, False)
    gone = take_notices_out(r, rec)
    rec["notices"] = []
    rec["notices_removed"] = True
    save_record(root, rec)
    say(f"took out {len(gone)} notice{'s' if len(gone) != 1 else ''} from the Herdr window; updates won't put them back."
        + (" An old Assistant tab still open in Herdr now says it can't load: close it." if "chat" in gone else ""))
    return 0


# ---- uninstall ----------------------------------------------------------------------------------

def cmd_uninstall(a):
    root = os.path.realpath(a.root or real_home())
    home = root == os.path.realpath(real_home())
    rec = load_record(root)
    old = old_record(root)
    if not rec and not old:
        raise Stop(f"Shepherdr isn't installed under {root}")
    r = Run(root, a.dry_run)
    rec = rec or {}
    links = dict(rec.get("links") or {})
    if old:
        # a 3.1 install (never switched, or left half-way): what it put in the Herdr app goes as at the switch
        carry_old(rec, old)
        links.update({k: v for k, v in (old.get("links") or {}).items() if k not in links})
        rec.setdefault("hooks", old.get("hooks") or [])
        leave_window(r, old)
    files = rec.get("files", {})
    kept = []
    # The service stops first (only the real home's runs).
    if home and not a.dry_run:
        if sys.platform == "darwin":
            subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}/{AGENT}"], capture_output=True)
        elif not managed_unit(root):   # someone else's unit (#1048) is theirs to stop
            subprocess.run(["systemctl", "--user", "disable", "--now", "shepherdr.service"], capture_output=True)
    # Each file as Shepherdr left it goes; one changed since (a role instruction of yours) stays.
    for rel, sha in sorted(files.items()):
        cur = read(r.p(rel))
        if cur is None:
            continue
        if fsha(rel, cur) != sha:
            kept.append(rel)
        elif not a.dry_run:
            os.remove(r.p(rel))
        if os.path.isfile(r.p(rel) + ".new") and not a.dry_run:   # Shepherdr's newer copy, left beside a kept file
            os.remove(r.p(rel) + ".new")
    # The button's folder in the Herdr app, when only Herdr's own editor files are left in it.
    top = r.p(f"{APP}/mods/{BUTTON}")
    if rec.get("button") and os.path.isdir(top) and not walk_files(top) and not a.dry_run:
        shutil.rmtree(top)
    take_notices_out(r, rec)
    take_keys_out(r, rec)
    # Links: ours removed, anything they replaced put back.
    for name, dest in links.items():
        p = r.p(f"{BIN}/{name}")
        if os.path.islink(p) and os.path.realpath(p) == os.path.realpath(dest) and not a.dry_run:
            os.remove(p)
    put_back(r, rec)
    set_hooks(r, rec, False)
    if not a.dry_run:
        if home:
            restore_share(root)
        for p in hold_paths(root):
            try:
                os.remove(p)
            except FileNotFoundError:
                pass
        for p in (r.p(RECORD), r.p(OLD_RECORD)):
            try:
                os.remove(p)
            except FileNotFoundError:
                pass
        # the agent-browser Shepherdr installed for the task browser (not data: nothing of the person's is in it)
        shutil.rmtree(os.path.join(where_for(root).roots["data"], "agent-browser"), ignore_errors=True)
        shutil.rmtree(os.path.join(where_for(root).roots["data"], "agent-desktop"), ignore_errors=True)
        # Folders that only held ours.
        for rel in (f"{APP}/data/shepherdr", SHARE):
            for d, _, _ in sorted(os.walk(r.p(rel)), reverse=True):
                try:
                    os.rmdir(d)
                except OSError:
                    pass
    say(f"Shepherdr uninstalled from {root}{' (dry run)' if a.dry_run else ''}. Shepherdr's data folders (`shepherdr where` listed them) and your own changes stay.")
    for n in r.notes:
        say(f"  - {n}")
    for k in kept:
        say(f"  kept (changed or yours): {k}")
    if r.backed:
        say(f"  what it set aside is in {r.backup_dir}")
    return 0


# ---- web: Serve from --------------------------------------------------------------------------------

def restore_share(root):
    """/shepherdr as it was before a move here took it (serve-from --take-link kept it in replaced-share.json)."""
    f = service_file(root, "replaced-share.json")
    try:
        old = json.load(open(f))
    except (OSError, ValueError):
        return
    tailscale = shutil.which("tailscale")
    if not tailscale or not str(old.get("port", "")).isdigit() or not str(old.get("proxy", "")).startswith("http://127.0.0.1:"):
        return
    subprocess.run([tailscale, "serve", f"--https={old['port']}", "--set-path", "/shepherdr", "off"], capture_output=True)
    if subprocess.run([tailscale, "serve", "--bg", f"--https={old['port']}", "--set-path", "/shepherdr", old["proxy"]], capture_output=True).returncode == 0:
        os.remove(f)
        say(f"  /shepherdr is shared to {old['proxy']} again, as before")


def web_source():
    """A whole source to install another machine from: this machine's installed Shepherdr folder, else the checkout."""
    share = os.path.join(real_home(), SHARE)
    if os.path.isfile(os.path.join(share, "install.sh")) and os.path.isfile(os.path.join(share, "web", "dist", "index.html")):
        return share
    src = find_source(None, load_record(real_home()) or None)
    if not os.path.isfile(os.path.join(src, "web", "dist", "index.html")):
        raise Stop(f"the web app isn't built in {src} (bun install && bun run build)")
    return src


def pack(src):
    """An install's source as one .tar.gz, laid out as a source (what share_items installs, by its own names)."""
    import io
    import tarfile
    buf = io.BytesIO()
    seen = set()
    with tarfile.open(fileobj=buf, mode="w:gz") as t:
        for _g, rel, path in share_items(src):
            name = rel[len(SHARE) + 1:]
            if name in seen or not os.path.isfile(path):
                continue
            seen.add(name)
            t.add(path, arcname=name, recursive=False)
    return buf.getvalue()


# On the other machine (hc exec has a bare PATH there): Bun when missing (its own installer, into ~/.bun), the pack
# unpacked as a source beside Shepherdr's folder, then its own installer (a 3.1 install there is switched over, as
# here), then its doctor, which lets that machine's sync go again once the install is whole.
INSTALL_THERE = r"""set -e
export PATH="$HOME/.local/bin:$HOME/.bun/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
command -v python3 >/dev/null || { echo "python3 isn't installed there" >&2; exit 3; }
command -v hc >/dev/null || { echo "herdr-core (hc) isn't installed there" >&2; exit 3; }
if ! command -v bun >/dev/null; then
  echo "installing Bun (bun.sh) there"
  curl -fsSL https://bun.sh/install | bash >/dev/null 2>&1 || { echo "couldn't install Bun there (https://bun.sh)" >&2; exit 4; }
fi
d="$HOME/.local/share/shepherdr-src"
rm -rf "$d.new"; mkdir -p "$d.new"; tar xzf - -C "$d.new"
rm -rf "$d"; mv "$d.new" "$d"
python3 "$d/bin/shepherdr" install --yes --source "$d" FLAGS
python3 "$d/bin/shepherdr" doctor || echo "doctor found something to fix there (above)"
"""


def install_args(**kw):
    """install's options with their defaults, for an install started from another command."""
    base = dict(cmd="install", root=None, source=None, dry_run=False, adopt=False, guard=False, keys="ask", no_hooks=False,
                yes=True, force=False, web=False, port=None, https_port=None, no_build=False)
    return argparse.Namespace(**{**base, **kw})


def cmd_web_install_on(a):
    """Installs (or updates) Shepherdr on a machine linked over herdr-core; here: on this machine."""
    if a.machine in ("here", None):
        if load_record(real_home()):
            say("Shepherdr's service is installed here.")
            return 0
        return cmd_install(install_args(source=web_source(), force=a.force))
    src = web_source()
    body = pack(src)
    say(f"  sending Shepherdr {VERSION} ({len(body) // 1024} KB) to {a.machine}")
    script = INSTALL_THERE.replace(" FLAGS", " --force" if a.force else "")
    r = subprocess.run(["hc", "exec", "--on", a.machine, "--stdin", "--timeout", "600", "--", "sh", "-c", script],
                       input=body, capture_output=True)
    for line in r.stdout.decode(errors="replace").splitlines():
        say(f"  {a.machine}: {line}")
    if r.returncode != 0:
        # every line: a switch from 3.1 that waits names the tasks still working there
        raise Stop(r.stderr.decode(errors="replace").strip().replace("shepherdr: ", "", 1) or f"the install on {a.machine} failed")
    return 0


def cmd_web_https_port(a):
    """shepherdr web https-port [N]: the tailnet HTTPS port this machine shares the web app on. With N: kept, and the
    service (running here) moves its share and links there within seconds: says the new link or tailscale's reason."""
    root = real_home()
    if a.machine is None:
        p = https_port(root)
        if a.json:
            print(json.dumps({"https_port": p}))
        else:
            say(f"The web app's tailnet HTTPS port here: {p}" + (" (the default)" if p == 443 else " (shepherdr web https-port 443 goes back)"))
        return 0
    try:
        p = int(a.machine)
    except ValueError:
        raise Stop(f"{a.machine} isn't a port: shepherdr web https-port <1-65535>, e.g. 8443")
    since = time.time()
    write_https_port(root, p)
    w = web_outcome(root, since, p) if has_unit(root) else None
    out = {"https_port": p, "link": (w or {}).get("link"), "error": (w or {}).get("share_error")}
    if a.json:
        print(json.dumps(out))
    elif w is None:
        say(f"Kept: the web app goes on tailnet HTTPS port {p} once Shepherdr's service runs here (`shepherdr doctor` checks).")
    elif out["error"]:
        say(f"Kept port {p}, but the web app isn't shared: {out['error']}")
    elif (w.get("serve") or {}).get("host"):
        say(f"Kept port {p}: it's used once this machine serves the web app ({w['serve']['host']} serves it now).")
    else:
        say(f"The web app is on port {p} now" + (f": {out['link']}" if out["link"] else "."))
    return 1 if out["error"] else 0


def cmd_web(a):
    if a.action == "install-on":
        return cmd_web_install_on(a)
    if a.action == "https-port":
        return cmd_web_https_port(a)
    if a.action in ("serve-from", "status"):
        if a.action == "serve-from" and not a.machine:
            raise Stop("which machine? shepherdr web serve-from <machine|here> (hc machine ls lists them)")
        bun = bun_path()
        script = next((p for p in (os.path.join(real_home(), SHARE, "service", "serve-from.ts"),
                                   os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "service", "serve-from.ts"))
                       if os.path.isfile(p)), None)
        if not bun or not script:
            raise Stop("Shepherdr's service isn't installed here (it needs Bun): ./install.sh first")
        argv = [bun, script, a.action] + ([a.machine] if a.machine else []) + (["--take-link"] if a.take_link else []) + (["--json"] if a.json else [])
        env = {**os.environ, "SHEPHERDR_CLI": os.path.realpath(__file__)}
        return subprocess.run(argv, env=env).returncode
    raise Stop("shepherdr web serve-from <machine|here> [--take-link] | shepherdr web status | shepherdr web https-port [N]")


def cmd_where(a):
    """Every path Shepherdr uses here, and the move's state (as `go env`)."""
    root = os.path.realpath(a.root or real_home())
    L = layout_mod()
    st = L.status(home=root, env=None if root == os.path.realpath(real_home()) else {})
    if a.json:
        say(json.dumps(st, indent=1))
        return 0
    state = ("Shepherdr's own folders" if st["migrated"] else "rolled back to ~/.herdr" if st["rolled_back"]
             else "~/.herdr (not moved yet: `shepherdr migrate`)")
    say(f"layout {st['layout'] or 1} (this Shepherdr knows {st['knows']}): {state}")
    for k, v in st["roots"].items():
        say(f"  {k:7} {v}")
    say("")
    for k, v in st["kinds"].items():
        say(f"  {k:14} {v['path']}" + (f"   [{v['state']}]" if st["migrated"] else ""))
    say(f"  {'worktrees':14} {st['worktrees']['new']} (new tasks)" + (f"; {st['worktrees']['old_left']} older ones stay in {st['worktrees']['old']}" if st["worktrees"]["old_left"] and st["worktrees"]["new"] != st["worktrees"]["old"] else ""))
    if st["migrated"] and not (st["journal"] or {}).get("cleaned"):
        say("\nThe old paths in ~/.herdr are links to these, for older Shepherdr copies and other machines not updated yet.")
    if os.path.exists(st["kinds"]["vault"]["path"]):
        say("Secrets: a file only you can read (mode 600 in a 700 folder), not encrypted: that permission on this disk is what guards it.")
    return 0


def restart_service(root):
    """The service reads its folders when it starts: after a move or a rollback by hand, it starts again (when it
    runs here). herdr-task's scheduler follows by itself within a minute."""
    if os.path.realpath(root) != os.path.realpath(real_home()) or not has_unit(root):
        return
    if sys.platform == "darwin":
        ok = subprocess.run(["launchctl", "kickstart", "-k", f"gui/{os.getuid()}/{AGENT}"], capture_output=True).returncode == 0
    else:
        ok = subprocess.run(["systemctl", "--user", "restart", "shepherdr.service"], capture_output=True).returncode == 0
    say("  the Shepherdr service started again on the new paths" if ok else "  restart the Shepherdr service (it reads its folders when it starts)")


def cmd_migrate(a):
    root = os.path.realpath(a.root or real_home())
    L = layout_mod()
    env = None if root == os.path.realpath(real_home()) else {}
    if a.rollback:
        res = L.rollback(home=root, env=env)
        say("Shepherdr's data is back in ~/.herdr: " + (", ".join(sorted(res["moved"])) or "nothing was moved") + ".")
        for n in res["notes"]:
            say(f"  - {n}")
        say("  An older Shepherdr finds it as it left it; this one stays on ~/.herdr until `shepherdr migrate`.")
        restart_service(root)
        return 0
    if a.cleanup_legacy:
        if not a.yes:
            raise Stop("this removes the links at the old paths (~/.herdr/...): an older Shepherdr on this machine, and other "
                       "machines on an older Shepherdr that read this one, would no longer find the data. Update every "
                       "machine first (`herdr-task machines` lists them), then run it again with --yes")
        gone = L.cleanup_legacy(home=root, env=env)
        say("Removed:" if gone else "Nothing to remove.")
        for g in gone:
            say(f"  {g}")
        return 0
    res = L.migrate(home=root, env=env, dry=a.dry_run, force=a.force, again=True)
    if a.dry_run:
        say(("Would move: " + ", ".join(sorted(res["moved"]))) if res["moved"] else "Nothing to move.")
    else:
        say(L.summary(res) or "Already in Shepherdr's own folders.")
        if res["state"] == "migrated":
            restart_service(root)
    for n in res["notes"]:
        say(f"  - {n}")
    return 0 if res["state"] in ("done", "migrated", "would migrate") else 1


def cmd_secrets(a):
    if a.action == "move-to" and not (a.machine or a.to_id):
        raise Stop("which machine? shepherdr secrets move-to <machine|here> (hc machine ls lists them)")
    bun = bun_path()
    script = next((p for p in (os.path.join(real_home(), SHARE, "service", "secrets-move.ts"),
                               os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "service", "secrets-move.ts"))
                   if os.path.isfile(p)), None)
    if not bun or not script:
        raise Stop("Shepherdr's service isn't installed here (it needs Bun): ./install.sh first")
    argv = [bun, script, a.action] + ([a.machine] if a.machine else []) + (["--to-id", a.to_id] if a.to_id else []) \
        + (["--restore"] if a.restore else []) + (["--json"] if a.json else [])
    return subprocess.run(argv).returncode


def hand_over(a, argv):
    """`shepherdr update` runs the installed copy, which a pull doesn't change: installing with it wrote the old version
    (and its old steps), so it took a second run to say the new one. When the source's own installer is another, it
    does the install instead, told where its source is."""
    if os.environ.get("SHEPHERDR_HANDED_OVER"):
        return
    root = os.path.realpath(a.root or real_home())
    rec = load_record(root) or old_record(root) or {}
    # an update comes from where it was installed; an install from the given source, else from this script's own
    src = a.source or (rec.get("source") if a.cmd == "update" else None)
    if not is_source(src):
        return
    src = os.path.realpath(src)
    me, new = os.path.realpath(__file__), os.path.join(src, "bin", "shepherdr")
    if not os.path.isfile(new) or os.path.realpath(new) == me or read(new) == read(me):
        return
    say(f"(the installer in {src} runs it: it's the newer one)")
    sys.stdout.flush()
    sys.stderr.flush()
    os.execve(sys.executable, [sys.executable, new, *argv, *([] if a.source else ["--source", src])],
              dict(os.environ, SHEPHERDR_HANDED_OVER="1"))


def main(argv):
    ap = argparse.ArgumentParser(prog="shepherdr", description="Install, update, check or remove Shepherdr.")
    sub = ap.add_subparsers(dest="cmd")
    for name in ("install", "update", "uninstall", "doctor"):
        c = sub.add_parser(name)
        c.add_argument("--root", help="install under this folder instead of your home (a scratch try: it mirrors "
                                      ".local/share/shepherdr, .local/bin and .config/herdr-core/templates)")
        c.add_argument("--source", help="the Shepherdr checkout to install from (default: this script's, else the last one)")
        if name in ("install", "update", "uninstall"):
            c.add_argument("--dry-run", action="store_true", help="say what would change, change nothing")
        if name in ("install", "update"):
            c.add_argument("--adopt", action="store_true", help="a Herdr mod named open-shepherdr that isn't Shepherdr's: back it up and take it over")
            c.add_argument("--no-hooks", action="store_true", help="leave Claude Code's and Codex's settings alone")
            c.add_argument("--yes", action="store_true", help="ask nothing (the installer asks nothing since 3.2)")
            c.add_argument("--force", action="store_true", help="install although a check failed, or switch from 3.1 while tasks are working")
            c.add_argument("--port", type=int, help=f"the port Shepherdr's service listens on, on 127.0.0.1 (default {DEFAULT_PORT}; "
                                                    "kept for updates): when another app already uses it")
            c.add_argument("--https-port", type=int, help="the tailnet HTTPS port the web app is shared on (default 443; kept "
                                                          "for updates, `shepherdr web https-port` changes it): when something else here holds 443")
            c.add_argument("--no-build", action="store_true", help="install the web app as it is in the checkout: no build, even when it's missing or old")
            # 3.1's options, still accepted (an older `shepherdr update` hands them on): every install is the web one now
            c.add_argument("--web", action="store_true", help=argparse.SUPPRESS)
            c.add_argument("--guard", action="store_true", help=argparse.SUPPRESS)
            c.add_argument("--keys", choices=["ask", "keep", "ours"], default="ask", help=argparse.SUPPRESS)
    w = sub.add_parser("web", help="where the web app is served from (Serve from)")
    w.add_argument("action", choices=["serve-from", "status", "install-on", "https-port"])
    w.add_argument("machine", nargs="?", help="a machine linked over herdr-core (hc machine ls), or here; https-port: the port")
    w.add_argument("--take-link", action="store_true", help="that machine's /shepherdr is shared to something else: set it aside (moving away puts it back)")
    w.add_argument("--force", action="store_true", help="install-on: switch that machine from 3.1 although tasks are working there")
    w.add_argument("--json", action="store_true")
    s = sub.add_parser("secrets", help="which machine keeps the secrets (Settings › Secrets › Kept on)")
    s.add_argument("action", choices=["move-to", "where"])
    s.add_argument("machine", nargs="?", help="a machine linked over herdr-core (hc machine ls), or here")
    s.add_argument("--restore", action="store_true", help="here: take this machine's backup back (the other one is gone for good)")
    s.add_argument("--to-id", help=argparse.SUPPRESS)
    s.add_argument("--json", action="store_true")
    wh = sub.add_parser("where", help="every path Shepherdr keeps its data in here, and whether it moved there")
    wh.add_argument("--root", help=argparse.SUPPRESS)
    wh.add_argument("--json", action="store_true")
    mg = sub.add_parser("migrate", help="move Shepherdr's data from ~/.herdr into its own folders (install and update do it)")
    mg.add_argument("--root", help=argparse.SUPPRESS)
    mg.add_argument("--dry-run", action="store_true", help="say what would move, move nothing")
    mg.add_argument("--rollback", action="store_true", help="everything back to ~/.herdr (an older Shepherdr then finds it)")
    mg.add_argument("--cleanup-legacy", action="store_true", help="remove the links at the old paths (once every machine is updated)")
    mg.add_argument("--force", action="store_true", help="move even on a network disk (no other machine uses this home)")
    mg.add_argument("--yes", action="store_true")
    wn = sub.add_parser("window", help="the Herdr window's notices where 3.1's Shepherdr views were")
    wn.add_argument("--remove", action="store_true", help="take them out (an old Assistant tab still open in Herdr then says it can't load)")
    wn.add_argument("--root", help=argparse.SUPPRESS)
    sub.add_parser("version")
    a = ap.parse_args(argv)
    try:
        if a.cmd in ("install", "update"):
            hand_over(a, argv)
            return cmd_install(a, update=a.cmd == "update")
        if a.cmd == "uninstall":
            return cmd_uninstall(a)
        if a.cmd == "doctor":
            return cmd_doctor(a)
        if a.cmd == "web":
            return cmd_web(a)
        if a.cmd == "secrets":
            return cmd_secrets(a)
        if a.cmd == "where":
            return cmd_where(a)
        if a.cmd == "migrate":
            return cmd_migrate(a)
        if a.cmd == "window":
            return cmd_window(a)
        if a.cmd == "version":
            say(f"shepherdr {VERSION}")
            return 0
        ap.print_help()
        return 2
    except Stop as e:
        print(f"shepherdr: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

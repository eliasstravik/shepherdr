#!/usr/bin/env python3
"""herdr-secret: secrets for agents (API keys, tokens, passwords), used by name, never seen.

The values live in one owner-only file on the main machine (the one running the Herdr app),
~/.herdr/vault.json (mode 600), by name at three scopes: Everywhere, a machine, a space. The most
specific one wins: the agent's space, then its machine, then Everywhere. The person adds them in
a masked box: an agent's ask card in its chat (mods/chat), or Settings > Secrets
(mods/shepherdr-settings). Both write the vault themselves (lib/secrets.js); a value never goes
through hc send, a chat, a log or an artifact.

Agents (in a Herdr terminal, $HC_TERMINAL_ID):
  herdr-secret ask NAME --why "what it's for"   a masked card in the agent's chat; end the turn
  herdr-secret run NAME[,NAME] -- <command>     values only in the command's environment; its
                                                output masks them
  herdr-secret env NAME[,NAME] --file .env      an owner-only file a git repo ignores
  herdr-secret list                             the names this agent can use

An agent reaches only its own scope: its terminal's space (herdr.space, herdr.task.space or
herdr.coordinator.space; a sub-agent's parent's), its machine, Everywhere. The terminal is the
one this process runs in: $HC_TERMINAL_ID must be an ancestor of it. herdr-core isn't a sandbox:
anything running as the same account can read an owner-only file; this keeps values out of
chats, logs and transcripts, it doesn't stop hostile code.

The ask is a label on the agent's own terminal, herdr.secret.ask.<NAME>=<why>: every Herdr window
sees it in terminals(), for a terminal on another machine too. The card removes it once answered.

On another machine nothing is stored: `run`, `env` and `list` there put a request label on the
terminal (herdr.secret.want=<nonce>:<names>) and wait on a fresh FIFO. The main machine's Herdr
sees the label and runs `herdr-secret serve <machine>/<terminal>` here, which checks that
terminal's scope and writes the values into the FIFO over hc's own link (hc exec --stdin). The
copy there is installed with `herdr-secret install --on <machine>`, which also marks it remote.

The person (on any machine: another one passes it to the main machine over hc's link):
  herdr-secret set NAME [--machine M | --space ID]   value from stdin (a hidden prompt in a tty)
  herdr-secret rm NAME [--machine M | --space ID]
  herdr-secret names [--json]                        every entry, without values
  herdr-secret where [--json]                        which machine keeps them, and whether it's this one

Which machine is the main one: herdr-core document "shepherdr.secrets" = { id, at, by } on every
machine (id: the main machine's herdr-core id), written by `shepherdr secrets move-to <machine>` and
handed on by each Shepherdr service (service/secrets.ts), as "shepherdr.host" is for Serve from.
Nobody named one: they follow Serve from ({..., auto: true}): the services name where they are now
(core/secrets.js autoKeeper) and the machine serving the web app moves them to itself with
`shepherdr secrets move-to` (backup, verified copy, rollback); the record is handed on the same way.
No such record yet: the main machine is the one without ~/.herdr/secret-remote (as before).
"""

import argparse
import fcntl
import getpass
import json
import os
import re
import secrets as tokens
import select
import shutil
import signal
import subprocess
import sys
import threading
import time

HOME = os.path.expanduser("~")
HERDR = os.path.join(HOME, ".herdr")
VAULT = os.environ.get("HERDR_SECRET_VAULT") or os.path.join(HERDR, "vault.json")
# Written by `install --on`: this copy runs on another machine and asks the main one. Only counts
# while no machine is named as the main one (SECRETS_DOC).
REMOTE_MARK = os.path.join(HERDR, "secret-remote")
# herdr-core's state here: core.json (this machine's id and name) and docs.json (its documents).
CORE = os.environ.get("HERDR_SECRET_CORE") or os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local", "state"), "herdr-core", os.environ.get("HC_SESSION") or "default")
SECRETS_DOC = "shepherdr.secrets"
# herdr-secret on another machine, wherever it was installed there (PATH there may not have it).
THERE = ('for b in "$HOME/.local/bin/herdr-secret" "${HERDR_APP_HOME:-$HOME/.config/herdr-app}/bin/herdr-secret" '
         '"$HOME/.local/share/shepherdr/bin/herdr-secret"; do [ -x "$b" ] && exec "$b" "$@"; done; '
         'echo "herdr-secret isn\'t installed there" >&2; exit 127')
DROP = os.path.join(HERDR, "secret-drop")
SERVED = os.path.join(HERDR, "secret-served")
NAME = re.compile(r"^[A-Za-z_][A-Za-z0-9_]{0,99}$")
ASK = "herdr.secret.ask."
WANT = "herdr.secret.want"
SPACE_LABELS = ("herdr.space", "herdr.task.space", "herdr.coordinator.space")
# Values shorter than this aren't masked in output (a one-letter value would mask every letter).
MASK_MIN = 4
WAIT = 90


class Fail(Exception):
    pass


def say(text):
    sys.stdout.write(text.rstrip("\n") + "\n")


# ---- the vault ------------------------------------------------------------------------------

def init_vault():
    """The vault, made owner-only if missing; its mode put right if it isn't."""
    d = os.path.dirname(VAULT)
    os.makedirs(d, exist_ok=True)
    if not os.path.exists(VAULT):
        fd = os.open(VAULT, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump({"version": 1, "secrets": []}, f)
    os.chmod(VAULT, 0o600)


def load():
    try:
        with open(VAULT) as f:
            data = json.load(f)
    except FileNotFoundError:
        return {"version": 1, "secrets": []}
    except ValueError:
        raise Fail(f"The vault ({VAULT}) isn't valid JSON; fix or move it first.")
    if not isinstance(data, dict) or not isinstance(data.get("secrets"), list):
        raise Fail(f"The vault ({VAULT}) isn't a Herdr vault.")
    return data


def save(data):
    init_vault()
    tmp = f"{VAULT}.{os.getpid()}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=1)
    os.replace(tmp, VAULT)


def locked(fn):
    init_vault()
    with open(VAULT + ".lock", "w") as lk:
        os.chmod(VAULT + ".lock", 0o600)
        fcntl.flock(lk, fcntl.LOCK_EX)
        return fn()


def same(e, scope, machine, space):
    return e.get("scope") == scope and (e.get("machine") or None) == (machine or None) and (e.get("space") or None) == (space or None)


def chain(machine, space):
    """The scopes an agent reaches, most specific first: (scope, machine, space)."""
    out = []
    if space:
        out.append(("space", None, space))
    out.append(("machine", machine, None))
    out.append(("everywhere", None, None))
    return out


def pick(data, names, machine, space):
    found, missing = {}, []
    order = chain(machine, space)
    for n in names:
        hit = None
        for sc in order:
            hit = next((e for e in data["secrets"] if e.get("name") == n and same(e, *sc) and isinstance(e.get("value"), str)), None)
            if hit:
                break
        if hit:
            found[n] = hit["value"]
        else:
            missing.append(n)
    return found, missing


def reachable(data, machine, space):
    """Names this scope reaches, each with where it's kept (the winning scope)."""
    out = {}
    for sc in reversed(chain(machine, space)):
        for e in data["secrets"]:
            if same(e, *sc) and NAME.match(str(e.get("name", ""))):
                out[e["name"]] = sc[0]
    return out


WHERE = {"space": "this space", "machine": "this machine", "everywhere": "Everywhere"}


# ---- who is asking --------------------------------------------------------------------------

def hc_json(*args):
    r = subprocess.run(["hc", *args, "--json"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=30)
    try:
        return json.loads(r.stdout or "null")
    except ValueError:
        return None


def parent_pid(pid):
    try:
        with open(f"/proc/{pid}/stat") as f:
            s = f.read()
        return int(s[s.rindex(")") + 2:].split()[1])
    except (OSError, ValueError, IndexError):
        pass
    r = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    try:
        return int(r.stdout.strip())
    except ValueError:
        return 0


def ancestors():
    out, pid = set(), os.getpid()
    for _ in range(64):
        pid = parent_pid(pid)
        if pid <= 1 or pid in out:
            break
        out.add(pid)
    return out


def me():
    """This process's own Herdr terminal: {address, labels}."""
    tid = os.environ.get("HC_TERMINAL_ID", "")
    if not tid or "/" in tid:
        raise Fail("herdr-secret works for an agent in a Herdr terminal: $HC_TERMINAL_ID isn't set here.")
    t = hc_json("get", tid)
    if not isinstance(t, dict) or t.get("error") or t.get("state") not in (None, "live"):
        raise Fail(f"Can't find this terminal ({tid}) in herdr-core.")
    pids = {p for p in (t.get("pid"), (t.get("foreground") or {}).get("pid")) if isinstance(p, int)}
    if not pids & ancestors():
        raise Fail(f"This process doesn't run in terminal {tid}: use secrets from the agent's own terminal.")
    return {"address": tid, "labels": t.get("labels") or {}, "parent": t.get("parent")}


DOCS = 'cat "${XDG_STATE_HOME:-$HOME/.local/state}/herdr-core/default/docs.json"'


def space_of_pane(pane, machine):
    """The space holding a pane, from that machine's herdr-app document (an agent parked behind
    its chat has only herdr.chat=<chat pane>)."""
    call = ["sh", "-c", DOCS] if not machine else ["hc", "exec", "--on", machine, "--", "sh", "-c", DOCS]
    try:
        r = subprocess.run(call, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=30)
        doc = json.loads(r.stdout)["herdr-app"]["value"]
    except (ValueError, KeyError, TypeError, subprocess.TimeoutExpired):
        return None

    def has(o):
        if isinstance(o, dict):
            return o.get("id") == pane or any(has(v) for v in o.values())
        if isinstance(o, list):
            return any(has(v) for v in o)
        return False
    for sp in doc.get("spaces") or []:
        if isinstance(sp, dict) and sp.get("id") and has(sp.get("tabs")):
            return sp["id"]
    return None


def space_of(t, machine):
    """The terminal's space as Herdr names it (another machine's ids carry its name), walking up
    to a sub-agent's parent when the terminal has none of its own."""
    for _ in range(5):
        labels = (t or {}).get("labels") or {}
        if labels.get("herdr.role") == "reviewer":
            raise Fail("Reviewers can't use secrets.")
        sp = next((labels[k] for k in SPACE_LABELS if labels.get(k)), None)
        if not sp and labels.get("herdr.chat"):
            sp = space_of_pane(labels["herdr.chat"], machine)
        if sp:
            return f"{machine}/{sp}" if machine and "/" not in sp else sp
        parent = (t or {}).get("parent")
        if not parent:
            return None
        if machine and "/" not in parent:
            parent = f"{machine}/{parent}"
        t = hc_json("get", parent)
    return None


def _json_file(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def core_me():
    """This machine's herdr-core identity: {id, name}, or None."""
    d = _json_file(os.path.join(CORE, "core.json"))
    return {"id": d["id"], "name": d.get("name") or ""} if isinstance(d, dict) and isinstance(d.get("id"), str) and d["id"] else None


def home_record():
    """The main machine as herdr-core's document names it: {id, at, by}, or None (none named yet)."""
    d = _json_file(os.path.join(CORE, "docs.json"))
    v = ((d or {}).get(SECRETS_DOC) or {}).get("value") if isinstance(d, dict) else None
    if isinstance(v, dict) and isinstance(v.get("id"), str) and v["id"] and isinstance(v.get("at"), (int, float)):
        return v
    return None


def host_id():
    """The machine serving the web app (Serve from: herdr-core document "shepherdr.host"), by id, or None."""
    d = _json_file(os.path.join(CORE, "docs.json"))
    v = ((d or {}).get("shepherdr.host") or {}).get("value") if isinstance(d, dict) else None
    return v["id"] if isinstance(v, dict) and isinstance(v.get("id"), str) and v["id"] else None


def remote():
    """Whether another machine keeps the secrets: the record says so, else (none yet) the mark."""
    rec = home_record()
    if rec:
        me = core_me()
        return not (me and me["id"] == rec["id"])
    return os.path.exists(REMOTE_MARK)


def links_here():
    """This machine's names for the machines it links: {name: id}."""
    d = hc_json("machine", "ls") or {}
    return {str(m["name"]): str(m["id"]) for m in d.get("machines") or [] if m.get("name") and m.get("id") and not m.get("temporary")}


def main_machine():
    """{here, set, id, name}: whether this machine keeps the secrets, and the main one's name here
    (None: this one; "" when this machine doesn't link it)."""
    rec = home_record()
    auto = bool(rec and rec.get("auto") is True)
    # following Serve from (auto): that machine by its name here (None: this one; "": not linked)
    serve = ""
    if auto and host_id():
        h = host_id()
        serve = None if (core_me() or {}).get("id") == h else next((n for n, i in links_here().items() if i == h), "")
    if not remote():
        me = core_me() or {}
        return {"here": True, "set": bool(rec), "auto": auto, "serve": serve, "id": (rec or {}).get("id") or me.get("id"), "name": None}
    if not rec:
        return {"here": False, "set": False, "auto": False, "serve": "", "id": None, "name": ""}
    name = next((n for n, i in links_here().items() if i == rec["id"]), "")
    return {"here": False, "set": True, "auto": auto, "serve": serve, "id": rec["id"], "name": name}


def keeper_by_asking():
    """No machine named to keep the secrets yet (the services name one on their own, SHEP-33; this
    is until that reaches here): the first machine linked from here that says it keeps them
    (`herdr-secret where` there), as {"name", "id"}, or None."""
    for m in (hc_json("machine", "ls") or {}).get("machines") or []:
        if m.get("temporary") or m.get("state") not in (None, "connected") or not m.get("name"):
            continue
        try:
            r = subprocess.run(["hc", "exec", "--on", str(m["name"]), "--timeout", "10", "--", "sh", "-c", THERE, "sh", "where", "--json"],
                               stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=20)
            w = json.loads(r.stdout.decode(errors="replace").strip().splitlines()[-1]) if r.returncode == 0 and r.stdout.strip() else None
        except (subprocess.TimeoutExpired, ValueError, IndexError):
            w = None
        if isinstance(w, dict) and w.get("here") is True:
            return {"name": str(m["name"]), "id": m.get("id")}
    return None


def forward(args, value=None):
    """Runs herdr-secret on the main machine with this machine's names for scopes (--caller), the
    value (if any) on stdin over hc's link: never in a command line or on disk. None named yet:
    the linked machine that keeps them (keeper_by_asking)."""
    m = main_machine()
    if not m["set"]:
        k = keeper_by_asking()
        if not k:
            raise Fail("No machine linked from here keeps the secrets: link the one that has them (hc machine add), or keep them here (Settings > Secrets > Kept on).")
        m = {**m, "set": True, "name": k["name"], "id": k["id"]}
    if not m["name"]:
        raise Fail("The machine that keeps secrets isn't linked from here (hc machine ls).")
    me = core_me() or {}
    caller = json.dumps({"id": me.get("id") or "", "links": links_here()})
    try:
        r = subprocess.run(["hc", "exec", "--stdin", "--on", m["name"], "--timeout", "30", "--", "sh", "-c", THERE, "sh", *args, "--caller", caller],
                           input=(value or "").encode(), stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60)
    except subprocess.TimeoutExpired:
        raise Fail(f"Can't reach {m['name']}, where secrets are kept: is it on?")
    err = r.stderr.decode(errors="replace").strip()
    if r.returncode != 0:
        if r.returncode == 1 and err.startswith("herdr-secret: "):
            raise Fail(err[len("herdr-secret: "):])
        why = err.splitlines()[-1] if err else str(r.returncode)
        try:
            why = json.loads(why)["error"].get("hint") or why
        except (ValueError, KeyError, TypeError, AttributeError):
            pass
        raise Fail(f"Can't reach {m['name']}, where secrets are kept: is it on? ({why})")
    return r.stdout.decode()


# ---- names between machines (core/host.js renamer and moveId) --------------------------------
# Each machine names the others its own way: a scope from another machine's words to this one's.

def renamer(frm, to):
    """A machine name in frm's words ({id, links}; None/"" is frm itself) to to's (None: to itself);
    False when to doesn't link it."""
    def rename(name):
        mid = frm.get("id") if name in (None, "", "local") else (frm.get("links") or {}).get(name)
        if not mid or not to.get("id"):
            return False
        if mid == to["id"]:
            return None
        return next((n for n, i in (to.get("links") or {}).items() if i == mid), False)
    return rename


def move_id(sid, rename):
    """A space id ("sp1" here, "vm/sp1" there) in other words; False: not nameable there."""
    s = str(sid)
    cut = s.find("/")
    m = rename(None if cut < 0 else s[:cut])
    if m is False:
        return False
    rest = s if cut < 0 else s[cut + 1:]
    return rest if m is None else f"{m}/{rest}"


def caller_words(raw):
    """--caller: the asking machine's {id, links}, and this machine's own."""
    try:
        c = json.loads(raw)
        assert isinstance(c, dict) and isinstance(c.get("id"), str) and isinstance(c.get("links"), dict)
    except (ValueError, AssertionError):
        raise Fail("--caller isn't readable.")
    me = core_me() or {}
    return c, {"id": me.get("id") or "", "links": links_here()}


def rename_scope(sc, rename):
    """(scope, machine, space) through rename; Fail when the other machine can't name it."""
    scope, machine, space = sc
    if scope == "machine":
        m = rename(machine)
        if m is False:
            raise Fail(f"The machine that keeps secrets doesn't link {machine or 'this machine'}.")
        return scope, m, None
    if scope == "space":
        sp = move_id(space, rename)
        if sp is False:
            raise Fail(f"The machine that keeps secrets can't reach space {space}.")
        return scope, None, sp
    return sc


def names_arg(s):
    names = [n.strip() for n in str(s).split(",") if n.strip()]
    if not names or len(names) > 32 or any(not NAME.match(n) for n in names):
        raise Fail("Name secrets like environment variables, comma-separated: GITHUB_TOKEN,OPENAI_API_KEY.")
    return list(dict.fromkeys(names))


# ---- getting values: here, or from the main machine -----------------------------------------

def values(names, list_only=False):
    """{"values": {...}} or {"names": {...}} for this agent, from the vault here or, on another
    machine, from the main one."""
    t = me()
    if not remote():
        sp = space_of(t, None)
        data = load()
        if list_only:
            return {"names": reachable(data, None, sp)}
        found, missing = pick(data, names, None, sp)
        if missing:
            raise Fail(f"No secret {', '.join(missing)} for this agent. Ask for it: herdr-secret ask {missing[0]} --why \"what it's for\".")
        return {"values": found}
    return fetch(t["address"], "list" if list_only else ",".join(names))


def fetch(tid, what):
    """Asks the main machine through a label and a fresh FIFO; nothing is written to disk."""
    os.makedirs(DROP, exist_ok=True)
    os.chmod(DROP, 0o700)
    nonce = tokens.token_hex(16)
    fifo = os.path.join(DROP, nonce)
    os.mkfifo(fifo, 0o600)
    buf = b""
    try:
        fd = os.open(fifo, os.O_RDONLY | os.O_NONBLOCK)
        try:
            r = subprocess.run(["hc", "label", tid, f"{WANT}={nonce}:{what}"], stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
            if r.returncode != 0:
                raise Fail(f"Couldn't ask the main machine: {r.stderr.strip()}")
            end = time.time() + WAIT
            while time.time() < end and not buf.endswith(b"\n"):
                select.select([fd], [], [], 0.2)
                try:
                    chunk = os.read(fd, 65536)
                except BlockingIOError:
                    chunk = b""
                if chunk:
                    buf += chunk
                else:
                    time.sleep(0.05)
        finally:
            os.close(fd)
    finally:
        try:
            os.unlink(fifo)
        except OSError:
            pass
        subprocess.run(["hc", "label", tid, f"{WANT}="], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if not buf.endswith(b"\n"):
        raise Fail("The main machine didn't answer: is Herdr open there with its Tasks tab bar? Try again in a moment.")
    try:
        d = json.loads(buf)
    except ValueError:
        raise Fail("The main machine's answer was unreadable; try again.")
    if d.get("error"):
        raise Fail(d["error"])
    return d


def serve(address):
    """Main machine: answers a remote terminal's request label (fetch()) over hc's link."""
    if remote() or "/" not in address:
        raise Fail("serve answers another machine's terminal from the main machine: serve <machine>/<terminal>.")
    machine = address.split("/", 1)[0]
    t = hc_json("get", address)
    want = str(((t or {}).get("labels") or {}).get(WANT) or "")
    m = re.match(r"^([0-9a-f]{32}):(list|[A-Za-z0-9_,]{1,4000})$", want)
    if not m:
        return 0
    nonce, what = m.groups()
    # One answer per request, whichever window saw it first.
    os.makedirs(SERVED, exist_ok=True)
    os.chmod(SERVED, 0o700)
    for f in os.listdir(SERVED):
        p = os.path.join(SERVED, f)
        try:
            if time.time() - os.path.getmtime(p) > 3600:
                os.unlink(p)
        except OSError:
            pass
    try:
        os.close(os.open(os.path.join(SERVED, nonce), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600))
    except FileExistsError:
        return 0
    try:
        sp = space_of(t, machine)
        data = load()
        if what == "list":
            out = {"names": reachable(data, machine, sp)}
        else:
            found, missing = pick(data, names_arg(what), machine, sp)
            out = {"error": f"No secret {', '.join(missing)} for this agent. Ask for it: herdr-secret ask {missing[0]} --why \"what it's for\"."} if missing else {"values": found}
    except Fail as e:
        out = {"error": str(e)}
    body = (json.dumps(out) + "\n").encode()
    script = 'f="$HOME/.herdr/secret-drop/$1"; [ -p "$f" ] || exit 3; cat > "$f"'
    r = subprocess.run(["hc", "exec", "--stdin", "--on", machine, "--timeout", "30", "--", "sh", "-c", script, "sh", nonce],
                       input=body, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    if r.returncode != 0:
        raise Fail(f"Couldn't answer {address}: {r.stderr.decode(errors='replace').strip() or r.returncode}")
    return 0


# ---- masking output -------------------------------------------------------------------------

class Masker:
    """Replaces exact values in a byte stream, including a value split across chunks: what could
    still be the start of a value waits for the next chunk."""

    def __init__(self, found):
        self.subs = sorted(((v.encode(), f"[{n} hidden]".encode()) for n, v in found.items() if len(v) >= MASK_MIN),
                           key=lambda x: -len(x[0]))
        self.pending = b""

    def feed(self, chunk):
        buf = self.pending + chunk
        for v, mark in self.subs:
            buf = buf.replace(v, mark)
        hold = 0
        for v, _ in self.subs:
            for k in range(min(len(v) - 1, len(buf)), hold, -1):
                if buf.endswith(v[:k]):
                    hold = k
                    break
        self.pending = buf[len(buf) - hold:] if hold else b""
        return buf[:len(buf) - hold] if hold else buf

    def flush(self):
        out, self.pending = self.pending, b""
        return out


def pump(src, dst, masker):
    out = dst.buffer if hasattr(dst, "buffer") else dst
    while True:
        chunk = os.read(src.fileno(), 65536)
        if not chunk:
            break
        data = masker.feed(chunk)
        if data:
            out.write(data)
            out.flush()
    out.write(masker.flush())
    out.flush()


def cmd_run(names, argv):
    if not argv:
        raise Fail("Say what to run: herdr-secret run NAME -- <command>.")
    found = values(names)["values"]
    env = dict(os.environ)
    env.update(found)
    try:
        p = subprocess.Popen(argv, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except OSError as e:
        raise Fail(f"Couldn't run {argv[0]}: {e.strerror}")
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda s, _f: p.send_signal(s))
    ts = [threading.Thread(target=pump, args=(p.stdout, sys.stdout, Masker(found)), daemon=True),
          threading.Thread(target=pump, args=(p.stderr, sys.stderr, Masker(found)), daemon=True)]
    for x in ts:
        x.start()
    code = p.wait()
    for x in ts:
        x.join()
    return code if code >= 0 else 128 - code


# ---- env files ------------------------------------------------------------------------------

def dotenv(v):
    if re.match(r"^[A-Za-z0-9_./:@+=,-]*$", v):
        return v
    return '"' + v.replace("\\", "\\\\").replace('"', '\\"').replace("$", "\\$").replace("\n", "\\n") + '"'


def cmd_env(names, path):
    path = os.path.abspath(path)
    d = os.path.dirname(path)
    if not os.path.isdir(d):
        raise Fail(f"No folder {d}.")
    if subprocess.run(["git", "-C", d, "rev-parse", "--show-toplevel"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
        raise Fail("env writes only inside a git repo (one that ignores the file); prefer herdr-secret run.")
    if subprocess.run(["git", "-C", d, "check-ignore", "-q", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
        raise Fail(f"Git doesn't ignore {os.path.basename(path)}: add it to .gitignore first, so the values never reach a commit.")
    if os.path.islink(path):
        raise Fail(f"{path} is a link; write to a plain file.")
    found = values(names)["values"]
    lines = []
    try:
        with open(path) as f:
            lines = [l.rstrip("\n") for l in f]
    except FileNotFoundError:
        pass
    keep = [l for l in lines if not any(re.match(rf"^\s*(export\s+)?{n}\s*=", l) for n in found)]
    keep += [f"{n}={dotenv(v)}" for n, v in found.items()]
    tmp = f"{path}.{os.getpid()}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write("\n".join(keep) + "\n")
    os.replace(tmp, path)
    os.chmod(path, 0o600)
    say(f"Wrote {', '.join(found)} to {os.path.basename(path)} (only you can read it; git ignores it). "
        "Never print or open it in a tool that shows its contents; remove it with a plain rm.")
    return 0


# ---- asking ---------------------------------------------------------------------------------

def cmd_ask(name, why, force):
    if not NAME.match(name):
        raise Fail("Name the secret like an environment variable: GITHUB_TOKEN.")
    t = me()
    if not force and not remote():
        sp = space_of(t, None)
        if name in reachable(load(), None, sp):
            say(f"{name} is already kept for you: use it by name (herdr-secret run {name} -- <command>). "
                "If it's wrong or expired, ask again with --force.")
            return 0
    why = re.sub(r"\s+", " ", why or "").strip()[:300]
    r = subprocess.run(["hc", "label", t["address"], f"{ASK}{name}={why or '-'}"], stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    if r.returncode != 0:
        raise Fail(f"Couldn't ask: {r.stderr.strip()}")
    say(f"Asked the person for {name} in a masked box in your chat. End your turn now and wait: you'll get a "
        f"line saying it's kept (by name only). Then use it with herdr-secret run {name} -- <command>. "
        "Never ask for its value in the chat.")
    return 0


# ---- the person's side ----------------------------------------------------------------------

def scope_args(a):
    if a.machine and a.space:
        raise Fail("Pick one: --machine or --space.")
    if a.space:
        return "space", None, a.space
    if a.machine is not None:
        return "machine", (None if a.machine in ("", "here", "local") else a.machine), None
    return "everywhere", None, None


def scope_flags(a):
    """The scope flags as given, to pass on to the main machine."""
    if a.space:
        return ["--space", a.space]
    if a.machine is not None:
        return ["--machine", a.machine] if a.machine else ["--machine"]
    return []


def here_scope(a):
    """The scope in this machine's words: a forwarded call's (--caller) renamed from the asking
    machine's. A forwarded call reaches only the machine that keeps the secrets."""
    sc = scope_args(a)
    if getattr(a, "caller", None):
        if remote():
            raise Fail("This machine doesn't keep the secrets (any more): try again.")
        c, mine = caller_words(a.caller)
        sc = rename_scope(sc, renamer(c, mine))
    return sc


def read_value_file(path):
    """--value-file: a file in ~/.herdr/secret-drop (the window's masked box), read and removed at once."""
    real = os.path.realpath(path)
    if os.path.dirname(real) != os.path.realpath(DROP) or os.path.islink(path):
        raise Fail("--value-file takes a file in ~/.herdr/secret-drop.")
    try:
        with open(real) as f:
            return f.read()
    finally:
        try:
            os.unlink(real)
        except OSError:
            pass


def cmd_set(name, a):
    if not NAME.match(name):
        raise Fail("Name the secret like an environment variable: GITHUB_TOKEN.")
    if getattr(a, "value_file", None):
        value = read_value_file(a.value_file)
    elif sys.stdin.isatty():
        value = getpass.getpass(f"{name}: ")
    else:
        value = sys.stdin.read()
    value = value.rstrip("\r\n")
    if not value:
        raise Fail("Give the value on stdin (herdr-secret set NAME < file), never in the command's words.")
    if remote() and not getattr(a, "caller", None):
        scope_args(a)
        say(forward(["set", name, *scope_flags(a)], value).strip() or f"Kept {name}.")
        return 0
    sc = here_scope(a)

    def go():
        data = load()
        data["secrets"] = [e for e in data["secrets"] if not (e.get("name") == name and same(e, *sc))]
        data["secrets"].append({"name": name, "scope": sc[0], "machine": sc[1], "space": sc[2], "value": value, "at": int(time.time() * 1000)})
        save(data)
    locked(go)
    say(f"Kept {name}.")
    return 0


def cmd_rm(name, a):
    if remote() and not getattr(a, "caller", None):
        scope_args(a)
        say(forward(["rm", name, *scope_flags(a)]).strip())
        return 0
    sc = here_scope(a)
    gone = []

    def go():
        data = load()
        keep = [e for e in data["secrets"] if not (e.get("name") == name and same(e, *sc))]
        gone.append(len(data["secrets"]) - len(keep))
        data["secrets"] = keep
        save(data)
    locked(go)
    say(f"Removed {name}." if gone[0] else f"No {name} there.")
    return 0


def cmd_names(as_json, caller=None):
    if caller and remote():
        raise Fail("This machine doesn't keep the secrets (any more): try again.")
    if remote() and not caller and (main_machine()["set"] or keeper_by_asking()):
        rows = json.loads(forward(["names", "--json"]) or "[]")
    else:
        rows = [{k: e.get(k) for k in ("name", "scope", "machine", "space", "at")} for e in load()["secrets"]]
    if caller:
        # in the asking machine's words (what it can't name stays in this machine's)
        c, mine = caller_words(caller)
        back = renamer(mine, c)
        for r in rows:
            if r.get("scope") == "machine":
                m = back(r.get("machine"))
                if m is not False:
                    r["machine"] = m
            elif r.get("scope") == "space" and r.get("space"):
                sp = move_id(r["space"], back)
                if sp is not False:
                    r["space"] = sp
    if as_json:
        say(json.dumps(rows))
    else:
        for r in rows:
            say(f"{r['name']}  {r['scope']}{' ' + str(r['machine'] or r['space']) if r['machine'] or r['space'] else ''}")
    return 0


# Shepherdr's installer holds every copy of the helpers to other machines (this file, removed by
# `shepherdr doctor` once the install is whole), as herdr-task's base.sync_held.
SYNC_HOLD = os.path.join(HOME, ".herdr", "sync-hold")


def sync_held():
    """Why copies to other machines wait now (the hold's first line), or None."""
    try:
        with open(SYNC_HOLD) as f:
            return f.readline().strip() or "held by Shepherdr's installer"
    except OSError:
        return None


def cmd_install(machine):
    held = sync_held()
    if held:
        raise Fail(f"copies to other machines wait: {held}. Run `shepherdr doctor` once the install is whole.")
    me_path = os.path.realpath(__file__)
    with open(me_path, "rb") as f:
        body = f.read()
    target = ".local/bin/herdr-secret"
    r = subprocess.run(["hc", "file", "write", "--on", machine, target], input=body, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if r.returncode != 0:
        raise Fail(f"Couldn't install herdr-secret on {machine}: {r.stderr.decode().strip()}")
    # marked remote there unless it keeps the secrets itself (mark-remote)
    script = 'chmod +x "$HOME/.local/bin/herdr-secret" && "$HOME/.local/bin/herdr-secret" mark-remote'
    r = subprocess.run(["hc", "exec", "--on", machine, "--", "sh", "-c", script], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if r.returncode != 0:
        raise Fail(f"Couldn't install herdr-secret on {machine}: {r.stderr.strip()}")
    say(f"Installed herdr-secret on {machine}.")
    return 0


def cmd_where(as_json):
    m = main_machine()
    if as_json:
        say(json.dumps(m))
    elif m["here"]:
        say("This machine keeps the secrets" + (" (following Serve from)." if m.get("auto") and m.get("serve") is None
                                                else ", for now: they follow Serve from." if m.get("auto") else "."))
    elif m["set"]:
        say(f"{m['name'] or m['id']} keeps the secrets{' (following Serve from)' if m.get('auto') else ''}.")
    else:
        say("Another machine keeps the secrets (this one is marked remote; none is named yet).")
    return 0


def mark_remote():
    """After an install here from another machine: marked as asking another machine, unless it
    keeps the secrets itself (the record names it, or none is named and it has a vault). A record
    naming this machine also clears a stray mark."""
    rec, me = home_record(), core_me()
    if rec:
        if me and rec["id"] == me["id"] and os.path.exists(REMOTE_MARK):
            os.unlink(REMOTE_MARK)
        return 0
    if not os.path.exists(VAULT):
        os.makedirs(HERDR, exist_ok=True)
        open(REMOTE_MARK, "a").close()
    return 0


def main(argv):
    rest = []
    if "--" in argv:
        i = argv.index("--")
        argv, rest = argv[:i], argv[i + 1:]
    p = argparse.ArgumentParser(prog="herdr-secret", description="Secrets for agents, used by name, never seen.")
    sub = p.add_subparsers(dest="cmd", required=True)
    c = sub.add_parser("ask", help="ask the person for a secret in a masked card; then end your turn")
    c.add_argument("name")
    c.add_argument("--why", default="", help="what it's for, in a few words")
    c.add_argument("--force", action="store_true", help="ask even though one is kept (wrong or expired)")
    c = sub.add_parser("run", help="run a command with secrets in its environment; its output masks them")
    c.add_argument("names")
    c = sub.add_parser("env", help="write secrets to an owner-only file a git repo ignores")
    c.add_argument("names")
    c.add_argument("--file", required=True)
    sub.add_parser("list", help="the names you can use")
    for verb in ("set", "rm"):
        c = sub.add_parser(verb, help="the person: keep a value (from stdin)" if verb == "set" else "the person: remove one")
        c.add_argument("name")
        c.add_argument("--machine", nargs="?", const="", default=None, help="for a machine (no value: this one)")
        c.add_argument("--space", help="for a space (its id)")
        c.add_argument("--caller", help=argparse.SUPPRESS)
        if verb == "set":
            c.add_argument("--value-file", help=argparse.SUPPRESS)
    c = sub.add_parser("names", help="every entry, without values")
    c.add_argument("--json", action="store_true")
    c.add_argument("--caller", help=argparse.SUPPRESS)
    c = sub.add_parser("where", help="which machine keeps the secrets")
    c.add_argument("--json", action="store_true")
    sub.add_parser("mark-remote", help=argparse.SUPPRESS)
    sub.add_parser("init", help="make the vault (owner-only) if it's missing")
    c = sub.add_parser("serve", help="(Herdr) answer another machine's terminal")
    c.add_argument("terminal")
    c = sub.add_parser("install", help="put this herdr-secret on another machine")
    c.add_argument("--on", required=True)
    a = p.parse_args(argv)
    if a.cmd != "run" and rest:
        p.error("only run takes a command after --")
    if a.cmd == "ask":
        return cmd_ask(a.name, a.why, a.force)
    if a.cmd == "run":
        return cmd_run(names_arg(a.names), rest)
    if a.cmd == "env":
        return cmd_env(names_arg(a.names), a.file)
    if a.cmd == "list":
        names = values([], list_only=True)["names"]
        if not names:
            say("No secrets for you yet. Ask: herdr-secret ask NAME --why \"what it's for\".")
        for n, where in sorted(names.items()):
            say(f"{n} ({WHERE.get(where, where)})")
        return 0
    if a.cmd == "set":
        return cmd_set(a.name, a)
    if a.cmd == "rm":
        return cmd_rm(a.name, a)
    if a.cmd == "names":
        return cmd_names(a.json, a.caller)
    if a.cmd == "where":
        return cmd_where(a.json)
    if a.cmd == "mark-remote":
        return mark_remote()
    if a.cmd == "init":
        if remote():
            raise Fail("The vault lives on the main machine.")
        init_vault()
        say(VAULT)
        return 0
    if a.cmd == "serve":
        return serve(a.terminal)
    if a.cmd == "install":
        return cmd_install(a.on)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Fail as e:
        sys.stderr.write(f"herdr-secret: {e}\n")
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)

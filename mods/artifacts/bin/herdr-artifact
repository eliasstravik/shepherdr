#!/usr/bin/env python3
"""herdr-artifact: Shepherdr's artifacts, the one way to make and change them.

An artifact is a web page an agent writes to show the person something: a report, a board, a form, a proof. It is a
folder with an index.html and the files beside it (css, js, pictures, data). It belongs to one folder, like a task:
the repo root in git (a linked worktree counts as its main repo), else the folder itself. Each folder's artifacts are
listed in <artifacts>/<slug>.json on the machine where the folder lives; every version's files are kept in
<artifacts>/files/<id>/v<n>/ (the last 20), with a picture of the page taken when it was published
(.thumb.png, .thumb-dark.png) beside them.

Every write takes the folder list's lock and replaces it atomically. `convert` turns what Shepherdr 3.1 kept (drawn
"recipes" and custom window panels) into pages, once.
"""

import argparse
import contextlib
import errno
import fcntl
import glob
import hashlib
import html
import json
import os
import re
import secrets
import shutil
import struct
import subprocess
import sys
import tempfile
import time
import urllib.parse
import zlib

VERSION = "1"
HOME = os.path.expanduser("~")
# GitHub #1117: a herdr-core started by launchd or systemd hands what it runs (hc exec --on from another machine) a bare
# PATH (/usr/bin:/bin), so hc, gh and the agents' CLIs wouldn't be found. When hc isn't on it, their usual folders go
# at the end: the person's own order still wins.
if not __import__("shutil").which("hc"):
    os.environ["PATH"] = os.pathsep.join([p for p in os.environ.get("PATH", "").split(os.pathsep) if p] + [
        d for d in (os.path.join(HOME, ".local", "bin"), "/opt/homebrew/bin", "/usr/local/bin")
        if d not in os.environ.get("PATH", "").split(os.pathsep)])
# ---- SHEP: Shepherdr's own folders (a copy of herdr_task/layout.py's PY; test/test_layout.py checks it) ----
def SHEP(rel, _t={'.herdr/shepherdr.json': ('config', 'settings.json'), '.herdr/model-picks.json': ('config', 'model-picks.json'), '.herdr/tasks': ('data', 'tasks'), '.herdr/artifacts': ('data', 'artifacts'), '.herdr/vault.json': ('data', 'secrets/vault.json'), '.herdr/secret-remote': ('data', 'secrets/remote'), '.herdr/tools.json': ('data', 'tools.json'), '.herdr/shepherdr': ('state', 'service'), '.herdr/browser': ('state', 'browser'), '.herdr/secret-drop': ('state', 'secret-drop'), '.herdr/secret-served': ('state', 'secret-served'), '.herdr/cli-check.json': ('state', 'cli-check.json'), '.herdr/machine-hold.json': ('state', 'machine-hold.json'), '.herdr/analytics': ('data', 'analytics')}):
    H, E = os.path.expanduser("~"), os.environ
    a = lambda v: E.get(v) if (E.get(v) or "").startswith("/") else None
    one = a("SHEPHERDR_HOME")
    R = dict((k, os.path.join(one, k)) for k in ("config", "data", "state")) if one else {
        "config": os.path.join(a("XDG_CONFIG_HOME") or os.path.join(H, ".config"), "shepherdr"),
        "data": os.path.join(a("XDG_DATA_HOME") or os.path.join(H, ".local", "share"), "shepherdr"),
        "state": os.path.join(a("XDG_STATE_HOME") or os.path.join(H, ".local", "state"), "shepherdr")}
    try:
        with open(os.path.join(R["data"], "LAYOUT")) as f:
            on = int((f.read().split() or ["0"])[0]) >= 2 and not os.path.lexists(os.path.join(H, ".herdr", ".layout-rollback"))
    except (OSError, ValueError):
        on = False
    if on:
        for old, (base, new) in _t.items():
            if rel == old or rel.startswith(old + "/"):
                return os.path.join(R[base], new + rel[len(old):])
    return os.path.join(H, rel)
# ---- end SHEP ----

# Shepherdr's own folders (~/.local/share/shepherdr/artifacts) once this machine's data moved there,
# else the old ~/.herdr/artifacts (which then links to the new place).
STORE = SHEP(".herdr/artifacts")
FILES = os.path.join(STORE, "files")
GUIDE = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "ARTIFACTS.md")
PAGE = "index.html"
# The picture of a version's page, taken when it is published (the app's tile), light and dark: kept in the version's
# folder under names no page file can have (a page's own files never start with a dot).
THUMB, THUMB_DARK = ".thumb.png", ".thumb-dark.png"
SHOT = (800, 500)
SHOT_WAIT = 45
# What a version was before `convert` made it a page (its recipe.json, its panel's code): kept, never served.
OLD = ".old"
# A custom panel's picture, as the old window last showed it (convert shows it on the page).
PICTURE = ".window.png"
# A task's proof by its title ("HAT-2: ... · Proof"), when --proof wasn't given.
PROOF = re.compile(r"·\s*proof\s*$", re.I)
KEEP = 20
MAX_FILES = 500
MB = 1024 * 1024
# The whole page (every version is kept, so every byte counts 20 times over)
MAX_BYTES = 50 * MB

class Fail(Exception):
    pass


def now():
    return int(time.time() * 1000)


def run(args, cwd=None, input=None):
    return subprocess.run(args, cwd=cwd, input=input, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                          universal_newlines=input is None or isinstance(input, str))


def git(cwd, *args):
    r = run(["git", "-C", cwd, *args])
    return r.returncode == 0, r.stdout.strip()


# ---- where a folder's artifacts live (the same rule as herdr-task) ----------------------------

def locate(path):
    path = os.path.realpath(os.path.expanduser(path or os.getcwd()))
    if not os.path.isdir(path):
        raise Fail(f"No such folder: {path}")
    ok, out = git(path, "rev-parse", "--path-format=absolute", "--git-common-dir", "--show-toplevel")
    lines = out.split("\n") if ok else []
    if len(lines) == 2:
        common, top = lines
        main = common[:-5] if common.endswith("/.git") else top
        return {"folder": main, "kind": "repo", "name": os.path.basename(main) or "/"}
    return {"folder": path, "kind": "folder", "name": "~" if path == HOME else (os.path.basename(path) or "/")}


def slug_of(folder):
    rel = os.path.relpath(folder, HOME) if folder == HOME or folder.startswith(HOME + "/") else folder
    s = re.sub(r"[^A-Za-z0-9._-]+", "-", "home" if rel == "." else rel.strip("/")).strip("-")
    return s or "root"


def store_path(folder):
    slug = slug_of(folder)
    p = os.path.join(STORE, slug + ".json")
    if os.path.exists(p):
        try:
            with open(p) as f:
                if json.load(f).get("folder") not in (None, folder):
                    slug = f"{slug}-{hashlib.sha1(folder.encode()).hexdigest()[:6]}"
                    p = os.path.join(STORE, slug + ".json")
        except (OSError, ValueError):
            pass
    return slug, p


def read_only(e):
    """Fails with the person's words when an OSError is the store being read-only (a sandbox); else returns."""
    if e.errno in (errno.EROFS, errno.EACCES, errno.EPERM):
        raise Fail(f"Can't change artifacts here: {STORE} is read-only (a sandbox?). Run this outside it.")


class Store:
    """One folder's artifacts: a change holds the folder's lock while open; a read takes none."""

    def __init__(self, loc, write=True):
        self.loc, self.write = loc, write
        self.slug, self.path = store_path(loc["folder"])
        self.dirty = False

    def __enter__(self):
        # A read takes no lock (#972, #971): every write replaces the list whole (os.replace), so a reader sees the old
        # list or the new one, never half. Readers that locked (a preview reads on every request) kept a publish
        # waiting for minutes, and a preview waited behind a publish's check: it stayed on Loading. A read-only
        # sandbox (a Codex reviewer's, #841) reads as anywhere else.
        self.lock = None
        if self.write:
            lock = os.path.join(STORE, "." + os.path.basename(self.path) + ".lock")
            try:
                os.makedirs(STORE, exist_ok=True)
                self.lock = open(lock, "a")
            except OSError as e:
                read_only(e)
                raise
            try:
                fcntl.flock(self.lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                # another herdr-artifact (a publish being saved) has this folder's list: say so, never wait silently
                print(f"Waiting for another herdr-artifact on {self.loc['name']}'s artifacts ({self.path})…", file=sys.stderr, flush=True)
                fcntl.flock(self.lock, fcntl.LOCK_EX)
        try:
            with open(self.path) as f:
                self.data = json.load(f)
        except FileNotFoundError:
            self.data = {}
        except ValueError:
            raise Fail(f"{self.path} isn't valid JSON. Fix it first.")
        d = self.data
        d.update(version=1, folder=self.loc["folder"], kind=self.loc["kind"], name=self.loc["name"], slug=self.slug)
        d.setdefault("artifacts", [])
        return self

    def __exit__(self, kind, *_):
        try:
            if kind is None and self.dirty and self.write:
                fd, tmp = tempfile.mkstemp(dir=STORE, prefix=".tmp-")
                with os.fdopen(fd, "w") as f:
                    json.dump(self.data, f, indent=1)
                    f.write("\n")
                os.replace(tmp, self.path)
        finally:
            if self.lock:
                fcntl.flock(self.lock, fcntl.LOCK_UN)
                self.lock.close()

    def find(self, ref):
        for a in self.data["artifacts"]:
            if a["id"] == ref:
                return a
        raise Fail(f"No artifact {ref!r} in {self.loc['name']}. `herdr-artifact list` shows them.")


def find_anywhere(ref):
    """The folder list that holds an artifact id, on this machine."""
    for f in sorted(os.listdir(STORE)) if os.path.isdir(STORE) else []:
        if not f.endswith(".json"):
            continue
        try:
            with open(os.path.join(STORE, f)) as fh:
                d = json.load(fh)
        except (OSError, ValueError):
            continue
        if any(a.get("id") == ref for a in d.get("artifacts") or []):
            return {"folder": d["folder"], "kind": d.get("kind", "folder"), "name": d.get("name", "")}
    raise Fail(f"No artifact {ref!r} on this machine. `herdr-artifact list --all` shows them.")


# ---- who is publishing --------------------------------------------------------------------

def me():
    """This terminal's address and its task, from herdr-core: {terminal, task}. Its task is its herdr.task label
    ("<list slug>#<n>", a task's worker and its helpers carry it), read with `hc get` (`hc ls` lists no labels),
    else the task's own HERDR_BROWSER_TASK, which its worker's shell is started with."""
    t = os.environ.get("HC_TERMINAL_ID") or None
    key = None
    if t:
        try:
            r = run(["hc", "get", t, "--json"])
            row = json.loads(r.stdout) if r.returncode == 0 else {}
        except (OSError, ValueError):
            row = {}
        key = ((row if isinstance(row, dict) else {}).get("labels") or {}).get("herdr.task")
    key = key or os.environ.get("HERDR_BROWSER_TASK") or None
    return {"terminal": t, "task": task_ref(key)}


def task_folder(task):
    """The folder of a task ("SHOP-4"): the one task list with that prefix that has it, else (several do) the one this
    agent's own task (HERDR_BROWSER_TASK, "<list slug>#<n>") is in. None: no list says, or it's still unclear."""
    prefix, _, n = (task or "").rpartition("-")
    if not prefix or not n.isdigit():
        return None
    tdir, found = SHEP(".herdr/tasks"), {}
    for f in sorted(os.listdir(tdir)) if os.path.isdir(tdir) else []:
        if not f.endswith(".json"):
            continue
        try:
            with open(os.path.join(tdir, f)) as fh:
                d = json.load(fh)
        except (OSError, ValueError):
            continue
        if not isinstance(d, dict) or (d.get("prefix") or "").upper() != prefix.upper() or not d.get("folder"):
            continue
        if any(str(x.get("id")) == n for x in d.get("tasks") or [] if isinstance(x, dict)) and os.path.isdir(d["folder"]):
            found[f[:-5]] = d["folder"]
    if len(set(found.values())) == 1:
        return next(iter(found.values()))
    mine = (os.environ.get("HERDR_BROWSER_TASK") or "").rpartition("#")[0]
    return found.get(mine)


def task_ref(key):
    """A task's key ("dev-shop#4") as its people know it ("SHOP-4"): its list's prefix, else "#4"."""
    if not key or "#" not in key:
        return None
    slug, n = key.rsplit("#", 1)
    if not n.isdigit():
        return None
    try:
        with open(os.path.join(SHEP(".herdr/tasks"), slug + ".json")) as f:
            prefix = json.load(f).get("prefix")
    except (OSError, ValueError):
        prefix = None
    return f"{prefix}-{n}" if prefix else f"#{n}"


# ---- files -------------------------------------------------------------------------------

def gather(src, limits=True):
    """A page's folder and its files (relative paths, sorted). Fails when it has no index.html, holds a link, or is
    too big. Files and folders that start with a dot, and node_modules, are left out."""
    src = os.path.realpath(os.path.expanduser(src))
    if os.path.isfile(src) and os.path.basename(src) == PAGE:
        src = os.path.dirname(src)
    if not os.path.isdir(src):
        raise Fail(f"No such folder: {src}")
    if not os.path.isfile(os.path.join(src, PAGE)):
        raise Fail(f"{src} has no index.html. An artifact is a folder with an index.html and the files beside it "
                   "(`herdr-artifact new <dir>` writes a starting one).")
    out, size = [], 0
    for root, dirs, names in os.walk(src):
        for d in dirs:
            if os.path.islink(os.path.join(root, d)):
                raise Fail(f"{os.path.relpath(os.path.join(root, d), src)} is a link: copy the folder in instead.")
        dirs[:] = [d for d in dirs if not d.startswith(".") and d != "node_modules"]
        for n in names:
            if n.startswith("."):
                continue
            p = os.path.join(root, n)
            rel = os.path.relpath(p, src)
            if os.path.islink(p):
                raise Fail(f"{rel} is a link: copy the file in instead.")
            if not os.path.isfile(p):
                continue
            size += os.path.getsize(p)
            out.append(rel)
    if limits and (len(out) > MAX_FILES or size > MAX_BYTES):
        raise Fail(f"Too big: {len(out)} files, {size / MB:.0f} MB (at most {MAX_FILES} files, {MAX_BYTES // MB} MB in all). "
                   "Make pictures and clips smaller, or leave out what the page doesn't show.")
    return src, sorted(out)


LINK = re.compile(r"""\b(?:src|href|poster)\s*=\s*(["'])(.*?)\1""", re.I | re.S)


def link_warnings(src, files):
    """What in index.html won't load once it is published: a path from the root or the disk, one that leaves the
    folder, a file that isn't beside it."""
    try:
        with open(os.path.join(src, PAGE), encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        return []
    have, out = set(files), []
    for m in LINK.finditer(text):
        ref = html.unescape(m.group(2)).strip()
        if not ref or ref.startswith(("#", "//", "?")) or re.match(r"^[a-z][a-z0-9+.-]*:", ref, re.I) and not ref.lower().startswith("file:"):
            continue
        path = urllib.parse.unquote(re.split(r"[?#]", ref, 1)[0])
        if ref.lower().startswith("file:") or path.startswith("/"):
            w = f"{ref}: a path from the root or the disk won't load. Put the file in the folder and name it from there (\"shot.png\")."
        elif os.path.normpath(path).startswith(".."):
            w = f"{ref}: it leaves the page's folder, so it won't load. Put the file in the folder."
        elif os.path.normpath(path) not in have and not (path.endswith("/") and os.path.join(os.path.normpath(path), PAGE) in have):
            w = f"{ref}: no such file in the folder."
        else:
            continue
        if w not in out:
            out.append(w)
    return out[:20]


def copy_files(src, files, dst):
    for rel in files:
        to = os.path.join(dst, rel)
        os.makedirs(os.path.dirname(to), exist_ok=True)
        shutil.copyfile(os.path.join(src, rel), to)


def files_of(d):
    """A kept version's own files (what its page is made of)."""
    out = []
    for root, dirs, names in os.walk(d):
        dirs[:] = [x for x in dirs if not x.startswith(".")]
        out += [os.path.relpath(os.path.join(root, n), d) for n in names if not n.startswith(".")]
    return sorted(out)


# ---- serving a page on this machine (its picture, `preview`) ---------------------------------------
# A page is served as the app serves it: from its own folder only, sandboxed (it runs its scripts but is no page of
# whoever serves it), under a path that starts with a random token (any account here can reach a loopback port).

TYPES = {".html": "text/html; charset=utf-8", ".htm": "text/html; charset=utf-8", ".css": "text/css; charset=utf-8",
         ".js": "text/javascript; charset=utf-8", ".mjs": "text/javascript; charset=utf-8", ".json": "application/json",
         ".map": "application/json", ".txt": "text/plain; charset=utf-8", ".md": "text/plain; charset=utf-8",
         ".csv": "text/csv; charset=utf-8", ".xml": "application/xml", ".svg": "image/svg+xml", ".png": "image/png",
         ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".gif": "image/gif", ".webp": "image/webp", ".avif": "image/avif",
         ".ico": "image/x-icon", ".woff": "font/woff", ".woff2": "font/woff2", ".ttf": "font/ttf", ".otf": "font/otf",
         ".wasm": "application/wasm", ".mp4": "video/mp4", ".m4v": "video/mp4", ".webm": "video/webm",
         ".mov": "video/quicktime", ".mp3": "audio/mpeg", ".m4a": "audio/mp4", ".wav": "audio/wav", ".ogg": "audio/ogg",
         ".pdf": "application/pdf"}
SANDBOX = "sandbox allow-scripts allow-forms allow-popups"

def span(header, size):
    """A Range header's one span of a file size bytes long: (start, end) with end included, "bad" when it can't be met,
    None for the whole file (service/media.ts's span, the same rules)."""
    m = re.fullmatch(r"bytes=(\d*)-(\d*)", (header or "").strip())
    if not m or not (m.group(1) or m.group(2)):
        return None
    if not m.group(1):
        start, end = max(0, size - int(m.group(2))), size - 1
    else:
        start, end = int(m.group(1)), (min(int(m.group(2)), size - 1) if m.group(2) else size - 1)
    return "bad" if start > end or start >= size else (start, end)


def page_file(base, rel):
    """The file a page's path names inside its folder, or None: no dot files, nothing outside, a folder is its index.html."""
    rel = rel.lstrip("/")
    if not rel or rel.endswith("/"):
        rel += PAGE
    parts = rel.split("/")
    if any(p in ("", "..") or p.startswith(".") for p in parts):
        return None
    base = os.path.realpath(base)
    p = os.path.realpath(os.path.join(base, *parts))
    if os.path.isdir(p):
        p = os.path.join(p, PAGE)
    return p if p.startswith(base + os.sep) and os.path.isfile(p) else None


def page_server(resolve, on_request=None):
    """An HTTP server on 127.0.0.1 (a free port) for pages: resolve(path after the token) -> a file's path, a
    (code, body, type) answer, or None. Returns (server, token); its links start http://127.0.0.1:<port>/<token>/."""
    import hmac
    import http.server
    token = secrets.token_urlsafe(24)

    class H(http.server.BaseHTTPRequestHandler):
        server_version = "herdr-artifact"

        def log_message(self, *_a):
            pass

        def send(self, code, body, ctype, extra=None):
            if isinstance(body, str):
                body = body.encode()
            self.send_response(code)
            for k, v in {"content-type": ctype, "content-length": str(len(body)), "x-content-type-options": "nosniff",
                         "cache-control": "no-store", "referrer-policy": "no-referrer", "content-security-policy": SANDBOX,
                         "access-control-allow-origin": "*", **(extra or {})}.items():
                self.send_header(k, v)
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(body)

        def do_HEAD(self):
            self.do_GET()

        def do_GET(self):
            if on_request:
                on_request()
            if (self.headers.get("host") or "").rsplit(":", 1)[0] not in ("127.0.0.1", "localhost"):
                return self.send(403, "Only on this machine.", "text/plain")
            path = urllib.parse.unquote(urllib.parse.urlsplit(self.path).path)
            given, _, rest = path.lstrip("/").partition("/")
            if not hmac.compare_digest(given.encode(), token.encode()):
                return self.send(403, "This link needs its token: `herdr-artifact preview <id>` gives the whole link.", "text/plain")
            p = resolve(rest)
            if isinstance(p, tuple):
                return self.send(*p)
            if not p:
                return self.send(404, "No such file.", "text/plain")
            size = os.path.getsize(p)
            part = span(self.headers.get("range"), size)
            ctype = TYPES.get(os.path.splitext(p)[1].lower(), "application/octet-stream")
            if part == "bad":
                return self.send(416, b"", ctype, {"content-range": f"bytes */{size}"})
            start, end = part or (0, size - 1)
            with open(p, "rb") as f:
                f.seek(start)
                body = f.read(end - start + 1)
            return self.send(206 if part else 200, body, ctype,
                             {"accept-ranges": "bytes", **({"content-range": f"bytes {start}-{end}/{size}"} if part else {})})

    srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), H)
    srv.daemon_threads = True
    return srv, token


# ---- a picture of the page (the app's tile) -------------------------------------------------------

def chrome_bin():
    """A Chrome to take the picture with: $HERDR_ARTIFACT_CHROME (empty: none), the task browser's own (agent-browser's
    Chrome for Testing, as herdr-browser installs it), else the machine's. None: no picture."""
    named = os.environ.get("HERDR_ARTIFACT_CHROME")
    if named is not None:
        return named if named and os.access(named, os.X_OK) else None
    found = []
    for base in (os.path.join(HOME, ".agent-browser", "browsers"),):
        for pat in ("chrome-*/chrome", "chrome-*/*/chrome", "chrome-*/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing",
                    "chrome-*/*/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing"):
            found += [p for p in glob.glob(os.path.join(base, pat)) if os.path.isfile(p) and os.access(p, os.X_OK)]
    if found:
        ver = lambda p: [int(x) for x in re.findall(r"\d+", os.path.relpath(p, os.path.join(HOME, ".agent-browser", "browsers")).split(os.sep)[0])]
        return max(found, key=ver)
    for n in ("google-chrome", "google-chrome-stable", "chromium", "chromium-browser"):
        p = shutil.which(n)
        if p:
            return p
    mac = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
    return mac if os.access(mac, os.X_OK) else None


def shoot(folder):
    """Pictures of the page in `folder`, light and dark, at SHOT's size: {THUMB: path, THUMB_DARK: path} of the ones
    taken, in a temp folder the caller removes ("dir"). Empty when no browser is here or it didn't draw: a publish
    never fails for its picture."""
    chrome = chrome_bin()
    if not chrome:
        return {}
    import threading
    srv, token = page_server(lambda rel: page_file(folder, rel))
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    tmp = tempfile.mkdtemp(prefix="herdr-artifact-shot-")
    url = f"http://127.0.0.1:{srv.server_address[1]}/{token}/"
    out = {"dir": tmp}

    def start(name, dark, sandbox=True):
        args = [chrome, "--headless=new", "--use-mock-keychain", "--password-store=basic", "--disable-gpu", "--hide-scrollbars", "--no-first-run", "--no-default-browser-check",
                "--disable-extensions", "--mute-audio", f"--user-data-dir={os.path.join(tmp, 'profile-' + name)}",
                f"--window-size={SHOT[0]},{SHOT[1]}", "--virtual-time-budget=4000", f"--screenshot={os.path.join(tmp, name)}"]
        if dark:
            args += ["--force-dark-mode", "--blink-settings=preferredColorScheme=0"]
        if not sandbox:
            args.append("--no-sandbox")
        return subprocess.Popen(args + [url], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def ok(name):
        try:
            return png_size(os.path.join(tmp, name))[0] > 0
        except (OSError, ValueError, struct.error):
            return False
    try:
        for sandbox in (True, False):  # a machine that refuses Chrome's own sandbox (root, AppArmor): once more without
            todo = [(n, d) for n, d in ((THUMB, False), (THUMB_DARK, True)) if not ok(n)]
            if not todo:
                break
            ps = []
            with contextlib.suppress(OSError):
                ps = [start(n, d, sandbox) for n, d in todo]
            end = time.time() + SHOT_WAIT
            for p in ps:
                try:
                    p.wait(timeout=max(1, end - time.time()))
                except subprocess.TimeoutExpired:
                    p.kill()
        for n in (THUMB, THUMB_DARK):
            if ok(n):
                out[n] = os.path.join(tmp, n)
    finally:
        srv.shutdown()
        srv.server_close()
    return out


def keep_shots(shots, dst):
    """The pictures taken, put in a version's folder; True when it has its (light) picture."""
    try:
        for n in (THUMB, THUMB_DARK):
            if shots.get(n):
                shutil.copyfile(shots[n], os.path.join(dst, n))
    except OSError:
        pass
    finally:
        if shots.get("dir"):
            shutil.rmtree(shots["dir"], ignore_errors=True)
    return os.path.isfile(os.path.join(dst, THUMB))


# ---- commands ----------------------------------------------------------------------------

def public(a):
    """An artifact as list and show give it."""
    out = {k: a.get(k) for k in ("id", "title", "version", "folder", "publisher", "task", "at", "created", "versions", "files")}
    last = (a.get("versions") or [{}])[-1]
    return dict(out, proof=bool(a.get("proof")), pinned=bool(a.get("pinned")), thumb=bool(last.get("thumb")))


def next_version(art):
    return (art["versions"][-1]["v"] if art["versions"] else 0) + 1


def trim(art):
    """Only the last KEEP versions stay."""
    for old in art["versions"][:-KEEP]:
        shutil.rmtree(os.path.join(FILES, art["id"], f"v{old['v']}"), ignore_errors=True)
    art["versions"] = art["versions"][-KEEP:]


def cmd_publish(o):
    src, files = gather(o.dir)
    who = me()
    # A new page for a task is filed under that task's folder, wherever it's published from (a scratch folder's
    # store is one its task's ready never reads); --folder still wins.
    loc = find_anywhere(o.id) if o.id and not o.folder else \
        locate(o.folder or (None if o.id else task_folder(o.task or who["task"])))
    with Store(loc, write=False) as s:
        art = s.find(o.id) if o.id else None
    if not art and not o.title:
        raise Fail("Give it a title: --title \"Coverage by package\".")
    as_proof = bool(getattr(o, "proof", False))

    def named(art, title):
        """(title, task): the title as given (SHEP-322: no task key in front; the task rides in its own field), an
        older one's "HAT-2: " dropped."""
        task = o.task or art.get("task") or who["task"]
        if task and title.upper().startswith(task.upper() + ":"):
            title = title[len(task) + 1:].strip() or title
        return title, task
    title, task = named(art or {}, o.title or (art or {}).get("title"))
    if as_proof and not task:
        raise Fail("--proof needs the task it proves: --task SHOP-4.")
    warnings = link_warnings(src, files)
    # The picture first, with no lock held: it takes a few seconds, and the folder's lock held through it would keep
    # every other publish waiting. The lock is taken only to save, from the list as it is then.
    shots = shoot(src)
    try:
        if not art:
            base = re.sub(r"[^a-z0-9]+", "-", o.title.lower()).strip("-")[:24].strip("-") or "artifact"
            while True:  # its files' folder, made now: the id is this publish's (another can't pick it meanwhile)
                aid = f"{base}-{secrets.token_hex(2)}"
                try:
                    os.makedirs(FILES, exist_ok=True)
                    os.mkdir(os.path.join(FILES, aid))
                    break
                except FileExistsError:
                    pass
                except OSError as e:  # a read-only store (a sandbox) says so
                    read_only(e)
                    raise
            art = {"id": aid, "created": now(), "versions": []}
        with Store(loc) as s:
            if not o.id:
                s.data["artifacts"].insert(0, art)
            else:
                art = s.find(o.id)  # as it is now: another publish may have saved a version meanwhile
                title, task = named(art, o.title or art["title"])
            v = next_version(art)
            keep = os.path.join(FILES, art["id"], f"v{v}")
            try:
                copy_files(src, files, keep)
            except OSError as e:
                read_only(e)
                raise
            thumb = keep_shots(shots, keep)
            shots = {}
            at = now()
            art.update(title=title, version=v, folder=loc["folder"], publisher=who["terminal"], task=task, at=at, files=files)
            # a task's proof stays on its task until the person keeps it; once kept it is an artifact like any other
            if task and not art.get("kept") and (as_proof or PROOF.search(title)):
                art["proof"] = True
            art["versions"].append({"v": v, "at": at, "publisher": who["terminal"], **({"note": o.note} if o.note else {}),
                                    **({"thumb": True} if thumb else {})})
            trim(art)
            s.data["artifacts"].remove(art)
            s.data["artifacts"].insert(0, art)
            s.dirty = True
    finally:
        if shots.get("dir"):
            shutil.rmtree(shots["dir"], ignore_errors=True)
    out = dict(public(art), warnings=warnings)
    if o.json:
        print(json.dumps(out))
    else:
        print(f"Published {art['id']} v{v}: {title}")
        print("It's the proof of " + task + ": it shows on that task." if art.get("proof") else "The person sees it in Artifacts; your chat shows its tile.")
        if not thumb:
            print("No picture of it was taken (no browser here): its tile shows its title only.")
        for w in warnings:
            print(f"Fix, then update it: {w}")
        print(f"See it as the person does: herdr-artifact preview {art['id']}")
    return 0


def cmd_list(o):
    if o.all:
        lists = []
        for f in sorted(os.listdir(STORE)) if os.path.isdir(STORE) else []:
            if f.endswith(".json"):
                try:
                    with open(os.path.join(STORE, f)) as fh:
                        lists.append(json.load(fh))
                except (OSError, ValueError):
                    pass
        arts = sorted((dict(a, folder=a.get("folder") or d.get("folder")) for d in lists if isinstance(d, dict) for a in d.get("artifacts") or []),
                      key=lambda a: -(a.get("at") or 0))
        out = {"artifacts": [public(a) for a in arts]}
    else:
        loc = locate(o.folder)
        with Store(loc, write=False) as s:
            out = {"folder": loc["folder"], "name": loc["name"], "store": s.path, "slug": s.slug,
                   "artifacts": [public(a) for a in s.data["artifacts"]]}
    if o.json:
        print(json.dumps(out))
        return 0
    if not out["artifacts"]:
        print("No artifacts.")
    for a in out["artifacts"]:
        marks = "".join(f"  ({w})" for w, on in (("pinned", a["pinned"]), ("proof", a["proof"])) if on)
        print(f"{a['id']:<32} v{a['version']:<3} {a['title']}{marks}")
    return 0


def cmd_where(o):
    loc = locate(o.folder)
    slug, path = store_path(loc["folder"])
    print(json.dumps(dict(loc, store=path, slug=slug, files=FILES)))
    return 0


def cmd_show(o):
    loc = find_anywhere(o.id)
    with Store(loc, write=False) as s:
        a = s.find(o.id)
    if o.json:
        print(json.dumps(dict(public(a), path=os.path.join(FILES, a["id"], f"v{a['version']}"))))
    else:
        print(f"{a['title']}  ({a['id']}, v{a['version']})" + ("  proof" if a.get("proof") else "") + ("  pinned" if a.get("pinned") else ""))
        for v in reversed(a["versions"]):
            print(f"  v{v['v']}  {time.strftime('%Y-%m-%d %H:%M', time.localtime(v['at'] / 1000))}  {v.get('note', '')}")
        print(f"  files: {os.path.join(FILES, a['id'], 'v' + str(a['version']))}")
    return 0


def cmd_rm(o):
    loc = find_anywhere(o.id)
    with Store(loc) as s:
        a = s.find(o.id)
        s.data["artifacts"].remove(a)
        s.dirty = True
    shutil.rmtree(os.path.join(FILES, o.id), ignore_errors=True)
    print(json.dumps({"removed": o.id}) if o.json else f"Removed {o.id}.")
    return 0


def change(o, fn, said):
    """One change to an artifact's record, saved; prints what `said(a)` says."""
    loc = find_anywhere(o.id)
    with Store(loc) as s:
        a = s.find(o.id)
        fn(a)
        s.dirty = True
    print(json.dumps(public(a)) if o.json else said(a))
    return 0


def cmd_rename(o):
    title = " ".join(o.title.split())
    if not title:
        raise Fail("Give it a name.")
    return change(o, lambda a: a.update(title=title[:200]), lambda a: f"{a['id']} is now: {a['title']}")


def cmd_pin(o):
    return change(o, lambda a: a.update(pinned=True), lambda a: f"Pinned {a['id']}.")


def cmd_unpin(o):
    return change(o, lambda a: a.pop("pinned", None), lambda a: f"Unpinned {a['id']}.")


def cmd_keep(o):
    """A task's proof kept as an artifact of its own: it shows in Artifacts from now on."""
    def keep(a):
        a.pop("proof", None)
        a["kept"] = True
    return change(o, keep, lambda a: f"Kept {a['id']}: it's in Artifacts now.")


def kept_version(a, v):
    """The folder of version v of an artifact (v None: the latest). Fails when it isn't kept."""
    v = v or a["version"]
    d = os.path.join(FILES, a["id"], f"v{v}")
    if not any(x["v"] == v for x in a.get("versions") or []) or not os.path.isdir(d):
        raise Fail(f"v{v} of {a['id']} isn't kept (only the last {KEEP} versions are). `herdr-artifact show {a['id']}` lists them.")
    return v, d


def cmd_restore(o):
    """An earlier version made the newest again: a copy of it as a new version (nothing is lost)."""
    loc = find_anywhere(o.id)
    with Store(loc) as s:
        a = s.find(o.id)
        n, src = kept_version(a, o.version)
        if n == a["version"]:
            raise Fail(f"v{n} is the newest version of {a['id']} already.")
        v = next_version(a)
        dst = os.path.join(FILES, a["id"], f"v{v}")
        try:
            shutil.copytree(src, dst, ignore=shutil.ignore_patterns(OLD))
        except OSError as e:
            read_only(e)
            raise
        was = next(x for x in a["versions"] if x["v"] == n)
        at = now()
        a.update(version=v, at=at, files=files_of(dst))
        a["versions"].append({"v": v, "at": at, "publisher": was.get("publisher"), "note": f"v{n} restored", "restored": n,
                              **({"thumb": True} if os.path.isfile(os.path.join(dst, THUMB)) else {})})
        trim(a)
        s.data["artifacts"].remove(a)
        s.data["artifacts"].insert(0, a)
        s.dirty = True
    print(json.dumps(public(a)) if o.json else f"Restored v{n} of {a['id']} as v{v}.")
    return 0


def live_terminals():
    r = run(["hc", "ls", "--json"])
    try:
        d = json.loads(r.stdout)
    except ValueError:
        return set()
    rows = d if isinstance(d, list) else d.get("terminals", [])
    return {x.get("address") for x in rows if x.get("state", "live") == "live"}


def task_worker(task, folder, live):
    """The live worker of a task ("HERD-47") of this folder, or None."""
    prefix, _, n = (task or "").rpartition("-")
    if not prefix or not n.isdigit():
        return None
    tdir = SHEP(".herdr/tasks")
    for f in sorted(os.listdir(tdir)) if os.path.isdir(tdir) else []:
        if not f.endswith(".json"):
            continue
        try:
            with open(os.path.join(tdir, f)) as fh:
                d = json.load(fh)
        except (OSError, ValueError):
            continue
        if d.get("folder") != folder or (d.get("prefix") or "").upper() != prefix.upper():
            continue
        t = next((x for x in d.get("tasks") or [] if str(x.get("id")) == n), None)
        for ag in reversed((t or {}).get("agents") or []):
            if ag.get("role") not in ("reviewer",) and ag.get("address") in live:
                return ag["address"]
    return None


def assistant_for(folder, live):
    """The live Assistant of the space this folder is: the one working in it, else in one of its repo's worktrees."""
    r = run(["hc", "ls", "--label", "herdr.role=coordinator", "--json"])
    try:
        d = json.loads(r.stdout)
    except ValueError:
        return None
    rows = d if isinstance(d, list) else d.get("terminals", [])
    real, near = os.path.realpath(folder), None
    for k in rows:
        addr = k.get("address")
        if not addr or "/" in addr or addr not in live:
            continue
        cwd = k.get("cwd")
        if not cwd:
            try:
                cwd = json.loads(run(["hc", "get", addr, "--json"]).stdout).get("cwd")
            except (ValueError, AttributeError):
                cwd = None
        if not cwd:
            continue
        if os.path.realpath(cwd) == real:
            return addr
        with contextlib.suppress(Fail, OSError):
            if not near and os.path.isdir(cwd) and locate(cwd)["folder"] == real:
                near = addr
    return near


def keeper(a, folder):
    """Who hears the person about an artifact: the agent that made it, while it runs; else its task's worker; else,
    with that agent gone, the Assistant of its space (the space's chat)."""
    live = live_terminals()
    if a.get("publisher") in live:
        return a["publisher"], "made it"
    w = task_worker(a.get("task"), folder, live)
    if w:
        return w, f"works on {a['task']}"
    c = assistant_for(folder, live)
    if c:
        return c, "is its space's Assistant (the agent that made it has ended)"
    raise Fail("The agent that made this page has ended, and its space has no chat running. Open the space's chat, then send it again.")


def attr(s):
    return re.sub(r"[<>]", "", str(s)).replace('"', "”")


# ---- PNGs in plain Python (#1054) ------------------------------------------------------------
# A stock machine has no ImageMagick and no PIL: an 8-bit RGB or RGBA PNG (what a browser's screenshot writes) is read,
# cut and written here.

def png_read(path, upto=None):
    """(width, height, channels, rows) of an 8-bit RGB or RGBA PNG, not interlaced; rows (bytearrays) only down to
    `upto` when given (a crop needs none below it)."""
    with open(path, "rb") as f:
        data = f.read()
    if data[:8] != b"\x89PNG\r\n\x1a\n":
        raise ValueError("not a PNG")
    i, idat, head = 8, [], None
    while i + 8 <= len(data):
        n, t = struct.unpack(">I4s", data[i:i + 8])
        body = data[i + 8:i + 8 + n]
        if t == b"IHDR":
            head = struct.unpack(">IIBBBBB", body) if len(body) == 13 else ()
        elif t == b"IDAT":
            idat.append(body)
        elif t == b"IEND":
            break
        i += 12 + n
    if not head or len(head) != 7:
        raise ValueError("no PNG header")
    w, h, depth, ctype, _c, _f, inter = head
    if depth != 8 or ctype not in (2, 6) or inter:
        raise ValueError("only an 8-bit RGB or RGBA PNG, not interlaced, is read without ImageMagick")
    ch = 3 if ctype == 2 else 4
    stride, rows, prev = w * ch, [], bytearray(w * ch)
    # what is inflated but not yet read: buf from pos (#1108: slicing off each row copied the rest, quadratic)
    z, buf, pos = zlib.decompressobj(), bytearray(), 0
    chunks = iter(idat)
    for y in range(min(h, upto if upto is not None else h)):
        while len(buf) - pos < stride + 1:
            if pos > len(buf) // 2:
                del buf[:pos]
                pos = 0
            nxt = next(chunks, None)
            buf += z.decompress(nxt) if nxt is not None else z.flush()
            if nxt is None and len(buf) - pos < stride + 1:
                raise ValueError("a PNG cut short")
        ft, line = buf[pos], bytearray(buf[pos + 1:pos + 1 + stride])
        pos += stride + 1
        if ft == 1:
            for x in range(ch, stride):
                line[x] = (line[x] + line[x - ch]) & 255
        elif ft == 2:
            line = bytearray((a + b) & 255 for a, b in zip(line, prev))
        elif ft == 3:
            for x in range(stride):
                line[x] = (line[x] + (((line[x - ch] if x >= ch else 0) + prev[x]) >> 1)) & 255
        elif ft == 4:
            for x in range(stride):
                a, b = (line[x - ch] if x >= ch else 0), prev[x]
                c = prev[x - ch] if x >= ch else 0
                pa, pb, pc = abs(b - c), abs(a - c), abs(a + b - 2 * c)
                line[x] = (line[x] + (a if pa <= pb and pa <= pc else b if pb <= pc else c)) & 255
        rows.append(line)
        prev = line
    return w, h, ch, rows


def png_write(path, w, h, ch, rows):
    def chunk(t, d):
        return struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d) & 0xFFFFFFFF)
    raw = b"".join(b"\0" + bytes(r) for r in rows)
    with open(path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2 if ch == 3 else 6, 0, 0, 0))
                + chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))


def png_size(path):
    with open(path, "rb") as f:
        head = f.read(24)
    if head[:8] != b"\x89PNG\r\n\x1a\n" or head[12:16] != b"IHDR":
        raise ValueError("not a PNG")
    return struct.unpack(">II", head[16:24])


def png_cut(src, out, x, y, w, h, outline=None, stroke=2, longest=None):
    """src's rectangle (px) as a PNG at out; outline: ("rect", x0, y0, x1, y1) or ("circle", cx, cy, r) inside the cut,
    drawn in blue; longest: shrunk (never grown) so its longest side is at most that."""
    x, y, w, h = max(0, int(x)), max(0, int(y)), int(w), int(h)
    W, H = png_size(src)
    if x >= W or y >= H:  # #1108: nothing of it to cut (a cut of nothing wrote a PNG with no pixels)
        raise ValueError(f"the rect starts outside the picture ({W}x{H} px)")
    W, H, ch, rows = png_read(src, upto=min(H, y + h))
    w, h = max(1, min(int(w), W - x)), max(1, min(int(h), H - y))
    cut = [bytearray(r[x * ch:(x + w) * ch]) for r in rows[y:y + h]]
    if outline:
        blue = bytes((0x2F, 0x81, 0xF7, 255)[:ch])

        def dot(px, py):
            px, py = int(px), int(py)
            for dy in range(stroke):
                for dx in range(stroke):
                    qx, qy = px + dx - stroke // 2, py + dy - stroke // 2
                    if 0 <= qx < w and 0 <= qy < h:
                        cut[qy][qx * ch:(qx + 1) * ch] = blue
        if outline[0] == "rect":
            x0, y0, x1, y1 = outline[1:]
            for px in range(int(x0), int(x1) + 1):
                dot(px, y0), dot(px, y1)
            for py in range(int(y0), int(y1) + 1):
                dot(x0, py), dot(x1, py)
        else:
            import math
            cx, cy, r = outline[1:]
            for k in range(int(2 * math.pi * r) * 2 + 8):
                t = k / (int(2 * math.pi * r) * 2 + 8) * 2 * math.pi
                dot(cx + r * math.cos(t), cy + r * math.sin(t))
    if longest and max(w, h) > longest:
        f = max(w, h) / longest
        nw, nh = max(1, round(w / f)), max(1, round(h / f))
        cut = [bytearray(b"".join(bytes(cut[int(j * f)][int(i * f) * ch:(int(i * f) + 1) * ch]) for i in range(nw))) for j in range(nh)]
        w, h = nw, nh
    png_write(out, w, h, ch, cut)
    return True


def cmd_crop(o):
    """A picture cut to what matters, for an artifact: no ImageMagick or PIL needed (#1054)."""
    x, y, w, h = rect(o.rect)
    if w < 1 or h < 1:
        raise Fail("The rect needs a width and a height: x,y,w,h in pixels.")
    try:
        png_cut(os.path.expanduser(o.src), os.path.expanduser(o.out), x, y, w, h, longest=o.max)
    except (OSError, ValueError, struct.error, zlib.error) as e:  # a corrupt or short PNG too (#1108)
        raise Fail(f"Couldn't crop {o.src}: {e}.")
    W, H = png_size(os.path.expanduser(o.out))
    print(json.dumps({"out": os.path.expanduser(o.out), "width": W, "height": H}) if o.json else f"Wrote {o.out} ({W}x{H}).")
    return 0


def rect(s):
    try:
        v = [float(x) for x in s.split(",")]
    except ValueError:
        raise Fail(f"Not a rect (x,y,w,h): {s}")
    if len(v) != 4:
        raise Fail(f"Not a rect (x,y,w,h): {s}")
    return v


# ---- the person's words to the agent (a note on the page, an answer from it) ----------------------------

def spot_of(s):
    """A pin "x,y" as fractions of the page's width and height (0 to 1) -> (x, y, words), or None when it's words."""
    m = re.fullmatch(r"\s*(-?\d*\.?\d+)\s*,\s*(-?\d*\.?\d+)\s*", s or "")
    if not m:
        return None
    x, y = (min(1.0, max(0.0, float(v))) for v in m.groups())
    third = lambda v: min(2, int(v * 3))
    yw, xw = ("top", "middle", "bottom")[third(y)], ("left", "center", "right")[third(x)]
    near = "the middle" if (yw, xw) == ("middle", "center") else f"the middle {xw}" if yw == "middle" else f"the {yw} center" if xw == "center" else f"the {yw} {xw}"
    return x, y, f"{round(x * 100)}% from the left, {round(y * 100)}% from the top of the page (near {near})"


def tell(o, extra, lines):
    """The person's words about an artifact, sent to who keeps it as <hc from="artifact" …>; held for an agent that
    waits on a question (typing would answer it)."""
    loc = find_anywhere(o.id)
    with Store(loc, write=False) as s:
        a = s.find(o.id)
    v = o.version or a["version"]
    to, why = keeper(a, loc["folder"])
    if v != a["version"]:
        lines = lines + [f"(Written on v{v}; the latest is v{a['version']}.)"]
    if why.startswith("is its space"):
        lines = lines + [f"(The agent that made this page has ended, so this comes to you. Its files: {os.path.join(FILES, a['id'], 'v' + str(a['version']))}; "
                         f"change a copy and `herdr-artifact update {a['id']} <dir>`.)"]
    body = f'<hc from="artifact" id="{attr(a["id"])}" version="{v}" title="{attr(a["title"])}"{extra}>\n' + "\n\n".join(lines) + "\n</hc>"
    out = {"to": to, "why": why, "version": v}
    if shell_in_front(to):
        # SHEP-324: its agent exited and left a plain shell, which would run the note as a command: kept instead (an
        # Assistant starts again with it, a task's agent gets it when the task is restarted)
        if not hold_note(to, body):
            raise Fail("Its agent isn't running (its terminal is a plain shell now), so nothing was typed into it. Restart it, then send this again.")
        out.update(held=True, said=STOPPED_NOTE)
        print(json.dumps(out) if o.json else f"Kept for {to}: {STOPPED_NOTE}")
        return 0
    r = run(["hc", "send", to, body])
    if r.returncode != 0:
        kind, msg = plain_error(r.stderr.strip() or r.stdout.strip())
        if kind != "blocked":
            raise Fail(msg or f"Couldn't send it to {to}.")
        if not hold_note(to, body):
            raise Fail("It's waiting on a question, and this couldn't be kept for later: send it again once that's answered.")
        out.update(held=True, said=HELD_NOTE)
        print(json.dumps(out) if o.json else f"Held for {to}: {HELD_NOTE}")
        return 0
    print(json.dumps(out) if o.json else f"Sent to {to} ({why}).")
    return 0


def cmd_note(o):
    """The person's note on a page (tap to drop a pin, then write), sent to the agent that keeps it."""
    text = (o.text or "").strip()
    if not text:
        raise Fail("Write the note: --text \"…\".")
    extra, lines = "", [text]
    if o.spot:
        at = spot_of(o.spot)
        if at:
            extra = f' spot="{at[0]:.3f},{at[1]:.3f}"'
            lines.append(f"(Their pin: {at[2]}.)")
        else:
            extra = f' on="{attr(o.spot)}"'
    return tell(o, extra, lines)


def cmd_say(o):
    """The person's answer from the page itself (its postMessage), sent to the agent that keeps it."""
    text = (o.text or "").strip()
    if not text:
        raise Fail("Nothing to send: --text \"…\".")
    return tell(o, " answer", [text])


HELD_NOTE = "It's waiting on a question: your note goes to it once that's answered."
STOPPED_NOTE = "Its agent had stopped, so nothing was typed into it: your note goes to it once it's running again."
SHELLS = {"bash", "zsh", "fish", "sh", "dash", "ksh", "tcsh", "csh", "nu", "xonsh", "pwsh", "powershell", "elvish"}


def shell_in_front(to):
    """Whether a plain shell is in front of terminal `to` (its agent exited): nothing may be typed there (SHEP-324; the
    same rule as herdr-task's agents.front)."""
    try:
        k = json.loads(run(["hc", "get", to, "--json"]).stdout or "null") or {}
    except ValueError:
        return False
    fg = k.get("foreground") or {}
    if k.get("state") != "live" or os.path.basename(str(fg.get("name") or "")) not in SHELLS:
        return False
    for a in (fg.get("argv") or [])[1:]:  # a shell running a command (fish -ic "claude …") still holds its agent
        if a == "--command" or a.startswith("--command=") or (a.startswith("-") and not a.startswith("--") and "c" in a[1:]):
            return False
        if not a.startswith("-") or a.startswith("--"):
            break
    return True


def plain_error(text):
    """(kind, message) of hc's or herdr-artifact's error, whatever JSON it came wrapped in (#1213: the page showed
    {"error": "{\"error\":{...}}"}): hc's {"error": {"kind", "message"}}, a {"error": "..."} or plain words."""
    kind, s = None, text
    for _ in range(4):
        if not isinstance(s, str):
            break
        t = s.strip()
        if not t.startswith("{"):
            break
        try:
            s = json.loads(t)
        except ValueError:
            break
        while isinstance(s, dict):
            kind = s.get("kind") or kind
            s = s.get("error") if "error" in s else s.get("message", "")
    msg = s if isinstance(s, str) else ""
    return kind, msg.strip()


def hold_note(to, body):
    """Kept by herdr-task (its held messages) for the agent at `to`; True when kept."""
    ht = shutil.which("herdr-task") or os.path.expanduser("~/.local/bin/herdr-task")
    try:
        return subprocess.run([ht, "_hold", to], input=body, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                              universal_newlines=True, timeout=30).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


# ---- pages for what Shepherdr 3.1 kept (convert, once) ---------------------------------------------
# 3.1's artifacts were recipes (recipe.json: a list of blocks each side drew) or, rarely, custom panels only the Herdr
# window ran (main.js). Each kept version becomes a plain page that needs nothing else: this small renderer is all
# that is left of the recipe format.

CSS = """:root { color-scheme: light dark; --fg: #111; --bg: #fff; --muted: #666; --line: #ddd; --good: #1a7f37; --warn: #9a6700; --bad: #cf222e; --link: #1d4ed8; }
@media (prefers-color-scheme: dark) { :root { --fg: #eee; --bg: #111; --muted: #999; --line: #333; --good: #3fb950; --warn: #d29922; --bad: #f85149; --link: #8ab4f8; } }
* { box-sizing: border-box; }
body { margin: 0 auto; padding: 16px; max-width: 720px; font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; color: var(--fg); background: var(--bg); overflow-wrap: anywhere; }
h1 { font-size: 22px; line-height: 1.25; margin: 0 0 12px; }
h2 { font-size: 18px; margin: 28px 0 8px; }
h3 { font-size: 16px; margin: 20px 0 6px; }
p, ul, ol, figure, pre, table { margin: 0 0 14px; }
img, video { max-width: 100%; height: auto; border: 1px solid var(--line); border-radius: 6px; }
figcaption, .muted { color: var(--muted); font-size: 14px; }
.scroll { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 15px; }
th, td { text-align: left; padding: 6px 12px 6px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
pre { overflow-x: auto; padding: 12px; border: 1px solid var(--line); border-radius: 6px; }
pre, code { font: 13px/1.45 ui-monospace, SFMono-Regular, Menlo, monospace; }
a { color: var(--link); text-underline-offset: 3px; }
button { font: inherit; padding: 8px 14px; border: 1px solid var(--fg); border-radius: 6px; background: var(--fg); color: var(--bg); }
.good { color: var(--good); } .warn { color: var(--warn); } .bad { color: var(--bad); }"""
# what only converted pages need
CSS_OLD = """.stats { display: flex; flex-wrap: wrap; gap: 8px 28px; margin: 0 0 14px; }
.stats b { display: block; font-size: 24px; line-height: 1.2; }
.note { border-left: 3px solid var(--line); padding: 2px 0 2px 12px; margin: 0 0 14px; }
.note.good { border-color: var(--good); color: inherit; } .note.warn { border-color: var(--warn); color: inherit; } .note.bad { border-color: var(--bad); color: inherit; }
.note p:last-child { margin: 0; }
.cols { display: flex; flex-wrap: wrap; gap: 0 24px; } .cols > div { flex: 1 1 260px; min-width: 0; }
.right { text-align: right; } .center { text-align: center; }
details { margin: 0 0 14px; } summary { cursor: pointer; }"""

esc = lambda s: html.escape("" if s is None else str(s), quote=True)


def md_inline(s):
    """One line of Markdown as HTML: `code`, **bold**, *italic*, [links](https://…)."""
    parts = re.split(r"(`[^`\n]+`)", "" if s is None else str(s))
    out = []
    for i, p in enumerate(parts):
        if i % 2:
            out.append(f"<code>{esc(p[1:-1])}</code>")
            continue
        t = esc(p)
        t = re.sub(r"!?\[([^\]\n]*)\]\(((?:https?://|mailto:)[^)\s]+)\)", lambda m: f'<a href="{m.group(2)}" target="_blank" rel="noopener">{m.group(1) or m.group(2)}</a>', t)
        t = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", t)
        t = re.sub(r"(?<![\w*])\*(?!\s)(.+?)(?<!\s)\*(?![\w*])", r"<em>\1</em>", t)
        out.append(t)
    return "".join(out)


def md_block(text):
    """Markdown as HTML: paragraphs, headings, lists, fenced code."""
    out, para, items, kind = [], [], [], None

    def flush():
        nonlocal para, items, kind
        if para:
            out.append("<p>" + "<br>".join(md_inline(x) for x in para) + "</p>")
        if items:
            out.append(f"<{kind}>" + "".join(f"<li>{md_inline(x)}</li>" for x in items) + f"</{kind}>")
        para, items, kind = [], [], None
    lines = ("" if text is None else str(text)).replace("\r\n", "\n").split("\n")
    i = 0
    while i < len(lines):
        line = lines[i]
        fence = re.match(r"^\s*(```|~~~)", line)
        if fence:
            flush()
            j = i + 1
            while j < len(lines) and not lines[j].strip().startswith(fence.group(1)):
                j += 1
            out.append("<pre><code>" + esc("\n".join(lines[i + 1:j])) + "</code></pre>")
            i = j + 1
            continue
        h = re.match(r"^(#{1,4})\s+(.*)$", line)
        li = re.match(r"^\s*(?:([-*•])|(\d+)[.)])\s+(.*)$", line)
        if not line.strip():
            flush()
        elif h:
            flush()
            n = min(4, len(h.group(1)) + 1)
            out.append(f"<h{n}>{md_inline(h.group(2))}</h{n}>")
        elif li:
            want = "ul" if li.group(1) else "ol"
            if para or (kind and kind != want):
                flush()
            kind = want
            items.append(li.group(3))
        elif items and line.startswith((" ", "\t")):
            items[-1] += " " + line.strip()
        else:
            if items:
                flush()
            para.append(line)
        i += 1
    flush()
    return "\n".join(out)


def _src(name, have):
    """A file beside the page by its name, as a link; None when it isn't there (or isn't a plain relative name)."""
    name = "" if name is None else str(name)
    if not name or name.startswith(("/", ".")) or ".." in name.split("/") or name not in have:
        return None
    return urllib.parse.quote(name)


def _media(src, have, caption=None, poster=None, flags=None, label=None):
    """A picture, clip, sound or PDF beside the page, with its caption."""
    link, ext = _src(src, have), os.path.splitext(str(src or ""))[1].lower()
    cap = "".join(f"<figcaption>{x}</figcaption>" for x in [" · ".join(md_inline(x) for x in (label, caption) if x)] if x)
    if not link:
        return f'<p class="muted">{esc(caption or label or "A file")} ({esc(src)}: not kept)</p>' if src else ""
    if ext in (".mp4", ".m4v", ".webm", ".mov"):
        f = flags or {}
        more = "".join(f" {k}" for k in ("autoplay", "loop", "muted") if f.get(k)) + (f' poster="{_src(poster, have)}"' if _src(poster, have) else "")
        body = f'<video controls playsinline preload="metadata" src="{link}"{more}></video>'
    elif ext in (".mp3", ".m4a", ".wav", ".ogg"):
        body = f'<audio controls preload="metadata" src="{link}"></audio>'
    elif ext == ".pdf":
        return f'<p><a href="{link}" target="_blank" rel="noopener">{md_inline(caption or label) or "Open the PDF"}</a> (PDF)</p>'
    else:
        body = f'<img src="{link}" alt="{esc(caption or label or "")}">'
    return f"<figure>{body}{cap}</figure>"


def _button(b):
    return f"[{esc(b.get('label') or 'Button')}]" + (f' <a href="{esc(b["href"])}" target="_blank" rel="noopener">{esc(b["href"])}</a>'
                                                    if str(b.get("href") or "").startswith("https://") else "")


def recipe_html(blocks, have, depth=0):
    """A recipe's blocks as plain HTML, top to bottom. What the person could press (a choice, a form, a button) reads
    as its labels."""
    out = []
    for b in blocks if isinstance(blocks, list) and depth < 6 else []:
        if not isinstance(b, dict):
            continue
        t = b.get("type")
        if t == "heading":
            try:
                n = min(4, max(2, int(b.get("level") or 1) + 1))
            except (TypeError, ValueError):
                n = 2
            out.append(f"<h{n}>{md_inline(b.get('text'))}</h{n}>")
        elif t == "text":
            out.append(md_block(b.get("md")))
        elif t == "list":
            tag = "ol" if b.get("ordered") else "ul"
            out.append(f"<{tag}>" + "".join(f"<li>{md_inline(x)}</li>" for x in b.get("items") or []) + f"</{tag}>")
        elif t == "table":
            cols = [c if isinstance(c, dict) else {"label": c} for c in b.get("columns") or []]
            cls = [f' class="{c["align"]}"' if c.get("align") in ("right", "center") else "" for c in cols]
            head = "".join(f"<th{cls[i]}>{md_inline(c.get('label'))}</th>" for i, c in enumerate(cols))
            rows = "".join("<tr>" + "".join(f"<td{cls[i] if i < len(cls) else ''}>{md_inline(x)}</td>" for i, x in enumerate(r if isinstance(r, list) else [r])) + "</tr>"
                           for r in b.get("rows") or [])
            out.append(f'<div class="scroll"><table>{"<thead><tr>" + head + "</tr></thead>" if head else ""}<tbody>{rows}</tbody></table></div>')
        elif t == "chart":
            series = [s for s in b.get("series") or [] if isinstance(s, dict)]
            head = "<th></th>" + "".join(f'<th class="right">{esc(s.get("name") or "")}</th>' for s in series)
            rows = "".join(f"<tr><td>{esc(lab)}</td>" + "".join(
                f'<td class="right">{esc((s.get("values") or [])[i] if i < len(s.get("values") or []) else "")}</td>' for s in series) + "</tr>"
                for i, lab in enumerate(b.get("labels") or []))
            out.append(f'<div class="scroll"><table><thead><tr>{head}</tr></thead><tbody>{rows}</tbody></table></div>')
        elif t == "stats":
            out.append('<div class="stats">' + "".join(
                f"<div><b>{esc(x.get('value'))}</b>{esc(x.get('label'))}" + (f' <span class="muted">{esc(x["note"])}</span>' if x.get("note") else "") + "</div>"
                for x in b.get("items") or [] if isinstance(x, dict)) + "</div>")
        elif t in ("image", "video", "audio", "pdf"):
            out.append(_media(b.get("src"), have, b.get("caption"), b.get("poster"), b))
        elif t == "pair":
            sides = [(k.capitalize(), b.get(k)) for k in ("before", "after") if isinstance(b.get(k), dict)]
            out.append('<div class="cols">' + "".join(f"<div>{_media(x.get('src'), have, x.get('caption'), x.get('poster'), None, lab)}</div>" for lab, x in sides) + "</div>")
        elif t == "code":
            out.append(f"<pre><code>{esc(b.get('text'))}</code></pre>")
        elif t == "callout":
            tone = b.get("tone") if b.get("tone") in ("good", "warn", "bad") else ""
            out.append(f'<div class="note {tone}">' + (f"<p><strong>{md_inline(b['title'])}</strong></p>" if b.get("title") else "") + md_block(b.get("md")) + "</div>")
        elif t == "columns":
            out.append('<div class="cols">' + "".join(f"<div>{recipe_html(c, have, depth + 1)}</div>" for c in b.get("columns") or []) + "</div>")
        elif t == "tabs":
            for tab in b.get("tabs") or []:
                if isinstance(tab, dict):
                    out.append(f"<h3>{esc(tab.get('label'))}</h3>" + recipe_html(tab.get("blocks"), have, depth + 1))
        elif t == "details":
            out.append(f"<details><summary>{md_inline(b.get('summary'))}</summary>{recipe_html(b.get('blocks'), have, depth + 1)}</details>")
        elif t == "divider":
            out.append("<hr>")
        elif t == "choice":
            out.append(f"<p><strong>{md_inline(b.get('question'))}</strong></p><ul>" + "".join(
                f"<li>{esc(x.get('label'))}" + (f': <span class="muted">{esc(x["description"])}</span>' if x.get("description") else "") + "</li>"
                for x in b.get("options") or [] if isinstance(x, dict)) + "</ul>")
        elif t == "form":
            rows = []
            for f in b.get("fields") or []:
                if not isinstance(f, dict):
                    continue
                more = [", ".join(str(x) for x in f["options"])] if f.get("options") else []
                if f.get("value") not in (None, "", False):
                    more.append("yes" if f["value"] is True else str(f["value"]))
                rows.append(f"<li>{esc(f.get('label') or f.get('name'))}" + (f': <span class="muted">{esc(" · ".join(more))}</span>' if more else "") + "</li>")
            out.append(f"<ul>{''.join(rows)}</ul><p class=\"muted\">[{esc(b.get('submit') or 'Send')}]</p>")
        elif t == "button":
            out.append(f'<p class="muted">{_button(b)}</p>')
        elif t == "buttons":
            out.append('<p class="muted">' + " ".join(_button(x) for x in b.get("items") or [] if isinstance(x, dict)) + "</p>")
    return "\n".join(x for x in out if x)


def page_html(title, body, old=False):
    return (f'<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n<meta name="viewport" content="width=device-width, initial-scale=1">\n'
            f"<title>{esc(title)}</title>\n<style>\n{CSS}{chr(10) + CSS_OLD if old else ''}\n</style>\n</head>\n<body>\n{body}\n</body>\n</html>\n")


def convert_version(a, d):
    """One kept version's folder made a page, in place: its recipe drawn as index.html (its pictures and clips stay
    beside it), or a custom panel's page showing the picture the window last took. What it was goes to .old/ inside
    it. Returns "recipe", "custom", or None when it is a page already (or gone)."""
    if not os.path.isdir(d) or os.path.isfile(os.path.join(d, PAGE)):
        return None
    old = os.path.join(d, OLD)
    at = lambda n: next((p for p in (os.path.join(d, n), os.path.join(old, n)) if os.path.isfile(p)), None)
    custom = bool(at("main.js")) or not at("recipe.json")
    title = a.get("title") or a["id"]
    os.makedirs(old, exist_ok=True)
    if custom:
        for n in os.listdir(d):  # a panel's code is nothing a page shows
            if not n.startswith("."):
                os.replace(os.path.join(d, n), os.path.join(old, n))
        pic = at(PICTURE)
        if pic:
            shutil.copyfile(pic, os.path.join(d, "window.png"))
        body = f"<h1>{esc(title)}</h1>\n" + (f'<figure><img src="window.png" alt="{esc(title)}"><figcaption>As the old Herdr window last showed it.</figcaption></figure>'
                                             if pic else '<p class="muted">This was made for the old Herdr window, so there is nothing to show here.</p>')
    else:
        try:
            with open(at("recipe.json"), encoding="utf-8") as f:
                recipe = json.load(f)
            blocks = recipe.get("blocks") if isinstance(recipe, dict) else None
        except (OSError, ValueError):
            blocks = None
        have = set(files_of(d))
        body = f"<h1>{esc(title)}</h1>\n" + (recipe_html(blocks, have) if isinstance(blocks, list)
                                             else '<p class="muted">What this showed could not be read.</p>')
        if os.path.isfile(os.path.join(d, "recipe.json")):
            os.replace(os.path.join(d, "recipe.json"), os.path.join(old, "recipe.json"))
    tmp = os.path.join(d, ".index.tmp")
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(page_html(title, body, old=True))
    os.replace(tmp, os.path.join(d, PAGE))
    return "custom" if custom else "recipe"


def converted_mark():
    return os.path.join(STORE, ".pages")


def edit_list(path, fn):
    """One folder's list changed under its lock: fn(data) -> True to save it."""
    with open(os.path.join(STORE, "." + os.path.basename(path) + ".lock"), "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            with open(path) as f:
                data = json.load(f)
            if isinstance(data, dict) and fn(data):
                fd, tmp = tempfile.mkstemp(dir=STORE, prefix=".tmp-")
                with os.fdopen(fd, "w") as f:
                    json.dump(data, f, indent=1)
                    f.write("\n")
                os.replace(tmp, path)
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)


def cmd_pictures(o):
    """The picture of every artifact's newest version that has none yet (a converted one, or one published where no
    browser was): a few at a time. Slow with many, and safe to stop and run again."""
    from concurrent.futures import ThreadPoolExecutor
    if not chrome_bin():
        print(json.dumps({"taken": [], "browser": False}) if o.json else "No browser here to take pictures with.")
        return 0
    todo = []
    for name in sorted(os.listdir(STORE)) if os.path.isdir(STORE) else []:
        if not name.endswith(".json"):
            continue
        try:
            with open(os.path.join(STORE, name)) as f:
                data = json.load(f)
        except (OSError, ValueError):
            continue
        for a in data.get("artifacts") or [] if isinstance(data, dict) else []:
            d = os.path.join(FILES, str(a.get("id")), f"v{a.get('version')}")
            if a.get("id") and (not o.id or a["id"] == o.id) and os.path.isfile(os.path.join(d, PAGE)) and not os.path.isfile(os.path.join(d, THUMB)):
                todo.append((os.path.join(STORE, name), a["id"], a["version"], d))
    taken = []

    def one(item):
        path, aid, v, d = item
        if not keep_shots(shoot(d), d):
            return

        def mark(data):
            for a in data.get("artifacts") or []:
                for x in a.get("versions") or [] if a.get("id") == aid else []:
                    if x.get("v") == v and not x.get("thumb"):
                        x["thumb"] = True
                        return True
            return False
        edit_list(path, mark)
        taken.append(aid)
    with ThreadPoolExecutor(max_workers=3) as pool:
        list(pool.map(one, todo))
    print(json.dumps({"taken": sorted(taken), "browser": True}) if o.json else f"Took {len(taken)} of {len(todo)} pictures.")
    return 0


def cmd_convert(o):
    """Once per machine: every artifact Shepherdr 3.1 kept becomes a page, every kept version of it, in place. Ids,
    titles, versions, times and tasks stay. Running it again changes nothing."""
    only = getattr(o, "id", None)
    if not only and os.path.isfile(converted_mark()):
        print(json.dumps({"converted": [], "done": True}) if o.json else "Nothing to convert: this machine's artifacts are pages already.")
        return 0
    done, failed = [], []
    for name in sorted(os.listdir(STORE)) if os.path.isdir(STORE) else []:
        if not name.endswith(".json"):
            continue
        path = os.path.join(STORE, name)

        def turn(data):
            dirty = False
            for a in data.get("artifacts") or []:
                if not isinstance(a, dict) or not a.get("id") or (only and a["id"] != only):
                    continue
                was = {}
                for x in a.get("versions") or []:
                    d = os.path.join(FILES, a["id"], f"v{x.get('v')}")
                    try:
                        kind = convert_version(a, d)
                    except OSError as e:
                        read_only(e)
                        failed.append({"id": a["id"], "version": x.get("v"), "why": str(e)})
                        continue
                    # a version's record says pages only: no kinds, no window pictures
                    if kind or "kind" in x or "picture" in x:
                        if kind or x.get("kind"):
                            x.setdefault("was", kind or x.get("kind"))
                        x.pop("kind", None)
                        x.pop("picture", None)
                        dirty = True
                    if kind:
                        was[x["v"]] = kind
                last = os.path.join(FILES, a["id"], f"v{a.get('version')}")
                if was and os.path.isdir(last):
                    a["files"] = files_of(last)
                    # a picture each takes seconds, hundreds of artifacts minutes: only when asked (else `pictures`, later)
                    if getattr(o, "pictures", False) and a["versions"] and not os.path.isfile(os.path.join(last, THUMB)):
                        if keep_shots(shoot(last), last):
                            a["versions"][-1]["thumb"] = True
                # 3.1 knew a task's proof by its title: it stays on its task now, as a proof published today
                if was and a.get("task") and PROOF.search(a.get("title") or "") and not a.get("kept") and not a.get("proof"):
                    a["proof"] = True
                if was:
                    done.append({"id": a["id"], "versions": sorted(was), "was": sorted(set(was.values()))})
            return dirty
        try:
            edit_list(path, turn)
        except (OSError, ValueError) as e:
            if isinstance(e, OSError):
                read_only(e)
            failed.append({"list": name, "why": str(e)})
    if not only and not failed and os.path.isdir(STORE):
        with open(converted_mark(), "w") as f:
            json.dump({"at": now(), "converted": len(done)}, f)
    if o.json:
        print(json.dumps({"converted": done, "failed": failed}))
    elif not done and not failed:
        print("Nothing to convert.")
    else:
        print(f"Made {len(done)} artifact{'' if len(done) == 1 else 's'} a page." + "".join(f"\n  couldn't: {x.get('id') or x.get('list')}: {x['why']}" for x in failed))
    return 1 if failed else 0


# ---- showing the person (SHEP-99) ------------------------------------------------------------
# Wherever the person is: the web app's page they use (a phone, a browser) opens it, else the window here; and a
# link always works. The machine that serves the web app writes its link in herdr-core's document shepherdr.web on
# every machine it links (core/host.js WEB_DOC), so an agent on a machine with no web app of its own has it too.
WEB_DOC = "shepherdr.web"
WEB_JSON = SHEP(".herdr/shepherdr/web.json")
# The core label an agent's terminal asks with: the serving machine's service hears it (service/show.ts).
SHOW = "herdr.show"


def core_doc(name):
    """A herdr-core document's value on this machine (hc connect, plain JSON lines), or None."""
    if not shutil.which("hc"):
        return None
    ask = "".join(json.dumps({"jsonrpc": "2.0", "id": i, "method": m, "params": p}) + "\n"
                  for i, m, p in ((1, "hello", {"generation": 1}), (2, "doc.get", {"name": name})))
    try:
        r = subprocess.run(["hc", "connect"], input=ask, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                           universal_newlines=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    for line in r.stdout.splitlines():
        try:
            m = json.loads(line)
        except ValueError:
            continue
        if isinstance(m, dict) and m.get("id") == 2:
            return (m.get("result") or {}).get("value")
    return None


def web_base():
    """The web app's link (its tailnet address, ".../shepherdr/"), or None: the host's word here, else what
    this machine's own service says (its web.json)."""
    for get in (lambda: core_doc(WEB_DOC), lambda: json.load(open(WEB_JSON))):
        try:
            link = (get() or {}).get("link")
        except (OSError, ValueError, AttributeError):
            link = None
        if isinstance(link, str) and link.startswith("https://"):
            return link if link.endswith("/") else link + "/"
    return None


def web_link(aid):
    base = web_base()
    return f"{base}?artifact={urllib.parse.quote(aid, safe='')}" if base else None


NO_LINK = ("No web link is known here yet: Shepherdr's web app isn't served, or the machine serving it hasn't "
           "linked this one (`shepherdr web status` there says).")


def known(aid, machine):
    """Fails unless the artifact is here (or, with --from, leaves that to the machine it's on)."""
    if not machine:
        find_anywhere(aid)


def cmd_link(o):
    known(o.id, o.machine)
    link = web_link(o.id)
    if not link:
        raise Fail(NO_LINK)
    print(json.dumps({"id": o.id, "link": link}) if o.json else link)
    return 0


def ask_screen(aid):
    """Asks the web app's page the person uses to open it: the label herdr.show on this agent's own terminal.
    True once asked (whether a page is on screen to show it, only the serving machine knows)."""
    me_ = os.environ.get("HC_TERMINAL_ID")
    if not me_ or not shutil.which("hc"):
        return False
    ask = {"id": secrets.token_hex(4), "at": now(), "artifact": aid}
    return run(["hc", "label", me_, f"{SHOW}={json.dumps(ask, separators=(',', ':'))}"]).returncode == 0


def cmd_open(o):
    """Shows an artifact to the person wherever they are: the app's page they use opens it, and its link is printed."""
    known(o.id, o.machine)
    link = web_link(o.id)
    screen = ask_screen(o.id)
    if o.json:
        print(json.dumps({"id": o.id, "link": link, "screen": screen}))
    else:
        if screen:
            print("Asked the person's screen to show it: the app opens it on the page they use, if one is open.")
        print(f"Link: {link}" if link else NO_LINK)
    return 0 if (screen or link) else 1


# ---- seeing it here, as the person does ------------------------------------------------------------
# The person's link leads to the machine that serves the app, which this one may not reach. `preview` serves this
# machine's pages themselves on 127.0.0.1 only (page_server: sandboxed as the app frames them, behind a random token),
# started on demand and gone after PREVIEW_IDLE seconds unused; the agent opens the link in its task's browser
# (herdr-browser) at a phone's and a desktop's width.
PREVIEW_IDLE = 1800
PREVIEW_WAIT = 20


def preview_state():
    return os.path.join(STORE, ".preview")


def preview_log():
    return os.path.join(STORE, ".preview.log")


def code_stamp():
    """Which herdr-artifact runs a preview server: one from an older copy is replaced."""
    try:
        return str(int(os.path.getmtime(os.path.realpath(__file__))))
    except OSError:
        return "0"


def preview_alive():
    """The running preview server's (port, token), when it answers as this herdr-artifact's for this store, else None."""
    import urllib.request
    try:
        with open(preview_state()) as f:
            st = json.load(f)
        port, token = int(st["port"]), str(st["token"])
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/{urllib.parse.quote(token, safe='')}/ping", timeout=2) as r:
            me_ = json.load(r)
    except (OSError, ValueError, KeyError, TypeError):
        return None
    if me_.get("store") != STORE or me_.get("code") != code_stamp():
        with contextlib.suppress(OSError, ValueError, TypeError, KeyError):
            os.kill(int(st["pid"]), 15)
        return None
    return port, token


def preview_start():
    """The (port, token) of this machine's preview server, started when none answers. Its own output goes to the
    preview log, so a start that fails says why; a busy machine gets PREVIEW_WAIT seconds, and a server that ended at
    once one more try."""
    alive = preview_alive()
    if alive:
        return alive
    os.makedirs(STORE, exist_ok=True)
    why = None
    for _ in (1, 2):
        with contextlib.suppress(OSError):
            os.unlink(preview_state())
        with open(preview_log(), "w") as log:
            p = subprocess.Popen([sys.executable, os.path.realpath(__file__), "_serve"], stdin=subprocess.DEVNULL,
                                 stdout=log, stderr=log, start_new_session=True, close_fds=True)
        end = time.time() + PREVIEW_WAIT
        while time.time() < end:
            time.sleep(0.1)
            alive = preview_alive()
            if alive:
                return alive
            if p.poll() is not None:
                break
        try:
            with open(preview_log()) as f:
                tail = [l.rstrip() for l in f.read().strip().splitlines()[-3:]]
        except OSError:
            tail = []
        if p.poll() is None:
            why = f"it didn't answer within {PREVIEW_WAIT} s"
            with contextlib.suppress(OSError):
                p.kill()
            break
        why = f"it ended at once (exit {p.returncode})" + (": " + " / ".join(tail) if tail else "")
    raise Fail(f"The preview server didn't start: {why}. Its log: {preview_log()}. Try again.")


def preview_file(rest):
    """What a preview link's path names: <id>/v<n>/<the page's own path>."""
    if rest == "ping":
        return 200, json.dumps({"store": STORE, "code": code_stamp()}), "application/json"
    m = re.match(r"^([\w.-]+)/v(\d+)(?:/(.*))?$", rest)
    if not m or m.group(1).startswith("."):
        return None
    if m.group(3) is None:  # the page's own links are read from its folder: it ends with a slash
        return 302, "", "text/plain", {"location": f"v{m.group(2)}/"}
    return page_file(os.path.join(FILES, m.group(1), f"v{int(m.group(2))}"), m.group(3))


def serve_preview(idle=PREVIEW_IDLE):
    """The preview server: this machine's pages, read only, on 127.0.0.1 (a free port, written with its token to the
    preview state, 0600). Ends after `idle` seconds without a request."""
    import threading
    last = [time.time()]
    srv, token = page_server(preview_file, lambda: last.__setitem__(0, time.time()))
    os.makedirs(STORE, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=STORE, prefix=".tmp-")
    with os.fdopen(fd, "w") as f:
        json.dump({"port": srv.server_address[1], "pid": os.getpid(), "token": token}, f)
    os.replace(tmp, preview_state())

    def watch():
        while time.time() - last[0] < idle:
            time.sleep(min(30, idle))
        srv.shutdown()
    threading.Thread(target=watch, daemon=True).start()
    try:
        srv.serve_forever()
    finally:
        with contextlib.suppress(OSError, ValueError):
            with open(preview_state()) as f:
                if json.load(f).get("pid") == os.getpid():
                    os.unlink(preview_state())
    return 0


def cmd_preview(o):
    """This machine's page, served here on 127.0.0.1: its link, for the task's browser."""
    with Store(find_anywhere(o.id), write=False) as s:
        v, d = kept_version(s.find(o.id), o.version)
    if not os.path.isfile(os.path.join(d, PAGE)):
        raise Fail(f"v{v} of {o.id} is no page yet (it was made for Shepherdr 3.1): run `herdr-artifact convert` once.")
    port, token = preview_start()
    link = f"http://127.0.0.1:{port}/{urllib.parse.quote(token, safe='')}/{urllib.parse.quote(o.id, safe='')}/v{v}/"
    if o.json:
        print(json.dumps({"id": o.id, "version": v, "link": link}))
    else:
        print(link)
        print("Open it in your task's browser, as the person sees it on a phone and on a desktop:\n"
              f"  herdr-browser set viewport 390 844 && herdr-browser open '{link}' && herdr-browser screenshot /abs/phone.png\n"
              f"  herdr-browser set viewport 1280 800 && herdr-browser open '{link}' && herdr-browser screenshot /abs/desktop.png")
    return 0


# What `new` starts a page with: the starter style (the guide's), a line, a table and a button that answers.
STARTER = """<h1>Title</h1>
<p>One line on what this shows. Replace everything in the body with yours.</p>
<div class="scroll">
<table>
<thead><tr><th>What</th><th>Value</th></tr></thead>
<tbody><tr><td>Example</td><td>42</td></tr></tbody>
</table>
</div>
<p><button onclick="parent.postMessage({ shepherdr: 'answer', text: 'Looks right' }, '*')">Looks right</button></p>"""


def cmd_new(o):
    d = os.path.realpath(os.path.expanduser(o.dir))
    if os.path.exists(os.path.join(d, PAGE)):
        raise Fail(f"{d}/index.html exists already.")
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, PAGE), "w", encoding="utf-8") as f:
        f.write(page_html("Title", STARTER))
    print(f"Wrote {d}/index.html. Write your page there (its files beside it), then: herdr-artifact publish {o.dir} --title \"...\"")
    return 0


def cmd_guide(_o):
    try:
        with open(GUIDE) as f:
            sys.stdout.write(f.read())
    except FileNotFoundError:
        raise Fail(f"The guide isn't installed here ({os.path.realpath(GUIDE)}). Update Shepherdr: `shepherdr update`.")
    return 0


# ---- another machine ------------------------------------------------------------------------

# Shepherdr's installer holds every copy of the helpers to other machines (this file, removed by
# `shepherdr doctor` once the install is whole), as herdr-task's base.sync_held.
# Its state folder's, or an older installer's in ~/.herdr: either holds.
SYNC_HOLDS = (os.path.join(os.path.dirname(SHEP(".herdr/secret-drop")), "sync-hold"), os.path.join(HOME, ".herdr", "sync-hold"))


def sync_held():
    """Why copies to other machines wait now (the hold's first line), or None."""
    for p in SYNC_HOLDS:
        try:
            with open(p) as f:
                return f.readline().strip() or "held by Shepherdr's installer"
        except OSError:
            continue
    return None


def remote(machine, argv):
    """Runs herdr-artifact on the machine that holds the folder, installing it there first."""
    me_ = os.path.realpath(__file__)
    with open(me_, "rb") as f:
        body = f.read()
    digest = hashlib.sha1(body).hexdigest()
    mark = os.path.join(STORE, ".remote", machine)
    target = ".local/bin/herdr-artifact"
    try:
        with open(mark) as f:
            installed = f.read().strip() == digest
    except OSError:
        installed = False

    def install():
        held = sync_held()
        if held:
            raise Fail(f"herdr-artifact isn't current on {machine}, and copies to other machines wait: {held}. "
                       "Run `shepherdr doctor` once the install is whole.")
        r = subprocess.run(["hc", "file", "write", "--on", machine, target], input=body, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if r.returncode != 0:
            raise Fail(f"Couldn't install herdr-artifact on {machine}: {r.stderr.decode().strip()}")
        subprocess.run(["hc", "exec", "--on", machine, "--", "chmod", "+x", target], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        os.makedirs(os.path.dirname(mark), exist_ok=True)
        with open(mark, "w") as f:
            f.write(digest)

    # Held (sync_held): no copy goes; the copy already there runs.
    if not installed and not sync_held():
        install()
    call = ["hc", "exec", "--on", machine, "--", "sh", "-c", 'exec "$HOME/.local/bin/herdr-artifact" "$@"', "herdr-artifact", *argv]
    r = run(call)
    if r.returncode == 127 or ("not found" in r.stderr and not r.stdout):
        install()
        r = run(call)
    sys.stderr.write(r.stderr)
    sys.stdout.write(r.stdout)
    return r.returncode


def main():
    argv = sys.argv[1:]
    if argv[:1] == ["--on"] and len(argv) > 1:
        try:
            return remote(argv[1], argv[2:])
        except Fail as e:
            print(json.dumps({"error": str(e)}) if "--json" in argv else f"herdr-artifact: {e}", file=sys.stdout if "--json" in argv else sys.stderr)
            return 1
    if argv[:1] == ["--version"]:
        print(VERSION)
        return 0
    if argv[:1] == ["_serve"]:
        return serve_preview()

    p = argparse.ArgumentParser(prog="herdr-artifact", description="Shepherdr's artifacts: web pages an agent writes to show the person something.",
                                epilog="`herdr-artifact guide` explains how to write one. Another machine's folder: herdr-artifact --on <machine> <command> ...")
    sub = p.add_subparsers(dest="cmd")

    def cmd(name, fn, help):
        c = sub.add_parser(name, help=help)
        c.add_argument("--json", action="store_true", help="JSON output")
        c.set_defaults(fn=fn)
        return c

    c = cmd("publish", cmd_publish, "publish a page (a folder with index.html): a new artifact, or with --id a new version")
    c.add_argument("dir", help="the folder with index.html and the files beside it")
    c.add_argument("--title", help="what it is, for people (needed for a new one)")
    c.add_argument("--id", help="an artifact's id: publish a new version of it")
    c.add_argument("--folder", help="the folder it belongs to (default: its task's, else here)")
    c.add_argument("--task", help="the task it's for (default: this agent's task)")
    c.add_argument("--note", help="what changed in this version")
    c.add_argument("--proof", action="store_true", help="it is its task's proof: it stays on the task, not in Artifacts")
    c = cmd("update", cmd_publish, "publish a new version of an artifact (publish --id)")
    c.add_argument("id")
    c.add_argument("dir")
    c.add_argument("--title")
    c.add_argument("--note")
    c.add_argument("--task")
    c.add_argument("--proof", action="store_true")
    c.set_defaults(folder=None)
    c = cmd("new", cmd_new, "write a starting index.html into a folder")
    c.add_argument("dir")
    cmd("guide", cmd_guide, "how to write an artifact")
    c = cmd("preview", cmd_preview, "see a page here as the person sees it: served on 127.0.0.1, for your task's browser")
    c.add_argument("id")
    c.add_argument("--version", type=int, help="an older version (default: the latest)")
    c = cmd("list", cmd_list, "a folder's artifacts, newest first")
    c.add_argument("--folder")
    c.add_argument("--all", action="store_true", help="every folder's on this machine")
    c = cmd("show", cmd_show, "an artifact, its versions and where its files are")
    c.add_argument("id")
    c = cmd("rm", cmd_rm, "delete an artifact and its versions")
    c.add_argument("id")
    c = cmd("rename", cmd_rename, "give an artifact another title")
    c.add_argument("id")
    c.add_argument("title")
    c = cmd("pin", cmd_pin, "pin an artifact to the top of Artifacts")
    c.add_argument("id")
    c = cmd("unpin", cmd_unpin, "unpin it")
    c.add_argument("id")
    c = cmd("keep", cmd_keep, "keep a task's proof as an artifact of its own (it shows in Artifacts)")
    c.add_argument("id")
    c = cmd("restore", cmd_restore, "make an earlier version the newest again (a copy of it)")
    c.add_argument("id")
    c.add_argument("--version", type=int, required=True, help="the version to bring back")
    c = cmd("note", cmd_note, "send the person's note on a page to the agent that keeps it")
    c.add_argument("id")
    c.add_argument("--text", required=True, help="what the person wrote")
    c.add_argument("--version", type=int, help="the version they were looking at (default: the latest)")
    c.add_argument("--spot", help="their pin: \"x,y\" as fractions of the page's width and height (0.5,0.2), or words")
    c = cmd("say", cmd_say, "send the person's answer from a page to the agent that keeps it")
    c.add_argument("id")
    c.add_argument("--text", required=True, help="the answer")
    c.add_argument("--version", type=int, help="the version they answered on (default: the latest)")
    c = cmd("convert", cmd_convert, "once: make every artifact Shepherdr 3.1 kept (recipes, window panels) a page")
    c.add_argument("--all", action="store_true", help="every artifact on this machine (the default)")
    c.add_argument("--id", help="only this artifact")
    c.add_argument("--pictures", action="store_true", help="also take each page's picture now (seconds each; else `herdr-artifact pictures` later)")
    c = cmd("pictures", cmd_pictures, "take the picture of every artifact that has none yet (after convert; slow with many)")
    c.add_argument("--all", action="store_true", help="every artifact on this machine (the default)")
    c.add_argument("--id", help="only this artifact")
    c = cmd("crop", cmd_crop, "cut a PNG to what matters (a screenshot for a page), with nothing else installed")
    c.add_argument("src", help="the PNG to cut")
    c.add_argument("out", help="where the cut PNG goes")
    c.add_argument("--rect", required=True, help="the part to keep, in the picture's pixels: x,y,w,h")
    c.add_argument("--max", type=int, help="shrink it so its longest side is at most this many pixels")
    c = cmd("where", cmd_where, "where a folder's artifacts are listed")
    c.add_argument("--folder")
    c = cmd("open", cmd_open, "show an artifact to the person, wherever they are, and print its link")
    c.add_argument("id")
    c.add_argument("--from", dest="machine", help="the machine it's on (default: this one)")
    c = cmd("link", cmd_link, "an artifact's link in the app, for the person")
    c.add_argument("id")
    c.add_argument("--from", dest="machine", help="the machine it's on (default: this one)")

    o = p.parse_args(argv)
    if not o.cmd:
        p.print_help()
        return 0
    try:
        return o.fn(o)
    except Fail as e:
        if getattr(o, "json", False):
            print(json.dumps({"error": str(e)}))
        else:
            print(f"herdr-artifact: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())

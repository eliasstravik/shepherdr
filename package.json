    "test": "bun test service core web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.17",
    "inter-ui": "4.1.1",
    "marked": "18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "emojibase-data": "17.0.0",
    "playwright-core": "1.63.0"
  }

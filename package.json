{
  "name": "shepherdr",
  "version": "2.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Private phone, tablet and desktop client for herdr-core.",
  "scripts": {
    "plugins": "bun scripts/build-plugins.ts",
    "build": "bun scripts/build-plugins.ts && vite build",
    "dev": "bun scripts/build-plugins.ts && vite",
    "start": "bun server/core/launcher.ts start",
    "demo": "SHEPHERDR_SOURCE=demo bun server/main.ts",
    "typecheck": "bun scripts/build-plugins.ts && tsc --noEmit",
    "test": "bun scripts/test.ts",
    "check": "bun run typecheck && bun scripts/test.ts && vite build"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/xterm": "6.0.0",
    "agent-browser": "0.39.4",
    "clsx": "2.1.1",
    "dompurify": "3.4.17",
    "highlight.js": "11.11.1",
    "inter-ui": "4.1.1",
    "marked": "18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rrule": "2.8.1",
    "web-push": "3.6.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "emojibase-data": "17.0.0",
    "playwright-core": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}

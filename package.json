{
  "name": "shepherdr",
  "version": "3.1.9",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Shepherdr's always-on service and its web app (phone, tablet, desktop), beside the Herdr layout.",
  "scripts": {
    "service": "bun service/main.ts",
    "dev": "vite --config web/vite.config.ts",

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "baseUrl": ".",
    "paths": { "@shared/*": ["shared/*"], "@client/*": ["src/*"], "@plugins/*": ["plugins/*"] }
  },
  "include": ["shared", "server", "plugins", "scripts", "src", "test", "helper/core-*.ts", "vite.config.ts"],
  "exclude": ["user-plugins"]
}

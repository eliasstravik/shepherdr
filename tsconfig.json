{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun"
    ],
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "web/shared/*"
      ],
      "@client/*": [
        "web/src/*"
      ],
      "@plugins/*": [
        "web/plugins/*"
      ],
      "@core/*": [
        "core/*"
      ]
    }
  },
  "include": [
    "service",
    "web/src",
    "web/shared",
    "web/plugins",
    "web/generated",
    "web/vite.config.ts",
    "web/vite.viewer.config.ts",
    "web/viewer",
    "web/build-plugins.ts",
    "core"
  ]
}
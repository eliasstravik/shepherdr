{
  "about": "When a Ready task is back at work (Working again, no Accept): core/tasks.js busyAgain() and herdr-task's busy_again() both pass these (core/tasks.test.js, test/test_herdr_task.py). now is fixed; each agent is { address, status, turn, role }.",
  "now": 1800000000000,
  "cases": [
    { "name": "still finishing the turn it said ready in",
      "task": { "state": "ready", "ready_at": 1799999990000, "ready_turns": { "t1": 5 } },
      "live": [{ "address": "t1", "status": "working", "turn": 4, "role": "worker" }], "expect": false },
    { "name": "that turn ended, idle",
      "task": { "state": "ready", "ready_at": 1799999000000, "ready_turns": { "t1": 5 } },
      "live": [{ "address": "t1", "status": "idle", "turn": 5, "role": "worker" }], "expect": false },
    { "name": "a message after it: a new turn",
      "task": { "state": "ready", "ready_at": 1799999000000, "ready_turns": { "t1": 5 } },
      "live": [{ "address": "t1", "status": "working", "turn": 5, "role": "worker" }], "expect": true },
    { "name": "said ready while idle (by someone else), then at work",
      "task": { "state": "ready", "ready_at": 1799999000000, "ready_turns": { "t1": 3 } },
      "live": [{ "address": "t1", "status": "working", "turn": 3, "role": "worker" }], "expect": true },
    { "name": "a new agent (resume, fix with none left) at work",
      "task": { "state": "ready", "ready_at": 1799999000000, "ready_turns": { "t1": 5 } },
      "live": [{ "address": "t2", "status": "working", "turn": 0, "role": "worker" }], "expect": true },
    { "name": "asking the person is Needs you, not this",
      "task": { "state": "ready", "ready_at": 1799999000000, "ready_turns": { "t1": 5 } },
      "live": [{ "address": "t1", "status": "blocked", "turn": 5, "role": "worker" }], "expect": false },
    { "name": "merging as asked: the merge is its work",
      "task": { "state": "ready", "ready_at": 1799999000000, "ready_turns": { "t1": 5 }, "merge_requested": 1799999500000 },
      "live": [{ "address": "t1", "status": "working", "turn": 9, "role": "worker" }], "expect": false },
    { "name": "a reviewer's turn",
      "task": { "state": "ready", "ready_at": 1799999000000, "ready_turns": { "t1": 5 } },
      "live": [{ "address": "t3", "status": "working", "turn": 0, "role": "reviewer" }], "expect": false },
    { "name": "a ready said before turns were kept, just now",
      "task": { "state": "ready", "ready_at": 1799999990000 },
      "live": [{ "address": "t1", "status": "working", "turn": 7, "role": "worker" }], "expect": false },
    { "name": "a ready said before turns were kept, long ago",
      "task": { "state": "ready", "ready_at": 1799999000000 },
      "live": [{ "address": "t1", "status": "working", "turn": 7, "role": "worker" }], "expect": true },
    { "name": "already Working",
      "task": { "state": "running", "ready_turns": { "t1": 5 } },
      "live": [{ "address": "t1", "status": "working", "turn": 9, "role": "worker" }], "expect": false }
  ]
}
